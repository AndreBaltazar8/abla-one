import "abla/test"
import "../../src/one_kit.ab"
import "../../src/backends/web_checkpoint.ab"
import "../../src/backends/web_recovery_live.ab"

class CheckpointApp(var label: string, var draft: string, var hits: int = 0) : OneApp {
    fun render(var ui: Ui): Node = column(style(), [
        button(ui, label, "", ui.press { hits = hits + 1 }, style()),
        input(draft, "Memo", ui.change { value -> draft = value }, style()).keyed("memo")
    ])
    fun receive(kind: string, value: string): void { return }
}

fun replace(value: Json, key: string, next: Json): Json {
    val keys: array<string> = []
    val values: array<Json> = []
    for (name in value.keys) { keys.append(name); values.append(if (name == key) next else value.get(name)) }
    jsonObject(keys, values)
}

fun main: int {
    val aQueue = oneLiveQueue()
    aQueue.browser = true
    aQueue.routes.start("/draft?q=a%C3%A7%C3%A3o")
    aQueue.storage.set("test-session", "old-credential")
    aQueue.nextId = 41
    val aApp = CheckpointApp("Submit invoice", "ação 📝")
    var a = oneSession("node-a", aApp, aQueue)
    a.eventFrontier = 7
    a.changeFrontier = 12
    a.routeFrontier = 3
    val aState = OneRecoveryState("node-a", "test-proof", "test-owner", oneLiveNoRecovery())
    aState.pickers.set(40, "files")
    aState.files.set(39, OneRecoveryFileJob(39, "opaque-handle", 100, 262144, false, true))
    val effectId="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    aState.effects.set(effectId,"{\"t\":\"back\",\"to\":\"/draft\"}")
    aState.effectOrder.append(effectId)
    oneRecoverySessions.set("node-a", aState)
    aQueue.eventContext = "opaque-operation"
    aQueue.eventOrdinal = 1
    aQueue.requestContexts.set(40, "opaque-operation/r1")
    a.render(oneDefaultTheme(), "/icons")
    val encoded = oneCheckpoint(a, jsonObject(["text"], [jsonString(aApp.draft)]))
    val saved = oneCheckpointRead(encoded)
    expect(saved != null, "bounded checkpoint round-trips a Unicode draft and transport state")
    if (saved == null) return testsPassed()
    expectEqual(saved.get("app").get("text").asString(), "ação 📝", "draft is data, not markup or a callback")
    expectEqual(saved.get("route").asString(), "/draft?q=a%C3%A7%C3%A3o", "route query survives recovery")
    val bQueue = oneLiveQueue()
    oneCheckpointSeed(bQueue, saved)
    expect(bQueue.nextId == 41 && bQueue.storage.get("test-session") == "old-credential", "factory receives durable secure storage and noncolliding request ids")
    // Hydration can rotate credentials. Restoring UI/event metadata must never
    // put the old credential back afterwards.
    bQueue.storage.set("test-session", "fresh-credential")
    val bApp = CheckpointApp("Delete customer", saved.get("app").get("text").asString())
    var b = oneSession("node-b", bApp, bQueue)
    val bState = OneRecoveryState("node-b", "test-proof", "other-owner", oneLiveNoRecovery())
    oneRecoverySessions.set("node-b", bState)
    oneCheckpointRestore(b, saved)
    expect(b.eventFrontier == 7 && b.durableFrontier == 7 && b.deferEventAck, "recovery starts from the durable event frontier")
    expect(b.changeFrontier == 12 && b.changeAnswer == 12, "lost durable typing patch is acknowledged on the new node")
    expect(b.routeFrontier == 3 && b.routeAnswer == 3, "lost durable navigation patch is acknowledged on the new node")
    expect(bState.pickers.get(40) == "files", "pending picker metadata survives owner loss")
    val fileJob = bState.files.get(39)
    expect(fileJob != null && fileJob.handle == "opaque-handle" && fileJob.offset == 100 && fileJob.length == 262144 && !fileJob.admitted, "file job descriptors survive owner loss and require idempotent readmission")
    expect(bState.effects.get(effectId)=="{\"t\":\"back\",\"to\":\"/draft\"}" && bState.effectOrder.size==1,"committed browser effects survive owner loss in their original order")
    val effect=saved.get("effects").values[0]
    expect(oneCheckpointRead(jsonStringify(replace(saved,"effects",jsonArray([effect,effect]))))==null,"duplicate effect IDs are rejected before restore")
    expect(!oneCheckpointEffect("{\"t\":\"fetch\",\"request\":{}}") && !oneCheckpointEffect("{\"t\":\"forward\",\"secret\":\"unexpected\"}"),"raw HTTP requests and unknown effect fields never enter the durable UI outbox")
    expect(!oneCheckpointEffect("{\"t\":\"back\",\"to\":\"//foreign.test\"}"),"durable browser back effects cannot introduce an external target")
    val badJob = jsonObject(["id", "handle", "offset", "length", "delete"], [jsonInteger(39), jsonString("opaque-handle"), jsonInteger(0), jsonInteger(262145), jsonBoolean(false)])
    expect(oneCheckpointRead(jsonStringify(replace(saved, "files", jsonArray([badJob])))) == null, "restored file reads cannot bypass the chunk bound")
    expect(bQueue.eventContext == "opaque-operation" && bQueue.requestContexts.get(40) == "opaque-operation/r1", "opaque pending-operation ancestry survives without raw HTTP requests")
    expect(bQueue.storage.get("test-session") == "fresh-credential", "authorization hydration wins over old checkpoint credentials")
    expect(b.changed && b.htmlSent == "" && b.cssSent == 0, "restored session sends a full fresh authorized render")
    b.render(oneDefaultTheme(), "/icons")
    expectEqual(oneEventLanding(b.maps, 1, 1, false), 0, "an old submit press cannot become a new destructive action at the same position")
    expectEqual(bApp.hits, 0, "restoring metadata never executes an old handler")

    expect(oneCheckpointRead("{") == null, "malformed JSON is refused")
    expect(oneCheckpointRead(jsonStringify(replace(saved, "v", jsonInteger(2)))) == null, "incompatible snapshot versions are refused")
    expect(oneCheckpointRead(jsonStringify(replace(saved, "frontier", jsonString("7")))) == null, "frontier strings are not coerced")
    expect(oneCheckpointRead(jsonStringify(replace(saved, "revision", jsonNumberText("1.5")))) == null, "fractional revisions are refused")
    expect(oneCheckpointRead(jsonStringify(replace(saved, "route", jsonString("//foreign.test/path")))) == null, "external route targets are refused")
    expect(oneCheckpointRead(jsonStringify(replace(saved, "route", jsonString("/\\foreign.test/path")))) == null, "browser-normalized backslash authority targets are refused")
    expect(oneCheckpointRead(jsonStringify(replace(saved, "app", jsonArray([])))) == null, "application checkpoint must be an object")
    expect(oneCheckpointRead(jsonStringify(replace(saved, "storage", jsonObject(["token"], [jsonInteger(1)])))) == null, "stored values retain exact string types")
    expect(oneCheckpointRead(jsonStringify(replace(saved, "width", jsonInteger(1000000)))) == null, "corrupt viewport sizes are bounded")
    val tooMany: array<Json> = []
    for (map in saved.get("maps").values) { var i = 0; while (i < 9) { tooMany.append(map); i = i + 1 } }
    expect(oneCheckpointRead(jsonStringify(replace(saved, "maps", jsonArray(tooMany)))) == null, "event history remains bounded at eight revisions")
    var huge = "x"
    while (huge.size <= oneRecoveryCheckpointLimit) huge = "$huge$huge"
    expect(oneCheckpointRead(huge) == null, "oversized data is rejected before parsing")
    expect(oneRecoveryPickerBegin("node-b", 41, "files") && oneRecoveryPickerBegin("node-b", 42, "profile") && oneRecoveryPickerBegin("node-b", 43, "emoji"), "four pending pickers can coexist")
    expect(!oneRecoveryPickerBegin("node-b", 44, "files"), "a fifth picker is refused before exposing another browser dialog")
    expect(oneRecoveryPickerBegin("node-b", 40, "files") && bState.pickers.keys().size == 4, "registering an existing picker does not consume capacity twice")
    val original=httpRequest("GET","/one/live?s=synthetic","",[HttpHeader("X-One-Recovery-Claim","attacker"),HttpHeader("Cookie","test=1")])
    val firstClaim=oneRecoveryAttachRequest(original)
    val secondClaim=oneRecoveryAttachRequest(original)
    expect(firstClaim.header("x-one-recovery-claim").size==32 && oneRecoveryIdentifier(firstClaim.header("x-one-recovery-claim")) && firstClaim.header("x-one-recovery-claim")!=secondClaim.header("x-one-recovery-claim"),"every accepted socket gets a fresh server-generated attach identity")
    expect(firstClaim.headers.size==2 && firstClaim.header("cookie")=="test=1","an app-supplied attach header is stripped while the actual browser identity is retained")
    oneRecoverySessions.remove("node-a")
    oneRecoverySessions.remove("node-b")
    testsPassed()
}
