import "abla/test"
import "abla/fs"
import "abla/sys/linux"
import "../../examples/gallery/gallery.ab"
import "../../src/backends/epaper.ab"

// The epaper backend (PaperMono): the driver's dither, its drawing planes,
// dirty rectangles and refresh modes, touch, and the wire format.

fun noIcons(): OneIconSource = OneIconSource({ name -> "" })

fun fileIcons(): OneIconSource = OneIconSource({ name -> linuxReadFile("build/gallery/icons/$name.svg", 65536) })

fun main: int {
    // Levels match abla-embedded's ssd1677CanvasGray (computed from its tables).
    val samples = [[0, 0, 0, 0], [128, 0, 0, 1], [128, 1, 0, 2], [128, 3, 3, 2], [200, 2, 1, 3], [255, 5, 6, 3], [64, 7, 2, 1], [100, 1, 3, 1], [190, 0, 2, 2]]
    for (s in samples) expectEqual(oneEpaperLevel(s[0], s[1], s[2]), s[3], "dither ${s[0]} at ${s[1]},${s[2]}")
    expectEqual(oneEpaperPhysicalX(10, 20), 20, "portrait x → physical x")
    expectEqual(oneEpaperPhysicalY(10, 20, 480), 469, "portrait x → physical y (rotation 3)")

    // Crisp: fills keep the panel's shades, text and lines print solid.
    expectEqual(oneEpaperShade(0), 0, "black")
    expectEqual(oneEpaperShade(208), 2, "a light fill is the light shade")
    expectEqual(oneEpaperShade(255), 3, "white")
    expectEqual(oneEpaperCrispPaint(OnePaint("text", 0, 0, 9, 9, 0, "#777777", "x", 16, "", "")).color, "#000000", "grey text prints black")
    expectEqual(oneEpaperCrispPaint(OnePaint("text", 0, 0, 9, 9, 0, "#777777", "x", 16, "", "")).weight, "medium", "small text is heavier")
    expectEqual(oneEpaperCrispPaint(OnePaint("text", 0, 0, 9, 9, 0, "#ffffff", "x", 16, "", "")).color, "#ffffff", "white text stays white")
    expectEqual(oneEpaperCrispPaint(OnePaint("rect", 0, 0, 9, 9, 0, "#d0d0d0", "", 0, "", "")).color, "#d0d0d0", "fills keep their shade")

    // Planes: LSB then MSB (48000 bytes each), rows of 100 bytes, MSB-first bits.
    val planes = filledArray(96000, 0)
    planes[0] = 0x5F
    planes[48000] = 0x3F
    planes[100] = 0xBF
    planes[48100] = 0xFF
    expectEqual(oneEpaperPlaneLevel(planes, 0, 0), 0, "LSB 0, MSB 0: black")
    expectEqual(oneEpaperPlaneLevel(planes, 1, 0), 1, "LSB 1, MSB 0")
    expectEqual(oneEpaperPlaneLevel(planes, 2, 0), 2, "LSB 0, MSB 1")
    expectEqual(oneEpaperPlaneLevel(planes, 3, 0), 3, "both bits: white")
    expectEqual(oneEpaperPlaneLevel(planes, 1, 1), 2, "row 1 is the next 100 bytes")

    // Rendering the gallery, band by band, matches rendering it whole.
    var sample = Gallery()
    var sampleUi = oneUiSized("epaper", oneDefaultTheme(), 360)
    val scaledOwners: array<string> = []
    val scaled = oneEpaperScaleFrame(onePaintFrame(oneLayout(sample.render(sampleUi), oneDefaultTheme(), "epaper", 360, 601, Map()), 360, 601), 133, 480, 800, 2, true, scaledOwners)
    val whole = oneRasterFrame(scaled, "#ffffff", noIcons())
    val banded = oneRasterBand(scaled, "#ffffff", noIcons(), 200, 40)
    var same = true
    var at = 0
    while (at < 480 * 40) {
        if (banded.pixels[at] != whole.pixels[200 * 480 + at]) same = false
        at = at + 1
    }
    expect(same, "a band's pixels are the frame's rows 200-239")

    val t = oneDefaultTheme()
    var app = Gallery()
    var state = oneEpaperState(onePaperMonoOptions())
    expectEqual(oneEpaperLogicalWidth(state.options), 360, "logical width at 133%")
    val first = oneEpaperRender(app, t, state, noIcons())
    expectEqual(first.mode, oneEpaperText, "the first frame is a full quality refresh")
    expectEqual(first.rects.size, 1, "covering")
    expect(first.rects[0].w == 800 && first.rects[0].h == 480, "the whole panel")
    expectEqual(first.planes.size, 96000, "PaperMono canvas: two 48000-byte planes")
    var dark = 0
    var py = 0
    while (py < 480) {
        var px = 0
        while (px < 800) {
            if (oneEpaperPlaneLevel(state.planes, px, py) < 3) dark = dark + 1
            px = px + 1
        }
        py = py + 1
    }
    expect(dark > 10000 && dark < 300000, "something is drawn (${dark} non-white pixels)")

    val again = oneEpaperRender(app, t, state, noIcons())
    expectEqual(again.rects.size, 0, "no change, nothing to refresh")
    expectEqual(again.revision, first.revision, "and the revision stays")

    // Tap "Adicionar (0)": a small partial refresh.
    var tapped = false
    for (p in state.frame.paints) {
        if (!tapped && p.op == "text" && p.text == "Adicionar (0)") {
            tapped = oneEpaperTouch(app, t, state, (p.x + p.w / 2) * state.options.scale / 100, (p.y + p.h / 2) * state.options.scale / 100)
        }
    }
    expect(tapped && app.count == 1, "a tap on the panel reaches the counter button")
    val counted = oneEpaperRender(app, t, state, noIcons())
    expect(counted.rects.size >= 1, "the change is refreshed")
    expectEqual(counted.mode, oneEpaperFastest, "as a fast partial refresh")
    var area = 0
    for (r in counted.rects) {
        expectEqual(r.x % 8, 0, "rectangles start on a byte")
        expectEqual(r.w % 8, 0, "and cover whole bytes")
        area = area + r.w * r.h
    }
    expect(area < 800 * 480 / 10, "only a small area (${area} px)")

    // Only the bands that changed were drawn, and the planes equal a fresh render.
    expect(state.pixelsDrawn > 0 && state.pixelsDrawn < 480 * 800 / 10, "a tap redraws little (${state.pixelsDrawn} pixels)")
    var freshApp = Gallery()
    freshApp.count = app.count
    var fresh = oneEpaperState(onePaperMonoOptions())
    oneEpaperRender(freshApp, t, fresh, noIcons())
    expectEqual(fresh.pixelsDrawn, 480 * 800, "a first frame draws every pixel")
    var planesMatch = true
    var planeAt = 0
    while (planeAt < 96000) {
        if (fresh.planes[planeAt] != state.planes[planeAt]) planesMatch = false
        planeAt = planeAt + 1
    }
    expect(planesMatch, "skipping bands leaves the same planes as a fresh render")

    // Borders and rules are at least two panel pixels.
    expectEqual(oneEpaperScaleSides("1 0 1 0", 133, 2), "2 0 2 0", "thin borders widen")
    expectEqual(oneEpaperScaleSides("3", 133, 2), "3", "thick ones scale")

    // A swipe shifts what is on the panel: few pixels are drawn, and the planes
    // equal a fresh render of the same scroll, both ways.
    for (delta in [160, -96, 200, -264]) {
        expect(oneEpaperScroll(state, 240, 400, delta), "swipe $delta scrolls")
        oneEpaperRender(app, t, state, noIcons())
        expect(state.pixelsDrawn < 480 * 800 * 3 / 4, "swipe $delta draws part of the screen (${state.pixelsDrawn})")
        var again = Gallery()
        again.count = app.count
        var freshScroll = oneEpaperState(onePaperMonoOptions())
        for (hit in state.frame.hits) if (hit.kind == "scroll") freshScroll.scroll.set(hit.key, oneParseInt(hit.value, 0))
        oneEpaperRender(again, t, freshScroll, noIcons())
        var same = 0
        var at = 0
        while (at < 96000) {
            if (freshScroll.planes[at] != state.planes[at]) same = same + 1
            at = at + 1
        }
        expectEqual(same, 0, "swipe $delta looks like a fresh render")
    }

    // Far apart rectangles refresh apart; close ones together; never more than four.
    expectEqual(oneEpaperGroupRects([OneEpaperRect(0, 0, 8, 8), OneEpaperRect(400, 0, 8, 8)]).size, 2, "far apart stays apart")
    expectEqual(oneEpaperGroupRects([OneEpaperRect(0, 0, 8, 8), OneEpaperRect(8, 8, 8, 8)]).size, 1, "touching merge")
    expectEqual(oneEpaperGroupRects([OneEpaperRect(0, 0, 8, 8), OneEpaperRect(100, 0, 8, 8), OneEpaperRect(200, 0, 8, 8), OneEpaperRect(300, 0, 8, 8), OneEpaperRect(400, 0, 8, 8), OneEpaperRect(500, 0, 8, 8)]).size, 4, "at most four")
    val greyPlanes = filledArray(96000, 255)
    expect(!oneEpaperShowsGrey(greyPlanes, OneEpaperRect(0, 0, 16, 8)), "white is not grey")
    greyPlanes[100] = 0
    expect(oneEpaperShowsGrey(greyPlanes, OneEpaperRect(0, 0, 16, 8)), "planes that differ are grey")

    // Switching tabs changes most of the screen: a full refresh.
    app.tab = 1
    val people = oneEpaperRender(app, t, state, noIcons())
    expect(people.rects.size >= 1, "tab switch refreshes")

    // Periodic full refresh after many partials.
    var full = false
    var n = 0
    while (n < 14) {
        app.count = app.count + 1
        app.tab = 0
        val u = oneEpaperRender(app, t, state, noIcons())
        if (u.mode == oneEpaperText) full = true
        n = n + 1
    }
    expect(full, "a full quality refresh comes back after ${state.options.fullEvery} partials")

    // A swipe scrolls the page's scroll area, within its bounds.
    expect(oneEpaperScroll(state, 240, 400, 300), "a swipe up scrolls the page")
    val scrolled = oneEpaperRender(app, t, state, noIcons())
    expect(scrolled.rects.size >= 1, "and the scrolled page is refreshed")
    expect(oneEpaperScroll(state, 240, 400, -100000), "scrolling back")
    oneEpaperRender(app, t, state, noIcons())
    expect(!oneEpaperScroll(state, 240, 400, -10), "stops at the top")
    expect(!oneEpaperScroll(state, 240, 790, 300), "the tab bar is not a scroll area")

    // Previews to look at, with icons: both pages.
    Path("build/ui").createDirectories()
    var shown = Gallery()
    var shownState = oneEpaperState(onePaperMonoOptions())
    oneEpaperRender(shown, t, shownState, fileIcons())
    Path("build/ui/epaper-gallery.png").writeText(oneEpaperPreview(shownState))
    shown.tab = 1
    oneEpaperRender(shown, t, shownState, fileIcons())
    Path("build/ui/epaper-gallery-people.png").writeText(oneEpaperPreview(shownState))
    oneEpaperKeyboardTest()
    testsPassed()
}

class Form(var mail: string by State("")) : OneApp {
    fun render(var ui: Ui): Node = column(style().fill(), [
        input(mail, "email", ui.change { value -> mail = value }, style().height(40)),
        text("typed: $mail", style())
    ])
    fun receive(kind: string, value: string): void {
        return
    }
}

// Where a key's centre is in panel pixels.
fun keyTap(var app: OneApp, t: Theme, var state: OneEpaperState, label: string): void {
    var index = 0
    var found = -1
    for (r in oneEpaperLayers[state.keyLayer]) {
        for (word in oneEpaperKeyWords(r)) {
            index = index + 1
            if (word == label) found = index
        }
    }
    expect(found > 0, "key $label")
    for (h in state.frame.hits) {
        if (h.event == oneEpaperKeyBase + found) {
            expect(oneEpaperTouch(app, t, state, (h.x + h.w / 2) * state.options.scale / 100, (h.y + h.h / 2) * state.options.scale / 100), "key $label acts")
            oneEpaperRender(app, t, state, OneIconSource({ name -> "" }))
            return
        }
    }
    expect(false, "key $label on screen")
    return
}

fun oneEpaperKeyboardTest(): void {
    val t = theme()
    var app = Form()
    var state = oneEpaperState(onePaperMonoOptions())
    oneEpaperRender(app, t, state, OneIconSource({ name -> "" }))
    expect(oneEpaperTouch(app, t, state, 100, 20), "an input opens the keyboard")
    oneEpaperRender(app, t, state, OneIconSource({ name -> "" }))
    expect(state.typingEvent != 0, "typing")
    keyTap(app, t, state, "⇧")
    keyTap(app, t, state, "A")
    expectEqual(state.keyLayer, 0, "one capital")
    keyTap(app, t, state, "b")
    keyTap(app, t, state, "#")
    keyTap(app, t, state, "ã")
    keyTap(app, t, state, "<")
    keyTap(app, t, state, "1")
    keyTap(app, t, state, "espaço")
    keyTap(app, t, state, "#")
    keyTap(app, t, state, "@")
    expectEqual(app.mail, "Ab1 @", "the app gets the text")
    keyTap(app, t, state, "OK")
    expectEqual(state.typingEvent, 0, "closed")
    expect(state.frame.hits.size == 1, "keys gone")
    return
}
