import "abla/test"
import "abla/fs"
import "../../examples/gallery/gallery.ab"
import "../../src/backends/epaper.ab"

// The epaper backend (PaperMono): the driver's dither, its drawing planes,
// dirty rectangles and refresh modes, touch, and the wire format.

fun noIcons(): OneIconSource = OneIconSource({ name -> "" })

fun main: int {
    // Levels match abla-embedded's ssd1677CanvasGray (computed from its tables).
    val samples = [[0, 0, 0, 0], [128, 0, 0, 1], [128, 1, 0, 2], [128, 3, 3, 2], [200, 2, 1, 3], [255, 5, 6, 3], [64, 7, 2, 1], [100, 1, 3, 1], [190, 0, 2, 2]]
    for (s in samples) expectEqual(oneEpaperLevel(s[0], s[1], s[2]), s[3], "dither ${s[0]} at ${s[1]},${s[2]}")
    expectEqual(oneEpaperPhysicalX(10, 20), 20, "portrait x → physical x")
    expectEqual(oneEpaperPhysicalY(10, 20, 480), 469, "portrait x → physical y (rotation 3)")

    // Planes: LSB then MSB (48000 bytes each), rows of 100 bytes, MSB-first bits.
    val planes = filledArray(96000, 0)
    planes[0] = 0x5F
    planes[48000] = 0x3F
    planes[100] = 0xBF
    planes[48100] = 0xFF
    expectEqual(oneEpaperPlaneLevel(planes, 0, 0), 0, "LSB 0, MSB 0: black")
    expectEqual(oneEpaperPlaneLevel(planes, 1, 0), 1, "LSB 1, MSB 0")
    expectEqual(oneEpaperPlaneLevel(planes, 2, 0), 2, "LSB 0, MSB 1")
    expectEqual(oneEpaperPlaneLevel(planes, 3, 0), 3, "both bits: white")
    expectEqual(oneEpaperPlaneLevel(planes, 1, 1), 2, "row 1 is the next 100 bytes")

    // Rendering the gallery, band by band, matches rendering it whole.
    var sample = Gallery()
    var sampleUi = oneUiSized("epaper", oneDefaultTheme(), 360)
    val scaled = oneEpaperScaleFrame(onePaintFrame(oneLayout(sample.render(sampleUi), oneDefaultTheme(), "epaper", 360, 601, Map()), 360, 601), 133, 480, 800)
    val whole = oneRasterFrame(scaled, "#ffffff", noIcons())
    val banded = oneRasterBand(scaled, "#ffffff", noIcons(), 200, 40)
    var same = true
    var at = 0
    while (at < 480 * 40) {
        if (banded.pixels[at] != whole.pixels[200 * 480 + at]) same = false
        at = at + 1
    }
    expect(same, "a band's pixels are the frame's rows 200-239")

    val t = oneDefaultTheme()
    var app = Gallery()
    var state = oneEpaperState(onePaperMonoOptions())
    expectEqual(oneEpaperLogicalWidth(state.options), 360, "logical width at 133%")
    val first = oneEpaperRender(app, t, state, noIcons())
    expectEqual(first.mode, oneEpaperQuality, "the first frame is a full quality refresh")
    expectEqual(first.rects.size, 1, "covering")
    expect(first.rects[0].w == 800 && first.rects[0].h == 480, "the whole panel")
    expectEqual(first.planes.size, 96000, "PaperMono canvas: two 48000-byte planes")
    var dark = 0
    var py = 0
    while (py < 480) {
        var px = 0
        while (px < 800) {
            if (oneEpaperPlaneLevel(state.planes, px, py) < 3) dark = dark + 1
            px = px + 1
        }
        py = py + 1
    }
    expect(dark > 10000 && dark < 300000, "something is drawn (${dark} non-white pixels)")

    val again = oneEpaperRender(app, t, state, noIcons())
    expectEqual(again.rects.size, 0, "no change, nothing to refresh")
    expectEqual(again.revision, first.revision, "and the revision stays")

    // Tap "Adicionar (0)": a small partial refresh.
    var tapped = false
    for (p in state.frame.paints) {
        if (!tapped && p.op == "text" && p.text == "Adicionar (0)") {
            tapped = oneEpaperTouch(app, t, state, (p.x + p.w / 2) * state.options.scale / 100, (p.y + p.h / 2) * state.options.scale / 100)
        }
    }
    expect(tapped && app.count == 1, "a tap on the panel reaches the counter button")
    val counted = oneEpaperRender(app, t, state, noIcons())
    expect(counted.rects.size >= 1, "the change is refreshed")
    expectEqual(counted.mode, oneEpaperFastest, "as a fast partial refresh")
    var area = 0
    for (r in counted.rects) {
        expectEqual(r.x % 8, 0, "rectangles start on a byte")
        expectEqual(r.w % 8, 0, "and cover whole bytes")
        area = area + r.w * r.h
    }
    expect(area < 800 * 480 / 10, "only a small area (${area} px)")

    // Only the bands that changed were drawn, and the planes equal a fresh render.
    expect(state.bandsDrawn > 0 && state.bandsDrawn <= 6, "a tap draws few bands (${state.bandsDrawn})")
    var freshApp = Gallery()
    freshApp.count = app.count
    var fresh = oneEpaperState(onePaperMonoOptions())
    oneEpaperRender(freshApp, t, fresh, noIcons())
    expectEqual(fresh.bandsDrawn, 20, "a first frame draws every band")
    var planesMatch = true
    var planeAt = 0
    while (planeAt < 96000) {
        if (fresh.planes[planeAt] != state.planes[planeAt]) planesMatch = false
        planeAt = planeAt + 1
    }
    expect(planesMatch, "skipping bands leaves the same planes as a fresh render")

    // Borders and rules are at least two panel pixels.
    expectEqual(oneEpaperScaleSides("1 0 1 0", 133, 2), "2 0 2 0", "thin borders widen")
    expectEqual(oneEpaperScaleSides("3", 133, 2), "3", "thick ones scale")

    // Wire format: header and the rectangle bytes.
    val wire = oneEpaperWire(counted, 800, 480)
    expect(wire.slice(0, 4) == "ONE1", "magic")
    expectEqual(wire[8], oneEpaperFastest, "mode byte")
    expectEqual(wire[9], counted.rects.size, "rectangle count")
    var expected = 10
    for (r in counted.rects) expected = expected + 8 + 2 * (r.w / 8) * r.h
    expectEqual(wire.size, expected, "rectangles carry both planes")

    // Switching tabs changes most of the screen: a full refresh.
    app.tab = 1
    val people = oneEpaperRender(app, t, state, noIcons())
    expect(people.rects.size >= 1, "tab switch refreshes")

    // Periodic full refresh after many partials.
    var full = false
    var n = 0
    while (n < 14) {
        app.count = app.count + 1
        app.tab = 0
        val u = oneEpaperRender(app, t, state, noIcons())
        if (u.mode == oneEpaperQuality) full = true
        n = n + 1
    }
    expect(full, "a full quality refresh comes back after ${state.options.fullEvery} partials")

    // A swipe scrolls the page's scroll area, within its bounds.
    expect(oneEpaperScroll(state, 240, 400, 300), "a swipe up scrolls the page")
    val scrolled = oneEpaperRender(app, t, state, noIcons())
    expect(scrolled.rects.size >= 1, "and the scrolled page is refreshed")
    expect(oneEpaperScroll(state, 240, 400, -100000), "scrolling back")
    oneEpaperRender(app, t, state, noIcons())
    expect(!oneEpaperScroll(state, 240, 400, -10), "stops at the top")
    expect(!oneEpaperScroll(state, 240, 790, 300), "the tab bar is not a scroll area")

    Path("build/ui").createDirectories()
    Path("build/ui/epaper-gallery.png").writeText(oneEpaperPreview(state))
    testsPassed()
}
