import "abla/test"
import "../../src/one.ab"

fun sample(): Theme {
    var t = theme()
    t.token("brand", "#193c30")
    t.token("epaper:brand", "#000000")
    t.token("web:brand", "#123456")
    t.token("web-canvas:brand", "#654321")
    t.token("accent", "@brand")
    t.token("loop", "@loop")
    t.textPreset("title", style().fontSize(17).weight("semibold").lineHeight(22))
    t.textPreset("caption", style().fontSize(12).on("epaper", style().fontSize(14)))
    t.kind("text", style().color("#172d28").fontSize(15))
    t.define("Button.primary", style().background("@brand").radius(12))
    t
}

fun main: int {
    val t = sample()
    expectEqual(t.value("@brand", "android"), "#193c30", "plain token")
    expectEqual(t.value("@brand", "epaper"), "#000000", "target-scoped token")
    expectEqual(t.value("@brand", "web-document"), "#123456", "family-scoped token")
    expectEqual(t.value("@brand", "web-canvas"), "#654321", "exact target beats family")
    expectEqual(t.value("@accent", "android"), "#193c30", "tokens chain")
    expectEqual(t.value("@missing", "android"), "@missing", "unknown token is left as is")
    expectEqual(t.value("@loop", "android"), "@loop", "cycles stop")
    expectEqual(t.value("#fff", "android"), "#fff", "literal values pass through")

    val plain = oneResolve(t, "text", style(), "android")
    expectEqual(plain.get("color"), "#172d28", "kind defaults apply")
    expectEqual(plain.get("size"), "15", "kind default size")
    val own = oneResolve(t, "text", style().fontSize(20), "android")
    expectEqual(own.get("size"), "20", "node style beats kind defaults")

    val title = oneResolve(t, "text", style().text("@title").color("@brand"), "android")
    expectEqual(title.get("size"), "17", "text preset expands")
    expectEqual(title.get("weight"), "semibold", "preset weight")
    expectEqual(title.get("color"), "#193c30", "tokens resolve in node styles")
    val afterPreset = oneResolve(t, "text", style().text("title").fontSize(30), "android")
    expectEqual(afterPreset.get("size"), "30", "later entries beat the preset")
    val caption = oneResolve(t, "text", style().text("caption"), "epaper")
    expectEqual(caption.get("size"), "14", "presets have their own target scopes")

    // Within one style: unscoped, then family, then exact target, regardless of order.
    val layered = style().on("web-document", style().radius(3)).on("web", style().radius(2)).radius(1)
    expectEqual(oneResolve(t, "column", layered, "web-document").get("radius"), "3", "exact target wins")
    expectEqual(oneResolve(t, "column", layered, "web-canvas").get("radius"), "2", "family beats unscoped")
    expectEqual(oneResolve(t, "column", layered, "android").get("radius"), "1", "unscoped elsewhere")

    val states = oneResolve(t, "pressable", style().background("#fff").pressed(style().background("#eee")).on("web", style().hover(style().background("#f5f5f5"))), "web-document")
    expectEqual(states.get("background"), "#fff", "base value")
    expectEqual(states.get("pressed:background"), "#eee", "pressed state key")
    expectEqual(states.get("hover:background"), "#f5f5f5", "hover state scoped to web")
    val android = oneResolve(t, "pressable", style().on("web", style().hover(style().background("#f5f5f5"))), "android")
    expect(!android.has("hover:background"), "web-only state ignored on android")

    val pressedPreset = oneResolve(t, "text", style().pressed(style().text("title")), "android")
    expectEqual(pressedPreset.get("pressed:size"), "17", "preset under a state keeps the state")

    val button = oneResolve(t, "pressable", t.named("Button.primary").with(style().radius(8)), "android")
    expectEqual(button.get("background"), "#193c30", "component variant defaults")
    expectEqual(button.get("radius"), "8", "instance overrides variant")
    expectEqual(button.int("radius", 0), 8, "int accessor")
    expectEqual(button.int("missing", 5), 5, "int fallback")

    expectEqual(oneParseInt("-12", 0), -12, "negative ints")
    expectEqual(oneParseInt("fill", 7), 7, "non-numeric falls back")
    expectEqual(oneParseInt("", 3), 3, "empty falls back")
    testsPassed()
}
