import "abla/test"
import "../../src/one_kit.ab"
import "../../src/layout/paint.ab"

fun press(var ui: Ui, label: string): Node = button(ui, label, "plain", ui.press { }, style())

fun block(width: int): Node = column(style().width(width).height(20), [])

fun boxAt(root: OneBox, index: int): borrow(root) OneBox = root.children[index]

fun testWrap(): void {
    val theme = oneDefaultTheme()
    val wrapped = oneLayout(column(style().fill(), [
        row(style().wrap().gap(10).padding(5), [block(100), block(100), block(100), block(50)])
    ]), theme, "desktop", 240, 300, Map()).children[0]
    expectEqual(boxAt(wrapped, 0).x, 5, "wrap: first at the padding")
    expectEqual(boxAt(wrapped, 1).x, 115, "wrap: second beside it, after the gap")
    expectEqual(boxAt(wrapped, 2).x, 5, "wrap: third starts a line")
    expectEqual(boxAt(wrapped, 2).y, 35, "wrap: a line lower, with the gap")
    expectEqual(boxAt(wrapped, 3).y, 35, "wrap: fourth still fits there")
    expectEqual(wrapped.h, 60, "wrap: as tall as its lines")
    val wide = oneLayout(column(style().fill(), [
        row(style().wrap().gap(10), [block(500), block(50)])
    ]), theme, "desktop", 240, 300, Map()).children[0]
    expectEqual(boxAt(wide, 0).y, 0, "wrap: an oversized child takes the first line")
    expectEqual(boxAt(wide, 1).y, 30, "wrap: and pushes the next down")
    val none = oneLayout(column(style().fill(), [row(style().wrap(), [])]), theme, "desktop", 240, 300, Map()).children[0]
    expectEqual(none.h, 0, "wrap: empty")
    return
}

fun testScrollRow(): void {
    val theme = oneDefaultTheme()
    val tree = column(style().fill(), [scrollRow(style().gap(10).padding(5), [block(100), block(100), block(100)])])
    val fresh = oneLayout(tree, theme, "desktop", 200, 300, Map()).children[0]
    expectEqual(fresh.w, 200, "scrollRow: takes the width offered")
    expectEqual(fresh.h, 30, "scrollRow: as tall as its children")
    expectEqual(fresh.contentH, 330, "scrollRow: content keeps natural widths")
    expectEqual(fresh.scrollY, 0, "scrollRow: starts at the left")
    val frame = onePaintFrame(oneLayout(tree, theme, "desktop", 200, 300, Map()), 200, 300)
    var hit = -1
    var index = 0
    while (index < frame.hits.size) {
        if (frame.hits[index].kind == "scrollAcross") hit = index
        index = index + 1
    }
    expect(hit >= 0, "scrollRow: scrollable when it overflows")
    val path = frame.hits[hit].key
    val offsets: Map<string, int> = Map()
    offsets.set(path, 60)
    expectEqual(oneLayout(tree, theme, "desktop", 200, 300, offsets).children[0].scrollY, 60, "scrollRow: keeps its offset")
    offsets.set(path, 9999)
    expectEqual(oneLayout(tree, theme, "desktop", 200, 300, offsets).children[0].scrollY, 130, "scrollRow: clamps at the end")
    offsets.set(path, -5)
    expectEqual(oneLayout(tree, theme, "desktop", 200, 300, offsets).children[0].scrollY, 0, "scrollRow: clamps at the start")
    var moved = oneLayout(tree, theme, "desktop", 200, 300, Map())
    offsets.set(path, 40)
    oneLayoutRescroll(moved, offsets, "r")
    expectEqual(moved.children[0].scrollY, 40, "scrollRow: rescroll applies without a new layout")
    expectEqual(moved.children[0].children[0].x, 5 - 40, "scrollRow: its children move with the offset")
    oneLayoutRescroll(moved, offsets, "r")
    expectEqual(moved.children[0].children[0].x, 5 - 40, "scrollRow: the same offset again moves nothing")
    // A child scrolled out sideways isn't painted, so a press there can't reach it.
    val offscreen = onePaintFrame(oneLayout(column(style().fill(), [scrollRow(style(), [block(300), block(300).set("onPress", "7")])]), theme, "desktop", 200, 300, Map()), 200, 300)
    var pressHits = 0
    for (found in offscreen.hits) if (found.kind == "press") pressHits = pressHits + 1
    expectEqual(pressHits, 0, "scrollRow: nothing to press outside it")
    // What follows a scrollRow is painted outside its clip.
    val clips = onePaintFrame(oneLayout(column(style().fill(), [scrollRow(style(), [block(500)]), text("after", style())]), theme, "desktop", 200, 300, Map()), 200, 300)
    var depth = 0
    var depthAtText = -1
    for (paint in clips.paints) {
        if (paint.op == "clip") depth = depth + 1
        else if (paint.op == "unclip") depth = depth - 1
        else if (paint.text == "after") depthAtText = depth
    }
    expectEqual(depthAtText, 0, "scrollRow: its clip ends with it")
    val fits = column(style().fill(), [scrollRow(style(), [block(50)])])
    val fitFrame = onePaintFrame(oneLayout(fits, theme, "desktop", 200, 300, Map()), 200, 300)
    var fitHits = 0
    for (found in fitFrame.hits) {
        if (found.kind == "scrollAcross") fitHits = fitHits + 1
    }
    expectEqual(fitHits, 0, "scrollRow: nothing to scroll when it fits")
    return
}

fun fieldFrame(value: string, multiline: bool): OneFrame {
    val theme = oneDefaultTheme()
    val field = input(value, "Type", 1, style().padding(16).set("maxLines", "2"))
    onePaintFrame(oneLayout(column(style().fill(), [if (multiline) field.set("multiline", "true") else field]), theme, "desktop", 300, 200, Map()), 300, 200)
}

fun fieldHit(frame: OneFrame): OneHit {
    var found = -1
    var index = 0
    while (index < frame.hits.size) {
        if (frame.hits[index].kind == "input") found = index
        index = index + 1
    }
    frame.hits[found]
}

fun fieldText(frame: OneFrame): array<OnePaint> {
    val texts: array<OnePaint> = []
    for (p in frame.paints) if (p.op == "text") texts.append(p)
    texts
}

fun caretFor(value: string): int = fieldHit(fieldFrame(value, false)).caretX

fun testCaret(): void {
    val empty = caretFor("")
    val word = caretFor("ab")
    val spaced = caretFor("ab ")
    expect(word > empty, "caret: after the text")
    expect(spaced > word, "caret: a trailing space moves it")
    expect(caretFor("ab  ") > spaced, "caret: and another moves it again")
    expect(caretFor(" ") > empty, "caret: only a space moves it too")
    expect(caretFor("ab c") > spaced, "caret: the next letter still moves it on")
    return
}

fun endsWith(text: string, end: string): bool = text.size >= end.size && text.slice(text.size - end.size, text.size) == end

fun testFieldShowsItsEnd(): void {
    var long = ""
    var index = 0
    while (index < 40) {
        long = "${long}palavra "
        index = index + 1
    }
    val frame = fieldFrame("${long}fim", false)
    val hit = fieldHit(frame)
    val texts = fieldText(frame)
    expectEqual(texts.size, 1, "long field: one line")
    expect(endsWith(texts[0].text, "fim"), "long field: the newest text is what's painted")
    expect(texts[0].x < hit.x + 16, "long field: it slid left")
    expectEqual(texts[0].x + texts[0].w, hit.caretX, "long field: the caret follows the text")
    expectEqual(hit.caretX, hit.x + hit.w - 16 - oneCaretWidth, "long field: the caret stays inside")
    var clips = 0
    for (p in frame.paints) if (p.op == "clip" && p.x == hit.x + 16) clips = clips + 1
    expectEqual(clips, 1, "long field: the slid text is clipped to the field")
    expect(!endsWith(fieldText(fieldFrame("${long}fim", false))[0].text, "…"), "long field: no ellipsis")
    expect(fieldText(fieldFrame("ab", false))[0].x == hit.x + 16, "short field: starts at its padding")
    // A character is never cut in half, whatever the width lands on.
    val accents = oneInputTail("ééééééééééééééééééééééééééééééééééééééééé", 16, "regular", 100)
    expect(accents[0] < 128 || accents[0] >= 192, "tail: starts on a whole character")
    expect(endsWith(fieldText(fieldFrame("${long}", false))[0].text, " "), "long field: its trailing space counts")
    expect(fieldHit(fieldFrame("${long}", false)).caretX <= hit.x + hit.w - 16, "long field: and the caret still fits")
    val rows = fieldFrame("${long}fim", true)
    val rowTexts = fieldText(rows)
    expectEqual(rowTexts.size, 2, "multiline: as many rows as it may show")
    expect(endsWith(rowTexts[1].text, "fim"), "multiline: the last ones")
    val rowHit = fieldHit(rows)
    expect(rowTexts[0].y >= rowHit.y, "multiline: the rows are inside the field")
    expect(rowHit.caretY > rowHit.y + rowHit.h / 2, "multiline: the caret is on the last row")
    expect(endsWith(fieldText(fieldFrame("", false))[0].text, "Type"), "empty field: shows its placeholder")
    return
}

fun testFeedFollows(): void {
    val theme = oneDefaultTheme()
    val tree = { count: int ->
        val items: array<Node> = []
        var index = 0
        while (index < count) {
            items.append(block(100))
            index = index + 1
        }
        column(style().fill(), [feed(style().grow(1), items, "bottom", 0, 0)])
    }
    val offsets: Map<string, int> = Map()
    expectEqual(oneLayout(tree(20), theme, "desktop", 200, 300, offsets).children[0].scrollY, 100, "feed: opens at its end")
    expectEqual(oneLayout(tree(30), theme, "desktop", 200, 300, offsets).children[0].scrollY, 300, "feed: follows new items")
    val frame = onePaintFrame(oneLayout(tree(30), theme, "desktop", 200, 300, offsets), 200, 300)
    var hit = -1
    var index = 0
    while (index < frame.hits.size) {
        if (frame.hits[index].kind == "scroll") hit = index
        index = index + 1
    }
    oneScrollTo(offsets, frame.hits[hit], 40)
    expectEqual(oneLayout(tree(40), theme, "desktop", 200, 300, offsets).children[0].scrollY, 40, "feed: scrolled up, it stays")
    oneScrollTo(offsets, frame.hits[hit], 300)
    expectEqual(oneLayout(tree(50), theme, "desktop", 200, 300, offsets).children[0].scrollY, 700, "feed: back at the end, it follows again")
    return
}

fun main: int {
    testFeedFollows()
    testCaret()
    testFieldShowsItsEnd()
    testWrap()
    testScrollRow()
    // A popover: only the anchor takes room, the panel is painted last and on the side asked for, and
    // while it's open a press anywhere else is its dismissal.
    var pop = oneUi("t", oneDefaultTheme())
    val below = press(pop, "Abaixo")
    val trigger = press(pop, "Abrir")
    val choice = press(pop, "Escolher")
    val close = pop.press { }
    val popped = column(style().fill(), [
        row(style().height(40), [spacer(200), popover(pop, trigger, true, "end", close, [choice])]),
        below
    ])
    val closed = column(style().fill(), [row(style().height(40), [spacer(200), popover(pop, trigger, false, "end", close, [choice])]), below])
    val popFrame = onePaintFrame(oneLayout(popped, oneDefaultTheme(), "desktop", 400, 300, Map()), 400, 300)
    val closedFrame = onePaintFrame(oneLayout(closed, oneDefaultTheme(), "desktop", 400, 300, Map()), 400, 300)
    expectEqual(closedFrame.hits.size, 2, "closed: the anchor and what's below")
    val lastPaint = popFrame.paints[popFrame.paints.size - 1]
    expectEqual(lastPaint.text, "Escolher", "the panel is painted last, over what's below")
    expectEqual(popFrame.hits.size, 2, "open: what's under it takes no input")
    expectEqual(popFrame.hits[0].w, 400, "a press outside covers the window")
    expectEqual(popFrame.hits[0].event, close, "and dismisses")
    expect(popFrame.hits[1].x + popFrame.hits[1].w <= 392, "the panel stays inside the window (${popFrame.hits[1].x}+${popFrame.hits[1].w})")
    expect(popFrame.hits[1].y >= 40, "below the anchor")
    val lowFrame = onePaintFrame(oneLayout(column(style().fill().justify("end"), [popover(pop, trigger, true, "start", close, [choice])]), oneDefaultTheme(), "desktop", 400, 300, Map()), 400, 300)
    expect(lowFrame.hits[1].y + lowFrame.hits[1].h <= 292 && lowFrame.hits[1].y < 250, "above it when only that fits (${lowFrame.hits[1].y})")

    // Text metrics: Inter "n" is 0.584 em? Use relations rather than constants.
    val w15 = oneTextWidth("Olá", 15, "regular")
    expect(w15 > 15 && w15 < 40, "text width is plausible ($w15)")
    expect(oneTextWidth("Olá", 30, "regular") >= 2 * w15 - 1, "width scales with size")
    expect(oneTextWidth("Olá", 15, "bold") > w15, "bold is wider")
    expectEqual(oneTextWidth("", 15, "regular"), 0, "empty text")
    val wrapped = oneWrap("Bom dia equipa a primeira versão está pronta", 15, "regular", 120, 0)
    expect(wrapped.size >= 3, "wrapping makes several lines")
    for (line in wrapped) expect(oneTextWidth(line, 15, "regular") <= 120, "each line fits ($line)")
    val clipped = oneWrap("Bom dia equipa a primeira versão está pronta", 15, "regular", 120, 1)
    expectEqual(clipped.size, 1, "maxLines 1")
    expect(clipped[0].size > 3 && clipped[0].slice(clipped[0].size - 3, clipped[0].size) == "…", "ellipsis")
    expect(oneTextWidth(clipped[0], 15, "regular") <= 120, "ellipsized line fits")
    expectEqual(oneWrap("a\nb", 15, "regular", 300, 0).size, 2, "explicit newlines")
    expect(oneWrap("supercalifragilisticexpialidocious", 15, "regular", 60, 0).size >= 3, "long words split")

    val t = oneDefaultTheme()
    val tree = column(style().padding(16).gap(8), [
        text("Título", style().text("title")),
        row(style().gap(12), [icon("bell", "", style().size(24)), text("cresce", style().grow(1)), text("fim", style())]),
        column(style().height(100).justify("between"), [text("a", style()), text("b", style())]),
        spacer(10),
        row(style().height(40).justify("center"), [text("meio", style())])
    ])
    val root = oneLayout(tree, t, "web-canvas", 390, 844, Map())
    expectEqual(root.w, 390, "root fills the viewport width")
    expectEqual(root.h, 844, "root fills the viewport height")
    val title = root.children[0]
    expectEqual(title.x, 16, "padding left")
    expectEqual(title.y, 16, "padding top")
    expectEqual(title.w, 358, "stretched to the inner width")
    expectEqual(title.h, 22, "title preset line height")
    val bar = root.children[1]
    expectEqual(bar.y, 16 + 22 + 8, "gap after the first child")
    expectEqual(bar.children[0].w, 24, "icon size")
    val grower = bar.children[1]
    val end = bar.children[2]
    expectEqual(grower.x, 24 + 12, "after the icon and gap")
    expectEqual(end.x + end.w, 358, "the last child ends at the row's edge (grow took the rest)")
    expectEqual(bar.children[0].y, (bar.h - 24) / 2, "row centers vertically")
    val between = root.children[2]
    expectEqual(between.h, 100, "fixed height")
    expectEqual(between.children[1].y + between.children[1].h, 100, "justify between pushes the last child to the end")
    expectEqual(root.children[3].h, 10, "spacer")
    val centered = root.children[4].children[0]
    expectEqual(centered.x, (358 - centered.w) / 2, "justify center")

    // A feed opens at the bottom and reports what is fully visible.
    var ui = oneUi("web-canvas", t)
    val items: array<Node> = []
    var i = 1
    while (i <= 30) {
        items.append(text("Mensagem $i", style().height(40)).keyed("m$i").setInt("item", i))
        i = i + 1
    }
    val chat = column(style(), [feed(style().grow(1), items, "bottom", 0, ui.change { v -> }), pressable(ui.press { }, style().height(50), [text("Enviar", style())])])
    val laidOut = oneLayout(chat, t, "web-canvas", 390, 400, Map())
    val f = laidOut.children[0]
    expectEqual(f.h, 350, "feed takes the space above the bar")
    expectEqual(f.contentH, 1200, "feed content height")
    expectEqual(f.scrollY, 850, "feed anchored at the bottom")
    val frame = onePaintFrame(laidOut, 390, 400)
    var texts = 0
    for (p in frame.paints) if (p.op == "text") texts = texts + 1
    expect(texts < 15, "rows scrolled out of view are not painted ($texts)")
    expectEqual(frame.visible.size, 1, "visible item report")
    expectEqual(frame.visible[0].item, 30, "the last row is visible")
    var presses = 0
    var scrolls = 0
    for (h in frame.hits) {
        if (h.kind == "press") presses = presses + 1
        if (h.kind == "scroll") scrolls = scrolls + 1
    }
    expectEqual(presses, 1, "press hit region")
    expectEqual(scrolls, 1, "scroll hit region")
    val scrolled: Map<string, int> = Map()
    scrolled.set("r/0", 0)
    expectEqual(oneLayout(chat, t, "web-canvas", 390, 400, scrolled).children[0].scrollY, 0, "saved scroll offsets apply")
    expect(oneFrameJson(frame).size > 100, "frame encodes to JSON")
    testsPassed()
}
