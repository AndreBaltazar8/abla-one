// Compile/export fixture and real Simulator application. Only synthetic input,
// timer and route actions: no network, account credentials or device access.
import "abla/build"
import "../src/one.ab"
import "../src/one_kit.ab"
import "../src/backends/ios.ab"

class IosContractFixture(
    val services: OneServices,
    var value: string = "", var status: string = "ready",
    var ignore: bool = false, var timerDone: bool = false
) : OneApp {
    fun render(var ui: Ui): Node {
        column(style().padding(16).gap(8), [
            input(value, "Fixture password", ui.change { next ->
                if (!ignore) value = next
                status = "editing"
            }, style()).set("secure", "true").keyed("secure"),
            pressable(ui.press {
                status = if (value == "s3crEt") "accepted_exact" else "refused"
                value = ""
            }, style(), [text("Accept", style())]).keyed("accept"),
            pressable(ui.press { status = "disabled_button_sent" }, style(), [text("Blocked", style())]).set("enabled", "false").keyed("blocked"),
            pressable(ui.press { ignore = true; value = ""; status = "ignore_mode" }, style(), [text("Ignore echoes", style())]).keyed("ignore"),
            pressable(ui.press { services.navigate("/next") }, style(), [text("New route", style())]).keyed("route"),
            text(status, style()).keyed("status"),
            text(if (timerDone) "timer_ready" else "timer_waiting", style()).keyed("timer")
        ]).keyed("root")
    }
    fun receive(kind: string, payload: string): void {
        if (kind == "result") timerDone = true
        if (kind == "route" && payload == "/next") {
            value = ""; ignore = false; status = "new_route"
        }
        return
    }
}
fun iosContractApplication(): int {
    val services = OneIosServices()
    var app = IosContractFixture(services)
    services.timer(100)
    oneIosRun(app, oneDefaultTheme(), "#FFFFFF")
}
val iosContractExported = #exportFunction("iosContractApplication", "abla_mobile_run")
