import "abla/http"
import "abla/io"
import "abla/text"
import "../server/shop.ab" as shop
import "../../../src/core/services.ab"
import "../../../src/server/remote.ab"
import "../../../src/server/http.ab"
import "../../../src/server/caller.ab"
import "../../../src/backends/web_session.ab"
import "../../../src/backends/web_live.ab"
import "both_client.ab"

// A server that runs its client code too: the call goes through the route, in
// process as the live server sends it, and the types are the server's own. The
// route sees the browser's caller: its session cookie, through oneLiveBrowserRequest.
fun main: int {
    oneServerAuthenticate { request -> if (oneCallerCookie(request, "sid") == "test-session") OnePrincipal("tester") else null }
    val router = httpRouter()
    router.post("/one/:route", oneServerHandler)
    var services = oneRecordedServices()
    val remote = bothOrders(services, ".")
    val browser = OneLivePrivateRequests { request, context -> router.dispatch(oneLiveBrowserRequest(request, context)) }
    val anonymous = oneLiveExecute({ request -> router.dispatch(request) }, OneLiveRequest(remote.id, services.requests[0]))
    if (!anonymous.contains("\"status\":401")) println("an in-process call without the browser's cookie was not refused")
    val payload = oneLiveExecute({ request -> router.dispatch(request) }, OneLiveRequest(remote.id, services.requests[0]), browser, OneLiveBrowserContext("theme=dark; sid=test-session"))
    println(bothSku(remote, payload))
    println(shop.orders("open", 3).items[0].lines[0].sku)
    println(shop.secret())
    0
}
