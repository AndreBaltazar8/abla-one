import "abla/io"
import contract "../server/shop.ab" as shop
import "../../../src/core/services.ab"
import "../../../src/server/remote.ab"

// `$remoteCall` and `$remoteDecode`: the id, and the reply read apart from the call.
fun main: int {
    var services: OneServices = oneRecordedServices()
    println("${$remoteCall(services, "https://example.test", shop.orders("open", 3))}")
    val refused = oneRemoteReply(oneResponse("{\"requestId\":1,\"status\":410,\"body\":\"\\\"use orders\\\"\"}"))
    println("${refused.kind} ${refused.message}")
    val reply = oneRemoteReply(oneResponse("{\"requestId\":1,\"status\":200,\"body\":\"{\\\"items\\\":[{\\\"id\\\":7,\\\"lines\\\":[{\\\"sku\\\":\\\"a\\\",\\\"count\\\":2}]}]}\"}"))
    val orders = $remoteDecode(reply.json, shop.orders())
    println("${reply.kind} ${orders.items[0].id} ${orders.items[0].lines[0].sku} ${orders.items[0].lines[0].count}")
    0
}
