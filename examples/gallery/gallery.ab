import "../../src/one_kit.ab"

// The gallery: every kit component with live state. Shared by all targets;
// see android.ab and web.ab for the entry files. Its screens have paths: "/" and
// "/people" (with ?q= for the search), and "/form/<n>". Handlers only say where to
// go; `show` is the one place that turns a route into a screen.

class Person(val name: string, val role: string, val seed: string)

class Gallery(
    val services: OneServices,
    var tab: int by State(0),
    var count: int by State(0),
    var filter: int by State(0),
    var query: string by State(""),
    var opened: string by State(""),
    var form: int by State(0),
    var formName: string by State(""),
    var formAmount: string by State(""),
    var formNotes: string by State(""),
    var linkPresses: int by State(0),
    var moment: string by State(""),
    var issued: int by State(0),
    var voided: int by State(0),
    var tallied: int by State(0),
    var draft: string by State(""),
    var sent: string by State(""),
    var carried: string by State(""),
    var plain: string by State(""),
    var page: string = "/"
) : OneApp {
    fun people(): array<Person> = [
        Person("Sofia Costa", "Proprietária", "u1"), Person("André Silva", "Membro", "u2"),
        Person("Inês Rocha", "Membro", "u3"), Person("Maya Townsend", "Administradora", "u4"),
        Person("Tiago Mendes", "Membro", "u5")
    ]

    fun render(var ui: Ui): Node = screen(ui).set("page.title", if (form > 0) "Formulário $form · Abla One" else if (tab == 1) "Pessoas · Abla One" else "Abla One")

    fun search(): string = if (query != "") "?q=${oneRouteEncode(query)}" else ""

    fun show(route: string): void {
        page = oneRoutePagePath(route)
        val parts = oneRouteSegments(route)
        if (oneRouteHasParam(route, "q")) query = oneRouteParam(route, "q")
        form = if (parts.size == 2 && parts[0] == "form") oneParseInt(parts[1], 0) else 0
        tab = if (parts.size == 1 && parts[0] == "people") 1 else 0
        moment = if (parts.size == 1 && parts[0] == "moment") "ask" else ""
        return
    }

    fun screen(var ui: Ui): Node = if (page.startsWith("/field/")) fieldScreen(ui) else if (page.startsWith("/same/")) sameScreen(ui) else if (moment != "") momentScreen(ui) else if (form > 0) formScreen(ui).keyed("form-$form") else column(style().fill().background("@surface"), [
        topBar(ui, [], text("Abla One", style().text("title")), [iconButton(ui, "icon_bell", "Avisos", ui.press { count = 0 }, style())]),
        scroll(style().grow(1), [
            if (tab == 0) components(ui) else peopleList(ui)
        ]),
        tabBar(ui, [TabItem("nav_home", "Componentes", ui.press { services.navigate("/${search()}") }), TabItem("nav_team", "Pessoas", ui.press { services.navigate("/people${search()}") })], tab)
    ])

    fun components(var ui: Ui): Node = column(style().gap(4), [
        sectionHeader(ui, "BOTÕES", none()),
        column(style().paddingX(16).gap(8), [
            button(ui, "Adicionar ($count)", "primary", ui.press { count += 1 }, style()),
            row(style().gap(8), [
                button(ui, "Secundário", "secondary", ui.press { count -= 1 }, style().grow(1)),
                button(ui, "Simples", "plain", ui.press { }, style().grow(1))
            ]),
            button(ui, "Eliminar", "danger", ui.press { count = 0 }, style())
        ]),
        sectionHeader(ui, "PESQUISA E FILTROS", badge(ui, "$count", "muted")),
        column(style().paddingX(16).gap(12), [
            searchField(ui, query, "Pesquisar pessoas", ui.change { value ->
                query = value
                services.navigate("$page${search()}", true)
            }),
            row(style().gap(8), [
                chip(ui, "Todas", filter == 0, ui.press { filter = 0 }),
                chip(ui, "Não lidas", filter == 1, ui.press { filter = 1 }),
                chip(ui, "Diretas", filter == 2, ui.press { filter = 2 })
            ])
        ]),
        sectionHeader(ui, "CARTÃO", none()),
        column(style().paddingX(16), [
            card(ui, [
                text("Faturação certificada", style().text("title")),
                text("Os componentes vêm do tema e cada propriedade pode ser alterada por plataforma.", style().text("body-sm").color("@muted")),
                text(if (opened != "") "Última pessoa aberta: $opened" else "Ainda não abriu ninguém.", style().text("caption").color("@subtle"))
            ], style())
        ]),
        column(style().paddingX(16).paddingTop(12).gap(8), [
            button(ui, "Abrir formulário", "secondary", ui.press { services.navigate("/form/1") }, style()),
            routeLink("/people", ui.press { services.navigate("/people${search()}") }, style().paddingY(6), [text("Ver pessoas", style().text("label"))])
        ]),
        spacer(24)
    ])

    // A screen that changes within its path, unkeyed, with another handler at the same place and
    // controls that come alive with a draft (tests/ui/web_live_events.mjs).
    fun momentScreen(var ui: Ui): Node = column(style().fill().padding(16).gap(12).background("@surface"), [
        if (moment == "ask") button(ui, "Emitir", "primary", ui.press { issued += 1; moment = "done" }, style())
        else button(ui, "Anular", "danger", ui.press { voided += 1; moment = "ask" }, style()),
        text("Emitidas: $issued, anuladas: $voided", style()),
        button(ui, "Contar", "secondary", ui.press { tallied += 1 }, style()),
        text("Contadas: $tallied", style()),
        textField(ui, draft, "Rascunho", ui.change { value -> draft = value }, style()),
        button(ui, "Enviar", "primary", if (draft != "") ui.press { sent = draft; draft = "" } else 0, style()),
        button(ui, "Guardar", "secondary", ui.press { sent = "guardado:$draft" }, style()).set("enabled", if (draft != "") "true" else "false"),
        button(ui, "Só com três", "secondary", ui.press { sent = "três:$draft" }, style()).set("enabled", if (draft.size >= 3) "true" else "false"),
        text("Enviado: $sent", style()),
        link("./people?q=", style().paddingY(6), [text("Outra página", style().text("label"))])
    ])

    // A field that is the same field on both routes beside one that only looks it, and a move to the
    // other route that takes as long as a request would (tests/ui/web_live_events.mjs).
    fun fieldScreen(var ui: Ui): Node {
        val other = if (page == "/field/1") "/field/2" else "/field/1"
        column(style().fill().padding(16).gap(12).background("@surface"), [
            text("Campos em $page", style()),
            textField(ui, carried, "Mantido", ui.change { value -> carried = value }, style()).sameField("kept"),
            textField(ui, plain, "Outro", ui.change { value -> plain = value }, style()),
            button(ui, "Mudar", "secondary", ui.press { services.navigate(other) }, style()),
            text("Mantido: $carried, outro: $plain", style())
        ])
    }

    // Two routes with one screen: only the URL differs.
    fun sameScreen(var ui: Ui): Node = column(style().fill().padding(16).gap(12).background("@surface"), [
        text("O mesmo ecrã", style()),
        textField(ui, plain, "Outro", ui.change { value -> plain = value }, style()),
        button(ui, "Contar", "secondary", ui.press { tallied += 1 }, style()),
        button(ui, "Mudar", "plain", ui.press { services.navigate(if (page == "/same/1") "/same/2" else "/same/1") }, style())
    ])

    // A long form, keyed by its number as an app keys its screens. Each one
    // opens at the top; state changes inside one keep its scroll position.
    fun formScreen(var ui: Ui): Node {
        // As much work as a real screen's render, so fast typing queues up.
        var work = 0
        while (work < 40000000) work = work + 1
        val following = form + 1
        column(style().fill().background("@surface"), [
            topBar(ui, [button(ui, "Voltar", "plain", ui.press { services.back("/") }, style())], text("Formulário $form", style().text("title")), []),
            scroll(style().grow(1), [
                column(style().padding(16).gap(12), [
                    textField(ui, formName, "Nome", ui.change { value -> formName = value }, style()),
                    text("Nome: $formName", style().text("caption")),
                    textField(ui, formAmount, "Valor", ui.change { value -> formAmount = value }, style()).set("keyboard", "decimal"),
                    text("Valor: $formAmount", style().text("caption")),
                    linkPress("https://example.com/abla-one", ui.press { linkPresses += 1 }, style().paddingY(6), [text("Abrir ligação ($linkPresses)", style().text("label"))]),
                    spacer(2400),
                    textField(ui, formNotes, "Notas", ui.change { value -> formNotes = value }, style()),
                    text("Notas: $formNotes", style().text("caption")),
                    button(ui, "Formulário seguinte", "secondary", ui.press { services.navigate("/form/$following") }, style())
                ])
            ])
        ])
    }

    fun peopleList(var ui: Ui): Node {
        val rows: array<Node> = []
        for (person in people()) {
            if (query == "" || oneContainsText(person.name, query)) {
                val name = person.name
                rows.append(listRow(ui, ListRowParts(avatar(ui, person.name, person.seed, 44, none()), person.name, person.role, "", icon("icon_right", "", style().size(18).tint("@subtle"))), ui.press { opened = name }, style()))
            }
        }
        if (rows.size == 0) rows.append(emptyState(ui, "Ninguém encontrado", "Experimente outro nome."))
        column(style(), rows)
    }

    fun receive(kind: string, value: string): void {
        if (kind == "route") show(value)
        return
    }
}

fun oneContainsText(text: string, query: string): bool {
    var i = 0
    while (i + query.size <= text.size) {
        var j = 0
        var same = true
        while (same && j < query.size) {
            var a = text[i + j]
            var b = query[j]
            if (a >= 65 && a <= 90) a = a + 32
            if (b >= 65 && b <= 90) b = b + 32
            same = a == b
            j = j + 1
        }
        if (same) return true
        i = i + 1
    }
    false
}
