import "../gallery.ab"
import "../../../src/backends/papermono.ab"
import "../../../build/papermono/icons.ab"
import "../../../src/core/ui.ab"
import "../../../src/core/services.ab"
import "../../../src/kit/theme.ab"
import "../../../src/raster/raster.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")

// The gallery on an M5Stack PaperMono, running on the device:
//   make papermono-gallery flash-papermono   (PORT=/dev/ttyACM0)

@export("app_main")
fun appMain(): void {
    var app: OneApp = Gallery(OneNoServices())
    onePaperMonoRun(app, oneDefaultTheme(), OneIconSource({ name -> oneEmbeddedIcon(name) }))
}
