CONFIG_IDF_TARGET="esp32s3"
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# E-paper refreshes busy-wait on the BUSY pin, and the first render is long.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
# The app runs in the main task; layout recursion is deep.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=65536
# The PaperMono's 8 MB of octal PSRAM holds the Abla heap.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# All code and the heap sit behind the caches: their size and the flash bus
# decide how fast an app runs.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_LINE_32B=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
