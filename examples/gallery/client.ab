import "gallery.ab"
import "../../src/backends/web_client.ab"
import "../../src/backends/web_session.ab"
import "../../src/core/ui.ab"
import "../../src/kit/theme.ab"

// The gallery's Wasm entry: the same app, run in the browser. Built by
// client_build.ab; the page (client_page.ab) is server-rendered and then
// hydrated by web/host.js with this module instead of a WebSocket.

@export("one_alloc")
trusted fun alloc(length: u32): u32 = u32(oneClientAlloc(int(length)))

@export("one_message")
trusted fun message(pointer: u32, length: u32): int =
    oneClientRespond(int(pointer), int(length), { session -> galleryClientApp() }, oneDefaultTheme(), "icons")

fun galleryClientApp(): OneApp = Gallery(oneLiveServices("client"))
