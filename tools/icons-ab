#!/bin/sh
set -e
root=$(cd "$(dirname "$0")/.." && pwd)
program=$root/build/icons-ab
if [ ! -x "$program" ] || [ "$root/tools/icons_ab.ab" -nt "$program" ]; then
  mkdir -p "$root/build"
  (cd "$root" && nix-shell ../ablac/shell.nix --run "../ablac/build/ablac build tools/icons_ab.ab -o '$program.next' --fast" >&2 && mv "$program.next" "$program")
fi
exec "$program" "$@"
