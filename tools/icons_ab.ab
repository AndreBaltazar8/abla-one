import "abla/fs"
import "abla/io"
import "abla/process"
import "abla/text"

fun literal(text: string): string {
    var out = "\""
    var i = 0
    while (i < text.size) {
        val byte = text[i]
        if (byte == 92) out = "$out\\\\"
        else if (byte == 34) out = "$out\\\""
        else if (byte == 36) out = "$out\\$"
        else if (byte == 10) out = "$out\\n"
        else out = "$out${text.slice(i, i + 1)}"
        i = i + 1
    }
    "$out\""
}

fun main: int {
    if (processArgumentCount() != 2) { eprintln("Usage: icons-ab OUTPUT.ab ICONS_DIR"); return 1 }
    val output = Path(processArgument(0))
    val folder = Path(processArgument(1))
    val files: array<string> = []
    for (entry in folder.entries()) if (entry.name().endsWith(".svg")) files.append(entry.name())
    var result = "// Generated by tools/icons-ab.py.\nfun oneEmbeddedIcon(name: string): string {\n"
    for (file in sortedStrings(files)) {
        val name = file.slice(0, file.size - 4)
        result = "$result    if (name == ${literal(name)}) return ${literal(folder.child(file).readText())}\n"
    }
    result = "$result    \"\"\n}\n"
    if (!output.writeText(result)) { eprintln("Could not write ${output.text}"); return 1 }
    0
}
