import "abla/fs"
import "abla/io"
import "abla/process"
import "abla/text"

// Writes build/papermono/thin_config.ab (it holds Wi-Fi credentials, and stays out of git): the Wi-Fi from ONE_WIFI_SSID and
// ONE_WIFI_PASSWORD, or else the primary network of ../mono-life/src/generated/m5echo_config.ab, and the server from
// tools/papermono-thin-config HOST_IPV4[:PORT] (plain HTTP, 8954 by default) or https://NAME[:PORT] (TLS, 443 by default).
// With --wifi, only the network, to build/papermono/wifi_config.ab under the current folder. ONE_THIN_ROOT is this repository.

fun thinFail(message: string): int {
    eprintln("papermono-thin-config: $message")
    exit(1)
    1
}

fun thinHexDigit(value: int): string = "0123456789abcdef".slice(value, value + 1)

// As a string literal with a terminating zero, whatever the bytes.
fun thinLiteral(bytes: string): string {
    var out = ""
    for (byte in bytes) out = "$out\\x${thinHexDigit(byte / 16)}${thinHexDigit(byte % 16)}"
    "$out\\x00"
}

fun thinDigits(text: string): bool {
    if (text == "") return false
    for (byte in text) if (byte < 48 || byte > 57) return false
    true
}

fun thinNumber(text: string): int {
    var value = 0
    for (byte in text) value = value * 10 + (byte - 48)
    value
}

fun thinFind(text: string, wanted: string): int {
    var at = 0
    while (at + wanted.size <= text.size) {
        if (text.slice(at, at + wanted.size) == wanted) return at
        at = at + 1
    }
    -1
}

// What stands between `before` and `after` in the file, for a value it has.
fun thinBetween(text: string, before: string, after: string): string {
    val found = thinFind(text, before)
    if (found < 0) thinFail("no $before in mono-life's configuration")
    val begin = found + before.size
    val end = thinFind(text.slice(begin, text.size), after)
    if (end < 0) thinFail("no end to $before in mono-life's configuration")
    text.slice(begin, begin + end)
}

class ThinWifi(val ssid: string, val ssidLength: int, val password: string, val passwordLength: int)

fun thinWifi(root: string): ThinWifi {
    val ssid = processEnvironmentOr("ONE_WIFI_SSID", "")
    val password = processEnvironmentOr("ONE_WIFI_PASSWORD", "")
    if (ssid != "") return ThinWifi(thinLiteral(ssid), ssid.size, thinLiteral(password), password.size)
    val source = Path("$root/../mono-life/src/generated/m5echo_config.ab").readText()
    ThinWifi(
        thinBetween(source, "wifiPrimarySsid = nativeStaticBytes(\"", "\")"), thinNumber(thinBetween(source, "wifiPrimarySsidLength = ", "\n")),
        thinBetween(source, "wifiPrimaryPassword = nativeStaticBytes(\"", "\")"), thinNumber(thinBetween(source, "wifiPrimaryPasswordLength = ", "\n"))
    )
}

// Only its owner can read it, from before there's anything in it.
fun thinWrite(path: Path, text: string): void {
    if (!path.parent().createDirectories()) thinFail("can't create ${path.parent().text}")
    if (!path.exists() && !path.createExclusive("", 384)) thinFail("can't create ${path.text}")
    if (!path.writeText(text)) thinFail("can't write ${path.text}")
    return
}

fun main: int {
    val root = processEnvironmentOr("ONE_THIN_ROOT", ".")
    val target = processArgument(0)
    if (target == "--wifi") {
        val wifi = thinWifi(root)
        thinWrite(Path("build/papermono/wifi_config.ab"), "// Generated by tools/papermono-thin-config --wifi. Holds credentials: do not commit.\nfun oneWifiConfigured(): OneWifiConfig = OneWifiConfig(\n    nativeStaticBytes(\"${wifi.ssid}\"), ${wifi.ssidLength}, nativeStaticBytes(\"${wifi.password}\"), ${wifi.passwordLength})\n")
        return 0
    }
    val tls = target.startsWith("https://")
    var address = if (tls) target.slice(8, target.size) else target
    while (tls && address.endsWith("/")) address = address.slice(0, address.size - 1)
    val colon = thinFind(address, ":")
    val host = if (colon >= 0) address.slice(0, colon) else address
    val portText = if (colon >= 0) address.slice(colon + 1, address.size) else ""
    val octets = ["0", "0", "0", "0"]
    val usage = "expected HOST_IPV4[:PORT] or https://NAME[:PORT]"
    if (!tls) {
        var rest = host
        var index = 0
        while (index < 4) {
            val dot = thinFind(rest, ".")
            val part = if (dot >= 0) rest.slice(0, dot) else rest
            if (!thinDigits(part) || part.size > 3 || thinNumber(part) > 255 || (index == 3) != (dot < 0)) return thinFail(usage)
            octets[index] = part
            rest = if (dot >= 0) rest.slice(dot + 1, rest.size) else ""
            index = index + 1
        }
    } else if (host == "") return thinFail(usage)
    if (portText != "" && !thinDigits(portText)) return thinFail(usage)
    val port = if (portText != "") thinNumber(portText) else if (tls) 443 else 8954
    val wifi = thinWifi(root)
    thinWrite(Path("$root/build/papermono/thin_config.ab"), "// Generated by tools/papermono-thin-config. Holds credentials: do not commit.\nimport \"../../src/backends/papermono_thin.ab\"\nfun oneThinConfigured(): OneThinConfig = OneThinConfig(\n    nativeStaticBytes(\"${wifi.ssid}\"), ${wifi.ssidLength}, nativeStaticBytes(\"${wifi.password}\"), ${wifi.passwordLength},\n    ${octets[0]}, ${octets[1]}, ${octets[2]}, ${octets[3]}, $port, ${if (tls) "true" else "false"},\n    nativeStaticBytes(\"${thinLiteral(host)}\"), ${host.size}, \"$host\")\n")
    0
}
