#!/usr/bin/env python3
"""Writes build/papermono/thin_config.ab (it holds Wi-Fi credentials, and stays out of
git): the Wi-Fi from ONE_WIFI_SSID and ONE_WIFI_PASSWORD, or else the primary network of
../mono-life/src/generated/m5echo_config.ab, and the server from
tools/papermono-thin-config HOST_IPV4[:PORT] (plain HTTP, 8954 by default) or
https://NAME[:PORT] (TLS, 443 by default)."""
import os, pathlib, re, sys

root = pathlib.Path(__file__).resolve().parent.parent
target = sys.argv[1] if len(sys.argv) > 1 else ""
tls = target.startswith("https://")
host, _, port = (target[8:].rstrip("/") if tls else target).partition(":")
octets = ["0"] * 4
if not tls:
    octets = host.split(".")
    if len(octets) != 4 or not all(o.isdigit() and int(o) < 256 for o in octets):
        sys.exit("papermono-thin-config: expected HOST_IPV4[:PORT] or https://NAME[:PORT]")
port = int(port or (443 if tls else 8954))

def literal(text):
    return "".join(f"\\x{b:02x}" for b in text) + "\\x00"

ssid, password = os.environ.get("ONE_WIFI_SSID", "").encode(), os.environ.get("ONE_WIFI_PASSWORD", "").encode()
ssidText, passwordText = literal(ssid), literal(password)
if not ssid:
    source = (root.parent / "mono-life/src/generated/m5echo_config.ab").read_text()
    ssidText = re.search(r'wifiPrimarySsid = nativeStaticBytes\("(.*)"\)', source).group(1)
    passwordText = re.search(r'wifiPrimaryPassword = nativeStaticBytes\("(.*)"\)', source).group(1)
    ssid = b"x" * int(re.search(r"wifiPrimarySsidLength = (\d+)", source).group(1))
    password = b"x" * int(re.search(r"wifiPrimaryPasswordLength = (\d+)", source).group(1))
out = root / "build/papermono/thin_config.ab"
out.parent.mkdir(parents=True, exist_ok=True)
out.touch(mode=0o600)
out.write_text(f"""// Generated by tools/papermono-thin-config. Holds credentials: do not commit.
import "../../src/backends/papermono_thin.ab"
fun oneThinConfigured(): OneThinConfig = OneThinConfig(
    nativeStaticBytes("{ssidText}"), {len(ssid)}, nativeStaticBytes("{passwordText}"), {len(password)},
    {octets[0]}, {octets[1]}, {octets[2]}, {octets[3]}, {port}, {'true' if tls else 'false'},
    nativeStaticBytes("{literal(host.encode())}"), {len(host)}, "{host}")
""")
