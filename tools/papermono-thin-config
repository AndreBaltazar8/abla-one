#!/bin/sh
# tools/papermono_thin_config.ab, built when it is newer than its program, which then runs where this was called from.
set -e
root=$(cd "$(dirname "$0")/.." && pwd)
program=$root/build/papermono-thin-config
if [ ! -x "$program" ] || [ "$root/tools/papermono_thin_config.ab" -nt "$program" ]; then
  mkdir -p "$root/build"
  (cd "$root" && nix-shell ../ablac/shell.nix --run "../ablac/build/ablac build tools/papermono_thin_config.ab -o '$program.next' --fast --no-cache" >&2 && mv "$program.next" "$program")
fi
ONE_THIN_ROOT=$root exec "$program" "$@"
