// abla-ui (https://github.com/AndreBaltazar8/abla-ui): State and flex layout, shared with
// abla-forge. Pinned by commit, never a branch; this name, URL and selector match abla.toml's
// [dependencies] entry and abla.lock. Only the modules that build with the compiler NovaKind
// pins are used (state, flex, text: not the tag syntax, which needs ablac 0.2.53).
compile fun oneUiSource(): ImportSource = gitImportSource(
    "abla-ui", "https://github.com/AndreBaltazar8/abla-ui.git", "rev",
    "277bc04cdc6fbc3191f17d846f21475118d258c9"
)
compile fun oneUiState(): ImportSource = importSubpath(oneUiSource(), "state")
compile fun oneUiFlex(): ImportSource = importSubpath(oneUiSource(), "flex")
compile fun oneUiText(): ImportSource = importSubpath(oneUiSource(), "text")
