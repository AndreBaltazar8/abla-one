import "abla/json"
import "layout.ab"

// The paint list (SPEC §10, M3): what web-canvas, desktop and epaper draw, in
// order, in absolute logical pixels. Hit regions route input back to events.

class OnePaint(
    val op: string,        // rect, border, text, icon, image, clip, unclip
    val x: int,
    val y: int,
    val w: int,
    val h: int,
    val radius: int,
    val color: string,
    val text: string,      // text line, icon name or image source
    val size: int,
    val weight: string,
    val sides: string      // border widths "top right bottom left"
)

class OneHit(
    val kind: string,      // press, input, scroll, link (value: href)
    val x: int,
    val y: int,
    val w: int,
    val h: int,
    val event: int,
    val submit: int,
    val key: string,       // layout path (scroll areas) or node key
    val value: string,
    val placeholder: string,
    val multiline: bool,   // or, for a scroll area, that it follows its end
    val caretX: int = 0,   // input: where the caret goes, after the text, with `oneUseCaret`
    val caretY: int = 0    // input: the middle of the caret's line
)

// A feed row fully inside its viewport: deliver `event` with `item` to mark it read.
class OneVisible(val event: int, val item: int)

class OneFrame(val paints: array<OnePaint>, val hits: array<OneHit>, val visible: array<OneVisible>, val width: int, val height: int, var popovers: int = 0)

fun onePaintFrame(root: OneBox, width: int, height: int): OneFrame {
    var frame = OneFrame([], [], [], width, height)
    onePaintBox(root, 0, 0, frame, "r", 0, 0, width, height)
    onePaintPopovers(root, frame)
    frame
}

// Open popovers go over everything, once the rest of the frame is done. While one is open nothing
// under it takes input: a press outside dismisses it.
fun onePaintPopovers(root: OneBox, var frame: OneFrame): void {
    if (frame.popovers == 0) return
    frame.hits.clear()
    onePopoversIn(root, 0, 0, frame, "r")
    return
}

fun onePopoversIn(box: OneBox, ox: int, oy: int, var frame: OneFrame, path: string): void {
    val x = ox + box.x
    val y = oy + box.y
    var index = 0
    for (child in box.children) {
        val childPath = if (child.node.key != "") "$path/k:${child.node.key}" else "$path/$index"
        if (box.node.kind == "popover" && index == 1) {
            oneAddHit(frame, "press", 0, 0, frame.width, frame.height, oneParseInt(box.node.attr("onDismiss"), 0), 0, "dismiss", "", "", false)
            // Below the anchor, or above it when only that fits, and inside the window.
            val gap = 4
            var px = if (box.node.attr("side") == "end") x + box.w - child.w else x
            if (px + child.w > frame.width - 8) px = frame.width - 8 - child.w
            if (px < 8) px = 8
            var py = y + box.h + gap
            if (py + child.h > frame.height - 8 && y - gap - child.h >= 8) py = y - gap - child.h
            onePaintBox(child, px, py, frame, childPath, 0, 0, frame.width, frame.height)
            onePopoversIn(child, px, py, frame, childPath)
        } else onePopoversIn(child, x, y - box.scrollY, frame, childPath)
        index = index + 1
    }
    return
}

val oneCaretWidth = 2

// The end of `value`, from the first character that doesn't fit `room` on: it's only
// partly seen, so what's left of the field is never empty. All of it when it fits.
@noinline
fun oneInputTail(value: string, size: int, weight: string, room: int): string {
    var start = value.size
    while (start > 0) {
        start = start - 1
        while (start > 0 && value[start] >= 128 && value[start] < 192) start = start - 1
        val tail = value.slice(start, value.size)
        if (oneTextWidth(tail, size, weight) > room) return tail
    }
    value
}

fun oneRect(op: string, x: int, y: int, w: int, h: int, radius: int, color: string): OnePaint = OnePaint(op, x, y, w, h, radius, color, "", 0, "", "")

// Out of line, as what makes a paint or a hit is large where it's inlined, on a device above all.
@noinline
fun oneAddRect(var frame: OneFrame, op: string, x: int, y: int, w: int, h: int, radius: int, color: string): void {
    frame.paints.append(oneRect(op, x, y, w, h, radius, color))
    return
}

@noinline
fun oneAddPaint(var frame: OneFrame, op: string, x: int, y: int, w: int, h: int, radius: int, color: string, text: string, size: int, weight: string, sides: string): void {
    frame.paints.append(OnePaint(op, x, y, w, h, radius, color, text, size, weight, sides))
    return
}

fun oneAddText(var frame: OneFrame, x: int, y: int, w: int, lh: int, color: string, text: string, size: int, weight: string): void = oneAddPaint(frame, "text", x, y, w, lh, 0, color, text, size, weight, "")

// Where a field's caret goes, added by what draws one (`oneUseCaret`): only a window does, and a program that never asks, an e-paper device
// above all, links none of it. The call takes a small `OneInputRows`, as with the hooks of src/layout/layout.ab.
class OneInputRows(val lines: array<string>, val first: int, val top: int, val left: int, val width: int, val pr: int)
val oneCaretPlace: array<(var: OneFrame, OneBox, OneInputRows) -> void> = []

@noinline
fun oneAddHit(var frame: OneFrame, kind: string, x: int, y: int, w: int, h: int, event: int, submit: int, key: string, value: string, placeholder: string, multiline: bool): void {
    frame.hits.append(OneHit(kind, x, y, w, h, event, submit, key, value, placeholder, multiline))
    return
}

// `cx..cy` with `cw × ch` is the current clip, for visibility tests.
// Out of line, as `onePaintBox`, which recurses, has a large frame.
@noinline
fun onePaintText(box: OneBox, x: int, y: int, pl: int, pr: int, pt: int, var frame: OneFrame): void {
    val r = box.r
    val size = r.int("size", 15)
    val lh = oneLineHeight(r)
    val align = r.get("textAlign")
    var line = 0
    for (text in box.lines) {
        val tw = box.lineWidths[line]
        val inner = box.w - pl - pr
        val tx = x + pl + (if (align == "center") (inner - tw) / 2 else if (align == "end" || align == "right") inner - tw else 0)
        oneAddText(frame, tx, y + pt + line * lh, tw, lh, if (r.get("color") != "") r.get("color") else "#111111", text, size, r.get("weight"))
        line = line + 1
    }
    return
}

// A dot for each character of a secure field's value.
fun oneMasked(value: string): string {
    var dots = ""
    for (b in value) if (b < 128 || b >= 192) dots = "$dots•"
    dots
}

@noinline
fun onePaintInput(box: OneBox, x: int, y: int, pl: int, pr: int, var frame: OneFrame, path: string): void {
    val r = box.r
    // What's typed stays in the hit, for editing; only what's drawn is masked.
    val typed = box.node.attr("value")
    val value = if (box.node.attr("secure") == "true") oneMasked(typed) else typed
    val placeholder = box.node.attr("placeholder")
    val size = r.int("size", 16)
    val lh = oneLineHeight(r)
    val weight = r.get("weight")
    val inner = box.w - pl - pr
    val multiline = box.node.attr("multiline") == "true"
    val color = if (value == "") r.get("placeholderColor") else r.get("color")
    val ink = if (color != "") color else "#888888"
    // The caret stays at the end, so the end is what shows. On a single line, text too long for
    // the field slides left under a clip, keeping room for the caret itself. Otherwise it's
    // the rows that fit: a value's last ones, as new text arrives at the end.
    val slides = value != "" && !multiline
    val most = if (multiline) r.int("maxLines", 5) else 1
    val lines = if (slides) [oneInputTail(value, size, weight, inner - oneCaretWidth)] else oneWrap(if (value == "") placeholder else value, size, weight, inner, if (value == "") most else 0)
    val first = if (lines.size > most) lines.size - most else 0
    // Centred, but a field taller than its rows starts them at the top, as far down as it
    // is in from the side.
    val centred = (box.h - lh * (lines.size - first)) / 2
    val top = y + (if (multiline && centred > pl) pl else centred)
    val width = if (slides) oneTextWidth(lines[0], size, weight) else inner
    val over = if (slides) width + oneCaretWidth - inner else 0
    val left = x + pl - (if (over > 0) over else 0)
    if (over > 0) oneAddRect(frame, "clip", x + pl, y, inner, box.h, 0, "")
    var line = first
    while (line < lines.size) {
        oneAddText(frame, left, top + (line - first) * lh, width, lh, ink, lines[line], size, weight)
        line = line + 1
    }
    if (over > 0) oneAddRect(frame, "unclip", x + pl, y, inner, box.h, 0, "")
    oneAddHit(frame, "input", x, y, box.w, box.h, oneParseInt(box.node.attr("onChange"), 0), oneParseInt(box.node.attr("onSubmit"), 0), path, typed, placeholder, multiline)
    if (oneCaretPlace.size > 0) oneCaretPlace[0](frame, box, OneInputRows(lines, first, top, left, width, pr))
    return
}

// On the field's hit, just added.
fun onePlaceCaret(var frame: OneFrame, box: OneBox, rows: OneInputRows): void {
    val hit = frame.hits[frame.hits.size - 1]
    val r = box.r
    val size = r.int("size", 16)
    val weight = r.get("weight")
    val value = hit.value
    var caretX = rows.left
    var caretY = hit.y + box.h / 2
    if (value != "" && !hit.multiline) caretX = rows.left + rows.width
    else if (value != "") {
        // The word wrapper drops the spaces at the end, so those are added back.
        var end = value.size
        while (end > 0 && value[end - 1] == 32) end = end - 1
        caretX = rows.left + oneTextWidth(rows.lines[rows.lines.size - 1], size, weight) + oneTextWidth(value.slice(end, value.size), size, weight)
        caretY = rows.top + (rows.lines.size - rows.first - 1) * oneLineHeight(r) + oneLineHeight(r) / 2
    }
    val rightmost = hit.x + box.w - rows.pr - oneCaretWidth
    frame.hits[frame.hits.size - 1] = OneHit(hit.kind, hit.x, hit.y, hit.w, hit.h, hit.event, hit.submit, hit.key, value, hit.placeholder, hit.multiline, if (caretX > rightmost) rightmost else caretX, caretY)
    return
}

fun oneUseCaret(): void {
    if (oneCaretPlace.size == 0) oneCaretPlace.append(onePlaceCaret)
    return
}

// One that fits has nothing to scroll across.
@noinline
fun onePaintScrollHit(box: OneBox, across: bool, x: int, y: int, var frame: OneFrame, path: string): void {
    val most = box.contentH - (if (across) box.w else box.h)
    if (!across || most > 0) oneAddHit(frame, if (across) "scrollAcross" else "scroll", x, y, box.w, box.h, 0, 0, path, "${box.scrollY}", "$most", oneFeedFollows(box.node))
    return
}

fun onePaintBox(box: OneBox, ox: int, oy: int, var frame: OneFrame, path: string, cx: int, cy: int, cw: int, ch: int): void {
    val r = box.r
    val x = ox + box.x
    val y = oy + box.y
    val kind = box.node.kind
    val radius = r.int("radius", 0)
    val background = r.get("background")
    if (background != "" && background != "transparent" && kind != "icon") oneAddRect(frame, "rect", x, y, box.w, box.h, radius, background)
    val all = r.int("border", 0)
    val top = r.int("borderTop", all)
    val right = r.int("borderRight", all)
    val bottom = r.int("borderBottom", all)
    val left = r.int("borderLeft", all)
    if (top + right + bottom + left > 0) oneAddPaint(frame, "border", x, y, box.w, box.h, radius, r.get("borderColor"), "", 0, "", "$top $right $bottom $left")
    val pl = onePad(r, "Left")
    val pt = onePad(r, "Top")
    val pr = onePad(r, "Right")
    if (kind == "text" || kind == "rich") {
        onePaintText(box, x, y, pl, pr, pt, frame)
    } else if (kind == "icon") {
        oneAddPaint(frame, "icon", x, y, box.w, box.h, 0, if (r.get("tint") != "") r.get("tint") else r.get("color"), box.node.attr("name"), 0, "", "")
    } else if (kind == "image") {
        oneAddPaint(frame, "image", x, y, box.w, box.h, radius, "", box.node.attr("src"), 0, r.get("fit"), "")
    } else if (kind == "bitmap") {
        oneAddPaint(frame, "bitmap", x, y, box.w, box.h, 0, "", box.node.attr("cells"), 0, box.node.attr("columns"), "")
    } else if (kind == "input") {
        onePaintInput(box, x, y, pl, pr, frame, path)
    }
    // Only the part in view takes a press: a row half scrolled away under a header
    // would otherwise take the header's taps.
    val hx = if (x > cx) x else cx
    val hy = if (y > cy) y else cy
    val hw = (if (x + box.w < cx + cw) x + box.w else cx + cw) - hx
    val hh = (if (y + box.h < cy + ch) y + box.h else cy + ch) - hy
    if ((kind == "pressable" || kind == "link") && hw > 0 && hh > 0) {
        val event = oneParseInt(box.node.attr("onPress"), 0)
        if (event > 0 && box.node.attr("enabled") != "false") oneAddHit(frame, "press", hx, hy, hw, hh, event, 0, path, box.node.attr("label"), "", false)
        // A link to outside the app (`external`) says so in the hit's placeholder, for the canvas page to open it in a new tab.
        if (kind == "link" && box.node.attr("route") != "true") oneAddHit(frame, "link", hx, hy, hw, hh, 0, 0, path, box.node.attr("href"), box.node.attr("external"), false)
    }
    val scrolls = kind == "scroll" || kind == "feed"
    // A scrollRow's children are already placed at its offset (oneMeasureScrollRow, oneLayoutRescroll), which keeps this short.
    val across = kind == "scrollRow"
    val down = if (across) 0 else box.scrollY
    var ncx = cx
    var ncy = cy
    var ncw = cw
    var nch = ch
    if (scrolls || across || r.get("clip") == "true") {
        oneAddRect(frame, "clip", x, y, box.w, box.h, radius, "")
        // Within the clip around it, if any.
        ncx = if (x > cx) x else cx
        ncy = if (y > cy) y else cy
        ncw = (if (x + box.w < cx + cw) x + box.w else cx + cw) - ncx
        nch = (if (y + box.h < cy + ch) y + box.h else cy + ch) - ncy
        if (scrolls || across) onePaintScrollHit(box, across, x, y, frame, path)
    }
    var index = 0
    var visibleItem = 0
    for (child in box.children) {
        val childPath = if (child.node.key != "") "$path/k:${child.node.key}" else "$path/$index"
        val childY = y + child.y - down
        if (kind == "popover" && index == 1) frame.popovers = frame.popovers + 1
        // Skip what a scroll area has scrolled out of view.
        else if ((!scrolls && !across) || (childY + child.h >= ncy && childY <= ncy + nch && x + child.x + child.w >= ncx && x + child.x <= ncx + ncw)) onePaintBox(child, x, y - down, frame, childPath, ncx, ncy, ncw, nch)
        if (kind == "feed" && child.node.attr("item") != "" && childY >= ncy && childY + child.h <= ncy + nch) {
            val item = oneParseInt(child.node.attr("item"), 0)
            if (item > visibleItem) visibleItem = item
        }
        index = index + 1
    }
    if (kind == "feed" && visibleItem > 0) {
        val event = oneParseInt(box.node.attr("onVisible"), 0)
        if (event > 0) frame.visible.append(OneVisible(event, visibleItem))
    }
    if (scrolls || across || r.get("clip") == "true") oneAddRect(frame, "unclip", x, y, box.w, box.h, 0, "")
    return
}

// Compact JSON for the web-canvas host: arrays per command and hit.
fun oneFrameJson(frame: OneFrame): string {
    val paints: array<Json> = []
    for (p in frame.paints) {
        paints.append(jsonArray([jsonString(p.op), jsonInteger(p.x), jsonInteger(p.y), jsonInteger(p.w), jsonInteger(p.h), jsonInteger(p.radius), jsonString(p.color), jsonString(p.text), jsonInteger(p.size), jsonInteger(oneWeightNumber(p.weight)), jsonString(p.sides)]))
    }
    val hits: array<Json> = []
    for (h in frame.hits) {
        hits.append(jsonArray([jsonString(h.kind), jsonInteger(h.x), jsonInteger(h.y), jsonInteger(h.w), jsonInteger(h.h), jsonInteger(h.event), jsonInteger(h.submit), jsonString(h.key), jsonString(h.value), jsonString(h.placeholder), jsonBoolean(h.multiline)]))
    }
    jsonStringify(jsonObject(["w", "h", "paints", "hits"], [jsonInteger(frame.width), jsonInteger(frame.height), jsonArray(paints), jsonArray(hits)]))
}

// Scrolls a scroll area to `offset`. A feed left at its end has no saved offset,
// which is what keeps it following new items; scrolled up, it stays put.
fun oneScrollTo(var scroll: Map<string, int>, hit: OneHit, offset: int): void {
    if (hit.multiline && offset >= oneParseInt(hit.placeholder, 0)) scroll.remove(hit.key)
    else scroll.set(hit.key, offset)
    return
}
