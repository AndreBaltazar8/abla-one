import "abla/io"
import "abla/float"
import "../one.ab"
import "inter_metrics.ab"
import "../../../abla-ui/src/text.ab"
import "../../../abla-ui/src/flex.ab"

// one-layout (SPEC §7, M3): lays out a node tree in logical pixels for the
// backends that draw themselves (web-canvas, desktop, epaper). Containers
// follow the same flex rules the DOM and Compose backends get from their
// platforms; text is measured with Inter's advance widths, the font those
// backends draw with.

// --- text metrics -------------------------------------------------------------

val oneAdvanceMaps: array<Map<int, int>> = []

fun oneWeightIndex(weight: string): int =
    if (weight == "bold" || weight == "700") 3 else if (weight == "semibold" || weight == "600") 2 else if (weight == "medium" || weight == "500") 1 else 0

fun oneWeightNumber(weight: string): int = 400 + oneWeightIndex(weight) * 100

fun oneAdvances(weight: string): Map<int, int> {
    if (oneAdvanceMaps.size == 0) {
        for (table in [oneInterWidths400, oneInterWidths500, oneInterWidths600, oneInterWidths700]) {
            val map: Map<int, int> = Map()
            var i = 0
            while (i < oneInterCodes.size) {
                map.set(oneInterCodes[i], table[i])
                i = i + 1
            }
            oneAdvanceMaps.append(map)
        }
    }
    oneAdvanceMaps[oneWeightIndex(weight)]
}

// Inter's widths as an abla-ui TableFont, one table a weight; abla-one's weights map to those
// four (oneWeightNumber), so a weight the tables don't have reads the regular one, as before.
// Made on first use, not at start-up: every program imports this file, and one that measures no
// text then links none of the font's code.
val oneInterFonts: array<TableFont> = []

fun oneInterFontReady(): void {
    if (oneInterFonts.size == 0) oneInterFonts.append(tableFont(oneInterCodes, [400, 500, 600, 700], [oneInterWidths400, oneInterWidths500, oneInterWidths600, oneInterWidths700],
        f64FromInt(oneInterAscent) / 1000.0, f64FromInt(oneInterDescent) / 1000.0, 560, false))
    return
}

// UTF-8 decoding: the code point at `i` and its byte length.
fun oneCodeAt(text: string, i: int): int {
    val b = text[i]
    if (b < 128) return b
    if (b >= 240 && i + 3 < text.size) return ((b - 240) * 262144) + ((text[i + 1] - 128) * 4096) + ((text[i + 2] - 128) * 64) + (text[i + 3] - 128)
    if (b >= 224 && i + 2 < text.size) return ((b - 224) * 4096) + ((text[i + 1] - 128) * 64) + (text[i + 2] - 128)
    if (b >= 192 && i + 1 < text.size) return ((b - 192) * 64) + (text[i + 1] - 128)
    b
}

fun oneCodeLength(b: int): int = if (b >= 240) 4 else if (b >= 224) 3 else if (b >= 192) 2 else 1

// Width of text in 1/1000 px (kept exact while summing): abla-ui's TableFont over the Inter
// advance tables (the same arithmetic as before: each code point's advance times the size,
// summed; code points past U+2000 that aren't listed are one em, others 560).
fun oneTextMilli(text: string, size: int, weight: string): int {
    oneInterFontReady()
    val face = oneInterFonts[0].face("Inter", f64FromInt(size), oneWeightNumber(weight))
    // The font sums in 1/1000 px exactly and hands back px; this is that sum again.
    f64ToInt(oneInterFonts[0].width(face, text, 0, text.size) * 1000.0 + 0.5)
}

@noinline
fun oneTextWidth(text: string, size: int, weight: string): int = (oneTextMilli(text, size, weight) + 999) / 1000

// Breaks text into lines no wider than `width`. Words longer than a line are
// split. With `maxLines`, the last kept line ends with an ellipsis.
fun oneWrap(text: string, size: int, weight: string, width: int, maxLines: int): array<string> {
    val lines: array<string> = []
    var line = ""
    var word = ""
    var i = 0
    while (i <= text.size) {
        val atEnd = i == text.size
        val b = if (atEnd) 32 else text[i]
        if (b == 10 || b == 32 || atEnd) {
            if (word != "") {
                val candidate = if (line == "") word else "$line $word"
                if (oneTextWidth(candidate, size, weight) <= width || line == "") {
                    if (line == "" && oneTextWidth(word, size, weight) > width) {
                        // Split a long word by characters.
                        var piece = ""
                        var j = 0
                        while (j < word.size) {
                            val n = oneCodeLength(word[j])
                            val next = "$piece${word.slice(j, j + n)}"
                            if (piece != "" && oneTextWidth(next, size, weight) > width) {
                                lines.append(piece)
                                piece = word.slice(j, j + n)
                            } else piece = next
                            j = j + n
                        }
                        line = piece
                    } else line = candidate
                } else {
                    lines.append(line)
                    line = word
                }
                word = ""
            }
            if (b == 10) {
                lines.append(line)
                line = ""
            }
            i = i + 1
        } else {
            val n = oneCodeLength(b)
            word = "$word${text.slice(i, i + n)}"
            i = i + n
        }
    }
    if (line != "" || lines.size == 0) lines.append(line)
    if (maxLines > 0 && lines.size > maxLines) {
        val kept: array<string> = []
        var k = 0
        while (k < maxLines) {
            kept.append(lines[k])
            k = k + 1
        }
        kept[maxLines - 1] = oneEllipsize(kept[maxLines - 1], size, weight, width)
        return kept
    }
    if (maxLines == 1 && oneTextWidth(lines[0], size, weight) > width) lines[0] = oneEllipsize(lines[0], size, weight, width)
    lines
}

// Breaks a field's text into rows no wider than `width`, as where each row starts and ends
// in `text`, so a caret and a selection can be placed on them. Nothing is dropped: spaces
// stay at the end of the row they follow, and a newline ends its row without being on it.
// One pass, adding up each character's width.
fun oneWrapSpans(text: string, size: int, weight: string, width: int, var starts: array<int>, var ends: array<int>): void {
    starts.clear()
    ends.clear()
    val advances = oneAdvances(weight)
    val room = width * 1000
    var start = 0
    var used = 0
    // Where the row may break, after its last space, and how wide it is up to there.
    var gap = -1
    var gapUsed = 0
    var i = 0
    while (i < text.size) {
        val b = text[i]
        if (b == 10) {
            starts.append(start)
            ends.append(i)
            start = i + 1
            used = 0
            gap = -1
            i = i + 1
        } else {
            val code = oneCodeAt(text, i)
            val found = advances.get(code)
            val advance = (if (found != null) found else if (code > 0x2000) 1000 else 560) * size
            // A row ended at its last space can leave a word that still doesn't fit: then again.
            while (b != 32 && used + advance > room && i > start) {
                if (gap > start) {
                    starts.append(start)
                    ends.append(gap)
                    start = gap
                    used = used - gapUsed
                } else {
                    // A word longer than the row is split where it reaches the side.
                    starts.append(start)
                    ends.append(i)
                    start = i
                    used = 0
                }
                gap = -1
            }
            used = used + advance
            if (b == 32) {
                gap = i + 1
                gapUsed = used
            }
            i = i + oneCodeLength(b)
        }
    }
    starts.append(start)
    ends.append(text.size)
    return
}

fun oneEllipsize(line: string, size: int, weight: string, width: int): string {
    var kept = line
    while (kept.size > 0 && oneTextWidth("$kept…", size, weight) > width) {
        // Drop the last character (UTF-8 aware).
        var end = kept.size - 1
        while (end > 0 && kept[end] >= 128 && kept[end] < 192) end = end - 1
        kept = kept.slice(0, end)
    }
    while (kept.size > 0 && kept[kept.size - 1] == 32) kept = kept.slice(0, kept.size - 1)
    "$kept…"
}

// --- boxes ---------------------------------------------------------------------

// A laid-out node. x/y are relative to the parent box; w/h include padding.
class OneBox(
    val node: Node,
    val r: Resolved,
    var x: int,
    var y: int,
    var w: int,
    var h: int,
    val children: array<OneBox>,
    val lines: array<string>,
    var contentH: int,
    var scrollY: int,  // this and contentH run across, for a scrollRow
    val lineWidths: array<int> = []  // of `lines`, when text
)

class OneLayoutContext(val theme: Theme, val target: string, val scroll: Map<string, int>, val cache: OneLayoutCache, val width: int, val height: int)

// What a layout can reuse from the last one, for a backend that lays out one
// theme, target and width over and over: a slow device spends most of a tap
// resolving the same styles and wrapping the same text. Entries are checked
// against their inputs, as a hash alone could show the wrong text or style.
class OneResolvedEntry(val kind: string, val style: Style, val resolved: Resolved)
class OneWrapEntry(val text: string, val size: int, val weight: string, val width: int, val maxLines: int, val lines: array<string>, val widths: array<int>)
class OneLayoutCache(val resolved: Map<int, OneResolvedEntry>, val wraps: Map<int, OneWrapEntry>, val boxes: Map<int, OneBox>)

val oneLayoutCacheMost = 1024
val oneScrollRowChildWidth = 1000000
// Wrapping rows and scrollRow, added by what makes them (`Style.wrap`, `scrollRow`): they are only reached through these, so a
// program that never makes one, a device above all, links none of their code. They are large where they get compiled.
class OneRowRoom(val availW: int, val availH: int, val givenW: int, val givenH: int)
val oneWrapRowMeasure: array<(var: OneLayoutContext, Node, Resolved, OneRowRoom, string) -> OneBox> = []
val oneScrollRowMeasure: array<(var: OneLayoutContext, Node, Resolved, OneRowRoom, string) -> OneBox> = []

fun oneLayoutCache(): OneLayoutCache = OneLayoutCache(Map(), Map(), Map())

fun oneHashText(hash: int, text: string): int {
    var h = (hash ^ text.size) * 1099511628211
    for (b in text) h = (h ^ b) * 1099511628211
    h
}

// A copy of a tree with its hashes, made once before laying it out, so unchanged
// subtrees (most of them, after a tap) keep their boxes.
fun oneHashTree(node: Node): Node {
    var style = oneHashText(node.style.entries.size, node.kind)
    for (entry in node.style.entries) style = oneHashText(oneHashText(oneHashText(oneHashText(style, entry.property), entry.value), entry.target), entry.state)
    var hash = oneHashText(style, node.key)
    for (item in node.attrs) hash = oneHashText(oneHashText(hash, item.name), item.value)
    var scrolls = node.kind == "scroll" || node.kind == "feed" || node.kind == "scrollRow"
    val children: array<Node> = []
    for (child in node.children) {
        val hashed = oneHashTree(child)
        hash = (hash ^ hashed.hash) * 1099511628211
        if (hashed.hasScroll) scrolls = true
        children.append(hashed)
    }
    Node(node.kind, node.key, node.style, node.attrs, children, hash | 1, style, scrolls)
}

fun oneSameStyle(a: Style, b: Style): bool {
    if (a.entries.size != b.entries.size) return false
    var i = 0
    while (i < a.entries.size) {
        val p = a.entries[i]
        val q = b.entries[i]
        if (p.property != q.property || p.value != q.value || p.target != q.target || p.state != q.state) return false
        i = i + 1
    }
    true
}

// Appends the lines of `text` and their widths to `out` and `widths`.
fun oneWrapCached(var cache: OneLayoutCache, text: string, size: int, weight: string, width: int, maxLines: int, var out: array<string>, var widths: array<int>): void {
    val key = oneHashText(oneHashText(size * 1009 + width * 31 + maxLines, weight), text)
    val found = cache.wraps.get(key)
    if (found != null && found.size == size && found.width == width && found.maxLines == maxLines && found.weight == weight && found.text == text) {
        for (line in found.lines) out.append(line)
        for (w in found.widths) widths.append(w)
        return
    }
    val lines = oneWrap(text, size, weight, width, maxLines)
    val measured: array<int> = []
    for (line in lines) {
        out.append(line)
        measured.append(oneTextWidth(line, size, weight))
    }
    for (w in measured) widths.append(w)
    if (cache.wraps.size >= oneLayoutCacheMost) cache.wraps.clear()
    cache.wraps.set(key, OneWrapEntry(text, size, weight, width, maxLines, lines, measured))
    return
}

fun onePad(r: Resolved, side: string): int {
    val own = r.get("padding$side")
    if (own != "") oneParseInt(own, 0) else r.int("padding", 0)
}

fun oneClamp(value: int, r: Resolved, axis: string): int {
    var v = value
    val minimum = r.int("min$axis", -1)
    val maximum = r.int("max$axis", -1)
    if (maximum >= 0 && v > maximum) v = maximum
    if (minimum >= 0 && v < minimum) v = minimum
    if (v < 0) 0 else v
}

fun oneLineHeight(r: Resolved): int {
    val size = r.int("size", 15)
    r.int("lineHeight", size * 14 / 10)
}

fun oneIsColumnKind(kind: string): bool = kind == "column" || kind == "pressable" || kind == "scroll" || kind == "feed" || kind == "link"

// Lays out `root` to fill width × height.
fun oneLayout(root: Node, theme: Theme, target: string, width: int, height: int, scroll: Map<string, int>): OneBox =
    oneLayoutWith(root, theme, target, width, height, scroll, oneLayoutCache())

// The same, reusing what `cache` holds (one theme, target and width per cache).
fun oneLayoutCached(root: Node, theme: Theme, target: string, width: int, height: int, scroll: Map<string, int>, var cache: OneLayoutCache): OneBox {
    oneLayoutWith(oneHashTree(root), theme, target, width, height, scroll, cache)
}

fun oneLayoutWith(root: Node, theme: Theme, target: string, width: int, height: int, scroll: Map<string, int>, var cache: OneLayoutCache): OneBox {
    oneViewportWidth = width
    var ctx = OneLayoutContext(theme, target, scroll, cache, width, height)
    // abla-ui's flex lays the tree out: its rules are this file's (see abla-ui's README, Layout).
    var t = flexTree()
    var m = OneFlexMeasure([], [], [], [], [], [], [], [], [], [], oneLayoutCache())
    val nodes: array<Node> = []
    val rs: array<Resolved> = []
    val top = oneFlexAdd(ctx, t, m, nodes, rs, root, -1)
    t.layout(top, f64FromInt(width), f64FromInt(height), m)
    oneFlexBox(ctx, t, m, nodes, rs, top, "r")
}

// --- the tree as abla-ui flex nodes --------------------------------------------

val oneMeasureNone = 0
val oneMeasureText = 1
val oneMeasureInput = 2
val oneMeasureInputLines = 3

// Measures text and inputs for flex, as oneMeasureFresh does: lines by oneWrap, line height by
// oneLineHeight. The lines of each node's last measurement are kept (start and count into `lines`).
class OneFlexMeasure(
    var what: array<int>, var texts: array<string>, var sizes: array<int>, var weights: array<string>,
    var maxLines: array<int>, var lineHeights: array<int>,
    var lineStart: array<int>, var lineCount: array<int>, var lines: array<string>, var widths: array<int>,
    var cache: OneLayoutCache
) : FlexMeasure {
    fun measure(node: int, maxWidth: f64, maxHeight: f64): FlexSize {
        val room = f64ToInt(maxWidth)
        val kind = what[node]
        if (kind == oneMeasureInput || kind == oneMeasureInputLines) {
            var rows = 1
            if (kind == oneMeasureInputLines) rows = oneWrap(texts[node], sizes[node], weights[node], room, maxLines[node]).size
            return FlexSize(0.0, f64FromInt(rows * lineHeights[node]))
        }
        lineStart[node] = lines.size
        oneWrapCached(cache, texts[node], sizes[node], weights[node], room, maxLines[node], lines, widths)
        lineCount[node] = lines.size - lineStart[node]
        var widest = 0
        var i = lineStart[node]
        while (i < lines.size) {
            if (widths[i] > widest) widest = widths[i]
            i = i + 1
        }
        FlexSize(f64FromInt(widest), f64FromInt(lineCount[node] * lineHeights[node]))
    }
}

fun oneFlexAlign(word: string): int =
    if (word == "") FLEX_AUTO else if (word == "center") FLEX_CENTER else if (word == "end") FLEX_END else if (word == "stretch") FLEX_STRETCH else FLEX_START

fun oneFlexJustify(word: string): int =
    if (word == "center") FLEX_CENTER else if (word == "end") FLEX_END else if (word == "between") FLEX_BETWEEN else FLEX_START

fun oneFlexSizeMode(word: string): int =
    if (word == "") FLEX_CONTENT else if (word == "fill") FLEX_FILL else if (word == "hug") FLEX_HUG else FLEX_FIXED

fun oneFlexBound(v: int, none: f64): f64 = if (v >= 0) f64FromInt(v) else none

// Adds `node` and its subtree under `parent`; returns its flex index (== its place in `nodes`).
fun oneFlexAdd(var ctx: OneLayoutContext, var t: FlexTree, var m: OneFlexMeasure, var nodes: array<Node>, var rs: array<Resolved>, node: Node, parent: int): int {
    val n = t.add(parent)
    val r = oneResolveNode(ctx, node)
    nodes.append(node)
    rs.append(r)
    m.what.append(oneMeasureNone)
    m.texts.append("")
    m.sizes.append(0)
    m.weights.append("")
    m.maxLines.append(0)
    m.lineHeights.append(0)
    m.lineStart.append(0)
    m.lineCount.append(0)
    val kind = node.kind
    t.setPadding(n, f64FromInt(onePad(r, "Left")), f64FromInt(onePad(r, "Top")), f64FromInt(onePad(r, "Right")), f64FromInt(onePad(r, "Bottom")))
    val widthProp = r.get("width")
    val heightProp = r.get("height")
    t.setWidth(n, oneFlexSizeMode(widthProp), f64FromInt(oneParseInt(widthProp, 0)))
    t.setHeight(n, oneFlexSizeMode(heightProp), f64FromInt(oneParseInt(heightProp, 0)))
    t.setMinMax(n, oneFlexBound(r.int("minWidth", -1), 0.0), oneFlexBound(r.int("maxWidth", -1), FLEX_INF),
        oneFlexBound(r.int("minHeight", -1), 0.0), oneFlexBound(r.int("maxHeight", -1), FLEX_INF))
    val grow = r.int("grow", 0)
    t.setFlex(n, if (grow > 0) f64FromInt(grow) else 0.0, 1.0)
    t.setGap(n, f64FromInt(r.int("gap", 0)))
    t.setAlign(n, oneFlexAlign(r.get("align")), oneFlexJustify(r.get("justify")))
    val self = r.get("alignSelf")
    t.setAlignSelf(n, if (self == "") FLEX_AUTO else oneFlexAlign(self))
    if (kind == "text" || kind == "rich") {
        t.setMeasured(n, true)
        m.what[n] = oneMeasureText
        m.texts[n] = if (kind == "text") node.attr("text") else oneRichPlain(node.attr("runs"))
        m.sizes[n] = r.int("size", 15)
        m.weights[n] = r.get("weight")
        m.maxLines[n] = r.int("maxLines", 0)
        m.lineHeights[n] = oneLineHeight(r)
        // Cut lines end in an ellipsis fitted to the room.
        if (m.maxLines[n] > 0) t.setMeasureExact(n, true)
    } else if (kind == "icon" || kind == "image" || kind == "bitmap") {
        val size = f64FromInt(r.int("size", if (kind == "icon") 24 else 40))
        t.setIntrinsic(n, size, size)
        t.setNoStretch(n, true)
    } else if (kind == "input") {
        t.setMeasured(n, true)
        t.setIntrinsic(n, FLEX_INTRINSIC_ROOM, -1.0)
        val value = node.attr("value")
        m.what[n] = if (node.attr("multiline") == "true") oneMeasureInputLines else oneMeasureInput
        m.texts[n] = if (value == "") node.attr("placeholder") else value
        m.sizes[n] = r.int("size", 16)
        m.weights[n] = r.get("weight")
        m.maxLines[n] = r.int("maxLines", 5)
        m.lineHeights[n] = oneLineHeight(r)
        t.setMeasureExact(n, true)
    } else if (kind == "divider") {
        t.setIntrinsic(n, FLEX_INTRINSIC_ROOM, 1.0)
    } else if (kind == "spacer") {
        val amount = f64FromInt(oneParseInt(node.attr("size"), 0))
        t.setIntrinsic(n, amount, amount)
        t.setNoStretch(n, true)
    } else if (kind == "row" || kind == "scrollRow") {
        t.setDir(n, FLEX_ROW)
        val across = kind == "scrollRow"
        if (across || r.get("wrap") == "true") {
            if ((across && oneScrollRowMeasure.size > 0) || (!across && oneWrapRowMeasure.size > 0)) {
                if (across) t.setScroll(n, true, false) else t.setWrap(n, true)
            } else println("one: plain row: make it with Style.wrap() or scrollRow()")
        }
    } else if (kind == "stack") {
        t.setDir(n, FLEX_STACK)
    } else if (kind == "popover") {
        t.setDir(n, FLEX_POPOVER)
    } else if (kind == "scroll" || kind == "feed") {
        t.setScroll(n, false, true)
    }
    var count = node.children.size
    if (kind == "popover" && count > 2) count = 2
    if (kind == "text" || kind == "rich" || kind == "icon" || kind == "image" || kind == "bitmap" || kind == "input" || kind == "divider" || kind == "spacer") count = 0
    for (i in 0 until count) {
        val unused = oneFlexAdd(ctx, t, m, nodes, rs, node.children[i], n)
    }
    n
}

// The laid-out flex node `n` as abla-one's box: its children, its text's lines, contentH as
// each kind keeps it, and scroll offsets (kept per node path; a feed opens at the bottom).
fun oneFlexBox(var ctx: OneLayoutContext, t: FlexTree, m: OneFlexMeasure, nodes: array<Node>, rs: array<Resolved>, n: int, path: string): OneBox {
    val node = nodes[n]
    val kind = node.kind
    val children: array<OneBox> = []
    var c = t.first[n]
    var index = 0
    while (c >= 0) {
        children.append(oneFlexBox(ctx, t, m, nodes, rs, c, oneChildPath(path, nodes[c], index)))
        c = t.next[c]
        index = index + 1
    }
    val lines: array<string> = []
    val lineWidths: array<int> = []
    if (m.what[n] == oneMeasureText) {
        for (i in m.lineStart[n] until m.lineStart[n] + m.lineCount[n]) {
            lines.append(m.lines[i])
            lineWidths.append(m.widths[i])
        }
    }
    val w = f64ToInt(t.w[n])
    val h = f64ToInt(t.h[n])
    var contentH = 0
    var scrollY = 0
    val leaf = kind == "text" || kind == "rich" || kind == "icon" || kind == "image" || kind == "bitmap" || kind == "input" || kind == "divider" || kind == "spacer"
    if (kind == "row" || kind == "scrollRow") {
        if (t.has(n, FLEX_F_SCROLL_X)) {
            contentH = f64ToInt(t.contentW[n])
            scrollY = oneScrollOffset(contentH, w, ctx.scroll.get(path), 0)
            for (child in children) child.x = child.x - scrollY
        } else if (!t.has(n, FLEX_F_WRAP)) contentH = h
    } else if (!leaf && kind != "stack" && kind != "popover") {
        contentH = f64ToInt(t.contentH[n])
        if (kind == "scroll" || kind == "feed") {
            val saved = ctx.scroll.get(path)
            val maxScroll = if (contentH > h) contentH - h else 0
            var offset = if (saved != null) saved else if (oneFeedFollows(node)) maxScroll else 0
            if (offset > maxScroll) offset = maxScroll
            if (offset < 0) offset = 0
            scrollY = offset
        }
    }
    OneBox(node, rs[n], f64ToInt(t.x[n]), f64ToInt(t.y[n]), w, h, children, lines, contentH, scrollY, lineWidths)
}

// Applies new scroll offsets to a finished layout, which is all a swipe changes.
fun oneLayoutRescroll(var box: OneBox, scroll: Map<string, int>, path: string): void {
    val kind = box.node.kind
    val across = kind == "scrollRow"
    if (kind == "scroll" || kind == "feed" || across) {
        val offset = oneScrollOffset(box.contentH, if (across) box.w else box.h, scroll.get(path), box.scrollY)
        if (across) for (child in box.children) child.x = child.x + box.scrollY - offset
        box.scrollY = offset
    }
    var index = 0
    while (index < box.children.size) {
        oneLayoutRescroll(box.children[index], scroll, oneChildPath(path, box.children[index].node, index))
        index = index + 1
    }
    return
}

fun oneResolveNode(var ctx: OneLayoutContext, node: Node): Resolved {
    var key = node.styleHash
    if (key == 0) {
        key = oneHashText(node.style.entries.size, node.kind)
        for (entry in node.style.entries) key = oneHashText(oneHashText(oneHashText(oneHashText(key, entry.property), entry.value), entry.target), entry.state)
    }
    val found = ctx.cache.resolved.get(key)
    if (found != null && found.kind == node.kind && oneSameStyle(found.style, node.style)) return found.resolved
    val resolved = oneResolve(ctx.theme, node.kind, node.style, ctx.target)
    if (ctx.cache.resolved.size >= oneLayoutCacheMost) ctx.cache.resolved.clear()
    ctx.cache.resolved.set(key, OneResolvedEntry(node.kind, node.style, resolved))
    resolved
}

// Measures and lays out `node`. `fixedW`/`fixedH` (-1 when free) are sizes
// the parent decided (stretch, fill, grow); availW/availH bound hugging.
fun oneMeasure(var ctx: OneLayoutContext, node: Node, r: Resolved, availW: int, availH: int, fixedW: int, fixedH: int, path: string): OneBox {
    // What holds a scroll area depends on its place and offset; the rest only on this.
    if (node.hash == 0 || node.hasScroll) return oneMeasureFresh(ctx, node, r, availW, availH, fixedW, fixedH, path)
    val key = (((((node.hash ^ availW) * 1099511628211) ^ availH) * 1099511628211 ^ fixedW) * 1099511628211 ^ fixedH) * 1099511628211
    val found = ctx.cache.boxes.get(key)
    if (found != null && found.node.hash == node.hash) return OneBox(node, r, 0, 0, found.w, found.h, found.children, found.lines, found.contentH, 0, found.lineWidths)
    val box = oneMeasureFresh(ctx, node, r, availW, availH, fixedW, fixedH, path)
    if (ctx.cache.boxes.size >= oneLayoutCacheMost) ctx.cache.boxes.clear()
    ctx.cache.boxes.set(key, OneBox(node, r, 0, 0, box.w, box.h, box.children, box.lines, box.contentH, 0, box.lineWidths))
    box
}

fun oneMeasureFresh(var ctx: OneLayoutContext, node: Node, r: Resolved, availW: int, availH: int, fixedW: int, fixedH: int, path: string): OneBox {
    val kind = node.kind
    val pl = onePad(r, "Left")
    val pr = onePad(r, "Right")
    val pt = onePad(r, "Top")
    val pb = onePad(r, "Bottom")
    val widthProp = r.get("width")
    val heightProp = r.get("height")
    var w = if (fixedW >= 0) fixedW else if (widthProp != "" && widthProp != "fill" && widthProp != "hug") oneParseInt(widthProp, 0) else if (widthProp == "fill") availW else -1
    var h = if (fixedH >= 0) fixedH else if (heightProp != "" && heightProp != "fill" && heightProp != "hug") oneParseInt(heightProp, 0) else -1
    val children: array<OneBox> = []
    val lines: array<string> = []
    val lineWidths: array<int> = []
    var contentH = 0

    if (kind == "text" || kind == "rich") {
        val size = r.int("size", 15)
        val weight = r.get("weight")
        val text = if (kind == "text") node.attr("text") else oneRichPlain(node.attr("runs"))
        val room = (if (w >= 0) w else availW) - pl - pr
        oneWrapCached(ctx.cache, text, size, weight, if (room < 1) 1 else room, r.int("maxLines", 0), lines, lineWidths)
        var widest = 0
        for (lw in lineWidths) if (lw > widest) widest = lw
        if (w < 0) w = widest + pl + pr
        if (h < 0) h = lines.size * oneLineHeight(r) + pt + pb
    } else if (kind == "icon" || kind == "image" || kind == "bitmap") {
        val size = r.int("size", if (kind == "icon") 24 else 40)
        if (w < 0) w = size
        if (h < 0) h = size
    } else if (kind == "input") {
        val size = r.int("size", 16)
        if (w < 0) w = availW
        if (h < 0) {
            var rows = 1
            if (node.attr("multiline") == "true") {
                val value = node.attr("value")
                rows = oneWrap(if (value == "") node.attr("placeholder") else value, size, r.get("weight"), w - pl - pr, r.int("maxLines", 5)).size
            }
            h = oneClamp(rows * oneLineHeight(r) + pt + pb, r, "Height")
        }
    } else if (kind == "divider") {
        if (w < 0) w = availW
        if (h < 0) h = 1
    } else if (kind == "spacer") {
        val amount = oneParseInt(node.attr("size"), 0)
        if (w < 0) w = amount
        if (h < 0) h = amount
    } else if (kind == "row" || kind == "scrollRow") {
        val box = oneMeasureAnyRow(ctx, node, r, availW, availH, w, h, pl, pr, pt, pb, path)
        return box
    } else if (kind == "stack") {
        val innerW = (if (w >= 0) w else availW) - pl - pr
        val innerH = (if (h >= 0) h else availH) - pt - pb
        var maxW = 0
        var maxH = 0
        var index = 0
        for (child in node.children) {
            val cr = oneResolveNode(ctx, child)
            // One that fills takes the stack's size, when it has one, as in a row or column.
            val box = oneMeasure(
                ctx, child, cr, innerW, innerH,
                if (cr.get("width") == "fill" && w >= 0) innerW else -1, if (cr.get("height") == "fill" && h >= 0) innerH else -1,
                oneChildPath(path, child, index)
            )
            if (box.w > maxW) maxW = box.w
            if (box.h > maxH) maxH = box.h
            children.append(box)
            index = index + 1
        }
        if (w < 0) w = maxW + pl + pr
        if (h < 0) h = maxH + pt + pb
        val align = r.get("align")
        var c = 0
        while (c < children.size) {
            children[c].x = pl + (if (align == "center") (w - pl - pr - children[c].w) / 2 else if (align == "end") w - pl - pr - children[c].w else 0)
            children[c].y = pt + (if (align == "center") (h - pt - pb - children[c].h) / 2 else if (align == "end") h - pt - pb - children[c].h else 0)
            c = c + 1
        }
    } else if (kind == "popover") {
        // The anchor takes the room; the panel floats, as wide and tall as the window lets it.
        val anchor = oneMeasure(ctx, node.children[0], oneResolveNode(ctx, node.children[0]), availW, availH, w, h, oneChildPath(path, node.children[0], 0))
        children.append(anchor)
        if (w < 0) w = anchor.w
        if (h < 0) h = anchor.h
        if (node.children.size > 1) {
            val panel = node.children[1]
            children.append(oneMeasure(ctx, panel, oneResolveNode(ctx, panel), ctx.width - 16, ctx.height - 16, -1, -1, oneChildPath(path, panel, 1)))
        }
    } else {
        // column, pressable, scroll, feed, native and the root: a column.
        val box = oneMeasureColumn(ctx, node, r, availW, availH, w, h, pl, pr, pt, pb, path)
        return box
    }
    w = oneClamp(w, r, "Width")
    h = oneClamp(h, r, "Height")
    OneBox(node, r, 0, 0, w, h, children, lines, contentH, 0, lineWidths)
}

@noinline
fun oneFeedFollows(node: Node): bool = node.kind == "feed" && node.attr("anchor") != "top"

fun oneChildPath(path: string, child: Node, index: int): string = if (child.key != "") "$path/k:${child.key}" else "$path/$index"

// Whether a column's child takes its width: its own alignSelf says so first, as CSS's align-self over align-items, and a
// button aligned to the start keeps its own width, as in a browser.
fun oneStretches(r: Resolved, columnStretches: bool): bool {
    val self = r.get("alignSelf")
    if (self != "") self == "stretch" else columnStretches
}

fun oneGrowOf(r: Resolved, axisFill: bool): int {
    val grow = r.int("grow", 0)
    if (grow > 0) grow else if (axisFill) 1 else 0
}

@noinline
fun oneMeasureColumn(var ctx: OneLayoutContext, node: Node, r: Resolved, availW: int, availH: int, givenW: int, givenH: int, pl: int, pr: int, pt: int, pb: int, path: string): OneBox {
    val kind = node.kind
    val scrolls = kind == "scroll" || kind == "feed"
    var w = givenW
    var h = givenH
    if (scrolls && h < 0) h = availH
    val gap = r.int("gap", 0)
    val align = r.get("align")
    val stretch = align == "" || align == "stretch"
    val innerW = (if (w >= 0) w else availW) - pl - pr
    val innerAvailH = (if (h >= 0) h else availH) - pt - pb
    val resolved: array<Resolved> = []
    for (child in node.children) resolved.append(oneResolveNode(ctx, child))
    // First pass: everything that doesn't grow.
    val boxes: array<OneBox> = []
    var used = 0
    var totalGrow = 0
    var index = 0
    while (index < node.children.size) {
        val child = node.children[index]
        val cr = resolved[index]
        val grow = if (scrolls) 0 else oneGrowOf(cr, cr.get("height") == "fill")
        val fixedW = if (cr.get("width") == "fill" || (oneStretches(cr, stretch) && cr.get("width") == "" && child.kind != "icon" && child.kind != "image" && child.kind != "bitmap" && child.kind != "spacer" && w >= 0)) innerW else -1
        val box = oneMeasure(ctx, child, cr, innerW, if (scrolls) 1000000 else innerAvailH, fixedW, -1, oneChildPath(path, child, index))
        if (grow > 0) totalGrow = totalGrow + grow else used = used + box.h
        boxes.append(box)
        index = index + 1
    }
    val gaps = if (node.children.size > 1) gap * (node.children.size - 1) else 0
    // Second pass: growers share what's left of a definite height.
    if (totalGrow > 0 && h >= 0) {
        var remaining = h - pt - pb - used - gaps
        if (remaining < 0) remaining = 0
        index = 0
        while (index < boxes.size) {
            val cr = resolved[index]
            val grow = oneGrowOf(cr, cr.get("height") == "fill")
            if (grow > 0) {
                val child = node.children[index]
                val fixedW = if (boxes[index].w == innerW || cr.get("width") == "fill") innerW else -1
                boxes[index] = oneMeasure(ctx, child, cr, innerW, remaining * grow / totalGrow, fixedW, remaining * grow / totalGrow, oneChildPath(path, child, index))
            }
            index = index + 1
        }
    }
    var contentH = gaps
    var widest = 0
    for (box in boxes) {
        contentH = contentH + box.h
        if (box.w > widest) widest = box.w
    }
    if (w < 0) {
        w = oneClamp(widest + pl + pr, r, "Width")
        // A hugging column stretches its children to its own width afterwards.
        if (stretch) {
            index = 0
            while (index < boxes.size) {
                val child = node.children[index]
                if (boxes[index].w < w - pl - pr && oneStretches(resolved[index], true) && resolved[index].get("width") == "" && child.kind != "icon" && child.kind != "image" && child.kind != "bitmap" && child.kind != "spacer") {
                    boxes[index] = oneMeasure(ctx, child, resolved[index], w - pl - pr, innerAvailH, w - pl - pr, boxes[index].h, oneChildPath(path, child, index))
                }
                index = index + 1
            }
        }
    }
    if (h < 0) h = oneClamp(contentH + pt + pb, r, "Height")
    // Main axis placement.
    val justify = r.get("justify")
    val free = h - pt - pb - contentH
    var cursor = pt
    var between = 0
    if (!scrolls && free > 0) {
        if (justify == "center") cursor = pt + free / 2
        else if (justify == "end") cursor = pt + free
        else if (justify == "between" && boxes.size > 1) between = free / (boxes.size - 1)
    }
    index = 0
    while (index < boxes.size) {
        val self = resolved[index].get("alignSelf")
        val a = if (self != "") self else align
        boxes[index].y = cursor
        boxes[index].x = pl + (if (a == "center") (w - pl - pr - boxes[index].w) / 2 else if (a == "end") w - pl - pr - boxes[index].w else 0)
        cursor = cursor + boxes[index].h + gap + between
        index = index + 1
    }
    val outer = OneBox(node, r, 0, 0, w, h, boxes, [], contentH + pt + pb, 0)
    if (scrolls) {
        val key = path
        val saved = ctx.scroll.get(key)
        val maxScroll = if (outer.contentH > h) outer.contentH - h else 0
        // Feeds open at the bottom (chat) unless scrolled; scroll areas at the top.
        var offset = if (saved != null) saved else if (oneFeedFollows(node)) maxScroll else 0
        if (offset > maxScroll) offset = maxScroll
        if (offset < 0) offset = 0
        outer.scrollY = offset
    }
    outer
}

// Children at their natural sizes, left to right, starting a new line when the
// next one doesn't fit. `gap` separates them both ways.
// What the call returns can't be followed through the array, so it's handed on as a new box.
@noinline
fun oneMeasureAnyRow(var ctx: OneLayoutContext, node: Node, r: Resolved, availW: int, availH: int, givenW: int, givenH: int, pl: int, pr: int, pt: int, pb: int, path: string): OneBox {
    val across = node.kind == "scrollRow"
    if (across || r.get("wrap") == "true") {
        val measure = if (across) oneScrollRowMeasure else oneWrapRowMeasure
        if (measure.size > 0) {
            val b = measure[0](ctx, node, r, OneRowRoom(availW, availH, givenW, givenH), path)
            return OneBox(b.node, b.r, b.x, b.y, b.w, b.h, b.children, b.lines, b.contentH, b.scrollY, b.lineWidths)
        }
        // Asked for by hand, `set("wrap", "true")` or `oneNode("scrollRow", ...)`: no code here, so a plain row. Each layout says so, as a flag to say it once costs a device more than the words.
        println("one: plain row: make it with Style.wrap() or scrollRow()")
    }
    val box = oneMeasureRow(ctx, node, r, availW, availH, givenW, givenH, pl, pr, pt, pb, path)
    box
}

fun oneUseWrapRows(): void {
    if (oneWrapRowMeasure.size == 0) oneWrapRowMeasure.append(oneMeasureWrapRow)
    return
}

fun oneUseScrollRows(): void {
    if (oneScrollRowMeasure.size == 0) oneScrollRowMeasure.append(oneMeasureScrollRow)
    return
}

fun oneMeasureWrapRow(var ctx: OneLayoutContext, node: Node, r: Resolved, room: OneRowRoom, path: string): OneBox {
    val pl = onePad(r, "Left")
    val pr = onePad(r, "Right")
    val pt = onePad(r, "Top")
    val pb = onePad(r, "Bottom")
    val availW = room.availW
    val availH = room.availH
    val givenW = room.givenW
    val givenH = room.givenH
    val gap = r.int("gap", 0)
    val innerW = (if (givenW >= 0) givenW else availW) - pl - pr
    val innerH = (if (givenH >= 0) givenH else availH) - pt - pb
    val boxes: array<OneBox> = []
    var x = 0
    var y = 0
    var lineH = 0
    var widest = 0
    var index = 0
    for (child in node.children) {
        val box = oneMeasure(ctx, child, oneResolveNode(ctx, child), innerW, innerH, -1, -1, oneChildPath(path, child, index))
        if (x > 0 && x + box.w > innerW) {
            y = y + lineH + gap
            x = 0
            lineH = 0
        }
        box.x = pl + x
        box.y = pt + y
        if (box.h > lineH) lineH = box.h
        if (x + box.w > widest) widest = x + box.w
        x = x + box.w + gap
        boxes.append(box)
        index = index + 1
    }
    val w = oneClamp(if (givenW >= 0) givenW else widest + pl + pr, r, "Width")
    val h = oneClamp(if (givenH >= 0) givenH else y + lineH + pt + pb, r, "Height")
    OneBox(node, r, 0, 0, w, h, boxes, [], 0, 0)
}

fun oneScrollOffset(content: int, size: int, saved: int?, current: int): int {
    val most = if (content > size) content - size else 0
    var offset = if (saved != null) saved else current
    if (offset > most) offset = most
    if (offset < 0) offset = 0
    offset
}

// Children at their natural widths, however wide that comes to.
fun oneMeasureScrollRow(var ctx: OneLayoutContext, node: Node, r: Resolved, room: OneRowRoom, path: string): OneBox {
    val pl = onePad(r, "Left")
    val pr = onePad(r, "Right")
    val pt = onePad(r, "Top")
    val pb = onePad(r, "Bottom")
    val availW = room.availW
    val availH = room.availH
    val givenW = room.givenW
    val givenH = room.givenH
    val gap = r.int("gap", 0)
    val innerH = (if (givenH >= 0) givenH else availH) - pt - pb
    val boxes: array<OneBox> = []
    var x = pl
    var tallest = 0
    var index = 0
    for (child in node.children) {
        val box = oneMeasure(ctx, child, oneResolveNode(ctx, child), oneScrollRowChildWidth, innerH, -1, -1, oneChildPath(path, child, index))
        box.x = x
        x = x + box.w + (if (index + 1 < node.children.size) gap else 0)
        if (box.h > tallest) tallest = box.h
        boxes.append(box)
        index = index + 1
    }
    for (box in boxes) box.y = pt + (tallest - box.h) / 2
    val w = oneClamp(if (givenW >= 0) givenW else availW, r, "Width")
    val h = oneClamp(if (givenH >= 0) givenH else tallest + pt + pb, r, "Height")
    val offset = oneScrollOffset(x + pr, w, ctx.scroll.get(path), 0)
    for (box in boxes) box.x = box.x - offset
    OneBox(node, r, 0, 0, w, h, boxes, [], x + pr, offset)
}

@noinline
fun oneMeasureRow(var ctx: OneLayoutContext, node: Node, r: Resolved, availW: int, availH: int, givenW: int, givenH: int, pl: int, pr: int, pt: int, pb: int, path: string): OneBox {
    var w = givenW
    var h = givenH
    val gap = r.int("gap", 0)
    val innerW = (if (w >= 0) w else availW) - pl - pr
    val innerH = (if (h >= 0) h else availH) - pt - pb
    val resolved: array<Resolved> = []
    for (child in node.children) resolved.append(oneResolveNode(ctx, child))
    val boxes: array<OneBox> = []
    var used = 0
    var totalGrow = 0
    var index = 0
    while (index < node.children.size) {
        val cr = resolved[index]
        val grow = oneGrowOf(cr, cr.get("width") == "fill")
        if (grow > 0) totalGrow = totalGrow + grow
        index = index + 1
    }
    val gaps = if (node.children.size > 1) gap * (node.children.size - 1) else 0
    index = 0
    while (index < node.children.size) {
        val child = node.children[index]
        val cr = resolved[index]
        val grow = oneGrowOf(cr, cr.get("width") == "fill")
        if (grow == 0) {
            val box = oneMeasure(ctx, child, cr, innerW - used - gaps, innerH, -1, if (cr.get("height") == "fill" && h >= 0) innerH else -1, oneChildPath(path, child, index))
            used = used + box.w
            boxes.append(box)
        } else boxes.append(OneBox(child, cr, 0, 0, 0, 0, [], [], 0, 0))
        index = index + 1
    }
    var remaining = innerW - used - gaps
    if (remaining < 0) remaining = 0
    index = 0
    while (index < node.children.size) {
        val cr = resolved[index]
        val grow = oneGrowOf(cr, cr.get("width") == "fill")
        if (grow > 0) {
            val child = node.children[index]
            val share = if (totalGrow > 0) remaining * grow / totalGrow else 0
            boxes[index] = oneMeasure(ctx, child, cr, share, innerH, share, if (cr.get("height") == "fill" && h >= 0) innerH else -1, oneChildPath(path, child, index))
        }
        index = index + 1
    }
    var contentW = gaps
    var tallest = 0
    for (box in boxes) {
        contentW = contentW + box.w
        if (box.h > tallest) tallest = box.h
    }
    if (w < 0) w = oneClamp(if (totalGrow > 0) innerW + pl + pr else contentW + pl + pr, r, "Width")
    if (h < 0) h = oneClamp(tallest + pt + pb, r, "Height")
    // Stretched children take the row's height.
    val align = r.get("align")
    val justify = r.get("justify")
    val free = w - pl - pr - contentW
    var cursor = pl
    var between = 0
    if (free > 0 && totalGrow == 0) {
        if (justify == "center") cursor = pl + free / 2
        else if (justify == "end") cursor = pl + free
        else if (justify == "between" && boxes.size > 1) between = free / (boxes.size - 1)
    }
    index = 0
    while (index < boxes.size) {
        val self = resolved[index].get("alignSelf")
        val a = if (self != "") self else if (align == "") "center" else align
        if (a == "stretch" && boxes[index].h < h - pt - pb) {
            boxes[index] = oneMeasure(ctx, node.children[index], resolved[index], boxes[index].w, h - pt - pb, boxes[index].w, h - pt - pb, oneChildPath(path, node.children[index], index))
        }
        boxes[index].x = cursor
        boxes[index].y = pt + (if (a == "center") (h - pt - pb - boxes[index].h) / 2 else if (a == "end") h - pt - pb - boxes[index].h else 0)
        cursor = cursor + boxes[index].w + gap + between
        index = index + 1
    }
    OneBox(node, r, 0, 0, w, h, boxes, [], h, 0)
}

// The plain text of rich runs (mentions and emoji as written).
fun oneRichPlain(runs: string): string {
    var out = ""
    var i = 0
    // Minimal scan of [{"kind":..,"text":"..."}]: collect "text" values.
    while (i + 8 < runs.size) {
        if (runs.slice(i, i + 8) == "\"text\":\"") {
            var j = i + 8
            var value = ""
            while (j < runs.size && runs[j] != 34) {
                if (runs[j] == 92 && j + 1 < runs.size) {
                    value = "$value${runs.slice(j + 1, j + 2)}"
                    j = j + 2
                } else {
                    value = "$value${runs.slice(j, j + 1)}"
                    j = j + 1
                }
            }
            out = "$out$value"
            i = j
        }
        i = i + 1
    }
    out
}
