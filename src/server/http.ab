import "abla/http"
import "abla/json"
import "remote.ab"

// Serves the `@server` routes: `router.post("/one/:route", oneServerHandler)`, with
// oneServerHandler generated for a program that imports its server modules normally.
fun oneServerAnswer(request: HttpRequest, dispatch: (string, Json) -> OneServerReply): HttpResponse {
    val parsed = jsonDecode(if (request.body == "") "{}" else request.body)
    val arguments = when (parsed) {
        is JsonParsed -> parsed.value
        is JsonMalformed, is JsonLimitExceeded -> return httpJson(jsonStringify(jsonString("not JSON")), 400)
    }
    val reply = dispatch(request.routeParameter("route"), arguments)
    httpJson(reply.body, reply.status)
}
