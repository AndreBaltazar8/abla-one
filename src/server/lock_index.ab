// A balanced string index, including the first inserted record for a prefix.
// Keep this in Abla: the evaluator's Map currently scans its keys linearly.
class OneLockIndex(
    val keys: array<string> = [], val left: array<int> = [],
    val right: array<int> = [], val height: array<int> = [],
    val first: array<int> = [], val root: array<int> = [-1]
)

compile fun oneLockByteLess(left: string, right: string): bool {
    var index = 0
    while (index < left.size && index < right.size) {
        if (left[index] != right[index]) return left[index] < right[index]
        index = index + 1
    }
    left.size < right.size
}

compile fun oneLockIndexHeight(index: OneLockIndex, node: int): int =
    if (node < 0) 0 else index.height[node]

compile fun oneLockIndexRefresh(var index: OneLockIndex, node: int): void {
    val left = index.left[node]
    val right = index.right[node]
    val a = oneLockIndexHeight(index, left)
    val b = oneLockIndexHeight(index, right)
    index.height[node] = 1 + (if (a > b) a else b)
    var first = node
    if (left >= 0 && index.first[left] < first) first = index.first[left]
    if (right >= 0 && index.first[right] < first) first = index.first[right]
    index.first[node] = first
    return
}

compile fun oneLockIndexLeft(var index: OneLockIndex, node: int): int {
    val top = index.right[node]
    index.right[node] = index.left[top]
    index.left[top] = node
    oneLockIndexRefresh(index, node)
    oneLockIndexRefresh(index, top)
    top
}

compile fun oneLockIndexRight(var index: OneLockIndex, node: int): int {
    val top = index.left[node]
    index.left[node] = index.right[top]
    index.right[top] = node
    oneLockIndexRefresh(index, node)
    oneLockIndexRefresh(index, top)
    top
}

compile fun oneLockIndexInsert(var index: OneLockIndex, node: int, key: string): int {
    if (node < 0) {
        val added = index.keys.size
        index.keys.append(key)
        index.left.append(-1); index.right.append(-1)
        index.height.append(1); index.first.append(added)
        return added
    }
    if (key == index.keys[node]) return node
    if (oneLockByteLess(key, index.keys[node])) {
        index.left[node] = oneLockIndexInsert(index, index.left[node], key)
    } else index.right[node] = oneLockIndexInsert(index, index.right[node], key)
    oneLockIndexRefresh(index, node)
    val balance = oneLockIndexHeight(index, index.left[node]) - oneLockIndexHeight(index, index.right[node])
    if (balance > 1) {
        if (!oneLockByteLess(key, index.keys[index.left[node]])) index.left[node] = oneLockIndexLeft(index, index.left[node])
        return oneLockIndexRight(index, node)
    }
    if (balance < -1) {
        if (oneLockByteLess(key, index.keys[index.right[node]])) index.right[node] = oneLockIndexRight(index, index.right[node])
        return oneLockIndexLeft(index, node)
    }
    node
}

compile fun oneLockRemember(var index: OneLockIndex, key: string): bool {
    val before = index.keys.size
    index.root[0] = oneLockIndexInsert(index, index.root[0], key)
    index.keys.size != before
}

compile fun oneLockFindIndexed(index: OneLockIndex, prefix: string): string {
    var node = index.root[0]
    while (node >= 0) {
        val key = index.keys[node]
        if (key.startsWith(prefix)) {
            var first = node
            // Matching prefixes form a contiguous lexical range. On each
            // boundary walk, whole interior subtrees can use their oldest key.
            var lower = index.left[node]
            while (lower >= 0) {
                if (index.keys[lower].startsWith(prefix)) {
                    if (lower < first) first = lower
                    val inside = index.right[lower]
                    if (inside >= 0 && index.first[inside] < first) first = index.first[inside]
                    lower = index.left[lower]
                } else lower = index.right[lower]
            }
            var upper = index.right[node]
            while (upper >= 0) {
                if (index.keys[upper].startsWith(prefix)) {
                    if (upper < first) first = upper
                    val inside = index.left[upper]
                    if (inside >= 0 && index.first[inside] < first) first = index.first[inside]
                    upper = index.right[upper]
                } else upper = index.left[upper]
            }
            return index.keys[first]
        }
        node = if (oneLockByteLess(key, prefix)) index.right[node] else index.left[node]
    }
    ""
}
