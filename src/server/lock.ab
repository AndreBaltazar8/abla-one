import "abla/compiler"
import "abla/fs"
import "abla/text"
import "remote.ab"

// server.lock (SPEC §16): what deployed clients may rely on. Each build compares the
// `@server` routes and their data shapes with the committed file: adding a route or a
// field passes and is recorded; changing or removing what is recorded fails the build.
// `@retired("reason")` on a route takes it out of the comparison (it answers 410).
// A server's entry calls it from a transform:
//
//   #compilerGrant("filesystem.read")
//   #compilerGrant("filesystem.write")
//   compile fun lock(): void { oneServerLock("server.lock"); return }
//   #compiler.transform(lock)

// `line` without module prefixes: they hold a checkout's path, and the file is committed.
compile fun oneLockPortable(line: string): string {
    val prefix = "__abla_module_"
    var out = ""
    var i = 0
    while (i < line.size) {
        if (line.slice(i, line.size).startsWith(prefix)) {
            i = i + prefix.size
            while (!line.slice(i, line.size).startsWith("__")) i = i + 1
            i = i + 2
        } else {
            out = "$out${line.slice(i, i + 1)}"
            i = i + 1
        }
    }
    out
}

compile fun oneLockRouteLine(function: int): string {
    var parameters = ""
    var index = 0
    while (index < compiler.parameterCount(function)) {
        val entry = "${compiler.parameterName(function, index)}: ${oneRemoteNormal(compiler.parameterType(function, index))}"
        parameters = if (parameters == "") entry else "$parameters, $entry"
        index = index + 1
    }
    oneLockPortable("route ${oneRemoteRoute(compiler.functionName(function))}($parameters) -> ${oneRemoteNormal(compiler.resultType(function))}")
}

// `class Name a: T, b: U` for each class a type reaches, once.
compile fun oneLockClasses(type: string, var seen: array<string>, var lines: array<string>): void {
    if (type.endsWith("?")) return oneLockClasses(type.slice(0, type.size - 1), seen, lines)
    var open = 0
    while (open < type.size && type[open] != 60) open = open + 1
    val head = type.slice(0, open)
    if (open < type.size) for (argument in oneRemoteArguments(type.slice(open + 1, type.size - 1))) oneLockClasses(argument, seen, lines)
    if (head == "array" || head == "Map" || head == "int" || head == "string" || head == "bool" || head == "f64" || head == "Json") return
    for (name in seen) if (name == head) return
    seen.append(head)
    val declaration = compilerFindClass(head)
    if (declaration < 0) return
    val none: array<string> = []
    var fields = ""
    var index = 0
    while (index < compilerClassFieldCount(declaration)) {
        val fieldType = oneRemoteSubstitute(compilerClassFieldType(declaration, index), none, none)
        fields = "$fields|${compilerClassFieldName(declaration, index)}: $fieldType"
        oneLockClasses(fieldType, seen, lines)
        index = index + 1
    }
    lines.append(oneLockPortable("class $head$fields"))
    return
}

compile fun oneLockSplit(text: string, separator: int): array<string> {
    val out: array<string> = []
    var start = 0
    var i = 0
    while (i <= text.size) {
        if (i == text.size || text[i] == separator) {
            if (i > start) out.append(text.slice(start, i))
            start = i + 1
        }
        i = i + 1
    }
    out
}

compile fun oneLockFind(lines: array<string>, prefix: string): string {
    for (line in lines) if (line.startsWith(prefix)) return line
    ""
}

compile fun oneLockByteLess(left: string, right: string): bool {
    var index = 0
    while (index < left.size && index < right.size) {
        if (left[index] != right[index]) return left[index] < right[index]
        index = index + 1
    }
    left.size < right.size
}

// The merge starts with retained routes, then discovered classes: even a
// canonical previous file is not nearly sorted here. Bound comparison work to
// O(n log n), sorting whole records without changing fields or parameters.
compile fun oneServerLockSorted(values: array<string>): array<string> {
    val current: array<string> = []
    val scratch: array<string> = []
    for (value in values) { current.append(value); scratch.append("") }
    val count = current.size
    var width = 1
    while (width < count) {
        var first = 0
        while (first < count) {
            val middle = if (first + width < count) first + width else count
            val end = if (middle + width < count) middle + width else count
            var left = first
            var right = middle
            var out = first
            while (out < end) {
                if (right < end && (left >= middle || oneLockByteLess(current[right], current[left]))) {
                    scratch[out] = current[right]
                    right = right + 1
                } else {
                    scratch[out] = current[left]
                    left = left + 1
                }
                out = out + 1
            }
            first = end
        }
        // Copy values back rather than transferring a local array alias across
        // buffers; the returned array keeps its own unambiguous ownership root.
        var index = 0
        while (index < count) {
            current[index] = scratch[index]
            index = index + 1
        }
        width = width * 2
    }
    current
}

compile fun oneServerLock(path: string): void {
    val current: array<string> = []
    val seen: array<string> = []
    val retired: array<string> = []
    for (function in compiler.functionsAnnotated("server")) {
        val route = oneRemoteRoute(compiler.functionName(function))
        if (oneRemoteIsRetired(function)) retired.append(route)
        current.append(oneLockRouteLine(function))
        var index = 0
        while (index < compiler.parameterCount(function)) {
            oneLockClasses(oneRemoteNormal(compiler.parameterType(function, index)), seen, current)
            index = index + 1
        }
        oneLockClasses(oneRemoteNormal(compiler.resultType(function)), seen, current)
    }
    val file = Path(path)
    val previous = if (file.exists()) file.readText() else ""
    val old = oneLockSplit(previous, 10)
    val problems: array<string> = []
    val merged: array<string> = []
    for (line in old) {
        val words = oneLockSplit(line, 32)
        if (line.startsWith("route ")) {
            val name = oneLockSplit(words[1], 40)[0]
            var isRetired = false
            for (r in retired) if (r == name) isRetired = true
            val now = oneLockFind(current, "route $name(")
            if (isRetired) merged.append(line)
            else if (now == "") problems.append("route $name was removed: mark it @retired instead")
            else if (now != line) problems.append("route $name changed: was $line")
            else merged.append(line)
        } else if (line.startsWith("class ")) {
            val parts = oneLockSplit(line.slice(6, line.size), 124)
            val now = oneLockSplit(oneLockFind(current, "class ${parts[0]}|"), 124)
            if (now.size == 0 && oneLockFind(current, "class ${parts[0]}") == "") merged.append(line)
            else {
                var index = 1
                while (index < parts.size) {
                    var kept = false
                    for (field in now) if (field == parts[index]) kept = true
                    if (!kept) problems.append("class ${parts[0]}: field ${parts[index]} was changed or removed")
                    index = index + 1
                }
            }
        }
    }
    if (problems.size > 0) {
        compiler.generateModule("one_server_lock", "fun oneServerLockProblem(): void {\n    ${oneRemoteErrorName("server lock: ${problems[0]}")}()\n}\n")
        return
    }
    for (line in current) if (!line.startsWith("route ") || oneLockFind(merged, line) == "") merged.append(line)
    var text = ""
    // Discovery and valid old-lock order may differ between build paths.
    // Sort complete records; parameter and class-field declaration order stays intact.
    for (line in oneServerLockSorted(merged)) text = "$text$line\n"
    if (text != previous) compiler.writeFile(path, text)
    return
}
