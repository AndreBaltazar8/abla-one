import "abla/compiler"
import "abla/compiler/parser"
import "abla/json"
import "../core/services.ab"
import "lock_index.ab"

// `@server` functions, called from any client (SPEC §16). A client imports the
// server module with `import contract`, so only signatures and data shapes reach
// its binary, and calls through `$remote`:
//
//   import contract "../server/orders.ab" as orders
//   pending = $remote(services, "https://example.com", orders.orders(session, "open"))
//   ... in receive: val result = pending.result(oneResponse(payload))
//
// Encoders and decoders are generated at compile time by walking the types,
// from the one declaration: numbers, strings, booleans, nullable values, arrays,
// maps with string keys, and classes, nested and generic.

// A call under way. `result` reads its completion.
class OneRemote<T>(val id: int, val decode: (Json) -> T, val validate: (Json) -> bool) {
    fun matches(response: OneResponse): bool = response.requestId == id
    fun result(response: OneResponse): OneRemoteResult<T> {
        oneRemoteChecked<T>(oneRemoteReply(response), decode, validate)
    }
}

// `kind`: "ok" (`value()` is set), "retired" (the server dropped this route: this
// build must update; `message` says why) or "failed". Check ok() before value().
class OneRemoteResult<T>(val values: array<T>, val status: int, val kind: string, val message: string) {
    fun ok(): bool = kind == "ok" && values.size == 1
    fun value(): borrow(this) T = values[0]
}

// A reply without saying what it holds, one type of it for all routes: `kind` as above, `json` when
// "ok". `$remoteDecode` reads that into the route's result. With `$remoteCall`, which only gives the
// request's id, this is what a client with many routes uses: `$remote`'s two generic classes are
// copied per result type, which an MCU's flash notices.
// ok() here checks HTTP/JSON only; $remoteDecode checks the declared result type.
class OneRemoteReply(val status: int, val kind: string, val message: string, val json: Json) {
    fun ok(): bool = kind == "ok"
}

@noinline
fun oneRemoteReply(response: OneResponse): OneRemoteReply {
    if (response.status == 410) {
        val reason = jsonParse(response.body)
        return OneRemoteReply(410, "retired", if (reason.succeeded) reason.value.asString() else response.body, jsonNull())
    }
    if (!response.ok()) return OneRemoteReply(response.status, "failed", if (response.error != "") response.error else response.body, jsonNull())
    val parsed = jsonParse(response.body)
    if (!parsed.succeeded) return OneRemoteReply(response.status, "failed", "not JSON", jsonNull())
    OneRemoteReply(response.status, "ok", "", parsed.value)
}

// Validate before constructing any typed value. A malformed success never turns
// into a class filled with default fields; its diagnostic contains no body data.
fun <T> oneRemoteChecked(reply: OneRemoteReply, decode: (Json) -> T, validate: (Json) -> bool): OneRemoteResult<T> {
    val values: array<T> = []
    if (!reply.ok()) return OneRemoteResult<T>(values, reply.status, reply.kind, reply.message)
    if (!validate(reply.json)) return OneRemoteResult<T>(values, reply.status, "failed", "invalid result type")
    values.append(decode(reply.json))
    OneRemoteResult<T>(values, reply.status, "ok", "")
}

// Some APIs answer a business refusal in a successful HTTP response. Handle that
// envelope explicitly, before decoding the route's complete success data shape.
class OneRemoteRefusal(val status: int, val message: string)
fun oneRemoteRefusal(reply: OneRemoteReply): OneRemoteRefusal? {
    if (!reply.ok() || !reply.json.isObject()) return null
    val status = reply.json.get("status")
    val error = reply.json.get("error")
    if (!oneRemoteValidInt(status) || !error.isString()) return null
    val code = status.asInt()
    if (code < 400 || code > 599) return null
    OneRemoteRefusal(code, error.asString())
}

// A call's arguments, filled in by the generated code one call each, so a route costs little.
class OneRemoteBody(val keys: array<string> = [], val values: array<Json> = [])
@noinline
fun oneRemoteBodyText(var body: OneRemoteBody, key: string, value: string): void {
    body.keys.append(key)
    body.values.append(jsonString(value))
    return
}
@noinline
fun oneRemoteBodyValue(var body: OneRemoteBody, key: string, value: Json): void {
    body.keys.append(key)
    body.values.append(value)
    return
}
@noinline
fun oneRemoteBodySend(body: OneRemoteBody, services: OneServices, base: string, route: string): int {
    val slash = if (base.size > 0 && base[base.size - 1] == 47) "" else "/"
    services.send(oneRequest("POST", "$base${slash}one/$route").json(jsonObject(body.keys, body.values)))
}

@noinline
fun oneRemoteTextField(json: Json, name: string): string = json.get(name).asString()
@noinline
fun oneRemoteIntField(json: Json, name: string): int = json.get(name).asInt()
@noinline
fun oneRemoteBoolField(json: Json, name: string): bool = json.get(name).asBoolean()
@noinline
fun oneRemoteCount(json: Json): int = if (json.isArray()) json.values.size else 0
@noinline
fun oneRemoteAt(json: Json, index: int): Json = json.values[index]

// What a route answers, on the server.
class OneServerReply(val status: int, val body: string)

fun <T> oneRemoteSend(services: OneServices, base: string, route: string, body: Json, decode: (Json) -> T, validate: (Json) -> bool): OneRemote<T> {
    val slash = if (base.size > 0 && base[base.size - 1] == 47) "" else "/"
    OneRemote<T>(services.send(oneRequest("POST", "$base${slash}one/$route").json(body)), decode, validate)
}

// --- values to and from JSON (what the generated code calls) --------------------

fun oneRemoteOutInt(value: int): Json = jsonInteger(value)
fun oneRemoteInInt(json: Json): int = json.asInt()
// Missing fields retain decoder defaults; explicit null belongs only to nullable types.
fun oneRemoteValidInt(json: Json): bool = json.isNumber() && json.asNumber().integer && json.intAvailable()
fun oneRemoteValidString(json: Json): bool = json.isString()
fun oneRemoteValidBool(json: Json): bool = json.isBoolean()
fun oneRemoteValidF64(json: Json): bool {
    if (!json.isNumber()) return false
    val value = oneRemoteInF64(json)
    value - value == 0.0
}
fun oneRemoteValidOther(json: Json): bool = true
fun oneRemoteOutString(value: string): Json = jsonString(value)
fun oneRemoteInString(json: Json): string = json.asString()
fun oneRemoteOutBool(value: bool): Json = jsonBoolean(value)
fun oneRemoteInBool(json: Json): bool = json.asBoolean()
fun oneRemoteOutJson(value: Json): Json = value
fun oneRemoteInJson(json: Json): Json = json
fun oneRemoteField(json: Json, name: string): Json = json.get(name)

fun <T> oneRemoteOutNullable(value: T?, out: (T) -> Json): Json = if (value != null) out(value) else jsonNull()
fun <T> oneRemoteInNullable(json: Json, read: (Json) -> T): T? = if (json.isNull()) null else read(json)

fun <T> oneRemoteOutArray(values: array<T>, out: (T) -> Json): Json {
    val items: array<Json> = []
    for (value in values) items.append(out(value))
    jsonArray(items)
}

fun <T> oneRemoteInArray(json: Json, read: (Json) -> T): array<T> {
    val items: array<T> = []
    if (json.isArray()) for (item in json.values) items.append(read(item))
    items
}

fun <V> oneRemoteOutMap(values: Map<string, V>, out: (V) -> Json): Json {
    val keys: array<string> = []
    val items: array<Json> = []
    for (key in values.keys()) {
        val value = values.get(key)
        if (value != null) {
            keys.append(key)
            items.append(out(value))
        }
    }
    jsonObject(keys, items)
}

fun <V> oneRemoteInMap(json: Json, read: (Json) -> V): Map<string, V> {
    val out: Map<string, V> = Map()
    if (json.isObject()) {
        var i = 0
        while (i < json.keys.size) {
            out.set(json.keys[i], read(json.values[i]))
            i = i + 1
        }
    }
    out
}

fun oneRemoteOutF64(value: f64): Json = ablaJsonValue(value)
fun oneRemoteInF64(json: Json): f64 = oneRemoteParseF64(json.asNumber().text)
fun oneRemoteObjectEmpty(): Json = jsonObject([], [])

fun oneRemoteParseF64(text: string): f64 {
    var negative = false
    var whole = 0.0
    var scale = 1.0
    var seenPoint = false
    var exponent = 0
    var exponentSign = 1
    var i = 0
    while (i < text.size) {
        val b = text[i]
        if (b == 45 && i == 0) negative = true
        else if (b == 46) seenPoint = true
        else if (b == 101 || b == 69) {
            i = i + 1
            while (i < text.size) {
                if (text[i] == 45) exponentSign = -1
                else if (text[i] != 43) {
                    // Once beyond any finite f64 scale, only the sign matters.
                    // Saturation also prevents long exponent text wrapping int.
                    exponent = if (exponent < 10000) exponent * 10 + text[i] - 48 else 10000
                }
                i = i + 1
            }
        } else {
            whole = whole * 10.0 + f64FromInt(b - 48)
            if (seenPoint) scale = scale * 10.0
        }
        i = i + 1
    }
    var value = whole / scale
    // Zero and non-finite values cannot change under further decimal scaling.
    // Work is bounded by f64 range, never by an attacker-supplied exponent.
    while (exponent > 0 && value != 0.0 && value - value == 0.0) {
        value = if (exponentSign > 0) value * 10.0 else value / 10.0
        exponent = exponent - 1
    }
    if (negative) 0.0 - value else value
}

// --- the generated code ------------------------------------------------------

// A compile-time pass (a transform, the only place a generated module can be added
// before analysis) writes plain Abla: one encoder and decoder per type, and for each
// `@server` function either the client call (a contract) or a route (its real body).

// Automatic generation owns append-only caches. Legacy/manual sources retain
// their original mutable-array behavior unless they explicitly opt in.
compile class OneRemoteSource(var code: string, val seen: array<string>, val problems: array<string>, val prefixes: array<string>, val classes: array<string>, val spellings: array<string>, val parts: array<string>, val indexed: bool = false, var seenIndex: OneLockIndex = OneLockIndex(), var classIndex: OneLockIndex = OneLockIndex())

compile fun oneRemoteRemember(var source: OneRemoteSource, name: string): bool {
    if (source.indexed && source.seen.size > 64) {
        if (source.seenIndex.keys.size != source.seen.size) source.seenIndex = oneLockIndexOf(source.seen)
        if (oneLockKnown(source.seenIndex, name)) return false
        oneLockRemember(source.seenIndex, name)
    } else {
        for (seen in source.seen) if (seen == name) return false
    }
    source.seen.append(name)
    true
}

// Keep complete declarations (including annotations) together. A program can have more
// than ablac's 1 MiB per-module limit; individual generated units stay below 512 KiB.
// Reserve compiler module slots for other transforms, such as the server lock.
compile fun oneRemoteAppend(var source: OneRemoteSource, declaration: string): void {
    if (declaration.size > 524288) {
        source.problems.append("remote declaration exceeds 512 KiB; split this data shape or route")
        return
    }
    if (source.code.size + declaration.size > 524288) {
        source.parts.append(source.code)
        source.code = ""
    }
    source.code = "${source.code}$declaration"
    return
}

compile fun oneRemoteHash(text: string): int {
    var value = 17
    for (b in text) value = (value * 257 + b + 1) % 1000000007
    value
}

// `Name<A, B>`'s arguments, split at the top level.
compile fun oneRemoteArguments(text: string): array<string> {
    val out: array<string> = []
    var start = 0
    var depth = 0
    var i = 0
    while (i < text.size) {
        if (text[i] == 60) depth = depth + 1
        if (text[i] == 62) depth = depth - 1
        if (text[i] == 44 && depth == 0) {
            out.append(oneRemoteTrim(text.slice(start, i)))
            start = i + 1
        }
        i = i + 1
    }
    out.append(oneRemoteTrim(text.slice(start, text.size)))
    out
}

compile fun oneRemoteTrim(text: string): string {
    var a = 0
    var b = text.size
    while (a < b && text[a] == 32) a = a + 1
    while (b > a && text[b - 1] == 32) b = b - 1
    text.slice(a, b)
}

// A type as written with the compiler's spellings normalized and type parameters replaced.
compile fun oneRemoteSubstitute(type: string, names: array<string>, values: array<string>): string {
    if (type.endsWith("?")) return "${oneRemoteSubstitute(type.slice(0, type.size - 1), names, values)}?"
    if (type.startsWith("nullable:")) return "${oneRemoteSubstitute(type.slice(9, type.size), names, values)}?"
    if (type.startsWith("map:")) {
        var colon = 4
        while (colon < type.size && type[colon] != 58) colon = colon + 1
        return "Map<${oneRemoteSubstitute(type.slice(4, colon), names, values)}, ${oneRemoteSubstitute(type.slice(colon + 1, type.size), names, values)}>"
    }
    if (type.startsWith("array:")) return "array<${oneRemoteSubstitute(type.slice(6, type.size), names, values)}>"
    var open = 0
    while (open < type.size && type[open] != 60) open = open + 1
    if (open < type.size) {
        var inner = ""
        for (argument in oneRemoteArguments(type.slice(open + 1, type.size - 1))) {
            val next = oneRemoteSubstitute(argument, names, values)
            inner = if (inner == "") next else "$inner, $next"
        }
        return "${type.slice(0, open)}<$inner>"
    }
    var i = 0
    while (i < names.size) {
        if (names[i] == type) return values[i]
        i = i + 1
    }
    if (type == "i64") "int" else type
}

// The name a class goes by here: one that came through an import alias carries its
// module's prefix.
compile fun oneRemoteClassName(var source: OneRemoteSource, name: string): string {
    if (source.indexed && source.classes.size > 64) {
        if (source.classIndex.keys.size != source.classes.size) source.classIndex = oneLockIndexOf(source.classes)
        val known = oneLockPosition(source.classIndex, name)
        if (known >= 0) return source.spellings[known]
    } else {
        var known = 0
        while (known < source.classes.size) {
            if (source.classes[known] == name) return source.spellings[known]
            known = known + 1
        }
    }
    var spelled = name
    val handle = compilerFindType(name)
    if (handle >= 0) {
        val own = oneRemoteModulePrefix(compilerTypeModuleIdentity(handle))
        if (own != "" && compilerFindClass("$own$name") >= 0) spelled = "$own$name"
    }
    if (spelled == name) for (prefix in source.prefixes) if (spelled == name && compilerFindClass("$prefix$name") >= 0) spelled = "$prefix$name"
    if (source.indexed && source.classIndex.keys.size > 0) oneLockRemember(source.classIndex, name)
    source.classes.append(name)
    source.spellings.append(spelled)
    spelled
}

compile fun oneRemoteModulePrefix(module: string): string {
    if (module == "") return ""
    val digits = "0123456789abcdef"
    var hex = ""
    for (b in module) hex = "$hex${digits.slice(b / 16, b / 16 + 1)}${digits.slice(b % 16, b % 16 + 1)}"
    "__abla_module_${hex}__"
}

// The modules `@server` functions come from, once each: spelling a class looks in them, and there are many of both.
compile fun oneRemotePrefixes(): array<string> {
    val modules: array<string> = []
    var moduleIndex = OneLockIndex()
    val prefixes: array<string> = []
    val functions: array<int> = []
    for (function in compilerContractFunctionsAnnotated("server")) functions.append(function)
    for (function in compiler.functionsAnnotated("server")) functions.append(function)
    for (function in functions) {
        val module = compiler.functionModuleIdentity(function)
        var known = false
        if (modules.size > 64) {
            if (moduleIndex.keys.size != modules.size) moduleIndex = oneLockIndexOf(modules)
            known = oneLockKnown(moduleIndex, module)
        } else { for (seen in modules) if (seen == module) known = true }
        if (!known) {
            if (moduleIndex.keys.size > 0) oneLockRemember(moduleIndex, module)
            modules.append(module)
            prefixes.append(oneRemoteModulePrefix(module))
        }
    }
    prefixes
}

// How to call a function here: under its module's prefix when it came through an alias.
compile fun oneRemoteFunctionName(function: int, route: string): string {
    val digits = "0123456789abcdef"
    var hex = ""
    for (b in compiler.functionModuleIdentity(function)) hex = "$hex${digits.slice(b / 16, b / 16 + 1)}${digits.slice(b % 16, b % 16 + 1)}"
    val full = "__abla_module_${hex}__$route"
    if (compilerFindFunction(full) >= 0) full else route
}

// A function's own name, without that prefix.
compile fun oneRemoteRoute(name: string): string {
    var start = 0
    var i = 0
    while (i + 1 < name.size) {
        if (name[i] == 95 && name[i + 1] == 95) start = i + 2
        i = i + 1
    }
    name.slice(start, name.size)
}

// `type` as this generated module spells it.
compile fun oneRemoteSpell(var source: OneRemoteSource, type: string): string {
    if (type.endsWith("?")) return "${oneRemoteSpell(source, type.slice(0, type.size - 1))}?"
    if (type == "int" || type == "string" || type == "bool" || type == "f64" || type == "Json") return type
    var open = 0
    while (open < type.size && type[open] != 60) open = open + 1
    var head = type.slice(0, open)
    if (head != "array" && head != "Map") head = oneRemoteClassName(source, head)
    if (open == type.size) return head
    var inner = ""
    for (argument in oneRemoteArguments(type.slice(open + 1, type.size - 1))) {
        val next = oneRemoteSpell(source, argument)
        inner = if (inner == "") next else "$inner, $next"
    }
    "$head<$inner>"
}

// The function that encodes (`out`) or decodes a `type`, written on first use.
compile fun oneRemoteCodec(var source: OneRemoteSource, type: string, out: bool, path: string): string {
    if (type == "int") return if (out) "oneRemoteOutInt" else "oneRemoteInInt"
    if (type == "string") return if (out) "oneRemoteOutString" else "oneRemoteInString"
    if (type == "bool") return if (out) "oneRemoteOutBool" else "oneRemoteInBool"
    if (type == "f64") return if (out) "oneRemoteOutF64" else "oneRemoteInF64"
    if (type == "Json") return if (out) "oneRemoteOutJson" else "oneRemoteInJson"
    val name = "oneRemote${if (out) "Out" else "In"}_${oneRemoteHash(type)}"
    if (!oneRemoteRemember(source, name)) return name
    val spelled = oneRemoteSpell(source, type)
    val signature = if (out) "fun $name(value: $spelled): Json" else "fun $name(json: Json): $spelled"
    val argument = if (out) "value" else "json"
    val helperKind = if (out) "Out" else "In"
    if (type.endsWith("?")) {
        val inner = oneRemoteCodec(source, type.slice(0, type.size - 1), out, path)
        oneRemoteAppend(source, "$signature = oneRemote${helperKind}Nullable($argument, $inner)\n")
        return name
    }
    var open = 0
    while (open < type.size && type[open] != 60) open = open + 1
    val head = type.slice(0, open)
    val arguments = if (open < type.size) oneRemoteArguments(type.slice(open + 1, type.size - 1)) else []
    if (head == "array") {
        val inner = oneRemoteCodec(source, arguments[0], out, "$path[]")
        // Reading, the loop is written out for each type: a shared generic would be copied per type anyway, with a closure.
        if (out) oneRemoteAppend(source, "$signature = oneRemoteOutArray(value, $inner)\n")
        else oneRemoteAppend(source, "fun $name(json: Json): $spelled {\n    val items: $spelled = []\n    val count = oneRemoteCount(json)\n    var index = 0\n    while (index < count) {\n        items.append($inner(oneRemoteAt(json, index)))\n        index = index + 1\n    }\n    items\n}\n")
        return name
    }
    if (head == "Map") {
        if (arguments[0] != "string") source.problems.append("$path: maps need string keys")
        val inner = oneRemoteCodec(source, arguments[1], out, "$path{}")
        oneRemoteAppend(source, "$signature = oneRemote${helperKind}Map($argument, $inner)\n")
        return name
    }
    val declaration = compilerFindClass(head)
    if (declaration < 0 && compilerFindType(head) >= 0) {
        // The contract names the class, but its module isn't loaded for the contract: a module the contract
        // imports only through another one doesn't carry its classes.
        source.problems.append("$path: $type is declared in a module the contract does not import directly (import that module in the contract's own module)")
        return name
    }
    if (declaration < 0 || type.contains("->") || compiler.isResource(compilerFindType(head))) {
        source.problems.append("$path: $type can't cross the network (plain data only: no closures, resources or native handles)")
        return name
    }
    val parameters: array<string> = []
    var index = 0
    while (index < compilerClassTypeParameterCount(declaration)) {
        parameters.append(compilerClassTypeParameterName(declaration, index))
        index = index + 1
    }
    var keys = ""
    var values = ""
    index = 0
    while (index < compilerClassFieldCount(declaration)) {
        val field = compilerClassFieldName(declaration, index)
        val fieldType = oneRemoteSubstitute(compilerClassFieldType(declaration, index), parameters, arguments)
        val codec = oneRemoteCodec(source, fieldType, out, "$path.$field")
        keys = if (keys == "") "\"$field\"" else "$keys, \"$field\""
        val read = if (out) "$codec(value.$field)"
            else if (fieldType == "string") "oneRemoteTextField(json, \"$field\")"
            else if (fieldType == "int") "oneRemoteIntField(json, \"$field\")"
            else if (fieldType == "bool") "oneRemoteBoolField(json, \"$field\")"
            else "$codec(oneRemoteField(json, \"$field\"))"
        values = if (values == "") read else "$values, $read"
        index = index + 1
    }
    val body = if (out) (if (keys == "") "oneRemoteObjectEmpty()" else "jsonObject([$keys], [$values])")
        else "$spelled($values)"
    oneRemoteAppend(source, "$signature = $body\n")
    name
}

// Requests validate supplied fields and preserve absent defaults. Replies require
// every declared field, including nullable ones, before any typed construction.
compile fun oneRemoteValidator(var source: OneRemoteSource, type: string, complete: bool = false): string {
    if (type == "int") return "oneRemoteValidInt"
    if (type == "string") return "oneRemoteValidString"
    if (type == "bool") return "oneRemoteValidBool"
    if (type == "f64") return "oneRemoteValidF64"
    if (type == "Json") return "oneRemoteValidOther"
    val name = "oneRemoteValidate${if (complete) "Reply" else ""}_${oneRemoteHash(type)}"
    if (!oneRemoteRemember(source, name)) return name
    if (type.endsWith("?")) {
        val inner = oneRemoteValidator(source, type.slice(0, type.size - 1), complete)
        oneRemoteAppend(source, "fun $name(json: Json): bool = json.isNull() || $inner(json)\n")
        return name
    }
    var open = 0
    while (open < type.size && type[open] != 60) open = open + 1
    val head = type.slice(0, open)
    val arguments = if (open < type.size) oneRemoteArguments(type.slice(open + 1, type.size - 1)) else []
    if (head == "array" || head == "Map") {
        val inner = oneRemoteValidator(source, arguments[if (head == "array") 0 else 1], complete)
        val shape = if (head == "array") "json.isArray()" else "json.isObject()"
        oneRemoteAppend(source, "fun $name(json: Json): bool {\n    if (!$shape) return false\n    for (value in json.values) if (!$inner(value)) return false\n    true\n}\n")
        return name
    }
    val declaration = compilerFindClass(head)
    if (declaration < 0) return "oneRemoteValidOther"
    val parameters: array<string> = []
    var index = 0
    while (index < compilerClassTypeParameterCount(declaration)) {
        parameters.append(compilerClassTypeParameterName(declaration, index))
        index = index + 1
    }
    var checks = ""
    index = 0
    while (index < compilerClassFieldCount(declaration)) {
        val field = compilerClassFieldName(declaration, index)
        val fieldType = oneRemoteSubstitute(compilerClassFieldType(declaration, index), parameters, arguments)
        val valid = oneRemoteValidator(source, fieldType, complete)
        if (complete) checks = "$checks    if (!json.has(\"$field\")) return false\n"
        if (valid != "oneRemoteValidOther") checks = "$checks    if (json.has(\"$field\") && !$valid(oneRemoteField(json, \"$field\"))) return false\n"
        index = index + 1
    }
    oneRemoteAppend(source, "fun $name(json: Json): bool {\n    if (!json.isObject()) return false\n${checks}    true\n}\n")
    name
}

// Compatibility is explicit per route, never inferred from a caller header.
// Opaque JSON adapters can retain their historical field coercion while new
// typed routes reject malformed arguments before executing application code.
compile fun oneRemoteLegacyJson(function: int): bool {
    var index = 0
    while (index < compiler.annotationCount(function)) {
        if (compiler.annotation(function, index) == "server" && compiler.annotationArgumentCount(function, index)>0 && compiler.annotationArgumentText(function,index,0)=="legacy-json") return true
        index = index + 1
    }
    false
}

compile fun oneRemoteIsRetired(function: int): bool {
    var index = 0
    while (index < compiler.annotationCount(function)) {
        if (compiler.annotation(function, index) == "retired") return true
        index = index + 1
    }
    false
}

// An unknown function whose name spells a problem out: how a compile-time pass stops
// a build with a message.
compile fun oneRemoteErrorName(problem: string): string {
    val letters = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
    var name = "ONE_ERROR__"
    for (b in problem) {
        var part = "_"
        var i = 0
        while (i < letters.size) {
            if (letters[i] == b) part = letters.slice(i, i + 1)
            i = i + 1
        }
        name = "$name$part"
    }
    name
}

compile fun oneRemoteRetiredReason(function: int): string {
    var index = 0
    while (index < compiler.annotationCount(function)) {
        if (compiler.annotation(function, index) == "retired") {
            return if (compiler.annotationArgumentCount(function, index) > 0) compiler.annotationArgumentText(function, index, 0) else ""
        }
        index = index + 1
    }
    ""
}

compile fun oneRemoteNormal(type: string): string {
    val none: array<string> = []
    oneRemoteSubstitute(type, none, none)
}

compile fun oneRemoteWriteClients(var source: OneRemoteSource): void {
    for (function in compilerContractFunctionsAnnotated("server")) {
        val route = oneRemoteRoute(compiler.functionName(function))
        var parameters = "services: OneServices, base: string"
        var keys = ""
        var values = ""
        var fill = ""
        var index = 0
        while (index < compiler.parameterCount(function)) {
            val name = compiler.parameterName(function, index)
            val type = oneRemoteNormal(compiler.parameterType(function, index))
            parameters = "$parameters, $name: ${oneRemoteSpell(source, type)}"
            val encoded = "${oneRemoteCodec(source, type, true, "$route($name)")}($name)"
            fill = if (type == "string") "$fill    oneRemoteBodyText(oneRemoteArguments, \"$name\", $name)\n" else "$fill    oneRemoteBodyValue(oneRemoteArguments, \"$name\", $encoded)\n"
            keys = if (keys == "") "\"$name\"" else "$keys, \"$name\""
            values = if (values == "") encoded else "$values, $encoded"
            index = index + 1
        }
        val result = oneRemoteNormal(compiler.resultType(function))
        val spelled = oneRemoteSpell(source, result)
        val decode = oneRemoteCodec(source, result, false, "$route: result")
        val validate = oneRemoteValidator(source, result, true)
        val body = if (keys == "") "oneRemoteObjectEmpty()" else "jsonObject([$keys], [$values])"
        oneRemoteAppend(source, "@noinline\nfun oneRemoteSendTo_$route($parameters): int {\n    var oneRemoteArguments = OneRemoteBody()\n$fill    oneRemoteBodySend(oneRemoteArguments, services, base, \"$route\")\n}\nfun oneRemoteDecode_$route(json: Json): OneRemoteResult<$spelled> = oneRemoteChecked<$spelled>(OneRemoteReply(200, \"ok\", \"\", json), $decode, $validate)\nfun oneRemoteDecode_$route(reply: OneRemoteReply): OneRemoteResult<$spelled> = oneRemoteChecked<$spelled>(reply, $decode, $validate)\n")
        oneRemoteAppend(source, "fun oneRemoteCall_$route($parameters): OneRemote<$spelled> = oneRemoteSend<$spelled>(services, base, \"$route\", $body, $decode, $validate)\n")
    }
    return
}

compile fun oneRemoteDispatchName(part: int): string = if (part == 0) "oneServerDispatch" else "oneServerDispatch_$part"

compile fun oneRemoteWriteRoutes(var source: OneRemoteSource): void {
    val functions = compiler.functionsAnnotated("server")
    if (functions.size == 0) return
    var cases = ""
    var part = 0
    for (function in functions) {
        if (cases.size > 65536) {
            oneRemoteAppend(source, "fun ${oneRemoteDispatchName(part)}(route: string, body: Json): OneServerReply {\n    if (!body.isObject()) return OneServerReply(400, jsonStringify(jsonString(\"invalid arguments\")))\n$cases    ${oneRemoteDispatchName(part + 1)}(route, body)\n}\n")
            part = part + 1
            cases = ""
        }
        val route = oneRemoteRoute(compiler.functionName(function))
        val full = oneRemoteFunctionName(function, route)
        val retired = oneRemoteRetiredReason(function)
        if (oneRemoteIsRetired(function)) cases = "$cases    if (route == \"$route\") return OneServerReply(410, jsonStringify(jsonString(\"$retired\")))\n"
        else {
            var arguments = ""
            var checks = ""
            var index = 0
            while (index < compiler.parameterCount(function)) {
                val name = compiler.parameterName(function, index)
                val type = oneRemoteNormal(compiler.parameterType(function, index))
                val read = "${oneRemoteCodec(source, type, false, "$route($name)")}(oneRemoteField(body, \"$name\"))"
                val valid = oneRemoteValidator(source, type)
                if (!oneRemoteLegacyJson(function) && valid != "oneRemoteValidOther") {
                    val reason = if (type == "int") "invalid integer in $name" else "invalid type in $name"
                    checks = "$checks        if (body.has(\"$name\") && !$valid(oneRemoteField(body, \"$name\"))) return OneServerReply(400, jsonStringify(jsonString(\"$reason\")))\n"
                }
                arguments = if (arguments == "") read else "$arguments, $read"
                index = index + 1
            }
            val encode = oneRemoteCodec(source, oneRemoteNormal(compiler.resultType(function)), true, "$route: result")
            cases = "$cases    if (route == \"$route\") {\n${checks}        return OneServerReply(200, jsonStringify($encode($full($arguments))))\n    }\n"
        }
    }
    oneRemoteAppend(source, "fun ${oneRemoteDispatchName(part)}(route: string, body: Json): OneServerReply {\n    if (!body.isObject()) return OneServerReply(400, jsonStringify(jsonString(\"invalid arguments\")))\n$cases    OneServerReply(404, jsonStringify(jsonString(\"no such route\")))\n}\n")
    if (compilerFindFunction("oneServerAnswer") >= 0) oneRemoteAppend(source, "fun oneServerHandler(request: HttpRequest): HttpResponse = oneServerAnswer(request, oneServerDispatch)\n")
    return
}

// The live server answers these under /one/ itself, before any route: a route of this name would
// never run (src/backends/web_live.ab, thin_host.ab).
compile fun oneRemoteReservedRoute(route: string): bool =
    route == "live" || route == "upload" || route == "cookies" || route == "host" || route == "canvas" || route == "fonts" || route == "thin"

compile fun oneRemoteGenerate(): void {
    var source = OneRemoteSource("", [], [], oneRemotePrefixes(), [], [], [], indexed = true)
    for (function in compiler.functionsAnnotated("server")) {
        val route = oneRemoteRoute(compiler.functionName(function))
        if (oneRemoteReservedRoute(route)) source.problems.append("route $route is reserved by the live server: rename it")
    }
    oneRemoteWriteClients(source)
    oneRemoteWriteRoutes(source)
    oneRemotePublish(source)
    return
}

compile fun oneRemotePublish(var source: OneRemoteSource): void {
    if (source.code != "") source.parts.append(source.code)
    if (source.parts.size > 48) source.problems.append("remote generation exceeds 48 module parts; split the contract")
    if (source.parts.size == 0 && source.problems.size == 0) return
    var problem = ""
    for (p in source.problems) problem = "$problem    ${oneRemoteErrorName(p)}()\n"
    // Unsupported generation must remain a hard compile error, even if no calls
    // are reachable: publish a small diagnostic unit, never just omit the routes.
    if (problem != "") {
        compiler.generateModule("one_remote_problems", "fun oneRemoteProblems(): void {\n$problem}\n")
        return
    }
    var part = 0
    for (code in source.parts) {
        compiler.generateModule("one_remote_$part", code)
        part = part + 1
    }
    return
}

#compiler.transform(oneRemoteGenerate)

// `$remote(services, base, contract.function(arguments))`.
compile fun oneRemoteParse(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    parserRawSkipWhitespace(cursor)
    val services = parserParseAblaExpression(cursor)
    parserRawSkipWhitespace(cursor)
    parserExpect(cursor, ",")
    parserRawSkipWhitespace(cursor)
    val base = parserParseAblaExpression(cursor)
    parserRawSkipWhitespace(cursor)
    parserExpect(cursor, ",")
    parserRawSkipWhitespace(cursor)
    val call = parserParseAblaExpression(cursor)
    parserRawSkipWhitespace(cursor)
    parserExpect(cursor, ")")
    if (syntaxKind(call) != "call" && syntaxKind(call) != "member.call") parserFail(cursor, "\$remote needs a direct call of a contract function")
    val arguments: array<SyntaxExpression> = [services, base]
    var index = 0
    while (index < syntaxChildCount(call)) {
        arguments.append(syntaxChild(call, index))
        index = index + 1
    }
    syntaxCall("oneRemoteCall_${oneRemoteRoute(syntaxText(call))}", arguments)
}

#compilerRegisterSubparser("remote", oneRemoteParse)

// `$remoteCall(services, base, contract.function(arguments))`: as `$remote`, giving the request's id.
compile fun oneRemoteCallParse(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    parserRawSkipWhitespace(cursor)
    val services = parserParseAblaExpression(cursor)
    parserRawSkipWhitespace(cursor)
    parserExpect(cursor, ",")
    parserRawSkipWhitespace(cursor)
    val base = parserParseAblaExpression(cursor)
    parserRawSkipWhitespace(cursor)
    parserExpect(cursor, ",")
    parserRawSkipWhitespace(cursor)
    val call = parserParseAblaExpression(cursor)
    parserRawSkipWhitespace(cursor)
    parserExpect(cursor, ")")
    if (syntaxKind(call) != "call" && syntaxKind(call) != "member.call") parserFail(cursor, "\$remoteCall needs a direct call of a contract function")
    val arguments: array<SyntaxExpression> = [services, base]
    var index = 0
    while (index < syntaxChildCount(call)) {
        arguments.append(syntaxChild(call, index))
        index = index + 1
    }
    syntaxCall("oneRemoteSendTo_${oneRemoteRoute(syntaxText(call))}", arguments)
}

#compilerRegisterSubparser("remoteCall", oneRemoteCallParse)

// `$remoteDecode(reply, contract.function())`: a checked result. Accepts either
// OneRemoteReply (preserves HTTP failures/status) or Json (assumes HTTP200).
compile fun oneRemoteDecodeParse(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    parserRawSkipWhitespace(cursor)
    val json = parserParseAblaExpression(cursor)
    parserRawSkipWhitespace(cursor)
    parserExpect(cursor, ",")
    parserRawSkipWhitespace(cursor)
    val call = parserParseAblaExpression(cursor)
    parserRawSkipWhitespace(cursor)
    parserExpect(cursor, ")")
    if (syntaxKind(call) != "call" && syntaxKind(call) != "member.call") parserFail(cursor, "\$remoteDecode needs a contract function, as a call")
    val arguments: array<SyntaxExpression> = [json]
    syntaxCall("oneRemoteDecode_${oneRemoteRoute(syntaxText(call))}", arguments)
}

#compilerRegisterSubparser("remoteDecode", oneRemoteDecodeParse)
