import "abla/bytes"
import "abla/float"
import "abla/crypto"
import "../layout/paint.ab"
import "inter_glyphs.ab"

// one-raster (SPEC §10, M3): draws a paint list into ARGB pixels, for the
// targets without a platform renderer (desktop, epaper) and for snapshot
// tests on the host. Anti-aliased fills use signed-area coverage
// accumulation, so glyph holes subtract and overlapping strokes merge.

// --- surface ---------------------------------------------------------------------

// `pixels` holds rows originY… of a width×height frame: all of them, or one
// band (oneSurfaceBand), which bounds memory on a small device.
// `scratch` is fills' coverage buffer, kept so drawing does not allocate.
class OneSurface(val width: int, val height: int, val pixels: array<int>, val clips: array<int>, var originY: int = 0, val scratch: array<int> = [], var clipLeft: int = 0, var clipTop: int = 0, var clipRight: int = 0, var clipBottom: int = 0) {
    // The innermost clip, kept in fields: blend reads it for every pixel.
    fun clipX0(): int = clipLeft
    fun clipY0(): int = clipTop
    fun clipX1(): int = clipRight
    fun clipY1(): int = clipBottom
    fun syncClip(): void {
        val n = clips.size
        clipLeft = if (n == 0) 0 else clips[n - 4]
        clipTop = if (n == 0) 0 else clips[n - 3]
        clipRight = if (n == 0) width else clips[n - 2]
        clipBottom = if (n == 0) height else clips[n - 1]
        return
    }
    fun pushClip(x: int, y: int, w: int, h: int): void {
        val x0 = if (x > clipLeft) x else clipLeft
        val y0 = if (y > clipTop) y else clipTop
        val x1 = if (x + w < clipRight) x + w else clipRight
        val y1 = if (y + h < clipBottom) y + h else clipBottom
        clips.append(x0)
        clips.append(y0)
        clips.append(x1)
        clips.append(y1)
        syncClip()
        return
    }
    fun popClip(): void {
        if (clips.size >= 4) clips.truncate(clips.size - 4)
        syncClip()
        return
    }
    // Blends `color` (0xRRGGBB) at coverage 0..255 over the pixel.
    fun blend(x: int, y: int, color: int, alpha: int): void {
        if (alpha <= 0 || x < clipLeft || y < clipTop || x >= clipRight || y >= clipBottom) return
        val i = (y - originY) * width + x
        if (alpha >= 255) {
            pixels[i] = color
            return
        }
        val old = pixels[i]
        val inv = 255 - alpha
        val r = (((color >> 16) & 255) * alpha + ((old >> 16) & 255) * inv) / 255
        val g = (((color >> 8) & 255) * alpha + ((old >> 8) & 255) * inv) / 255
        val b = ((color & 255) * alpha + (old & 255) * inv) / 255
        pixels[i] = (r << 16) | (g << 8) | b
        return
    }
}

fun oneSurface(width: int, height: int, background: int): OneSurface =
    OneSurface(width, height, filledArray(width * height, background), [], 0, [], 0, 0, width, height)

// Rows y0 until y0 + rows of a width×height frame: drawing is clipped to them.
fun oneSurfaceBand(width: int, height: int, y0: int, rows: int, background: int): OneSurface =
    OneSurface(width, height, filledArray(width * rows, background), [0, y0, width, y0 + rows], y0, [], 0, y0, width, y0 + rows)

// Points a band surface at the rectangle x0 until x1, y0 until y0 + rows of
// the frame (rows at most the surface's), with that rectangle cleared to
// `background` and drawing clipped to it: redrawing costs what changed.
fun oneSurfaceMoveTo(var surface: OneSurface, x0: int, y0: int, x1: int, rows: int, background: int): void {
    var row = 0
    while (row < rows) {
        var i = row * surface.width + x0
        val end = row * surface.width + x1
        while (i < end) {
            surface.pixels[i] = background
            i = i + 1
        }
        row = row + 1
    }
    surface.clips.clear()
    surface.clips.append(x0)
    surface.clips.append(y0)
    surface.clips.append(x1)
    surface.clips.append(y0 + rows)
    surface.originY = y0
    surface.syncClip()
    return
}

fun oneHex(c: int): int = if (c >= 48 && c <= 57) c - 48 else if (c >= 97 && c <= 102) c - 87 else if (c >= 65 && c <= 70) c - 55 else 0

// "#rrggbb", "#rgb" or "#aarrggbb" -> 0xRRGGBB and alpha 0..255.
fun oneColorValue(value: string): int {
    if (value.size == 7 && value[0] == 35) return ((oneHex(value[1]) * 16 + oneHex(value[2])) * 65536) + ((oneHex(value[3]) * 16 + oneHex(value[4])) * 256) + oneHex(value[5]) * 16 + oneHex(value[6])
    if (value.size == 4 && value[0] == 35) return (oneHex(value[1]) * 17 * 65536) + (oneHex(value[2]) * 17 * 256) + oneHex(value[3]) * 17
    if (value.size == 9 && value[0] == 35) return ((oneHex(value[3]) * 16 + oneHex(value[4])) * 65536) + ((oneHex(value[5]) * 16 + oneHex(value[6])) * 256) + oneHex(value[7]) * 16 + oneHex(value[8])
    0
}

fun oneColorAlpha(value: string): int = if (value.size == 9 && value[0] == 35) oneHex(value[1]) * 16 + oneHex(value[2]) else if (value == "" || value == "transparent") 0 else 255

// --- paths ---------------------------------------------------------------------------

// Closed polygons in pixels; `ends` holds each contour's end index.
class OnePath(val xs: array<f64>, val ys: array<f64>, val ends: array<int>) {
    fun moveTo(x: f64, y: f64): void {
        close()
        xs.append(x)
        ys.append(y)
        return
    }
    fun lineTo(x: f64, y: f64): void {
        xs.append(x)
        ys.append(y)
        return
    }
    fun close(): void {
        val start = if (ends.size == 0) 0 else ends[ends.size - 1]
        if (xs.size > start) ends.append(xs.size)
        return
    }
    fun quadTo(cx: f64, cy: f64, x: f64, y: f64): void {
        val x0 = xs[xs.size - 1]
        val y0 = ys[ys.size - 1]
        var i = 1
        while (i <= 8) {
            val t = f64FromInt(i) / 8.0
            val u = 1.0 - t
            lineTo(u * u * x0 + 2.0 * u * t * cx + t * t * x, u * u * y0 + 2.0 * u * t * cy + t * t * y)
            i = i + 1
        }
        return
    }
    fun cubicTo(c1x: f64, c1y: f64, c2x: f64, c2y: f64, x: f64, y: f64): void {
        val x0 = xs[xs.size - 1]
        val y0 = ys[ys.size - 1]
        var i = 1
        while (i <= 12) {
            val t = f64FromInt(i) / 12.0
            val u = 1.0 - t
            lineTo(u * u * u * x0 + 3.0 * u * u * t * c1x + 3.0 * u * t * t * c2x + t * t * t * x, u * u * u * y0 + 3.0 * u * u * t * c1y + 3.0 * u * t * t * c2y + t * t * t * y)
            i = i + 1
        }
        return
    }
}

fun onePath(): OnePath = OnePath([], [], [])

fun oneRoundRectPath(x: f64, y: f64, w: f64, h: f64, radius: f64, var path: OnePath): void {
    var r = radius
    if (r * 2.0 > w) r = w / 2.0
    if (r * 2.0 > h) r = h / 2.0
    if (r <= 0.5) {
        path.moveTo(x, y)
        path.lineTo(x + w, y)
        path.lineTo(x + w, y + h)
        path.lineTo(x, y + h)
        path.close()
        return
    }
    val k = 0.5523 * r
    path.moveTo(x + r, y)
    path.lineTo(x + w - r, y)
    path.cubicTo(x + w - r + k, y, x + w, y + r - k, x + w, y + r)
    path.lineTo(x + w, y + h - r)
    path.cubicTo(x + w, y + h - r + k, x + w - r + k, y + h, x + w - r, y + h)
    path.lineTo(x + r, y + h)
    path.cubicTo(x + r - k, y + h, x, y + h - r + k, x, y + h - r)
    path.lineTo(x, y + r)
    path.cubicTo(x, y + r - k, x + r - k, y, x + r, y)
    path.close()
    return
}

// Fills a path with signed-area coverage (font-rs). Overlapping contours of
// the same direction merge; opposite ones subtract (holes).
fun oneFill(var surface: OneSurface, var path: OnePath, color: int, alpha: int): void {
    path.close()
    if (path.xs.size < 3) return
    var minX = path.xs[0]
    var maxX = path.xs[0]
    var minY = path.ys[0]
    var maxY = path.ys[0]
    for (v in path.xs) {
        if (v < minX) minX = v
        if (v > maxX) maxX = v
    }
    for (v in path.ys) {
        if (v < minY) minY = v
        if (v > maxY) maxY = v
    }
    var bx = f64ToInt(minX) - 1
    var by = f64ToInt(minY) - 1
    var bx1 = f64ToInt(maxX) + 2
    var by1 = f64ToInt(maxY) + 2
    // Rows clip here. Columns only to the surface: coverage accumulates from a
    // shape's left edge, and blend applies the clip's sides.
    if (bx1 <= surface.clipX0() || bx >= surface.clipX1()) return
    if (bx < 0) bx = 0
    if (by < surface.clipY0()) by = surface.clipY0()
    if (bx1 > surface.width) bx1 = surface.width
    if (by1 > surface.clipY1()) by1 = surface.clipY1()
    val bw = bx1 - bx
    val bh = by1 - by
    if (bw <= 0 || bh <= 0) return
    // A square-cornered rectangle on whole pixels covers its pixels fully.
    if (path.ends.size == 1 && path.xs.size == 4 && oneWholePixelRect(path)) {
        oneFillRect(surface, f64ToInt(minX), f64ToInt(minY), f64ToInt(maxX) - f64ToInt(minX), f64ToInt(maxY) - f64ToInt(minY), color, alpha)
        return
    }
    // Coverage in fixed point (font-rs's signed-area accumulation): positions
    // in 1/256 px, coverage in 1/65536. Microcontrollers often have no
    // double-precision FPU, where this is the difference between seconds and
    // a fraction of one for a screen.
    val needed = (bw + 2) * bh
    var cleared = 0
    while (cleared < needed && cleared < surface.scratch.size) {
        surface.scratch[cleared] = 0
        cleared = cleared + 1
    }
    while (surface.scratch.size < needed) surface.scratch.append(0)
    var start = 0
    for (end in path.ends) {
        var i = start
        while (i < end) {
            val j = if (i + 1 < end) i + 1 else start
            oneAccumulateLine(surface.scratch, bw + 2, bh, oneFixed(path.xs[i]) - bx * 256, oneFixed(path.ys[i]) - by * 256,
                oneFixed(path.xs[j]) - bx * 256, oneFixed(path.ys[j]) - by * 256)
            i = i + 1
        }
        start = end
    }
    var y = 0
    while (y < bh) {
        var sum = 0
        var x = 0
        val row = y * (bw + 2)
        while (x < bw) {
            sum = sum + surface.scratch[row + x]
            var cover = if (sum < 0) 0 - sum else sum
            if (cover > 65536) cover = 65536
            if (cover > 131) surface.blend(bx + x, by + y, color, (cover * alpha + 32768) >> 16)
            x = x + 1
        }
        y = y + 1
    }
    return
}

// A position in 1/256 px.
fun oneFixed(v: f64): int = oneFloor(v * 256.0 + 0.5)

// floor(a / b) for b > 0.
fun oneFloorDiv(a: int, b: int): int = if (a >= 0) a / b else 0 - ((b - 1 - a) / b)

fun oneWholePixelRect(path: OnePath): bool {
    var i = 0
    while (i < 4) {
        if (f64FromInt(f64ToInt(path.xs[i])) != path.xs[i] || f64FromInt(f64ToInt(path.ys[i])) != path.ys[i]) return false
        i = i + 1
    }
    // Two distinct xs and two distinct ys, each edge axis-aligned.
    var k = 0
    while (k < 4) {
        val n = (k + 1) % 4
        if (path.xs[k] != path.xs[n] && path.ys[k] != path.ys[n]) return false
        k = k + 1
    }
    true
}

fun oneFloor(v: f64): int {
    val i = f64ToInt(v)
    if (f64FromInt(i) > v) i - 1 else i
}

// Adds a line's signed area to the accumulation buffer (font-rs draw_line),
// in fixed point: positions in 1/256 px, areas in 1/65536 of a pixel.
fun oneAccumulateLine(var acc: array<int>, stride: int, rows: int, x0: int, y0: int, x1: int, y1: int): void {
    if (y0 == y1) return
    val dir = if (y0 < y1) 1 else -1
    val ax = if (y0 < y1) x0 else x1
    val ay = if (y0 < y1) y0 else y1
    val bxv = if (y0 < y1) x1 else x0
    val byv = if (y0 < y1) y1 else y0
    val spanX = bxv - ax
    val spanY = byv - ay
    var yStart = oneFloorDiv(ay, 256)
    if (yStart < 0) yStart = 0
    var yEnd = oneFloorDiv(byv, 256) + 1
    if (yEnd > rows) yEnd = rows
    var y = yStart
    while (y < yEnd) {
        val linestart = y * stride
        val top = if (y * 256 > ay) y * 256 else ay
        val bottom = if ((y + 1) * 256 < byv) (y + 1) * 256 else byv
        val dy = bottom - top
        if (dy > 0) {
            val x = ax + (top - ay) * spanX / spanY
            val xnext = ax + (bottom - ay) * spanX / spanY
            val d = dy * dir
            val xa = if (x < xnext) x else xnext
            val xb = if (x < xnext) xnext else x
            val x0i = oneFloorDiv(xa, 256)
            val x1ceil = oneFloorDiv(xb, 256) + 1
            if (x1ceil <= x0i + 1) {
                val xmf = (x + xnext) / 2 - x0i * 256
                oneAccAdd(acc, linestart + x0i, d * (256 - xmf))
                oneAccAdd(acc, linestart + x0i + 1, d * xmf)
            } else {
                val width = xb - xa
                val x0f = xa - x0i * 256
                val a0 = (256 - x0f) * (256 - x0f) / (2 * width)
                val x1f = xb - (x1ceil - 1) * 256
                val am = x1f * x1f / (2 * width)
                oneAccAdd(acc, linestart + x0i, d * a0)
                if (x1ceil == x0i + 2) oneAccAdd(acc, linestart + x0i + 1, d * (256 - a0 - am))
                else {
                    val step = 65536 / width
                    val a1 = (384 - x0f) * 256 / width
                    oneAccAdd(acc, linestart + x0i + 1, d * (a1 - a0))
                    var xi = x0i + 2
                    while (xi < x1ceil - 1) {
                        oneAccAdd(acc, linestart + xi, d * step)
                        xi = xi + 1
                    }
                    val a2 = a1 + (x1ceil - x0i - 3) * step
                    oneAccAdd(acc, linestart + x1ceil - 1, d * (256 - a2 - am))
                }
                oneAccAdd(acc, linestart + x1ceil, d * am)
            }
        }
        y = y + 1
    }
    return
}

fun oneAccAdd(var acc: array<int>, index: int, value: int): void {
    if (index >= 0 && index < acc.size) acc[index] = acc[index] + value
    return
}

// A polygon's orientation, to make every stroke piece wind the same way.
fun oneSignedArea(xs: array<f64>, ys: array<f64>): f64 {
    var a = 0.0
    var i = 0
    while (i < xs.size) {
        val j = (i + 1) % xs.size
        a = a + xs[i] * ys[j] - xs[j] * ys[i]
        i = i + 1
    }
    a
}

fun oneAddPolygon(var path: OnePath, xs: array<f64>, ys: array<f64>): void {
    val forward = oneSignedArea(xs, ys) >= 0.0
    var i = 0
    while (i < xs.size) {
        val k = if (forward) i else xs.size - 1 - i
        if (i == 0) path.moveTo(xs[k], ys[k]) else path.lineTo(xs[k], ys[k])
        i = i + 1
    }
    path.close()
    return
}

// Strokes polylines with round joins and caps: a quad per segment and a disc
// per vertex, all winding the same way so they merge.
fun oneStroke(var surface: OneSurface, var lines: OnePath, width: f64, color: int, alpha: int): void {
    lines.close()
    var shape = onePath()
    val r = width / 2.0
    var start = 0
    for (end in lines.ends) {
        var i = start
        while (i < end) {
            val x = lines.xs[i]
            val y = lines.ys[i]
            val disc: array<f64> = []
            val discY: array<f64> = []
            var k = 0
            while (k < 12) {
                val a = 6.2831853 * f64FromInt(k) / 12.0
                disc.append(x + r * oneCos(a))
                discY.append(y + r * oneSin(a))
                k = k + 1
            }
            oneAddPolygon(shape, disc, discY)
            if (i + 1 < end) {
                val nx = lines.xs[i + 1]
                val ny = lines.ys[i + 1]
                val dx = nx - x
                val dy = ny - y
                val len = oneSqrt(dx * dx + dy * dy)
                if (len > 0.0001) {
                    val px = -dy / len * r
                    val py = dx / len * r
                    oneAddPolygon(shape, [x + px, nx + px, nx - px, x - px], [y + py, ny + py, ny - py, y - py])
                }
            }
            i = i + 1
        }
        start = end
    }
    oneFill(surface, shape, color, alpha)
    return
}

fun oneSqrt(v: f64): f64 {
    if (v <= 0.0) return 0.0
    var x = if (v > 1.0) v else 1.0
    var i = 0
    while (i < 20) {
        x = 0.5 * (x + v / x)
        i = i + 1
    }
    x
}

fun oneSin(a: f64): f64 {
    // Range-reduce to [-pi, pi], then a Taylor series.
    var x = a
    while (x > 3.14159265) x = x - 6.2831853
    while (x < -3.14159265) x = x + 6.2831853
    val x2 = x * x
    x * (1.0 - x2 / 6.0 * (1.0 - x2 / 20.0 * (1.0 - x2 / 42.0 * (1.0 - x2 / 72.0 * (1.0 - x2 / 110.0)))))
}

fun oneCos(a: f64): f64 = oneSin(a + 1.5707963)

// --- glyphs ----------------------------------------------------------------------------

// Each weight's outlines, decoded when first drawn: little-endian 16-bit
// words, kept as bytes (a small device's heap has no room for an int each).
val oneGlyphBytes: array<string> = []
val oneGlyphCodes: Map<int, int> = Map()

fun oneGlyphTable(weight: int): string {
    if (oneGlyphBytes.size == 0) {
        var i = 0
        while (i < oneInterCodes.size) {
            oneGlyphCodes.set(oneInterCodes[i], i)
            i = i + 1
        }
        var w = 0
        while (w < 4) {
            oneGlyphBytes.append("")
            w = w + 1
        }
    }
    if (oneGlyphBytes[weight] == "") {
        oneGlyphBytes[weight] = base64Decode(if (weight == 0) oneGlyphs400 else if (weight == 1) oneGlyphs500 else if (weight == 2) oneGlyphs600 else oneGlyphs700)
    }
    oneGlyphBytes[weight]
}

fun oneGlyphWord(bytes: string, index: int): int {
    val v = bytes[index * 2] + bytes[index * 2 + 1] * 256
    if (v >= 32768) v - 65536 else v
}

fun oneGlyphOffset(weight: int, index: int): int =
    if (weight == 0) oneGlyphIndex400[index] else if (weight == 1) oneGlyphIndex500[index] else if (weight == 2) oneGlyphIndex600[index] else oneGlyphIndex700[index]

// Adds the glyph for `code` at pen position (x, baseline) to `path`; returns
// its advance in pixels.
fun oneGlyphPath(var path: OnePath, code: int, weight: int, size: f64, x: f64, baseline: f64): f64 {
    val words = oneGlyphTable(weight)
    oneGlyphOffset(0, 0)
    val found = oneGlyphCodes.get(code)
    val scale = size / f64FromInt(oneGlyphUnitsPerEm)
    if (found == null) return size * 0.6
    var p = oneGlyphOffset(weight, found)
    val advance = f64FromInt(oneGlyphWord(words, p)) * scale
    val contours = oneGlyphWord(words, p + 1)
    p = p + 2
    var c = 0
    while (c < contours) {
        val count = oneGlyphWord(words, p)
        p = p + 1
        // TrueType quadratic contours: implied on-curve midpoints between
        // consecutive off-curve points.
        val px: array<f64> = []
        val py: array<f64> = []
        val on: array<bool> = []
        var k = 0
        while (k < count) {
            px.append(x + f64FromInt(oneGlyphWord(words, p)) * scale)
            py.append(baseline - f64FromInt(oneGlyphWord(words, p + 1)) * scale)
            on.append(oneGlyphWord(words, p + 2) == 1)
            p = p + 3
            k = k + 1
        }
        var first = 0
        while (first < count && !on[first]) first = first + 1
        var sx = 0.0
        var sy = 0.0
        if (first == count) {
            sx = (px[0] + px[count - 1]) / 2.0
            sy = (py[0] + py[count - 1]) / 2.0
            first = 0
        } else {
            sx = px[first]
            sy = py[first]
        }
        path.moveTo(sx, sy)
        var ctrl = false
        var cx = 0.0
        var cy = 0.0
        var n = 1
        while (n <= count) {
            val idx = (first + n) % count
            val x1 = px[idx]
            val y1 = py[idx]
            if (on[idx]) {
                if (ctrl) path.quadTo(cx, cy, x1, y1) else path.lineTo(x1, y1)
                ctrl = false
            } else {
                if (ctrl) {
                    val mx = (cx + x1) / 2.0
                    val my = (cy + y1) / 2.0
                    path.quadTo(cx, cy, mx, my)
                }
                cx = x1
                cy = y1
                ctrl = true
            }
            n = n + 1
        }
        if (ctrl) path.quadTo(cx, cy, sx, sy)
        path.close()
        c = c + 1
    }
    advance
}

fun oneDrawText(var surface: OneSurface, text: string, x: int, y: int, h: int, size: int, weight: string, color: string): void {
    val ascent = f64FromInt(oneInterAscent * size) / 1000.0
    val descent = f64FromInt(oneInterDescent * size) / 1000.0
    val baseline = oneFloor(f64FromInt(y) + (f64FromInt(h) - ascent - descent) / 2.0 + ascent + 0.5)
    val rgb = oneColorValue(color)
    val alpha = oneColorAlpha(color)
    val w = oneWeightIndex(weight)
    var pen = f64FromInt(x)
    var i = 0
    while (i < text.size) {
        val whole = oneFloor(pen)
        val glyph = oneGlyphBitmap(oneCodeAt(text, i), w, size, oneFloor((pen - f64FromInt(whole)) * 4.0))
        oneBlitGlyph(surface, glyph, whole, baseline, rgb, alpha)
        pen = pen + glyph.advance
        i = i + oneCodeLength(text[i])
    }
    return
}

// A character's coverage (a byte per pixel, rows of w) at one size, weight and
// quarter-pixel position, relative to its pen and baseline. Outlines are costly
// to decode and fill, and text repeats its letters.
class OneGlyphBitmap(val left: int, val top: int, val w: int, val h: int, val cover: string, val advance: f64)

val oneGlyphCache: Map<int, OneGlyphBitmap> = Map()

fun oneGlyphBitmap(code: int, weight: int, size: int, quarter: int): OneGlyphBitmap {
    val key = (code << 20) | (size << 8) | (weight << 2) | quarter
    val cached = oneGlyphCache.get(key)
    if (cached != null) return cached
    var path = onePath()
    val advance = oneGlyphPath(path, code, weight, f64FromInt(size), f64FromInt(quarter) / 4.0, 0.0)
    path.close()
    var glyph = OneGlyphBitmap(0, 0, 0, 0, "", advance)
    if (path.xs.size >= 3) {
        var minX = path.xs[0]
        var maxX = path.xs[0]
        var minY = path.ys[0]
        var maxY = path.ys[0]
        for (v in path.xs) {
            if (v < minX) minX = v
            if (v > maxX) maxX = v
        }
        for (v in path.ys) {
            if (v < minY) minY = v
            if (v > maxY) maxY = v
        }
        val left = oneFloor(minX)
        val top = oneFloor(minY)
        val w = oneFloor(maxX) + 2 - left
        val h = oneFloor(maxY) + 2 - top
        val acc: array<int> = filledArray((w + 2) * h, 0)
        var start = 0
        for (end in path.ends) {
            var i = start
            while (i < end) {
                val j = if (i + 1 < end) i + 1 else start
                oneAccumulateLine(acc, w + 2, h, oneFixed(path.xs[i]) - left * 256, oneFixed(path.ys[i]) - top * 256,
                    oneFixed(path.xs[j]) - left * 256, oneFixed(path.ys[j]) - top * 256)
                i = i + 1
            }
            start = end
        }
        var cover = byteBuffer()
        var y = 0
        while (y < h) {
            var sum = 0
            var x = 0
            while (x < w) {
                sum = sum + acc[y * (w + 2) + x]
                var c = if (sum < 0) 0 - sum else sum
                if (c > 65536) c = 65536
                cover.appendByteValue((c * 255 + 32768) >> 16)
                x = x + 1
            }
            y = y + 1
        }
        glyph = OneGlyphBitmap(left, top, w, h, cover.toText(), advance)
    }
    oneGlyphCache.set(key, glyph)
    glyph
}

fun oneBlitGlyph(var surface: OneSurface, glyph: OneGlyphBitmap, penX: int, baseline: int, color: int, alpha: int): void {
    val x0 = penX + glyph.left
    val y0 = baseline + glyph.top
    var y = if (y0 < surface.clipTop) surface.clipTop - y0 else 0
    val rows = if (y0 + glyph.h > surface.clipBottom) surface.clipBottom - y0 else glyph.h
    val first = if (x0 < surface.clipLeft) surface.clipLeft - x0 else 0
    val columns = if (x0 + glyph.w > surface.clipRight) surface.clipRight - x0 else glyph.w
    while (y < rows) {
        var x = first
        val row = y * glyph.w
        while (x < columns) {
            val c = glyph.cover[row + x]
            if (c != 0) surface.blend(x0 + x, y0 + y, color, if (alpha == 255) c else (c * alpha + 127) / 255)
            x = x + 1
        }
        y = y + 1
    }
    return
}

// --- icons (SVG paths) -----------------------------------------------------------

// Draws an SVG icon (as produced by tools/vector2svg.py) into a box. Stroked
// paths use their stroke width; filled paths fill. Everything takes `tint`.
fun oneDrawSvg(var surface: OneSurface, svg: string, x: int, y: int, w: int, h: int, tint: string): void {
    val box = oneSvgAttr(svg, "viewBox")
    val parts = oneNumbers(box)
    if (parts.size < 4) return
    val sx = f64FromInt(w) / parts[2]
    val sy = f64FromInt(h) / parts[3]
    var at = 0
    while (true) {
        val next = oneFind(svg, "<path", at)
        if (next < 0) return
        val end = oneFind(svg, "/>", next)
        val element = svg.slice(next, if (end < 0) svg.size else end)
        at = if (end < 0) svg.size else end
        var path = onePath()
        oneSvgPath(oneSvgAttr(element, "d"), path, f64FromInt(x) - parts[0] * sx, f64FromInt(y) - parts[1] * sy, sx, sy)
        val stroke = oneSvgAttr(element, "stroke")
        val fill = oneSvgAttr(element, "fill")
        val color = oneColorValue(tint)
        if (stroke != "" && stroke != "none") {
            val widths = oneNumbers(oneSvgAttr(element, "stroke-width"))
            oneStroke(surface, path, (if (widths.size > 0) widths[0] else 1.0) * sx, color, 255)
        }
        if (fill != "none") oneFill(surface, path, color, 255)
    }
    return
}

fun oneFind(text: string, needle: string, from: int): int {
    var i = from
    while (i + needle.size <= text.size) {
        if (text.slice(i, i + needle.size) == needle) return i
        i = i + 1
    }
    -1
}

fun oneSvgAttr(element: string, name: string): string {
    val at = oneFind(element, " $name=\"", 0)
    if (at < 0) return ""
    val start = at + name.size + 3
    var end = start
    while (end < element.size && element[end] != 34) end = end + 1
    element.slice(start, end)
}

fun oneNumbers(text: string): array<f64> {
    val out: array<f64> = []
    var i = 0
    while (i < text.size) {
        val b = text[i]
        if ((b >= 48 && b <= 57) || b == 45 || b == 46) {
            var j = i
            if (text[j] == 45) j = j + 1
            var seenDot = false
            while (j < text.size && ((text[j] >= 48 && text[j] <= 57) || (text[j] == 46 && !seenDot))) {
                if (text[j] == 46) seenDot = true
                j = j + 1
            }
            out.append(oneParseFloat(text.slice(i, j)))
            i = j
        } else i = i + 1
    }
    out
}

fun oneParseFloat(text: string): f64 {
    var negative = false
    var value = 0.0
    var scale = 0.0
    for (b in text) {
        if (b == 45) negative = true
        else if (b == 46) scale = 1.0
        else if (b >= 48 && b <= 57) {
            if (scale > 0.0) {
                scale = scale / 10.0
                value = value + f64FromInt(b - 48) * scale
            } else value = value * 10.0 + f64FromInt(b - 48)
        }
    }
    if (negative) -value else value
}

// SVG path data: M L H V C Q A Z (absolute and relative).
fun oneSvgPath(d: string, var path: OnePath, ox: f64, oy: f64, sx: f64, sy: f64): void {
    var i = 0
    var cmd = 77
    var cx = 0.0
    var cy = 0.0
    var startX = 0.0
    var startY = 0.0
    val args: array<f64> = []
    while (i <= d.size) {
        val b = if (i < d.size) d[i] else 0
        val letter = (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
        if (letter || i == d.size) {
            // Run the previous command with the numbers collected so far.
            if (args.size > 0 || cmd == 90 || cmd == 122) {
                val rel = cmd >= 97
                val c = if (rel) cmd - 32 else cmd
                var k = 0
                val n = if (c == 77 || c == 76) 2 else if (c == 72 || c == 86) 1 else if (c == 67) 6 else if (c == 81) 4 else if (c == 65) 7 else 0
                if (c == 90) {
                    path.close()
                    cx = startX
                    cy = startY
                }
                while (n > 0 && k + n <= args.size) {
                    val bx = if (rel) cx else 0.0
                    val byv = if (rel) cy else 0.0
                    if (c == 77 || c == 76) {
                        val x = bx + args[k]
                        val y = byv + args[k + 1]
                        if (c == 77 && k == 0) {
                            path.moveTo(ox + x * sx, oy + y * sy)
                            startX = x
                            startY = y
                        } else path.lineTo(ox + x * sx, oy + y * sy)
                        cx = x
                        cy = y
                    } else if (c == 72) {
                        cx = (if (rel) cx else 0.0) + args[k]
                        path.lineTo(ox + cx * sx, oy + cy * sy)
                    } else if (c == 86) {
                        cy = (if (rel) cy else 0.0) + args[k]
                        path.lineTo(ox + cx * sx, oy + cy * sy)
                    } else if (c == 67) {
                        path.cubicTo(ox + (bx + args[k]) * sx, oy + (byv + args[k + 1]) * sy, ox + (bx + args[k + 2]) * sx, oy + (byv + args[k + 3]) * sy, ox + (bx + args[k + 4]) * sx, oy + (byv + args[k + 5]) * sy)
                        cx = bx + args[k + 4]
                        cy = byv + args[k + 5]
                    } else if (c == 81) {
                        path.quadTo(ox + (bx + args[k]) * sx, oy + (byv + args[k + 1]) * sy, ox + (bx + args[k + 2]) * sx, oy + (byv + args[k + 3]) * sy)
                        cx = bx + args[k + 2]
                        cy = byv + args[k + 3]
                    } else if (c == 65) {
                        val ex = bx + args[k + 5]
                        val ey = byv + args[k + 6]
                        oneSvgArc(path, cx, cy, args[k], args[k + 1], args[k + 3] != 0.0, args[k + 4] != 0.0, ex, ey, ox, oy, sx, sy)
                        cx = ex
                        cy = ey
                    }
                    k = k + n
                }
            }
            args.clear()
            if (letter) cmd = b
            i = i + 1
        } else if ((b >= 48 && b <= 57) || b == 45 || b == 46) {
            var j = i
            if (d[j] == 45) j = j + 1
            var seenDot = false
            while (j < d.size && ((d[j] >= 48 && d[j] <= 57) || (d[j] == 46 && !seenDot))) {
                if (d[j] == 46) seenDot = true
                j = j + 1
            }
            args.append(oneParseFloat(d.slice(i, j)))
            i = j
        } else i = i + 1
    }
    return
}

// Endpoint arc (SVG A) flattened to lines; rotation is not supported (icons
// use axis-aligned arcs).
fun oneSvgArc(var path: OnePath, x0: f64, y0: f64, rxIn: f64, ryIn: f64, large: bool, sweep: bool, x1: f64, y1: f64, ox: f64, oy: f64, sx: f64, sy: f64): void {
    var rx = if (rxIn < 0.0) -rxIn else rxIn
    var ry = if (ryIn < 0.0) -ryIn else ryIn
    if (rx == 0.0 || ry == 0.0) {
        path.lineTo(ox + x1 * sx, oy + y1 * sy)
        return
    }
    val dx = (x0 - x1) / 2.0
    val dy = (y0 - y1) / 2.0
    var lambda = (dx * dx) / (rx * rx) + (dy * dy) / (ry * ry)
    if (lambda > 1.0) {
        val s = oneSqrt(lambda)
        rx = rx * s
        ry = ry * s
    }
    var num = rx * rx * ry * ry - rx * rx * dy * dy - ry * ry * dx * dx
    if (num < 0.0) num = 0.0
    var coef = oneSqrt(num / (rx * rx * dy * dy + ry * ry * dx * dx))
    if (large == sweep) coef = -coef
    val cxp = coef * rx * dy / ry
    val cyp = -coef * ry * dx / rx
    val cx = cxp + (x0 + x1) / 2.0
    val cy = cyp + (y0 + y1) / 2.0
    val a0 = oneAtan2((dy - cyp) / ry, (dx - cxp) / rx)
    var delta = oneAtan2((-dy - cyp) / ry, (-dx - cxp) / rx) - a0
    if (sweep && delta < 0.0) delta = delta + 6.2831853
    if (!sweep && delta > 0.0) delta = delta - 6.2831853
    var i = 1
    while (i <= 16) {
        val a = a0 + delta * f64FromInt(i) / 16.0
        path.lineTo(ox + (cx + rx * oneCos(a)) * sx, oy + (cy + ry * oneSin(a)) * sy)
        i = i + 1
    }
    return
}

fun oneAtan2(y: f64, x: f64): f64 {
    if (x == 0.0 && y == 0.0) return 0.0
    val ax = if (x < 0.0) -x else x
    val ay = if (y < 0.0) -y else y
    val a = if (ax > ay) ay / ax else ax / ay
    val s = a * a
    var r = ((-0.0464964749 * s + 0.15931422) * s - 0.327622764) * s * a + a
    if (ay > ax) r = 1.57079637 - r
    if (x < 0.0) r = 3.14159274 - r
    if (y < 0.0) -r else r
}

// --- frames ----------------------------------------------------------------------------

// Icons by name: returns the SVG text (desktop reads files, tests embed them).
class OneIconSource(val load: (string) -> string)

fun oneRasterFrame(frame: OneFrame, background: string, icons: OneIconSource): OneSurface {
    var surface = oneSurface(frame.width, frame.height, oneColorValue(background))
    oneRasterInto(surface, frame, icons)
    surface
}

// One band of the frame (oneSurfaceBand): the paints that reach it.
fun oneRasterBand(frame: OneFrame, background: string, icons: OneIconSource, y0: int, rows: int): OneSurface {
    var surface = oneSurfaceBand(frame.width, frame.height, y0, rows, oneColorValue(background))
    oneRasterInto(surface, frame, icons)
    surface
}

// How far a paint may draw past its box (text: descenders, side bearings).
fun onePaintReach(p: OnePaint): int = if (p.op == "text") p.h / 4 + 2 else 0

// Whether a paint can draw in the rectangle; clips always count.
fun onePaintReaches(p: OnePaint, left: int, top: int, right: int, bottom: int): bool {
    if (p.op == "clip" || p.op == "unclip") return true
    val reach = onePaintReach(p)
    p.y - reach < bottom && p.y + p.h + reach > top && p.x - reach < right && p.x + p.w + reach > left
}

fun oneRasterInto(var surface: OneSurface, frame: OneFrame, icons: OneIconSource): void {
    val left = surface.clipLeft
    val top = surface.clipTop
    val right = surface.clipRight
    val bottom = surface.clipBottom
    for (p in frame.paints) {
        if (!onePaintReaches(p, left, top, right, bottom)) {
        } else if (p.op == "rect") {
            var path = onePath()
            oneRoundRectPath(f64FromInt(p.x), f64FromInt(p.y), f64FromInt(p.w), f64FromInt(p.h), f64FromInt(p.radius), path)
            oneFill(surface, path, oneColorValue(p.color), oneColorAlpha(p.color))
        } else if (p.op == "border") {
            val sides = oneNumbers(p.sides)
            val color = oneColorValue(p.color)
            val alpha = oneColorAlpha(if (p.color == "") "#dddddd" else p.color)
            if (sides.size == 4 && sides[0] == sides[1] && sides[1] == sides[2] && sides[2] == sides[3] && sides[0] > 0.0) {
                // Outer shape minus inner shape (wound the other way).
                var path = onePath()
                oneRoundRectPath(f64FromInt(p.x), f64FromInt(p.y), f64FromInt(p.w), f64FromInt(p.h), f64FromInt(p.radius), path)
                var inner = onePath()
                val t = sides[0]
                oneRoundRectPath(f64FromInt(p.x) + t, f64FromInt(p.y) + t, f64FromInt(p.w) - 2.0 * t, f64FromInt(p.h) - 2.0 * t, f64FromInt(p.radius) - t, inner)
                inner.close()
                var start = 0
                for (end in inner.ends) {
                    var k = end - 1
                    path.moveTo(inner.xs[k], inner.ys[k])
                    k = k - 1
                    while (k >= start) {
                        path.lineTo(inner.xs[k], inner.ys[k])
                        k = k - 1
                    }
                    start = end
                }
                oneFill(surface, path, color, alpha)
            } else if (sides.size == 4) {
                if (sides[0] > 0.0) oneFillRect(surface, p.x, p.y, p.w, f64ToInt(sides[0]), color, alpha)
                if (sides[2] > 0.0) oneFillRect(surface, p.x, p.y + p.h - f64ToInt(sides[2]), p.w, f64ToInt(sides[2]), color, alpha)
                if (sides[3] > 0.0) oneFillRect(surface, p.x, p.y, f64ToInt(sides[3]), p.h, color, alpha)
                if (sides[1] > 0.0) oneFillRect(surface, p.x + p.w - f64ToInt(sides[1]), p.y, f64ToInt(sides[1]), p.h, color, alpha)
            }
        } else if (p.op == "text") oneDrawText(surface, p.text, p.x, p.y, p.h, p.size, p.weight, if (p.color == "") "#111111" else p.color)
        else if (p.op == "icon") {
            val svg = icons.load(p.text)
            if (svg != "") oneDrawSvg(surface, svg, p.x, p.y, p.w, p.h, if (p.color == "") "#111111" else p.color)
        } else if (p.op == "image") {
            val svg = if (p.text.size > 0 && p.text[0] != 47 && p.text[0] != 46 && !oneStarts(p.text, "http")) icons.load(p.text) else ""
            if (svg != "") oneDrawSvgColors(surface, svg, p.x, p.y, p.w, p.h)
        } else if (p.op == "clip") surface.pushClip(p.x, p.y, p.w, p.h)
        else if (p.op == "unclip") surface.popClip()
    }
    return
}

fun oneStarts(text: string, prefix: string): bool = text.size >= prefix.size && text.slice(0, prefix.size) == prefix

// SVG images in their own colours (logos): fill and stroke colours from the file.
fun oneDrawSvgColors(var surface: OneSurface, svg: string, x: int, y: int, w: int, h: int): void {
    val parts = oneNumbers(oneSvgAttr(svg, "viewBox"))
    if (parts.size < 4) return
    val s = if (f64FromInt(w) / parts[2] < f64FromInt(h) / parts[3]) f64FromInt(w) / parts[2] else f64FromInt(h) / parts[3]
    val ox = f64FromInt(x) + (f64FromInt(w) - parts[2] * s) / 2.0 - parts[0] * s
    val oy = f64FromInt(y) + (f64FromInt(h) - parts[3] * s) / 2.0 - parts[1] * s
    var at = 0
    while (true) {
        val next = oneFind(svg, "<path", at)
        if (next < 0) return
        val end = oneFind(svg, "/>", next)
        val element = svg.slice(next, if (end < 0) svg.size else end)
        at = if (end < 0) svg.size else end
        // Group transforms (rotate) aren't supported; marks use plain paths.
        var path = onePath()
        oneSvgPath(oneSvgAttr(element, "d"), path, ox, oy, s, s)
        val stroke = oneSvgAttr(element, "stroke")
        val fill = oneSvgAttr(element, "fill")
        if (stroke != "" && stroke != "none") {
            val widths = oneNumbers(oneSvgAttr(element, "stroke-width"))
            oneStroke(surface, path, (if (widths.size > 0) widths[0] else 1.0) * s, oneColorValue(stroke), 255)
        }
        if (fill != "" && fill != "none") oneFill(surface, path, oneColorValue(fill), 255)
    }
    return
}

fun oneFillRect(var surface: OneSurface, x: int, y: int, w: int, h: int, color: int, alpha: int): void {
    val left = if (x > surface.clipX0()) x else surface.clipX0()
    val right = if (x + w < surface.clipX1()) x + w else surface.clipX1()
    val bottom = if (y + h < surface.clipY1()) y + h else surface.clipY1()
    var j = if (y > surface.clipY0()) y else surface.clipY0()
    while (j < bottom) {
        var i = left
        if (alpha >= 255) {
            // Opaque: straight into the row.
            val row = (j - surface.originY) * surface.width
            while (i < right) {
                surface.pixels[row + i] = color
                i = i + 1
            }
        } else {
            while (i < right) {
                surface.blend(i, j, color, alpha)
                i = i + 1
            }
        }
        j = j + 1
    }
    return
}

// --- PNG -----------------------------------------------------------------------------------

val oneCrcTable: array<int> = []

fun oneCrc(data: ByteBuffer, from: int, to: int): int {
    if (oneCrcTable.size == 0) {
        var n = 0
        while (n < 256) {
            var c = n
            var k = 0
            while (k < 8) {
                c = if (c % 2 == 1) 3988292384 ^ (c / 2) else c / 2
                k = k + 1
            }
            oneCrcTable.append(c)
            n = n + 1
        }
    }
    var crc = 4294967295
    var i = from
    while (i < to) {
        crc = oneCrcTable[(crc ^ data.byteAt(i)) % 256] ^ (crc / 256)
        i = i + 1
    }
    crc ^ 4294967295
}

fun oneBe32(var out: ByteBuffer, value: int): void {
    out.appendByteValue((value / 16777216) % 256)
    out.appendByteValue((value / 65536) % 256)
    out.appendByteValue((value / 256) % 256)
    out.appendByteValue(value % 256)
    return
}

fun onePngChunk(var out: ByteBuffer, kind: string, var data: ByteBuffer): void {
    oneBe32(out, data.size())
    var chunk = byteBuffer()
    chunk.appendText(kind)
    chunk.appendBuffer(data)
    out.appendBuffer(chunk)
    oneBe32(out, oneCrc(chunk, 0, chunk.size()))
    return
}

// An uncompressed (stored deflate) RGB PNG; for snapshots and previews.
fun oneSurfacePng(surface: OneSurface): string {
    var out = byteBuffer()
    for (b in [137, 80, 78, 71, 13, 10, 26, 10]) out.appendByteValue(b)
    var header = byteBuffer()
    oneBe32(header, surface.width)
    oneBe32(header, surface.height)
    for (b in [8, 2, 0, 0, 0]) header.appendByteValue(b)
    onePngChunk(out, "IHDR", header)
    var raw = byteBuffer()
    var y = 0
    while (y < surface.height) {
        raw.appendByteValue(0)
        var x = 0
        while (x < surface.width) {
            val c = surface.pixels[y * surface.width + x]
            raw.appendByteValue((c / 65536) % 256)
            raw.appendByteValue((c / 256) % 256)
            raw.appendByteValue(c % 256)
            x = x + 1
        }
        y = y + 1
    }
    var z = byteBuffer()
    z.appendByteValue(120)
    z.appendByteValue(1)
    var a = 1
    var b = 0
    var offset = 0
    val total = raw.size()
    while (offset < total || offset == 0) {
        val size = if (total - offset > 65535) 65535 else total - offset
        z.appendByteValue(if (offset + size >= total) 1 else 0)
        z.appendByteValue(size % 256)
        z.appendByteValue(size / 256)
        z.appendByteValue((65535 - size) % 256)
        z.appendByteValue((65535 - size) / 256)
        var i = 0
        while (i < size) {
            val v = raw.byteAt(offset + i)
            z.appendByteValue(v)
            a = (a + v) % 65521
            b = (b + a) % 65521
            i = i + 1
        }
        offset = offset + size
        if (total == 0) offset = 1
    }
    oneBe32(z, b * 65536 + a)
    onePngChunk(out, "IDAT", z)
    var empty = byteBuffer()
    onePngChunk(out, "IEND", empty)
    out.toText()
}
