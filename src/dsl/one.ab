import "abla/compiler/parser"
import "runtime.ab"
import "../../../abla-ui/src/grammar.ab"

// `$one`: XML-like component syntax (SPEC §5). A template is one element; it
// compiles to ordinary calls (column, text, pressable, button, ...) and needs a
// `ui: Ui` in scope, which handlers register with.
//
//   $one
//     <Pressable onPress={ count += 1 } paddingX=16 height=68 gap=12
//                pressed:background=@surface-pressed web:hover:background=@surface-alt>
//       <Text text="title-sm" maxLines=1>Count {count}</Text>
//     </Pressable>
//
// Attributes are style properties unless the element takes them as data
// (label, key, value, ...). A prefix scopes a property to a target or a state:
// `android:radius=14`, `pressed:background=@x`, `web:hover:background=@y`.
// Values: "text", numbers, @tokens, bare words, or {Abla expressions}.
// `on*={...}` handlers hold statements separated by `;`; onChange receives
// `value`. Capitalised tags that aren't built in call the function of that
// name with `ui`, the attribute values in order, and the children (if any).
// <If cond={...}>…</If> <Else>…</Else> and <For each={xs} as="x">…</For>
// control what is rendered.
//
// The grammar is abla-ui's (src/grammar.ab, shared with its `$ui`); this file is $one's element
// table: its tags, what each compiles to, and its runtime helpers (runtime.ab).

compile val oneTagLanguage = TagLanguage("one", true, false, ["pressed", "hover", "focus", "disabled", "selected", "checked"], oneDslTextual, oneDslBuild)

compile fun oneDslContainer(tag: string): bool =
    tag == "Column" || tag == "Row" || tag == "Stack" || tag == "Scroll" || tag == "Pressable"

compile fun oneDslTextual(tag: string): bool =
    tag == "Text" || tag == "Button" || tag == "Badge" || tag == "Chip"

compile fun oneDslBuiltin(tag: string): bool =
    oneDslContainer(tag) || oneDslTextual(tag) || tag == "Icon" || tag == "Image" || tag == "Input" ||
    tag == "Spacer" || tag == "Divider" || tag == "Avatar" || tag == "If" || tag == "Else" || tag == "For"

// Attributes the element keeps as data (node attributes or call arguments).
// Attributes the element keeps as data (node attributes or call arguments).
compile fun oneDslData(tag: string, name: string): bool {
    if (name == "key" || name == "label" || name == "selected" || name == "enabled" || name == "item" || name == "style") return true
    when (tag) {
        "Icon" -> name == "name"
        "Image" -> name == "src" || name == "authorization" || name == "fallback"
        "Input" -> name == "value" || name == "placeholder" || name == "keyboard" || name == "multiline" || name == "secure" || name == "maxLength" || name == "onChange" || name == "onSubmit" || name == "submitName"
        "Pressable" -> name == "onPress"
        "Spacer" -> name == "amount"
        "Button" -> name == "variant" || name == "onPress"
        "Chip" -> name == "onPress"
        "Badge" -> name == "variant"
        "Avatar" -> name == "name" || name == "seed" || name == "diameter" || name == "photo"
        "If" -> name == "cond"
        "For" -> name == "each" || name == "as"
        else -> false
    }
}

compile fun oneDslStyle(lang: TagLanguage, cursor: ParserCursor, tag: string, var a: TagAttributes): SyntaxExpression {
    var result = tagValue(a, "style", syntaxCall("style", []))
    var i = 0
    while (i < a.names.size) {
        val name = a.names[i]
        if (!oneDslData(tag, name)) {
            if (a.kinds[i] == "action") parserFail(cursor, "$tag doesn't handle $name")
            val p = tagProperty(lang, name)
            // Only a program that writes it pays for wrapping rows, as with `Style.wrap`.
            if (p.property == "wrap") result = syntaxCall("oneStyleWrapping", [result])
            result = syntaxCall("oneStyleSet", [result, syntaxString(p.target), syntaxString(p.state), syntaxString(p.property), tagString(lang, a, i)])
        }
        i = i + 1
    }
    result
}

// Node attributes kept on the element (label, selected, keyboard, ...).
compile fun oneDslNodeAttributes(lang: TagLanguage, tag: string, node: SyntaxExpression, var a: TagAttributes): SyntaxExpression {
    var result = node
    var i = 0
    while (i < a.names.size) {
        val name = a.names[i]
        if (name == "key") result = syntaxCall("oneKey", [result, tagString(lang, a, i)])
        else if (name == "label" || name == "selected" || name == "enabled" || name == "item" ||
            (tag == "Input" && (name == "keyboard" || name == "multiline" || name == "secure" || name == "maxLength" || name == "submitName")) ||
            (tag == "Image" && (name == "authorization" || name == "fallback")))
            result = syntaxCall("oneAttrSet", [result, syntaxString(name), tagString(lang, a, i)])
        i = i + 1
    }
    result
}

compile fun oneDslPress(var a: TagAttributes, name: string): SyntaxExpression {
    val i = tagIndex(a, name)
    if (i < 0) syntaxInteger(0) else syntaxCall("onePress", [syntaxIdentifier("ui"), a.values[i]])
}

compile fun oneDslBuild(lang: TagLanguage, cursor: ParserCursor, tag: string, var a: TagAttributes, content: SyntaxExpression, children: array<SyntaxExpression>): SyntaxExpression {
    val styled = oneDslStyle(lang, cursor, tag, a)
    var node = when (tag) {
        "Column" -> syntaxCall("column", [styled, syntaxArray(children)])
        "Row" -> syntaxCall("row", [styled, syntaxArray(children)])
        "Stack" -> syntaxCall("stack", [styled, syntaxArray(children)])
        "Scroll" -> syntaxCall("scroll", [styled, syntaxArray(children)])
        "ScrollRow" -> syntaxCall("scrollRow", [styled, syntaxArray(children)])
        "Pressable" -> syntaxCall("pressable", [oneDslPress(a, "onPress"), styled, syntaxArray(children)])
        "Text" -> syntaxCall("text", [content, styled])
        "Icon" -> syntaxCall("icon", [tagText(lang, a, "name", ""), tagText(lang, a, "label", ""), styled])
        "Image" -> syntaxCall("image", [tagText(lang, a, "src", ""), tagText(lang, a, "label", ""), styled])
        "Input" -> syntaxCall("input", [tagValue(a, "value", syntaxString("")), tagText(lang, a, "placeholder", ""),
            if (tagIndex(a, "onChange") >= 0) syntaxCall("oneChange", [syntaxIdentifier("ui"), tagValue(a, "onChange", syntaxNull())]) else syntaxInteger(0), styled])
        "Spacer" -> syntaxCall("spacer", [tagValue(a, "amount", syntaxInteger(0))])
        "Divider" -> syntaxCall("divider", [styled])
        "Button" -> syntaxCall("button", [syntaxIdentifier("ui"), content, tagText(lang, a, "variant", "primary"), oneDslPress(a, "onPress"), styled])
        "Chip" -> syntaxCall("chip", [syntaxIdentifier("ui"), content, tagValue(a, "selected", syntaxBoolean(false)), oneDslPress(a, "onPress")])
        "Badge" -> syntaxCall("badge", [syntaxIdentifier("ui"), content, tagText(lang, a, "variant", "")])
        "Avatar" -> syntaxCall("avatar", [syntaxIdentifier("ui"), tagText(lang, a, "name", ""), tagText(lang, a, "seed", ""), tagValue(a, "diameter", syntaxInteger(40)), tagValue(a, "photo", syntaxCall("none", []))])
        else -> {
            // A user component: Name(ui, attributes in order, children).
            val arguments: array<SyntaxExpression> = [syntaxIdentifier("ui")]
            var i = 0
            while (i < a.names.size) {
                arguments.append(if (a.kinds[i] == "action") syntaxCall("onePress", [syntaxIdentifier("ui"), a.values[i]]) else a.values[i])
                i = i + 1
            }
            if (children.size > 0) arguments.append(syntaxArray(children))
            syntaxCall(tag, arguments)
        }
    }
    if (oneDslBuiltin(tag)) node = oneDslNodeAttributes(lang, tag, node, a)
    if (tag == "Input" && tagIndex(a, "onSubmit") >= 0) node = syntaxCall("oneAttrSet", [node, syntaxString("onSubmit"), syntaxCall("oneString", [oneDslPress(a, "onSubmit")])])
    node
}

compile fun oneDslParse(cursor: ParserCursor): SyntaxExpression = tagElement(oneTagLanguage, cursor)

#compilerRegisterSubparser("one", oneDslParse)
