// abla-ui is checked out beside abla-one and reached by relative path, as NovaKind's pinned
// build reaches every library (its toolchain/sibling-revisions names the commit).
export import "../../../abla-ui/src/revision.ab"

// Reactive state is abla-ui's plain State (https://github.com/AndreBaltazar8/abla-ui,
// src/revision.ab): application state lives in ordinary classes whose properties are delegated
// to it, `var query: string by State("")`. A write that changes the value moves the global
// revision, which the run loop uses to decide whether to render again; a read is a load of the
// value. (abla-ui's Tracked, which re-renders a component by what it read, is not used: abla-one
// renders on the revision.)

fun oneRevision(): int = stateRevision()

// Marks the app dirty after an in-place change the State delegate can't see,
// such as appending to an array held in state.
fun oneInvalidate(): void {
    stateTouchAll()
    return
}
