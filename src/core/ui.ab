import "abla/json"
import "theme.ab"
import "node.ab"
import "routes.ab"
import "state.ab"

val oneChangeBase = 1000000

// The render context. Event ids are handed out in render order. Handlers are
// never stored: to deliver an event the run loop renders again in dispatch
// mode, and the handler whose id matches runs right there. That lets handlers
// be ordinary FnMut closures that call any method of the app, which the
// language doesn't allow to be kept in arrays. Ids match the tree on screen
// because the run loop only dispatches events from the current revision.
class Ui(
    val target: string,
    val theme: Theme,
    // The viewport width in logical pixels, 0 when unknown (render for a phone).
    val width: int,
    val dispatchId: int,
    val dispatchValue: string,
    var presses: int,
    var changes: int,
    var handled: bool
) {
    fun press(var handler: FnMut() -> void): int {
        presses = presses + 1
        if (!handled && presses == dispatchId) {
            handled = true
            handler()
        }
        presses
    }
    fun change(var handler: FnMut(string) -> void): int {
        changes = changes + 1
        val id = oneChangeBase + changes
        if (!handled && id == dispatchId) {
            handled = true
            handler(dispatchValue)
        }
        id
    }
    // A press held down: `handler(true)` when it goes down on the control, and
    // `handler(false)` when it's let go, wherever the pointer is then. Only
    // the desktop delivers it (a target without it never calls the handler);
    // its id is a change's, with the value "down" or "up".
    fun hold(var handler: FnMut(bool) -> void): int {
        changes = changes + 1
        val id = oneChangeBase + changes
        if (!handled && id == dispatchId) {
            handled = true
            handler(dispatchValue == "down")
        }
        id
    }
    // Fine-grained invalidation: `build` runs only when `deps` (a summary of
    // what the subtree reads, such as "${message.id}|${message.edited}")
    // differs from the last render, or when the event being delivered
    // belongs to the subtree. Otherwise the previous subtree is reused and its
    // event ids are skipped over, so ids stay those of a full render. On the
    // web, a reused subtree also reuses its HTML. `key` names the subtree
    // among the app's memos (a message id, "header").
    fun memo(key: string, deps: string, var build: FnMut() -> Node): Node {
        val found = oneMemoFind(key)
        if (found >= 0) {
            val entry = oneMemoEntries[found]
            val same = entry.deps == deps && entry.pressStart == presses && entry.changeStart == changes && entry.target == target && entry.width == width
            val inside = (dispatchId > presses && dispatchId <= presses + entry.pressCount) ||
                (dispatchId > oneChangeBase + changes && dispatchId <= oneChangeBase + changes + entry.changeCount)
            if (same && !(inside && !handled)) {
                presses = presses + entry.pressCount
                changes = changes + entry.changeCount
                return entry.node
            }
        }
        val pressStart = presses
        val changeStart = changes
        val built = build().set("memo", "$key|${oneMemoBuilds}")
        oneMemoBuilds = oneMemoBuilds + 1
        // Only what a plain render produced is kept: a dispatch render runs a
        // handler part-way through and may mix old and new state.
        if (dispatchId == 0) oneMemoStore(key, OneMemo(deps, target, width, pressStart, changeStart, presses - pressStart, changes - changeStart, built))
        built
    }
    fun named(name: string): Style = theme.named(name)
    // A component's own style for one of its parts, which the app's theme can
    // extend or override by defining "<component>.<part>".
    fun part(component: string, part: string, defaults: Style): Style =
        defaults.set("part", if (part == "") component else "$component.$part")
}

fun oneUi(target: string, theme: Theme): Ui = Ui(target, theme, 0, 0, "", 0, 0, false)
fun oneUiSized(target: string, theme: Theme, width: int): Ui {
    oneViewportWidth = width
    Ui(target, theme, width, 0, "", 0, 0, false)
}

// Memos of the current scope (`oneMemoScope`: a live session's id, or "" in
// apps with one tree). Each entry remembers the event ids its subtree took.
class OneMemo(val deps: string, val target: string, val width: int, val pressStart: int, val changeStart: int, val pressCount: int, val changeCount: int, val node: Node)

var oneMemoScope = ""
var oneMemoBuilds = 0
val oneMemoKeys: array<string> = []
val oneMemoEntries: array<OneMemo> = []

fun oneMemoFind(key: string): int {
    val full = "$oneMemoScope::$key"
    var i = 0
    while (i < oneMemoKeys.size) {
        if (oneMemoKeys[i] == full) return i
        i = i + 1
    }
    -1
}

fun oneMemoStore(key: string, entry: OneMemo): void {
    val found = oneMemoFind(key)
    if (found >= 0) {
        oneMemoEntries[found] = entry
        return
    }
    // Bounded: the oldest entries go first.
    if (oneMemoKeys.size >= 4096) oneMemoForget("")
    oneMemoKeys.append("$oneMemoScope::$key")
    oneMemoEntries.append(entry)
    return
}

// Drops a scope's memos (an ended session); "" drops the oldest half.
fun oneMemoForget(scope: string): void {
    val keys: array<string> = []
    val entries: array<OneMemo> = []
    var i = 0
    while (i < oneMemoKeys.size) {
        val keep = if (scope == "") i >= oneMemoKeys.size / 2 else !oneMemoKeys[i].startsWith("$scope::")
        if (keep) {
            keys.append(oneMemoKeys[i])
            entries.append(oneMemoEntries[i])
        }
        i = i + 1
    }
    oneMemoKeys.clear()
    oneMemoEntries.clear()
    for (k in keys) oneMemoKeys.append(k)
    for (e in entries) oneMemoEntries.append(e)
    return
}

// What every Abla One application implements. `receive` gets platform
// completions (HTTP responses, opened links, visibility, picked files).
interface OneApp {
    fun render(var ui: Ui): Node
    fun receive(kind: string, value: string): void
}

// Tells the app about moves between routes. What it does in response can move
// again (a redirect), so this runs until there are none, within reason. Whether
// there were any; a plain field may have changed, so the next render must not be skipped.
fun oneRoutesDrain(var app: OneApp, var routes: OneRoutes): bool {
    var moved = false
    var rounds = 0
    while (rounds < 16 && routes.pending.size > 0) {
        for (path in routes.takePending()) app.receive("route", path)
        moved = true
        rounds = rounds + 1
    }
    if (moved) oneInvalidate()
    moved
}

// What a tree says about its route to whoever shows it: which entry it belongs to
// (scroll positions go with it) and whether the system's back button is the app's.
fun oneRouteStamp(root: Node, routes: OneRoutes): Node =
    root.setInt("one.entry", routes.entry()).set("one.back", if (routes.canGoBack()) "true" else "false")

// Delivers one event by rendering in dispatch mode. Returns whether a handler
// with that id was found. The returned tree is discarded by callers.
fun oneDispatch(var app: OneApp, target: string, theme: Theme, event: int, value: string, width: int = 0): bool {
    if (event <= 0) return false
    var ui = Ui(target, theme, width, event, value, 0, 0, false)
    app.render(ui)
    ui.handled
}

// What kind of event a place holds: what's after its "#".
fun oneEventPlaceKind(place: string): string {
    var i = place.size - 1
    while (i >= 0 && place[i] != 35) i = i - 1
    place.slice(i + 1, place.size)
}

// Where each event id of a rendered tree lives: "<key path>#<event>", with a
// node's key at each level, or for unkeyed nodes their kind and position
// among siblings of that kind (so inserting a button doesn't move an input). An event that arrives from a slightly
// older tree is translated to the id at the same place in the current tree,
// so a tap that races a re-render (a poll, a completion) is not lost. Keyed
// list rows keep their place when other rows come and go. The control there must
// still say what it said (`says`) and be enabled: a press was made for what the person
// read, so on another control or another amount it's dropped.
//
// Across a move to another route an id is translated only when nothing the person reads changed
// (`screen`), or for a field the app says is the same field on both (`Node.sameField`).
class OneEventMap(val byId: Map<int, string>, val byPlace: Map<string, int>, val says: Map<string, string>, val fieldIds: Map<string, int>, val fieldOf: Map<int, string>, var screen: int) {
    fun translate(older: OneEventMap, id: int): int {
        val place = older.byId.get(id)
        if (place == null) return 0
        val current = byPlace.get(place)
        if (current != null && says.get(place) == older.says.get(place)) return current
        moved(older, place)
    }
    // The same control somewhere else: a new width lays a screen out differently, and the first render
    // of a page doesn't know its width. It has to be the only one saying that, in both trees.
    fun moved(older: OneEventMap, place: string): int {
        val said = older.says.get(place) ?? ""
        if (said == "") return 0
        val kind = oneEventPlaceKind(place)
        if (older.saying(said, kind).size != 1) return 0
        val here = saying(said, kind)
        if (here.size != 1) return 0
        byPlace.get(here[0]) ?? 0
    }
    fun saying(said: string, kind: string): array<string> {
        val found: array<string> = []
        for (place in byPlace.keys()) if (says.get(place) == said && oneEventPlaceKind(place) == kind) found.append(place)
        found
    }
    fun same(other: OneEventMap): bool {
        val places = byPlace.keys()
        if (places.size != other.byPlace.keys().size) return false
        for (place in places) if (byPlace.get(place) != other.byPlace.get(place) || says.get(place) != other.says.get(place)) return false
        true
    }
}

fun oneEventMap(root: Node): OneEventMap {
    var map = OneEventMap(Map(), Map(), Map(), Map(), Map(), 0)
    oneCollectEvents(root, "r", map)
    map.screen = oneEventScreen(root, 7)
    map
}

// The id in the newest of `maps` for an event made `age` renders ago, or 0 for nowhere. `moved`: a
// move to another route happened since.
fun oneEventLanding(maps: array<OneEventMap>, age: int, id: int, moved: bool): int {
    if (age < 0 || age >= maps.size) return 0
    val current = maps[maps.size - 1]
    val older = maps[maps.size - 1 - age]
    if (moved && older.screen != current.screen) {
        val field = older.fieldOf.get(id)
        return if (field != null) current.fieldIds.get(field) ?? 0 else 0
    }
    if (age == 0) return if (current.byId.has(id)) id else 0
    current.translate(older, id)
}

// A press that lands nowhere is lost, and the person can't tell from the screen: the app hears `receive("pressLost", "")`, to say
// so as it likes. Not the second of a double press, whose first did land: nobody wanted that one to do more.
class OnePresses(var shown: int, var id: int) {
    fun landed(revision: int, press: int): void {
        shown = revision
        id = press
        return
    }
    fun lost(var app: OneApp, revision: int, press: int): bool {
        if (press > oneChangeBase || (revision == shown && press == id)) return false
        app.receive("pressLost", "")
        true
    }
}

fun onePresses(): OnePresses = OnePresses(-1, 0)

// Keeps the last `most`, oldest out first.
fun oneEventMapsBound(var maps: array<OneEventMap>, most: int): void {
    if (maps.size <= most) return
    val kept: array<OneEventMap> = []
    var i = maps.size - most
    while (i < maps.size) {
        kept.append(maps[i])
        i = i + 1
    }
    maps.clear()
    for (item in kept) maps.append(item)
    return
}

fun oneEventMix(hash: int, text: string): int {
    var h = (hash ^ text.size) * 1099511628211
    for (b in text) h = (h ^ b) * 1099511628211
    h
}

// What a screen says, as `oneEventSays` for a control: a field's value doesn't count.
fun oneEventScreen(node: Node, hash: int): int {
    var h = oneEventMix(oneEventMix(hash, node.kind), node.key)
    for (name in ["text", "label", "name", "placeholder", "runs", "src", "cells"]) {
        if (node.has(name)) h = oneEventMix(h, node.attr(name))
    }
    if (node.attr("submitName") != "") h = oneEventMix(h, node.attr("submitName"))
    for (child in node.children) h = oneEventScreen(child, h)
    h
}

// What a control shows: its kind and the text and icons in it, not a field's value.
fun oneEventSays(node: Node): string {
    var out = "${node.kind}|${node.attr("text")}|${node.attr("label")}|${node.attr("name")}|${node.attr("placeholder")}|${node.attr("runs")}"
    for (child in node.children) out = "$out/${oneEventSays(child)}"
    out
}

fun oneCollectEvents(node: Node, place: string, var map: OneEventMap): void {
    for (item in node.attrs) {
        if (item.name == "onPress" || item.name == "onChange" || item.name == "onSubmit" || item.name == "onVisible" || item.name == "onDismiss") {
            val id = oneParseInt(item.value, 0)
            if (id > 0 && node.attr("enabled") != "false") {
                map.byId.set(id, "$place#${item.name}")
                map.byPlace.set("$place#${item.name}", id)
                // What's read on a feed changes all the time, and reporting what's in view commits to nothing.
                map.says.set("$place#${item.name}", if (item.name == "onVisible") "" else if (item.name == "onSubmit" && node.attr("submitName") != "")
                    "onSubmit:"+jsonStringify(jsonArray([jsonString(oneEventSays(node)),jsonString(node.attr("submitName"))])) else oneEventSays(node))
                if (item.name == "onChange" && node.has("sameField")) {
                    map.fieldIds.set(node.attr("sameField"), id)
                    map.fieldOf.set(id, node.attr("sameField"))
                }
            }
        }
    }
    val seen: Map<string, int> = Map()
    for (child in node.children) {
        val count = seen.get(child.kind)
        val n = if (count != null) count else 0
        seen.set(child.kind, n + 1)
        oneCollectEvents(child, "$place/${if (child.key != "") "k:${child.key}" else "${child.kind}$n"}", map)
    }
    return
}
