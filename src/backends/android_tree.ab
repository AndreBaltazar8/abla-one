import "abla/json"
import "../../../abla-mobile/src/ui.ab"
import "../one.ab"

// Encoding for the `android` target. Resolved trees are sent to the
// abla-mobile host as `one.*` nodes and drawn by its generic OneRenderer
// (Compose). Style keys go through unchanged ("gap", "pressed:background");
// node attributes are prefixed with "a." so they can't collide with style
// properties. Sibling keys are the node's key or its index; `key` is the
// fallback, so a keyed root keeps its key and a new one starts a new screen,
// with fresh scroll positions and fields.

fun oneAndroidNode(node: Node, outer: Theme, key: string): MobileNode =
    oneMobileNode(node, outer, key, "android")

// One scalar-stream semantic tree is shared by Compose and SwiftUI; only style
// resolution uses the actual target. Android's public entry remains unchanged.
fun oneMobileNode(node: Node, outer: Theme, key: string, target: string): MobileNode {
    val theme = if (node.attr("theme") != "") outer.scoped(node.attr("theme")) else outer
    val resolved = oneResolve(theme, node.kind, node.style, target)
    val keys: array<string> = []
    val values: array<Json> = []
    for (name in resolved.props.keys()) {
        keys.append(name)
        values.append(jsonString(resolved.get(name)))
    }
    for (item in node.attrs) {
        keys.append("a.${item.name}")
        values.append(jsonString(item.value))
    }
    val children: array<MobileNode> = []
    var index = 0
    for (child in node.children) {
        children.append(oneMobileNode(child, theme, if (child.key != "") child.key else "$index", target))
        index = index + 1
    }
    MobileNode("one.${node.kind}", if (node.key != "") node.key else key, jsonObject(keys, values), children)
}

