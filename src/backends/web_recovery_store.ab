import "abla/http"
import "abla/json"
import "web_recovery.ab"

// Adapters distinguish unavailable (503), absent/expired (404), unauthorized
// (403) and fenced/version-conflicting (409). No failure is a fresh session.
class OneRecoveryResult(val status: int, val epoch: int = 0, val version: int = 0, val payload: string = "", val cookies: array<string> = [], val cookiesReady: bool = false)
class OneRecoveryCompletion(val id: string, val payload: string)
class OneRecoveryInbox(val status: int, val items: array<OneRecoveryCompletion> = [])
class OneRecoveryFileJob(val request: int, val handle: string, val offset: int, val length: int, val deleting: bool, var admitted: bool = false, var retryAt: int = 0)

// A frozen candidate survives a pending/uncertain adapter result. New edits
// may continue in memory, but cannot be mistaken for this candidate's commit.
class OneRecoveryWrite(
    val generation: int, val frontier: int, val payload: string,
    val patch: string, val outbox: array<string>, val cookies: bool,
    val consumed: array<string>, val activity: int, val active: bool
)

// The SDK never picks a database, key or bucket. Applications supply bounded
// authenticated persistence and off-path blob IO. The save CAS must atomically
// consume only the inbox IDs represented by its checkpoint. Reads leave inbox
// rows available until that CAS, so death between delivery and save loses none.
class OneLiveRecoveryStore(
    val enabled: bool,
    val create: (HttpRequest, string, string, string, string) -> OneRecoveryResult,
    val attach: (HttpRequest, string, string, string) -> OneRecoveryResult,
    val inspect: (HttpRequest, string, string) -> OneRecoveryResult,
    val save: (string, string, int, int, string, bool, array<string>) -> OneRecoveryResult,
    val fence: (string, string, int) -> int,
    val end: (string, string, int) -> int,
    val inbox: (string, string, int, array<int>) -> OneRecoveryInbox,
    // Claims an upload's HTTP ticket; the application answers it from its
    // off-path worker. False rejects it with503, never a node-local fallback.
    val upload: (HttpRequest, int) -> bool,
    // Accepted jobs complete through inbox, not by blocking the live loop on
    // object storage. Handles are scoped to session and fenced owner epoch.
    val readFile: (string, string, int, int, string, int, int) -> int,
    val deleteFile: (string, string, int, int, string) -> int
)

fun oneLiveNoRecovery(): OneLiveRecoveryStore = OneLiveRecoveryStore(false,
    { request, id, proof, owner, body -> OneRecoveryResult(503) },
    { request, id, proof, owner -> OneRecoveryResult(503) },
    { request, id, proof -> OneRecoveryResult(503) },
    { id, owner, epoch, version, body, active, consumed -> OneRecoveryResult(503) },
    { id, owner, epoch -> 503 }, { id, owner, epoch -> 503 },
    { id, owner, epoch, requests -> OneRecoveryInbox(503) },
    { request, ticket -> false },
    { id, owner, epoch, request, handle, offset, length -> 503 },
    { id, owner, epoch, request, handle -> 503 })

class OneRecoveryState(
    val id: string,
    val proof: string,
    val owner: string,
    val store: OneLiveRecoveryStore,
    var epoch: int = 0,
    var version: int = 0,
    val batch: OneRecoveryBatch = OneRecoveryBatch(),
    var draft: Json = jsonNull(),
    var captured: bool = false,
    var restored: bool = false,
    var ready: bool = false,
    var checkedAt: int = -1000,
    var status: int = 200,
    val consumed: array<string> = [],
    var inboxAt: int = -1000,
    var active: bool = true,
    val pickers: Map<int, string> = Map(),
    val files: Map<int, OneRecoveryFileJob> = Map(),
    val hydrationFiles: Map<int, bool> = Map(),
    val effects: Map<string, string> = Map(),
    val effectOrder: array<string> = [],
    var prepared: OneRecoveryWrite? = null,
    var activitySerial: int = 0,
    var committedActivity: int = -1,
    var initialPayload: string = "",
    var pendingPage: bool = false,
    var inboxPending: bool = false,
    val pageCookies: array<string> = [],
    var ending: bool = false,
    var endRetryAt: int = 0
)

class OneRecoveryHttp(val owner: string, val ticket: int, val request: HttpRequest, var stage: string, var session: string, val started: int)
val oneRecoveryHttp: array<OneRecoveryHttp> = []

val oneRecoverySessions: Map<string, OneRecoveryState> = Map()

fun oneRecoveryCapture(id: string, text: string): bool {
    val state = oneRecoverySessions.get(id)
    if (state == null || text.size > oneRecoveryCheckpointLimit) return false
    val parsed = jsonParse(text)
    if (!parsed.succeeded || !parsed.value.isObject()) return false
    state.draft = parsed.value
    state.captured = true
    true
}

fun oneRecoveryReady(id: string): bool {
    val state = oneRecoverySessions.get(id)
    if (state == null || !state.restored) return false
    state.ready = true
    true
}

fun oneRecoveryFileRead(id: string, request: int, handle: string, offset: int, length: int): int {
    val state = oneRecoverySessions.get(id)
    if (state == null || state.status != 200) return 503
    if (state.files.keys().size >= 64 || handle.size == 0 || handle.size > 256) return 429
    state.files.set(request, OneRecoveryFileJob(request, handle, offset, length, false))
    state.batch.changed(true)
    202
}

// Trusted app hydration is the only file work admitted before live-restored.
// Negative IDs cannot collide with restored positive app request IDs. No
// browser frame can invoke this server-side API or choose its handle.
fun oneRecoveryHydrationRead(id: string, request: int, handle: string, offset: int, length: int): int {
    val state = oneRecoverySessions.get(id)
    if (state == null || !state.restored || state.ready || request >= 0 || request < -9007199254740991) return 409
    if (state.hydrationFiles.has(request) || state.files.has(request) || offset < 0 || length <= 0 || length > 262144) return 400
    if (state.status == 403 || state.status == 404 || state.status == 409 || state.status == 410) return 409
    if (state.files.keys().size >= 64 || handle.size == 0 || handle.size > 256 || offset > oneRecoveryFileLimit) return 400
    // A pending/transient fence must hold admission, not discard the draft.
    // recoverySettle rechecks ownership before it submits this trusted job.
    state.files.set(request, OneRecoveryFileJob(request,handle,offset,length,false))
    state.hydrationFiles.set(request,true)
    state.batch.changed(true)
    202
}

fun oneRecoveryFileDelete(id: string, request: int, handle: string): int {
    val state = oneRecoverySessions.get(id)
    if (state == null || state.status != 200) return 503
    if (state.files.keys().size >= 64 || handle.size == 0 || handle.size > 256) return 429
    state.files.set(request, OneRecoveryFileJob(request, handle, 0, 0, true))
    state.batch.changed(true)
    202
}

fun oneRecoveryPickerBegin(id: string, request: int, kind: string): bool {
    val state = oneRecoverySessions.get(id)
    if (state == null) return true
    if (state.pickers.has(request)) return state.pickers.get(request) == kind
    if (state.pickers.keys().size >= oneRecoveryPickerLimit) return false
    state.pickers.set(request, kind)
    state.batch.changed(true)
    true
}

fun oneRecoveryPickerEnd(var state: OneRecoveryState, request: int): void {
    state.pickers.remove(request)
    for (id in state.effects.keys()) {
        val effect = jsonParse(state.effects.get(id) ?? "")
        if (effect.succeeded && effect.value.getString("t") == "pick" && effect.value.getInt("id") == request) oneRecoveryEffectForget(state,id)
    }
    return
}

fun oneRecoveryEffectForget(var state: OneRecoveryState, id: string): void {
    state.effects.remove(id)
    val kept: array<string> = []
    for (existing in state.effectOrder) if (state.effects.has(existing)) kept.append(existing)
    state.effectOrder.clear()
    for (existing in kept) state.effectOrder.append(existing)
    return
}
