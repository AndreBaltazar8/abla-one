import "../one.ab"
import "../layout/layout.ab"
import "../layout/paint.ab"
import "../raster/raster.ab"

// The `epaper` target (SPEC §10, M4), PaperMono first. Each change is laid out,
// painted and rasterized (one-layout, one-raster), then quantised to the panel's
// four grey levels in its drawing planes, a band of rows at a time. Changed areas
// become byte-aligned dirty rectangles, and the backend picks the refresh mode: a
// full refresh first and periodically, fast partial refreshes in between. A device
// runner (papermono.ab) copies the rectangles into its canvas and refreshes them.
//
// Coordinates: the panel is 800×480 physically and used in portrait
// (480×800, PaperMono rotation 0). `scale` maps logical pixels to panel
// pixels in percent (133: a 360×601 logical screen, text at phone sizes).

class OneEpaperOptions(
    val width: int,          // portrait panel pixels: 480
    val height: int,         // 800
    val scale: int,          // percent
    val background: string,
    // A full quality refresh after this many partial ones (clears ghosting).
    val fullEvery: int,
    // Above this share of the panel (percent), refresh fully.
    val fullArea: int,
    // The thinnest border or rule, in panel pixels: one is too faint on e-paper.
    val minStroke: int = 2,
    // Sharp: no antialiasing or dither, text and lines solid (oneEpaperCrispPaint),
    // fills in the panel's own shades.
    val crisp: bool = true
)

fun onePaperMonoOptions(): OneEpaperOptions = OneEpaperOptions(480, 800, 133, "#ffffff", 12, 45)

// A rectangle in physical canvas coordinates (800×480); x and w are
// multiples of 8, as the controller addresses bytes.
class OneEpaperRect(val x: int, val y: int, val w: int, val h: int)

// Refresh modes, as abla-embedded's ssd1677Lut names them.
val oneEpaperQuality = 1
val oneEpaperText = 2
val oneEpaperFast = 3
val oneEpaperFastest = 4

class OneEpaperUpdate(val revision: int, val mode: int, val rects: array<OneEpaperRect>, val planes: array<int>)

class OneEpaperState(
    val options: OneEpaperOptions,
    // The panel as last rendered: the SSD1677 drawing planes (the layout
    // oneEpaperPlaneLevel reads), one byte value per element.
    val planes: array<int>,
    var revision: int,
    var partials: int,
    var frame: OneFrame,
    var full: bool,
    // Scroll offsets by scroll area (layout path), in logical pixels.
    val scroll: Map<string, int>,
    // The paints last drawn and their hashes (what the next render diffs
    // against), and how many pixels the last render drew.
    var paints: array<OnePaint>,
    var hashes: array<int>,
    var pixelsDrawn: int,
    // The band surface (and its fill scratch), kept between renders.
    var surface: OneSurface,
    // Each scroll area's panel offset as last drawn (oneEpaperPanelOffset), and
    // the scroll areas each paint sits in ("|key|key|"), to shift rather than redraw.
    val offsets: Map<string, int>,
    var owners: array<string>,
    // Called between bands of a render: a device reads its touch panel here.
    var onBand: () -> void = { },
    // Style and text work kept between layouts, the last layout, and the state
    // revision it is of: a swipe that changed nothing else reuses it.
    var layoutCache: OneLayoutCache = oneLayoutCache(),
    val boxes: array<OneBox> = [],
    var boxRevision: int = -1,
    var scrolled: bool = false,
    // Which 8x8 tiles a render changed, kept: the array is a tenth of a render's garbage.
    val dirty: array<int> = []
)

fun oneEpaperBandSurface(options: OneEpaperOptions): OneSurface {
    var surface = oneSurfaceBand(options.width, options.height, 0, oneEpaperBandRows, oneColorValue(options.background))
    surface.crisp = options.crisp
    surface
}

fun oneEpaperState(options: OneEpaperOptions): OneEpaperState =
    OneEpaperState(options, filledArray(options.width * options.height / 4, 0), 0, 0, OneFrame([], [], [], 0, 0), true, Map(), [], [], 0, oneEpaperBandSurface(options), Map(), [])

// Portrait rows rasterized at a time: a multiple of 8 (a canvas byte) that
// divides 800. A whole frame at once would take a 480×800 surface, more
// memory than a microcontroller's heap.
val oneEpaperBandRows = 40

fun oneEpaperLogicalWidth(o: OneEpaperOptions): int = o.width * 100 / o.scale
fun oneEpaperLogicalHeight(o: OneEpaperOptions): int = o.height * 100 / o.scale

// Physical canvas position of a portrait pixel (SSD1677 rotation 3).
fun oneEpaperPhysicalX(x: int, y: int): int = y
fun oneEpaperPhysicalY(x: int, y: int, width: int): int = width - 1 - x

// abla-embedded's ssd1677CanvasGray: a 4×4 Bayer dither to four levels,
// in physical coordinates, so neighbouring updates line up.
fun oneEpaperLevel(gray: int, px: int, py: int): int {
    val sum = gray + oneEpaperDither[(px & 3) + (py & 3) * 4]
    if (sum < 0) return 0
    val level = sum >> 6
    if (level > 3) 3 else level
}

// The words 0xA684E2C0 and 0x95B7D1F3, a nibble per position (low nibble
// first), each as nibble * 4 - 30.
val oneEpaperDither: array<int> = [-30, 18, -22, 26, -14, 2, -6, 10, -18, 30, -26, 22, -2, 14, -10, 6]

// The panel's nearest grey, no dither: 0 black … 3 white.
fun oneEpaperShade(gray: int): int {
    val shade = (gray + 42) / 85
    if (shade > 3) 3 else shade
}

fun oneEpaperGray(rgb: int): int = (((rgb >> 16) & 255) * 299 + ((rgb >> 8) & 255) * 587 + (rgb & 255) * 114) / 1000

// Text, icons and lines print solid black or white, whatever grey the theme
// asks for, and small text is a little heavier: thin strokes are what a panel
// without soft edges loses. Fills keep their shade.
fun oneEpaperCrispPaint(p: OnePaint): OnePaint {
    if (p.op == "rect" || p.op == "clip" || p.op == "unclip" || p.op == "image") return p
    val solid = if (p.color == "") "" else if (oneEpaperGray(oneColorValue(p.color)) < 192) "#000000" else "#ffffff"
    val weight = if (p.op == "text" && p.size < 24 && (p.weight == "" || p.weight == "regular" || p.weight == "normal")) "medium" else p.weight
    OnePaint(p.op, p.x, p.y, p.w, p.h, p.radius, solid, p.text, p.size, weight, p.sides)
}

// A scroll offset on the panel: whole canvas bytes, so scrolling can move bytes
// (eight portrait rows are one byte).
fun oneEpaperPanelOffset(scroll: int, scale: int): int = scroll * scale / 100 / 8 * 8

// The paint list scaled from logical to panel pixels. What scrolls is scaled as
// if unscrolled and then moved by whole panel offsets, so a paint lands on the
// same pixels relative to its scroll area wherever that is scrolled. `owners`
// gets each paint's scroll areas.
fun oneEpaperScaleFrame(frame: OneFrame, scale: int, width: int, height: int, minStroke: int, crisp: bool, var owners: array<string>): OneFrame {
    val paints: array<OnePaint> = []
    val logical: array<int> = []
    val panel: array<int> = []
    val keys: array<string> = []
    var addLogical = 0
    var subtractPanel = 0
    var owner = ""
    for (p in frame.paints) {
        if (p.op == "unclip" && logical.size > 0) {
            addLogical = addLogical - logical[logical.size - 1]
            subtractPanel = subtractPanel - panel[panel.size - 1]
            logical.truncate(logical.size - 1)
            panel.truncate(panel.size - 1)
            keys.truncate(keys.size - 1)
            owner = ""
            for (k in keys) if (k != "") owner = "$owner|$k|"
        }
        val x = p.x * scale / 100
        val y = (p.y + addLogical) * scale / 100 - subtractPanel
        var w = (p.x + p.w) * scale / 100 - x
        var h = (p.y + p.h + addLogical) * scale / 100 - subtractPanel - y
        // A thin rule keeps the thinnest width the panel shows well.
        if (p.op == "rect" && w > 0 && h > 0) {
            if (w < minStroke) w = minStroke
            if (h < minStroke) h = minStroke
        }
        val paint = OnePaint(p.op, x, y, w, h, p.radius * scale / 100, p.color, p.text, p.size * scale / 100, p.weight, oneEpaperScaleSides(p.sides, scale, minStroke))
        paints.append(if (crisp) oneEpaperCrispPaint(paint) else paint)
        owners.append(owner)
        if (p.op == "clip") {
            var scroll = 0
            var key = ""
            for (hit in frame.hits) {
                if (hit.kind == "scroll" && hit.x == p.x && hit.y == p.y && hit.w == p.w && hit.h == p.h) {
                    scroll = oneParseInt(hit.value, 0)
                    key = hit.key
                }
            }
            logical.append(scroll)
            panel.append(oneEpaperPanelOffset(scroll, scale))
            keys.append(key)
            addLogical = addLogical + scroll
            subtractPanel = subtractPanel + oneEpaperPanelOffset(scroll, scale)
            if (key != "") owner = "$owner|$key|"
        }
    }
    OneFrame(paints, frame.hits, frame.visible, width, height)
}

fun oneEpaperScaleSides(sides: string, scale: int, minStroke: int): string {
    if (sides == "") return ""
    var out = ""
    var start = 0
    var i = 0
    while (i <= sides.size) {
        if (i == sides.size || sides[i] == 32) {
            val n = oneParseInt(sides.slice(start, i), 0)
            val scaled = if (n > 0 && n * scale / 100 < minStroke) minStroke else n * scale / 100
            out = if (out == "") "$scaled" else "$out $scaled"
            start = i + 1
        }
        i = i + 1
    }
    out
}

// Renders the app and returns what the panel needs. An update without
// rectangles means nothing visible changed.
fun oneEpaperRender(var app: OneApp, theme: Theme, var state: OneEpaperState, icons: OneIconSource): OneEpaperUpdate {
    val o = state.options
    if (state.boxes.size == 1 && state.scrolled && state.boxRevision == oneRevision()) oneLayoutRescroll(state.boxes[0], state.scroll, "r")
    else {
        var ui = oneUiSized("epaper", theme, oneEpaperLogicalWidth(o))
        val built = app.render(ui)
        oneEpaperLayOut(built, theme, state)
    }
    oneEpaperDraw(state, icons)
}

// The same for a tree that comes from elsewhere (a thin device's server).
fun oneEpaperRenderTree(tree: Node, theme: Theme, var state: OneEpaperState, icons: OneIconSource): OneEpaperUpdate {
    if (state.boxes.size == 1 && state.scrolled && state.boxRevision == oneRevision()) oneLayoutRescroll(state.boxes[0], state.scroll, "r")
    else oneEpaperLayOut(tree, theme, state)
    oneEpaperDraw(state, icons)
}

fun oneEpaperLayOut(tree: Node, theme: Theme, var state: OneEpaperState): void {
    val o = state.options
    val laid = oneLayoutCached(tree, theme, "epaper", oneEpaperLogicalWidth(o), oneEpaperLogicalHeight(o), state.scroll, state.layoutCache)
    state.boxes.clear()
    state.boxes.append(laid)
    return
}

fun oneEpaperDraw(var state: OneEpaperState, icons: OneIconSource): OneEpaperUpdate {
    val o = state.options
    val lw = oneEpaperLogicalWidth(o)
    val lh = oneEpaperLogicalHeight(o)
    state.scrolled = false
    state.boxRevision = oneRevision()
    val frame = onePaintFrame(state.boxes[0], lw, lh)
    state.frame = frame
    val owners: array<string> = []
    val scaled = oneEpaperScaleFrame(frame, o.scale, o.width, o.height, o.minStroke, o.crisp, owners)
    // Redraw what the paint list says changed, quantise it into canvas bytes
    // (eight portrait rows are one physical byte), and mark the 8×8 tiles
    // whose bytes changed. A band of rows at a time, on one kept surface.
    val pw = o.height
    val ph = o.width
    val stride = pw / 8
    val plane = stride * ph
    val tilesX = pw / 8
    val tilesY = (ph + 7) / 8
    while (state.dirty.size < tilesX * tilesY) state.dirty.append(0)
    var changed = 0
    val background = oneColorValue(o.background)
    val hashes: array<int> = []
    for (p in scaled.paints) hashes.append(oneEpaperPaintHash(p))
    // One scroll area that moved: shift what it shows instead of redrawing it,
    // then only what the shift cannot bring is drawn (and the shifted bytes count as changed).
    val oldPaints: array<OnePaint> = []
    val oldHashes: array<int> = []
    val strips: array<OneEpaperRect> = []
    val shift = if (state.full) null else oneEpaperFindShift(state, scaled)
    var at = 0
    while (at < state.paints.size) {
        val p = state.paints[at]
        if (shift != null && at < state.owners.size && state.owners[at].contains("|${shift.key}|")) {
            val moved = OnePaint(p.op, p.x, p.y - shift.distance, p.w, p.h, p.radius, p.color, p.text, p.size, p.weight, p.sides)
            oldPaints.append(moved)
            oldHashes.append(oneEpaperPaintHash(moved))
        } else {
            oldPaints.append(p)
            oldHashes.append(state.hashes[at])
        }
        at = at + 1
    }
    if (shift != null) {
        changed = changed + oneEpaperShiftPlanes(state, shift, tilesX)
        for (strip in oneEpaperShiftStrips(shift)) strips.append(strip)
    }
    for (hit in frame.hits) {
        if (hit.kind == "scroll") state.offsets.set(hit.key, oneEpaperPanelOffset(oneParseInt(hit.value, 0), o.scale))
    }
    val areas = if (state.full) [OneEpaperRect(0, 0, o.width, o.height)]
        else oneEpaperChanged(oldPaints, oldHashes, scaled.paints, hashes, o.width, o.height, strips)
    var drawn = 0
    for (area in areas) {
        var y0 = area.y
        while (y0 < area.y + area.h) {
            val remaining = area.y + area.h - y0
            val rows = if (remaining > oneEpaperBandRows) oneEpaperBandRows else remaining
            state.onBand()
            oneSurfaceMoveTo(state.surface, area.x, y0, area.x + area.w, rows, background)
            oneRasterInto(state.surface, scaled, icons)
            drawn = drawn + area.w * rows
            var x = area.x
            while (x < area.x + area.w) {
                val py = oneEpaperPhysicalY(x, 0, o.width)
                var column = y0 / 8
                while (column * 8 < y0 + rows) {
                    var lsb = 0
                    var msb = 0
                    var k = 0
                    var at = (column * 8 - y0) * o.width + x
                    var bit = 128
                    while (k < 8) {
                        val pixel = state.surface.pixels[at]
                        // (Most of a screen is black or white: skip their arithmetic.)
                        if (pixel == 16777215) {
                            lsb = lsb | bit
                            msb = msb | bit
                        } else if (pixel != 0 || !o.crisp) {
                            val y = column * 8 + k
                            val level = if (o.crisp) oneEpaperShade(oneEpaperGray(pixel)) else oneEpaperLevel(oneEpaperGray(pixel), y, py)
                            if ((level & 1) == 1) lsb = lsb | bit
                            if (level >= 2) msb = msb | bit
                        }
                        at = at + o.width
                        bit = bit >> 1
                        k = k + 1
                    }
                    val offset = py * stride + column
                    if (state.planes[offset] != lsb || state.planes[offset + plane] != msb) {
                        state.planes[offset] = lsb
                        state.planes[offset + plane] = msb
                        val tile = (py / 8) * tilesX + column
                        if (state.dirty[tile] == 0) {
                            state.dirty[tile] = 1
                            changed = changed + 1
                        }
                    }
                    column = column + 1
                }
                x = x + 1
            }
            y0 = y0 + rows
        }
    }
    state.paints = scaled.paints
    state.hashes = hashes
    state.owners = owners
    state.pixelsDrawn = drawn
    var rects: array<OneEpaperRect> = []
    if (changed > 0) {
        rects = oneEpaperRects(state.dirty, tilesX, tilesY, ph)
        var tile = 0
        while (tile < state.dirty.size) {
            state.dirty[tile] = 0
            tile = tile + 1
        }
    }
    var mode = oneEpaperFastest
    if (rects.size > 0) {
        val area = changed * 100 / (tilesX * tilesY)
        if (state.full || state.partials >= o.fullEvery || (!o.crisp && area >= o.fullArea)) {
            // Text, not Quality: 0.7 s rather than 3.4 s on the panel, with far less flashing.
            mode = oneEpaperText
            rects = [OneEpaperRect(0, 0, pw, ph)]
            state.partials = 0
            state.full = false
        } else {
            mode = if (area >= 15) oneEpaperFast else oneEpaperFastest
            state.partials = state.partials + 1
        }
        state.revision = state.revision + 1
    }
    OneEpaperUpdate(state.revision, mode, rects, state.planes)
}

// A scroll area to shift: its canvas-byte rows top until bottom (portrait), its
// columns left until right, and how far its content moves up.
class OneEpaperShift(val key: string, val left: int, val right: int, val top: int, val bottom: int, val alignedTop: int, val alignedBottom: int, val distance: int)

// The shift between what was drawn and this frame: when exactly one scroll area
// moved, and by less than it shows.
fun oneEpaperFindShift(state: OneEpaperState, scaled: OneFrame): OneEpaperShift? {
    val o = state.options
    var found: OneEpaperShift? = null
    var moved = 0
    for (hit in scaled.hits) {
        if (hit.kind == "scroll") {
            val before = state.offsets.get(hit.key)
            val now = oneEpaperPanelOffset(oneParseInt(hit.value, 0), o.scale)
            if (before != null && before != now) {
                moved = moved + 1
                val top = hit.y * o.scale / 100
                val bottom = oneEpaperClamp((hit.y + hit.h) * o.scale / 100, o.height)
                val alignedTop = (top + 7) / 8 * 8
                val alignedBottom = bottom / 8 * 8
                val distance = now - before
                val span = if (distance < 0) 0 - distance else distance
                if (span < alignedBottom - alignedTop)
                    found = OneEpaperShift(hit.key, hit.x * o.scale / 100, oneEpaperClamp((hit.x + hit.w) * o.scale / 100, o.width), top, bottom, alignedTop, alignedBottom, distance)
            }
        }
    }
    if (moved == 1) found else null
}

// Moves the area's canvas bytes and marks their tiles; how many tiles it marked.
fun oneEpaperShiftPlanes(var state: OneEpaperState, shift: OneEpaperShift, tilesX: int): int {
    val first = shift.alignedTop / 8
    val last = shift.alignedBottom / 8
    val by = shift.distance / 8
    var marked = 0
    var x = shift.left
    while (x < shift.right) {
        val py = oneEpaperPhysicalY(x, 0, state.options.width)
        var plane = 0
        while (plane < 2) {
            val base = plane * 48000 + py * 100
            var column = if (by > 0) first else last - 1
            while (column >= first && column < last) {
                val source = column + by
                if (source >= first && source < last) state.planes[base + column] = state.planes[base + source]
                column = if (by > 0) column + 1 else column - 1
            }
            plane = plane + 1
        }
        var column = first
        while (column < last) {
            val tile = (py / 8) * tilesX + column
            if (state.dirty[tile] == 0) {
                state.dirty[tile] = 1
                marked = marked + 1
            }
            column = column + 1
        }
        x = x + 1
    }
    marked
}

// What a shift leaves to draw: the rows it uncovered, and the area's rows outside
// whole bytes. Rows byte-aligned, as every redrawn area is.
fun oneEpaperShiftStrips(shift: OneEpaperShift): array<OneEpaperRect> {
    val w = shift.right - shift.left
    val top = shift.top / 8 * 8
    val bottom = (shift.bottom + 7) / 8 * 8
    val uncovered = if (shift.distance > 0) OneEpaperRect(shift.left, shift.alignedBottom - shift.distance, w, bottom - (shift.alignedBottom - shift.distance))
        else OneEpaperRect(shift.left, top, w, shift.alignedTop - shift.distance - top)
    val other = if (shift.distance > 0) OneEpaperRect(shift.left, top, w, shift.alignedTop - top)
        else OneEpaperRect(shift.left, shift.alignedBottom, w, bottom - shift.alignedBottom)
    val out: array<OneEpaperRect> = [uncovered]
    if (other.h > 0) out.append(other)
    out
}

fun oneEpaperClamp(value: int, most: int): int = if (value > most) most else value

fun oneEpaperPaintHash(p: OnePaint): int {
    var h = 17
    h = h * 31 + p.x
    h = h * 31 + p.y
    h = h * 31 + p.w
    h = h * 31 + p.h
    h = h * 31 + p.radius
    h = h * 31 + p.size
    oneEpaperHashText(oneEpaperHashText(oneEpaperHashText(oneEpaperHashText(oneEpaperHashText(h, p.op), p.color), p.text), p.weight), p.sides)
}

fun oneEpaperHashText(hash: int, text: string): int {
    var h = hash * 31 + text.size
    for (b in text) h = h * 31 + b
    h
}

// The screen areas to redraw between two paint lists: around each paint only
// one of them has, with rows aligned to canvas bytes, overlaps merged. Clips
// that changed, or the same paints in another order, redraw everything.
fun oneEpaperChanged(old: array<OnePaint>, oldHashes: array<int>, new: array<OnePaint>, newHashes: array<int>, width: int, height: int, strips: array<OneEpaperRect>): array<OneEpaperRect> {
    val whole = [OneEpaperRect(0, 0, width, height)]
    val counts: Map<int, int> = Map()
    for (h in oldHashes) counts.set(h, (counts.get(h) ?? 0) + 1)
    val areas: array<OneEpaperRect> = []
    for (strip in strips) areas.append(strip)
    var i = 0
    while (i < new.size) {
        val left = counts.get(newHashes[i]) ?? 0
        if (left > 0) counts.set(newHashes[i], left - 1)
        else {
            if (new[i].op == "clip" || new[i].op == "unclip") return whole
            oneEpaperAddArea(areas, new[i], width, height)
        }
        i = i + 1
    }
    i = 0
    while (i < old.size) {
        val left = counts.get(oldHashes[i]) ?? 0
        if (left > 0) {
            counts.set(oldHashes[i], left - 1)
            if (old[i].op == "clip" || old[i].op == "unclip") return whole
            oneEpaperAddArea(areas, old[i], width, height)
        }
        i = i + 1
    }
    if (areas.size == strips.size && old.size == new.size) {
        i = 0
        while (i < new.size) {
            if (oldHashes[i] != newHashes[i]) return whole
            i = i + 1
        }
    }
    // Merge until no two overlap (they share canvas bytes otherwise).
    var merged = true
    while (merged) {
        merged = false
        var a = 0
        while (a < areas.size && !merged) {
            var b = a + 1
            while (b < areas.size && !merged) {
                val p = areas[a]
                val q = areas[b]
                if (p.x < q.x + q.w && q.x < p.x + p.w && p.y < q.y + q.h && q.y < p.y + p.h) {
                    val x0 = if (p.x < q.x) p.x else q.x
                    val y0 = if (p.y < q.y) p.y else q.y
                    val x1 = if (p.x + p.w > q.x + q.w) p.x + p.w else q.x + q.w
                    val y1 = if (p.y + p.h > q.y + q.h) p.y + p.h else q.y + q.h
                    areas[a] = OneEpaperRect(x0, y0, x1 - x0, y1 - y0)
                    areas[b] = areas[areas.size - 1]
                    areas.truncate(areas.size - 1)
                    merged = true
                }
                b = b + 1
            }
            a = a + 1
        }
    }
    areas
}

fun oneEpaperAddArea(var areas: array<OneEpaperRect>, p: OnePaint, width: int, height: int): void {
    val reach = onePaintReach(p)
    val x0 = if (p.x - reach < 0) 0 else p.x - reach
    val x1 = if (p.x + p.w + reach > width) width else p.x + p.w + reach
    val top = if (p.y - reach < 0) 0 else p.y - reach
    val bottom = if (p.y + p.h + reach > height) height else p.y + p.h + reach
    if (x1 <= x0 || bottom <= top) return
    val y0 = top / 8 * 8
    val y1 = (bottom + 7) / 8 * 8
    areas.append(OneEpaperRect(x0, y0, x1 - x0, (if (y1 > height) height else y1) - y0))
    return
}

// Dirty tiles as rectangles: runs per tile row, joined downwards while the
// run lines up. Very many small rectangles collapse into their bounds.
fun oneEpaperRects(dirty: array<int>, tilesX: int, tilesY: int, height: int): array<OneEpaperRect> {
    val open: array<OneEpaperRect> = []
    val done: array<OneEpaperRect> = []
    var ty = 0
    while (ty < tilesY) {
        val runs: array<OneEpaperRect> = []
        var tx = 0
        while (tx < tilesX) {
            if (dirty[ty * tilesX + tx] == 1) {
                var end = tx
                while (end < tilesX && dirty[ty * tilesX + end] == 1) end = end + 1
                runs.append(OneEpaperRect(tx * 8, ty * 8, (end - tx) * 8, 8))
                tx = end
            } else tx = tx + 1
        }
        val next: array<OneEpaperRect> = []
        for (r in open) {
            var grown = false
            for (run in runs) if (run.x == r.x && run.w == r.w) grown = true
            if (grown) next.append(OneEpaperRect(r.x, r.y, r.w, r.h + 8)) else done.append(r)
        }
        for (run in runs) {
            var joined = false
            for (r in open) if (run.x == r.x && run.w == r.w) joined = true
            if (!joined) next.append(run)
        }
        open.clear()
        for (r in next) open.append(r)
        ty = ty + 1
    }
    for (r in open) done.append(r)
    val out: array<OneEpaperRect> = []
    for (r in done) out.append(OneEpaperRect(r.x, r.y, r.w, if (r.y + r.h > height) height - r.y else r.h))
    if (out.size <= 48) return out
    var left = 100000
    var top = 100000
    var right = 0
    var bottom = 0
    for (r in out) {
        if (r.x < left) left = r.x
        if (r.y < top) top = r.y
        if (r.x + r.w > right) right = r.x + r.w
        if (r.y + r.h > bottom) bottom = r.y + r.h
    }
    [OneEpaperRect(left, top, right - left, bottom - top)]
}

// The SSD1677 drawing planes (abla-embedded ssd1677_canvas.ab): the LSB
// plane, then the MSB plane, each one bit per pixel, rows of 100 bytes (800
// physical pixels), most significant bit first. The grey level (0 black … 3
// white) of physical pixel (px, py):
fun oneEpaperPlaneLevel(planes: array<int>, px: int, py: int): int {
    val offset = py * 100 + px / 8
    val bit = oneEpaperBit(px % 8)
    (if ((planes[offset] / bit) % 2 == 1) 1 else 0) + (if ((planes[offset + 48000] / bit) % 2 == 1) 2 else 0)
}

fun oneEpaperBit(position: int): int = if (position == 0) 128 else if (position == 1) 64 else if (position == 2) 32 else if (position == 3) 16 else if (position == 4) 8 else if (position == 5) 4 else if (position == 6) 2 else 1

// The event of what is pressable at a portrait panel pixel, 0 if nothing is.
fun oneEpaperPressAt(state: OneEpaperState, x: int, y: int): int {
    val lx = x * 100 / state.options.scale
    val ly = y * 100 / state.options.scale
    var i = state.frame.hits.size - 1
    while (i >= 0) {
        val h = state.frame.hits[i]
        if (h.kind == "press" && lx >= h.x && lx < h.x + h.w && ly >= h.y && ly < h.y + h.h) return h.event
        i = i - 1
    }
    0
}

// A tap at a portrait panel pixel. Returns whether a handler ran.
fun oneEpaperTouch(var app: OneApp, theme: Theme, state: OneEpaperState, x: int, y: int): bool =
    oneDispatch(app, "epaper", theme, oneEpaperPressAt(state, x, y), "", oneEpaperLogicalWidth(state.options))

// A swipe at portrait pixel (x, y): scrolls the innermost scroll area there
// by `dy` panel pixels (positive moves the content up, as a finger dragging
// up does), within its bounds. Whether anything moved.
fun oneEpaperScroll(var state: OneEpaperState, x: int, y: int, dy: int): bool {
    val lx = x * 100 / state.options.scale
    val ly = y * 100 / state.options.scale
    var i = state.frame.hits.size - 1
    while (i >= 0) {
        val h = state.frame.hits[i]
        if (h.kind == "scroll" && lx >= h.x && lx < h.x + h.w && ly >= h.y && ly < h.y + h.h) {
            val current = oneParseInt(h.value, 0)
            val most = oneParseInt(h.placeholder, 0)
            var next = current + dy * 100 / state.options.scale
            if (next > most) next = most
            if (next < 0) next = 0
            if (next != current) {
                state.scroll.set(h.key, next)
                state.scrolled = true
                return true
            }
        }
        i = i - 1
    }
    false
}

// A device refreshes one rectangle at a time: rectangles grouped so that a group's
// bounds take in nothing far from them. Portrait rows run along physical x, so
// widely separated controls are far apart there; at most four groups (each costs
// a refresh), the closest merging first.
fun oneEpaperGroupRects(rects: array<OneEpaperRect>): array<OneEpaperRect> {
    val groups: array<OneEpaperRect> = []
    for (r in rects) groups.append(r)
    var merged = true
    while (merged) {
        merged = false
        var bestA = -1
        var bestB = -1
        var bestGap = 1000000
        var a = 0
        while (a < groups.size) {
            var b = a + 1
            while (b < groups.size) {
                val gap = oneEpaperRectGap(groups[a], groups[b])
                if (gap < bestGap) {
                    bestGap = gap
                    bestA = a
                    bestB = b
                }
                b = b + 1
            }
            a = a + 1
        }
        if (bestA >= 0 && (bestGap <= 16 || groups.size > 4)) {
            val p = groups[bestA]
            val q = groups[bestB]
            val x0 = if (p.x < q.x) p.x else q.x
            val y0 = if (p.y < q.y) p.y else q.y
            val x1 = if (p.x + p.w > q.x + q.w) p.x + p.w else q.x + q.w
            val y1 = if (p.y + p.h > q.y + q.h) p.y + p.h else q.y + q.h
            groups[bestA] = OneEpaperRect(x0, y0, x1 - x0, y1 - y0)
            groups[bestB] = groups[groups.size - 1]
            groups.truncate(groups.size - 1)
            merged = true
        }
    }
    groups
}

fun oneEpaperRectGap(p: OneEpaperRect, q: OneEpaperRect): int {
    val gapX = if (q.x >= p.x + p.w) q.x - p.x - p.w else if (p.x >= q.x + q.w) p.x - q.x - q.w else 0
    val gapY = if (q.y >= p.y + p.h) q.y - p.y - p.h else if (p.y >= q.y + q.h) p.y - q.y - q.h else 0
    if (gapX > gapY) gapX else gapY
}

// Whether a canvas rectangle shows a grey (the planes differ only there).
fun oneEpaperShowsGrey(planes: array<int>, r: OneEpaperRect): bool {
    var row = r.y
    while (row < r.y + r.h) {
        var column = r.x / 8
        while (column < (r.x + r.w) / 8) {
            val at = row * 100 + column
            if (planes[at] != planes[at + 48000]) return true
            column = column + 1
        }
        row = row + 1
    }
    false
}

// A preview of the panel as it will look (four greys), as a PNG.
fun oneEpaperPreview(state: OneEpaperState): string {
    val o = state.options
    var surface = oneSurface(o.width, o.height, 16777215)
    var y = 0
    while (y < o.height) {
        var x = 0
        while (x < o.width) {
            val v = oneEpaperPlaneLevel(state.planes, oneEpaperPhysicalX(x, y), oneEpaperPhysicalY(x, y, o.width)) * 85
            surface.pixels[y * o.width + x] = v * 65536 + v * 256 + v
            x = x + 1
        }
        y = y + 1
    }
    oneSurfacePng(surface)
}
