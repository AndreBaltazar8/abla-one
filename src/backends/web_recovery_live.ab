import "web_live.ab"
import "web_checkpoint.ab"
import "web_recovery_store.ab"

fun oneRecoveryIdentifier(value: string): bool {
    if (value.size != 32 && value.size != 64) return false
    for (b in value) if (!((b >= 48 && b <= 57) || (b >= 97 && b <= 102))) return false
    true
}

// A fresh server-generated claim distinguishes new sockets from retries of
// one pending attach, including clients that reuse a Sec-WebSocket-Key.
fun oneRecoveryAttachRequest(request: HttpRequest): HttpRequest {
    val headers: array<HttpHeader> = []
    for (header in request.headers) if (header.name.lowercase() != "x-one-recovery-claim") headers.append(header)
    headers.append(HttpHeader("X-One-Recovery-Claim",oneLiveSessionId()))
    HttpRequest(request.method,request.path,request.query,headers,request.body,request.parameterNames,request.parameterValues)
}

// A missing local ID is never a public-page downgrade. Only an existing app
// constructed by the server's exclusion policy may use legacy transport.
fun OneLiveServer.recoveryRequired(id: string): bool {
    if(!recovery.enabled)return false
    val index=findSession(id)
    index<0 || sessions[index].recoveryEligible || oneRecoverySessions.has(id)
}

fun OneLiveServer.recoveryCapture(index: int): string? {
    val state = oneRecoverySessions.get(sessions[index].id)
    if (state == null) return null
    state.captured = false
    sessions[index].app.receive("checkpoint", "")
    if (!state.captured) return null
    val body = oneCheckpoint(sessions[index], state.draft)
    if (body.size > oneRecoveryCheckpointLimit || oneCheckpointRead(body) == null) return null
    body
}

fun OneLiveServer.recoveryStart(request: HttpRequest, index: int): int {
    if (!recovery.enabled || !sessions[index].recoveryEligible) return 200
    val id = sessions[index].id
    if (!oneRecoverySessions.has(id)) {
        val created = OneRecoveryState(id, "${oneLiveSessionId()}${oneLiveSessionId()}", recoveryOwner, recovery)
        created.ready = true
        oneRecoverySessions.set(id, created)
    }
    val state = oneRecoverySessions.get(id)
    if (state == null) return 503
    sessions[index].deferEventAck = true
    if (state.initialPayload == "") {
        val captured = recoveryCapture(index)
        if (captured == null) return 503
        state.initialPayload = captured
    }
    val body = state.initialPayload
    val stored = if (state.epoch == 0) recovery.create(request, id, state.proof, recoveryOwner, body)
        else recovery.save(id, recoveryOwner, state.epoch, state.version, body, true, [])
    if (stored.status == 202) { state.pendingPage = true; return 202 }
    if (stored.status != 200) { state.pendingPage = false; return stored.status }
    state.pendingPage = false
    for (cookie in stored.cookies) state.pageCookies.append(cookie)
    state.initialPayload = ""
    state.epoch = stored.epoch
    state.version = stored.version
    state.checkedAt = oneLiveNow()
    state.committedActivity = state.activitySerial
    state.batch.saved(state.batch.changes, oneLiveNow())
    200
}

fun oneRecoveryRequest(request: HttpRequest, route: string): HttpRequest {
    val path = oneRouteWithoutHash(route)
    val query = path.indexOf("?")
    HttpRequest("GET", if (query < 0) path else path.slice(0, query), if (query < 0) "" else path.slice(query + 1, path.size), request.headers, "", [], [])
}

// Forget only this process's app/handlers. Claiming another epoch is not signout
// and must never delete the durable state another process is about to resume.
fun OneLiveServer.recoveryForgetLocal(id: string, currentSlot: int): void {
    val kept: array<OneLiveSession> = []
    for (session in sessions) {
        if (session.id != id) kept.append(session)
        else if (session.slot >= 0 && session.slot != currentSlot) {
            queue(session.slot, webSocketEncodeFrame(webSocketClosePayload(1012, "session moved"), 8))
            slots[session.slot].session = ""
            slots[session.slot].closing = true
        }
    }
    sessions.clear()
    for (session in kept) sessions.append(session)
    oneLiveForget(id)
    oneMemoForget(id)
    oneRecoverySessions.remove(id)
    return
}

fun OneLiveServer.recoveryRefuse(slot: int, status: int): void {
    val ending = status == 403 || status == 404 || status == 410
    queue(slot, webSocketEncodeFrame(webSocketClosePayload(if (ending) 1008 else 1013, if (ending) "session ended" else "session storage unavailable"), 8))
    slots[slot].closing = true
    return
}

fun OneLiveServer.recoveryHello(slot: int, text: string): void {
    if (text.size > 16384) { recoveryRefuse(slot, 403); return }
    val parsed = jsonParse(text)
    val request = slots[slot].recoveryRequest
    if (slots[slot].recoveryMessage != "" && parsed.succeeded && parsed.value.getString("t") == "viewport") {
        val width = parsed.value.get("w")
        if (oneCheckpointCounter(width) && width.asInt() > 0 && width.asInt() <= 65536) {
            val waiting = jsonParse(slots[slot].recoveryMessage)
            if (waiting.succeeded) slots[slot].recoveryMessage = jsonStringify(oneRecoveryWith(waiting.value, "w", width))
        }
        return
    }
    if (!parsed.succeeded || request == null || parsed.value.getString("t") != "hello" || !parsed.value.get("proof").isString()) { recoveryRefuse(slot, 403); return }
    val id = slots[slot].session
    val proof = parsed.value.get("proof").asString()
    if (!oneRecoveryIdentifier(proof)) { recoveryRefuse(slot, 403); return }
    val opened = recoveryOpen(request, id, proof, slot)
    if (opened.status == 202 || opened.status == 409) { slots[slot].recoveryMessage = text; return }
    if (opened.status != 200) { recoveryRefuse(slot, opened.status); return }
    val index = opened.index
    val state = oneRecoverySessions.get(id)
    if (state == null) { recoveryRefuse(slot, 503); return }
    sessions[index].slot = slot
    sessions[index].connected = true
    sessions[index].lastSeen = oneLiveNow()
    slots[slot].awaitingRecovery = false
    slots[slot].recoveryRequest = null
    slots[slot].recoveryMessage = ""
    oneSessionMessage(sessions[index], theme, parsed.value)
    state.batch.changed(true)
    return
}

class OneRecoveryOpened(val status: int, val index: int = -1)

fun OneLiveServer.recoveryOpen(request: HttpRequest, id: string, proof: string, currentSlot: int = -1): OneRecoveryOpened {
    val loaded = recovery.attach(request, id, proof, recoveryOwner)
    if (loaded.status != 200) return OneRecoveryOpened(loaded.status)
    val saved = oneCheckpointRead(loaded.payload)
    if (saved == null) return OneRecoveryOpened(503)
    // The shared adapter has already checked proof, current credentials and
    // revocation off-loop. Calling a DB-backed legacy resumes callback here
    // would reintroduce a blocking authentication query on the live thread.
    recoveryForgetLocal(id, currentSlot)
    val state = OneRecoveryState(id, proof, recoveryOwner, recovery, loaded.epoch, loaded.version)
    state.restored = true
    state.draft = saved.get("app")
    state.checkedAt = oneLiveNow()
    oneRecoverySessions.set(id, state)
    val queueIndex = oneLiveQueueIndex(id)
    oneCheckpointSeed(oneLiveQueueList[queueIndex], saved)
    val app = factory(oneRecoveryRequest(request, saved.get("route").asString()), id)
    sessions.append(oneSession(id, app, oneLiveQueueList[queueIndex]))
    val index = sessions.size - 1
    var rounds = 0
    while (rounds < 16 && pump(index)) rounds = rounds + 1
    oneCheckpointRestore(sessions[index], saved)
    // Cookie delivery can be lost independently of the durable checkpoint.
    // Re-offer current storage after every authorized restore, even if the
    // fresh app has no organization and performs no new secureWrite.
    sessions[index].queue.cookiesChanged=true
    sessions[index].app.receive("restore", jsonStringify(saved.get("app")))
    rounds = 0
    while (rounds < 16 && pump(index)) rounds = rounds + 1
    OneRecoveryOpened(200, index)
}

fun OneLiveServer.recoveryCookies(request: HttpRequest): HttpResponse {
    if (request.method != "POST") return httpText("Method not allowed", 405)
    val id = request.queryParameter("s")
    val proof = request.header("x-one-proof")
    if (!oneRecoveryIdentifier(id) || !oneRecoveryIdentifier(proof)) return httpText("Session unavailable", 403)
    val loaded = recovery.inspect(request, id, proof)
    if (loaded.status == 202) return oneRecoveryPendingResponse("cookies", id)
    if (loaded.status != 200) return httpText("Session unavailable", loaded.status)
    val headers: array<HttpHeader> = [HttpHeader("Cache-Control", "no-store")]
    if (loaded.cookiesReady) {
        for (cookie in loaded.cookies) headers.append(HttpHeader("Set-Cookie", cookie))
        return HttpResponse(204,headers,"")
    }
    val saved = oneCheckpointRead(loaded.payload)
    if (saved == null) return httpText("Session unavailable", 503)
    val stored: Map<string, string> = Map()
    for (key in saved.get("storage").keys) stored.set(key, saved.get("storage").get(key).asString())
    for (key in stored.keys()) for (cookie in storage.cookies(request, key, stored.get(key) ?? "")) headers.append(HttpHeader("Set-Cookie", cookie))
    HttpResponse(204, headers, "")
}

fun OneLiveServer.recoveryFence(index: int, immediate: bool): bool {
    if (!recovery.enabled) return true
    val state = oneRecoverySessions.get(sessions[index].id)
    // A new SSR app hydrates before it is registered durably.
    if (state == null || state.epoch == 0) return true
    if (state.status == 409 || state.status == 403 || state.status == 404) return false
    val now = oneLiveNow()
    val validFor = if (immediate) 50 else oneRecoveryBatchMilliseconds
    if (now - state.checkedAt < validFor) return state.status == 200
    state.checkedAt = now
    state.status = recovery.fence(state.id, recoveryOwner, state.epoch)
    if (state.status == 202) { state.checkedAt = now - oneRecoveryBatchMilliseconds; return false }
    if (state.status == 409 || state.status == 403 || state.status == 404) {
        val slot = sessions[index].slot
        if (slot >= 0) {
            queue(slot, webSocketEncodeFrame(webSocketClosePayload(1012, "session moved"), 8))
            slots[slot].closing = true
        }
    }
    state.status == 200
}

fun OneLiveServer.recoverySettle(index: int): void {
    val state = oneRecoverySessions.get(sessions[index].id)
    if (state == null || sessions[index].slot < 0 || !recoveryFence(index, false)) return
    if (state.prepared != null) { recoveryFinishWrite(index); return }
    for (id in state.files.keys()) {
        val job = state.files.get(id)
        if (job == null || job.admitted || job.retryAt > oneLiveNow() || (!state.ready && !state.hydrationFiles.has(id))) continue
        val status = if (job.deleting) state.store.deleteFile(state.id, state.owner, state.epoch, id, job.handle)
            else state.store.readFile(state.id, state.owner, state.epoch, id, job.handle, job.offset, job.length)
        if (status == 200) job.admitted = true
        else if (status == 503) job.retryAt = oneLiveNow() + 1000
        else if (status != 202) {
            state.files.remove(id)
            state.hydrationFiles.remove(id)
            sessions[index].queue.complete(oneResponsePayload(id, status, "", "File unavailable"))
            state.batch.changed(true)
        }
    }
    val hydration = !state.ready
    val requested: array<int> = []
    if (hydration) for (id in state.hydrationFiles.keys()) requested.append(id)
    if (hydration && requested.size == 0) return
    val interval = if (state.files.keys().size > 0 || state.pickers.keys().size > 0) 100 else oneRecoveryBatchMilliseconds
    if ((state.inboxPending || oneLiveNow() - state.inboxAt >= interval) && state.consumed.size < 64) {
        if (!state.inboxPending) state.inboxAt = oneLiveNow()
        val inbox = recovery.inbox(state.id, recoveryOwner, state.epoch, requested)
        if (inbox.status == 202) { state.inboxPending = true; return }
        state.inboxPending = false
        if (inbox.status != 200) { state.status = inbox.status; return }
        if (inbox.items.size > 64) { state.status = 503; return }
        for (item in inbox.items) if (!oneRecoveryConsumed(state, item.id) && state.consumed.size < 64) {
            if (item.id.size == 0 || item.id.size > 128 || item.payload.size > 524288) { state.status = 503; return }
            val response = oneResponse(item.payload)
            if (!response.valid) { state.status = 503; return }
            if (hydration && !state.hydrationFiles.has(response.requestId)) { state.status = 503; return }
            state.consumed.append(item.id)
            val deliver = response.requestId > 0 || state.hydrationFiles.has(response.requestId)
            state.hydrationFiles.remove(response.requestId)
            oneRecoveryPickerEnd(state,response.requestId)
            state.files.remove(response.requestId)
            if (deliver) sessions[index].queue.complete(item.payload)
        }
        if (inbox.items.size > 0) {
            var rounds = 0
            while (rounds < 8 && pump(index)) rounds = rounds + 1
        }
    }
    // Hydration may complete inside pump above; until then no render, ack or
    // checkpoint may authorize old controls or persist a partial app state.
    if (!state.ready) return
    val force = sessions[index].queue.cookiesChanged || sessions[index].queue.outbox.size > 0 || sessions[index].queue.moves.size > 0
    if (force) state.batch.changed(true)
    else if (sessions[index].changed && !state.batch.pending) state.batch.changed()
    val now = oneLiveNow()
    if (!state.batch.due(now)) return
    if (!recoveryEffects(index)) { state.batch.failed(now); return }
    val previous = sessions[index].durableFrontier
    val routeAnswer = sessions[index].routeAnswer
    val changeAnswer = sessions[index].changeAnswer
    val viewportAnswer = sessions[index].viewportAnswer
    val moves: array<Json> = []
    for (move in sessions[index].queue.moves) moves.append(move)
    sessions[index].durableFrontier = sessions[index].eventFrontier
    // Prepare the exact render/maps represented by this checkpoint. Nothing is
    // sent before the CAS. A failed attempt resets the CSS/HTML send baseline.
    val message = oneSessionUpdate(sessions[index], theme, options.iconBase)
    val body = recoveryCapture(index)
    if (body == null) {
        sessions[index].durableFrontier = previous
        sessions[index].cssSent = 0; sessions[index].htmlSent = ""; sessions[index].changed = true
        recoveryRetryRender(index, routeAnswer, changeAnswer, viewportAnswer, moves)
        state.batch.failed(now)
        return
    }
    sessions[index].durableFrontier = previous
    val outgoing: array<string> = []
    for (id in state.effectOrder) {
        val effect = state.effects.get(id)
        if (effect != null) outgoing.append(jsonStringify(jsonObject(["t","id","message"],[jsonString("effect"),jsonString(id),jsonParse(effect).value])))
    }
    val cookies = sessions[index].queue.cookiesChanged
    sessions[index].queue.cookiesChanged = false
    val consumed: array<string> = []
    for (id in state.consumed) consumed.append(id)
    state.prepared = OneRecoveryWrite(state.batch.changes, sessions[index].eventFrontier, body, message, outgoing, cookies, consumed, state.activitySerial, state.activitySerial != state.committedActivity)
    recoveryFinishWrite(index)
    return
}

fun OneLiveServer.recoveryEffects(index: int): bool {
    val state = oneRecoverySessions.get(sessions[index].id)
    if (state == null) return false
    if (state.effects.keys().size + sessions[index].queue.outbox.size > 32) return false
    var bytes = 0
    for (id in state.effectOrder) bytes = bytes + (state.effects.get(id) ?? "").size
    for (message in sessions[index].queue.outbox) {
        if (!oneCheckpointEffect(message)) return false
        bytes = bytes + message.size
    }
    if (bytes > 65536) return false
    for (message in sessions[index].queue.takeOutbox()) {
        val id = oneLiveSessionId()
        state.effects.set(id,message)
        state.effectOrder.append(id)
    }
    true
}

fun OneLiveServer.recoveryFinishWrite(index: int): void {
    val state = oneRecoverySessions.get(sessions[index].id)
    if (state == null) return
    val prepared = state.prepared
    if (prepared == null || oneLiveNow() < state.batch.retryAt) return
    val saved = recovery.save(state.id, recoveryOwner, state.epoch, state.version, prepared.payload, prepared.active, prepared.consumed)
    if (saved.status == 202) return
    if (saved.status != 200) {
        if (saved.status == 503) state.batch.failed(oneLiveNow())
        else {
            state.status = saved.status
            recoveryRefuse(sessions[index].slot, saved.status)
        }
        return
    }
    state.version = saved.version
    val remaining: array<string> = []
    for (id in state.consumed) {
        var included = false
        for (used in prepared.consumed) if (id == used) included = true
        if (!included) remaining.append(id)
    }
    state.consumed.clear()
    for (id in remaining) state.consumed.append(id)
    state.committedActivity = prepared.activity
    state.batch.saved(prepared.generation, oneLiveNow())
    sessions[index].durableFrontier = prepared.frontier
    val slot = sessions[index].slot
    // Paint/ack the committed route before invoking browser history controls;
    // an older patch must not replace the URL after back/forward has run.
    if (prepared.patch != "") queue(slot, webSocketEncodeFrame(prepared.patch, 1))
    if (prepared.cookies) queue(slot, webSocketEncodeFrame("{\"t\":\"cookies\"}", 1))
    for (outgoing in prepared.outbox) queue(slot, webSocketEncodeFrame(outgoing, 1))
    state.prepared = null
    return
}

fun oneRecoveryConsumed(state: OneRecoveryState, id: string): bool {
    for (seen in state.consumed) if (seen == id) return true
    false
}

fun OneLiveServer.recoveryRetryRender(index: int, route: int, typed: int, viewport: int, moves: array<Json>): void {
    sessions[index].eventAckSent = -1
    sessions[index].routeAnswer = route
    sessions[index].changeAnswer = typed
    sessions[index].viewportAnswer = viewport
    for (move in moves) sessions[index].queue.moves.append(move)
    return
}

fun oneRecoveryWith(value: Json, key: string, next: Json): Json {
    val keys: array<string> = []
    val values: array<Json> = []
    var found = false
    for (name in value.keys) { keys.append(name); values.append(if (name == key) next else value.get(name)); if (name == key) found = true }
    if (!found) { keys.append(key); values.append(next) }
    jsonObject(keys, values)
}

fun oneRecoveryPendingResponse(stage: string, session: string): HttpResponse =
    HttpResponse(202, [HttpHeader("X-One-Recovery-Pending", stage), HttpHeader("X-One-Recovery-Session", session)], "")

fun OneLiveServer.recoveryWaitHttp(slot: int, request: HttpRequest, response: HttpResponse): void {
    var count = 0
    for (pending in oneRecoveryHttp) if (pending.owner == recoveryOwner) count = count + 1
    if (count >= 128) {
        queue(slot, httpText("Session storage unavailable", 503).render())
        slots[slot].closing = true
        return
    }
    oneRecoveryHttp.append(OneRecoveryHttp(recoveryOwner, ticket(slot), request, response.header("X-One-Recovery-Pending"), response.header("X-One-Recovery-Session"), oneLiveNow()))
    poller.modifyDescriptor(slots[slot].descriptor, false, false)
    return
}

// All store operations may be submitted to an off-path adapter. Pending202 is
// internal only: HTTP sockets and their original identity stay held, and a
// WebSocket sees no patch/ack until hydration and the durable CAS have finished.
fun OneLiveServer.recoveryPending(): void {
    val now = oneLiveNow()
    for (id in oneRecoverySessions.keys()) {
        val ending = oneRecoverySessions.get(id)
        if (ending == null || !ending.ending || ending.owner != recoveryOwner || now < ending.endRetryAt) continue
        val status = ending.store.end(id, ending.owner, ending.epoch)
        if (status == 200 || status == 403 || status == 404 || status == 409 || status == 410) oneRecoverySessions.remove(id)
        else ending.endRetryAt = now + (if (status == 202) 10 else 1000)
    }
    var slot = 0
    while (slot < slots.size) {
        if (slots[slot].awaitingRecovery && !slots[slot].closing && slots[slot].recoveryMessage != "") {
            if (now - slots[slot].recoveryStarted > 10000) recoveryRefuse(slot, 503)
            else recoveryHello(slot, slots[slot].recoveryMessage)
        }
        slot = slot + 1
    }
    val kept: array<OneRecoveryHttp> = []
    for (pending in oneRecoveryHttp) {
        if (pending.owner != recoveryOwner) { kept.append(pending); continue }
        if (ticketSlot(pending.ticket) < 0) continue
        if (now - pending.started > 10000) { answer(pending.ticket, httpText("Session storage unavailable", 503)); continue }
        var response = httpText("Session unavailable", 404)
        if (pending.stage == "cookies") response = recoveryCookies(pending.request)
        else if (pending.stage == "open") response = page(pending.request)
        else {
            val index = findSession(pending.session)
            if (index >= 0) response = pageRender(pending.request, index)
        }
        if (response.status == 202 && response.header("X-One-Recovery-Pending") != "") {
            pending.stage = response.header("X-One-Recovery-Pending")
            pending.session = response.header("X-One-Recovery-Session")
            kept.append(pending)
        } else answer(pending.ticket, response)
    }
    oneRecoveryHttp.clear()
    for (pending in kept) oneRecoveryHttp.append(pending)
    return
}
