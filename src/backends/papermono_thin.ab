import "papermono.ab"
import "thin_client.ab"
import "abla/bytes"
import "../../../abla-embedded/src/esp32/esp_idf_net.ab"

// A PaperMono in thin mode (SPEC §16): the app's state and handlers run on a server
// (thin_host.ab), which sends the node tree. Layout, scrolling and drawing stay here,
// as in full mode, so a swipe never waits on the network; a tap sends its event, and
// the answer is the new tree. Picked at build time: `make papermono-gallery MODE=thin`.

trusted noescape extern:"c" fun lwip_socket(domain: i32, kind: i32, protocol: i32): i32
trusted noescape extern:"c" fun lwip_connect(socket: i32, address: i64*, length: u32): i32
trusted noescape extern:"c" fun lwip_send(socket: i32, data: i64*, length: u32, flags: i32): i32
trusted noescape extern:"c" fun lwip_recv(socket: i32, data: i64*, length: u32, flags: i32): i32
trusted noescape extern:"c" fun lwip_close(socket: i32): i32

// Where the Wi-Fi and the server are (C strings with their lengths, from a generated
// config that stays out of git). With `tls`, `name` is verified against ESP-IDF's roots.
class OneThinConfig(val ssid: int, val ssidLength: int, val password: int, val passwordLength: int,
    val a: int, val b: int, val c: int, val d: int, val port: int, val tls: bool, val name: int, val nameLength: int, val host: string)

val oneThinRequestStorage = nativeStaticAllocate(512)
val oneThinReceiveStorage = nativeStaticAllocate(2048)
val oneThinAddressStorage = nativeStaticAllocate(16)

trusted fun oneThinSocket(config: OneThinConfig): int {
    val socket = int(lwip_socket(i32(2), i32(1), i32(0)))
    if (socket < 0) return -1
    val address = nativeBufferAt(oneThinAddressStorage, 16)
    var offset = 0
    while (offset < 16) {
        address.storeU32(offset, 0)
        offset = offset + 4
    }
    address.store(0, 16)
    address.store(1, 2)
    address.store(2, (config.port >> 8) & 255)
    address.store(3, config.port & 255)
    address.store(4, config.a)
    address.store(5, config.b)
    address.store(6, config.c)
    address.store(7, config.d)
    val timeout = nativeBufferAt(socketTimeoutStorage, 16)
    timeout.storeU32(0, 5)
    timeout.storeU32(4, 0)
    timeout.storeU32(8, 0)
    timeout.storeU32(12, 0)
    lwip_setsockopt(i32(socket), i32(solSocket), i32(soReceiveTimeout), pointer(socketTimeoutStorage), u32(16))
    lwip_setsockopt(i32(socket), i32(solSocket), i32(soSendTimeout), pointer(socketTimeoutStorage), u32(16))
    if (lwip_connect(i32(socket), pointer(oneThinAddressStorage), u32(16)) != i32(0)) {
        lwip_close(i32(socket))
        return -1
    }
    socket
}

// One request; the response body when it is 200, "" otherwise (204, or no answer).
// A new connection each time: taps are rare, and it survives the server restarting.
trusted fun oneThinRequest(config: OneThinConfig, method: string, path: string): string {
    val head = "$method $path HTTP/1.0\r\nHost: ${config.host}\r\nConnection: close\r\nContent-Length: 0\r\n\r\n"
    if (head.size > 512) return ""
    val out = nativeBufferAt(oneThinRequestStorage, 512)
    var i = 0
    while (i < head.size) {
        out.store(i, head[i])
        i = i + 1
    }
    val connection = if (config.tls) (tlsConnectBundle(config.name, config.nameLength, config.port, 5000)|0) else oneThinSocket(config)
    if (connection <= 0) {
        println("papermono: can't reach the server")
        return ""
    }
    val sent = if (config.tls) TlsConnection(connection).writeAll(oneThinRequestStorage, head.size)
        else int(lwip_send(i32(connection), pointer(oneThinRequestStorage), u32(head.size), i32(0))) == head.size
    var answer = byteBuffer()
    if (sent) {
        val chunk = nativeBufferAt(oneThinReceiveStorage, 2048)
        var quiet = 0
        while (quiet < 100) {
            paperMonoGestureSample()
            val read = if (config.tls) TlsConnection(connection).readSome(oneThinReceiveStorage, 2048)
                else int(lwip_recv(i32(connection), pointer(oneThinReceiveStorage), u32(2048), i32(0)))
            if (read > 0) {
                var at = 0
                while (at < read) {
                    answer.appendByteValue(chunk.load(at))
                    at = at + 1
                }
                quiet = 0
            } else if (config.tls && tlsWouldBlock(read)) {
                delayMilliseconds(5)
                quiet = quiet + 1
            } else quiet = 100
        }
    }
    if (config.tls) TlsConnection(connection).close() else lwip_close(i32(connection))
    val text = answer.toText()
    // (HTTP/1.0 asked: no chunks, the body ends with the connection.)
    val status = if (text.size > 12) text.slice(9, 12) else ""
    if (status != "200") {
        if (status != "204") println("papermono: bad answer: status $status")
        return ""
    }
    var body = 0
    while (body + 3 < text.size && !(text[body] == 13 && text[body + 1] == 10 && text[body + 2] == 13 && text[body + 3] == 10)) body = body + 1
    if (body + 4 <= text.size) text.slice(body + 4, text.size) else ""
}

trusted fun oneThinConnect(config: OneThinConfig): void {
    while (!wifiHasAddress()) {
        if (!wifiJoin(config.ssid, config.ssidLength, config.password, config.passwordLength, 15000)) println("papermono: no Wi-Fi yet")
    }
    return
}

// Runs until the device powers off.
trusted fun onePaperMonoRunThin(theme: Theme, icons: OneIconSource, config: OneThinConfig): void {
    runtimeMemorySetCollectionGrowth(524288)
    runtimeMemorySetLimit(5242880)
    val control = paperMonoOpen()
    if ((control|0) == 0) return
    onePaperMonoClear()
    val session = paperMonoDisplayStart(control)
    if ((session|0) == 0) return
    paperMonoFrontlight(control, 26)
    if (!paperMonoGesturesOpen(control)) println("papermono: no touch")
    val wifi = wifiStart()
    if (wifi != 0) {
        println("papermono: Wi-Fi start failed: $wifi")
        return
    }
    oneThinConnect(config)
    println("papermono: thin, on Wi-Fi")
    var app = oneThinApp()
    var state = oneEpaperState(onePaperMonoOptions())
    state.onBand = { paperMonoGestureSample() }
    var shown = false
    var lastPoll = 0
    var collected = runtimeMemoryLiveBytes()
    while (true) {
        paperMonoGestureSample()
        val gesture = paperMonoGestureTake()
        var draw = false
        val started = onePaperMonoMilliseconds()
        if (gesture == paperMonoGestureTap) {
            val event = oneEpaperPressAt(state, paperMonoGestureAtX(), paperMonoGestureAtY())
            if (event > 0) {
                draw = app.update(oneThinRequest(config, "POST", "/one/thin/event?id=$event"))
                lastPoll = onePaperMonoMilliseconds()
            }
        } else if (gesture == paperMonoGestureSwipe) {
            draw = oneEpaperScroll(state, paperMonoGestureAtX(), paperMonoGestureAtY(), paperMonoGestureTravel())
        } else if (onePaperMonoMilliseconds() - lastPoll > 2000) {
            if (!wifiHasAddress()) oneThinConnect(config)
            draw = app.update(oneThinRequest(config, "GET", "/one/thin/tree?have=${app.revision}"))
            lastPoll = onePaperMonoMilliseconds()
        }
        if (draw || (!shown && app.revision >= 0)) {
            val update = oneEpaperRenderTree(app.tree, theme, state, icons)
            println("papermono: thin revision ${app.revision}, ${update.rects.size} rectangles, mode ${update.mode}, ${onePaperMonoMilliseconds() - started} ms")
            onePaperMonoShow(session, update)
            shown = true
        }
        if (gesture == paperMonoGestureNone) {
            val live = runtimeMemoryLiveBytes()
            if (live < collected) collected = live
            if (live > collected + 262144) {
                runtimeMemoryCollect()
                collected = runtimeMemoryLiveBytes()
            }
            onePaperMonoPause(2)
        }
    }
    return
}
