import "abla/http"
import "abla/io"
import "abla/net"
import "abla/json"
import "abla/crypto"
import "abla/bytes"
import "abla/websocket"
import "abla/process/time"
import "abla/sys/linux/random"
import "abla/sys/linux/process"
import "../one.ab"
import "web_document.ab"
import "web_session.ab"
import "web_recovery_live.ab"
import "../layout/paint.ab"

// Live web (SPEC §10, web-document M2): apps run on the server, one session
// per browser tab. The first request is rendered on the server (SSR) and the
// page then connects to /one/live over WebSocket. Browser events go to the
// session, which re-renders; the server sends the new markup and only the CSS
// rules the page hasn't seen, and the thin host (web/host.js) patches the DOM
// by `data-one` keys. Other HTTP requests go to the application's handler, in
// the same epoll loop and process.
//
// Services in a session: requests to the same origin (a path such as
// /api/mobile) are dispatched in process after the current event; timers run
// in the loop; secure storage is the session's memory. `effect("subscribe",
// topic)` subscribes the session to `oneLiveBroadcast(topic, payload)`, which
// reaches it as `receive("push", payload)`: the server pushes changes instead
// of waiting for a poll.

class OneLiveSlot(
    var descriptor: int,
    var input: string,
    var output: string,
    var outputOffset: int,
    var upgraded: bool,
    var session: string,
    var closing: bool,
    // Tells this connection from an earlier one in the same slot, for tickets.
    var generation: int,
    // A socket of the application's (OneLiveSockets), not a page's.
    var appSocket: bool,
    var recoveryRequest: HttpRequest? = null,
    var awaitingRecovery: bool = false,
    var recoveryMessage: string = "",
    var recoveryStarted: int = 0
)

class OneLiveOptions(
    val title: string,
    val lang: string,
    val background: string,
    val iconBase: string,
    // Path of web/host.js, read once when the server is constructed and
    // served at /one/host.js. Deploy it with the matching server revision.
    val hostScript: string,
    // Extra markup for the document head (fonts, favicons, meta tags).
    val head: string,
    // The first-layout connection state, outside the app while it is held.
    val connectionText: string = "Connecting…",
    val reloadText: string = "Reload"
)

// Seeds a new session's secure storage from the page request, and maps stored
// values back to cookies. Storage is the app's; cookies let a later page load
// (or another server process) continue where the session left off, for
// example after the session rotated its tokens. An empty value means the key
// was removed. `resumes` says whether a request's credentials may continue a session
// holding these values, on a page load or a new socket: a session outlives neither the
// credentials it was opened with nor the person's signing out elsewhere. Refused, the
// session ends and the page starts a new one from the request.
class OneLiveStorage(
    val seed: (HttpRequest) -> Map<string, string>,
    val cookies: (HttpRequest, string, string) -> array<string>,
    val resumes: (HttpRequest, Map<string, string>) -> bool
)

// WebSockets of the application's own, on the server's port and in its loop, such
// as a worker that dials in. `claims` picks the upgrade requests; each connection is
// known by its ticket, for `OneLiveServer.sendSocket` and `closeSocket`. A handler
// runs mid-loop, so one that wants to send queues it for after `step`.
class OneLiveSockets(
    val claims: (HttpRequest) -> bool,
    val opened: (int, HttpRequest) -> void,
    val message: (int, string) -> void,
    val closed: (int) -> void
)

fun oneLiveNoSockets(): OneLiveSockets = OneLiveSockets({ request -> false }, { ticket, request -> return }, { ticket, text -> return }, { ticket -> return })

fun oneLiveNoDefers(): (HttpRequest, int) -> bool {
    val none: (HttpRequest, int) -> bool = { request, ticket -> false }
    none
}

fun oneLiveNoStorage(): OneLiveStorage = OneLiveStorage({ request -> Map<string, string>() }, { request, key, value -> array<string>() }, { request, stored -> true })

// Host-only context for an in-process service call. It is never decoded from
// a browser message or request header, nor saved in a UI checkpoint. Cookie
// bytes are transport input, not verified authentication: the app must validate
// its own signed nonce/session. Synthetic HTTP requests retain no socket peer.
class OneLiveBrowserContext(val cookie: string, val peerAddress: SocketPeerAddress? = null)
class OneLiveCallContext(val requestId: int, val operation: string, val session: string, val epoch: int, val browser: OneLiveBrowserContext? = null)
class OneLivePrivateRequests(val handle: (HttpRequest, OneLiveCallContext) -> HttpResponse)
// Admission of actual browser HTTP only, before any page/asset/upload/defer or
// WebSocket branch. Null admits; a response refuses and closes the connection.
// Internal renderer RPC is governed by the application's private callback.
class OneLiveRequestAdmission(val check: (HttpRequest) -> HttpResponse?)

class OneEphemeralUpload(val request: HttpRequest, val ticket: int)

resource class OneLiveServer(
    val handler: (HttpRequest) -> HttpResponse,
    // Which requests are live pages (SSR + session) instead of handler requests:
    // a predicate of the app's, or `oneLivePaths([...])`. /one/* never is.
    val isPage: (HttpRequest) -> bool,
    // Creates the app for a new session from the page request (cookies,
    // query) and the session id; give the app `oneLiveServices(session)`.
    val factory: (HttpRequest, string) -> OneApp,
    val theme: Theme,
    val options: OneLiveOptions,
    val storage: OneLiveStorage,
    val sockets: OneLiveSockets,
    // Takes a request whose answer isn't ready, with the ticket to give
    // `OneLiveServer.answer` later. False leaves it to `handler`.
    val defers: (HttpRequest, int) -> bool,
    val listener: TcpListener,
    val poller: SocketPoller,
    val slots: array<OneLiveSlot>,
    val sessions: array<OneLiveSession>,
    var stopped: bool,
    val recovery: OneLiveRecoveryStore,
    val recoveryOwner: string,
    // Pin the thin client to this running server. A later build may replace
    // the source tree, but must not change the protocol of an existing node.
    val hostSource: string,
    val privateRequests: OneLivePrivateRequests? = null,
    val browserContexts: Map<string, OneLiveBrowserContext> = Map(),
    val admission: OneLiveRequestAdmission? = null,
    val ephemeralUploads: array<OneEphemeralUpload> = []
) {
    fun drop(): void {
        for (session in sessions) {
            val state = oneRecoverySessions.get(session.id)
            if (state != null && state.owner == recoveryOwner) oneRecoveryRawDrop(state)
        }
        for (slot in slots) if (slot.descriptor >= 0) linuxTcpCloseDescriptor(slot.descriptor)
        poller.close()
        listener.close()
        stopped = true
        return
    }
}

// Topics and payloads broadcast during this loop iteration, delivered to
// subscribed sessions before the next render.
val oneLiveBroadcasts: array<string> = []

fun oneLiveBroadcast(topic: string, payload: string): void {
    oneLiveBroadcasts.append(topic)
    oneLiveBroadcasts.append(payload)
    return
}

fun oneLiveServer(
    address: Ipv4SocketAddress,
    handler: (HttpRequest) -> HttpResponse,
    isPage: (HttpRequest) -> bool,
    factory: (HttpRequest, string) -> OneApp,
    theme: Theme,
    options: OneLiveOptions,
    storage: OneLiveStorage = oneLiveNoStorage(),
    sockets: OneLiveSockets = oneLiveNoSockets(),
    defers: (HttpRequest, int) -> bool = oneLiveNoDefers(),
    recovery: OneLiveRecoveryStore = oneLiveNoRecovery(),
    privateRequests: OneLivePrivateRequests? = null,
    admission: OneLiveRequestAdmission? = null
): OneLiveServer {
    val listener = tcpListenAddress(address, 1024)
    listener.setNonblocking()
    val poller = socketPoller()
    if (listener.descriptor >= 0 && poller.descriptor >= 0) poller.watchDescriptor(listener.descriptor)
    OneLiveServer(handler, isPage, factory, theme, options, storage, sockets, defers, move(listener), move(poller), [], [], false, recovery, oneLiveSessionId(), linuxReadFile(options.hostScript,1048576), privateRequests, Map(), admission)
}

// Retain transport origin only when an app opted into the private callback.
// Never use a Cookie header supplied by a renderer's OneRequest here.
fun OneLiveServer.rememberBrowser(id: string,request: HttpRequest): void {
    if(privateRequests!=null)browserContexts.set(id,OneLiveBrowserContext(request.header("cookie"),request.peerAddress))
    return
}

// Claims the paths an app declares, as `isPage`: "/people", "/form/:n", "/docs/*".
fun oneLivePaths(patterns: array<string>): (HttpRequest) -> bool {
    val claim: (HttpRequest) -> bool = { request ->
        var claimed = false
        for (pattern in patterns) if (oneRouteMatches(pattern, request.path)) claimed = true
        claimed
    }
    claim
}

// The server's own: never a page, whatever an app's predicate says.
fun oneLiveReserved(path: string): bool = path == "/one" || path.startsWith("/one/")

// The route a request asks for.
fun oneLiveRoute(request: HttpRequest): string =
    oneRoutePath(if (request.query != "") "${request.path}?${request.query}" else request.path)

// A JSON string for inside a <script>: a route comes from the request.
fun oneLiveScriptString(value: string): string {
    val text = jsonStringify(jsonString(value))
    var out = ""
    var start = 0
    var i = 0
    while (i < text.size) {
        if (text[i] == 60) {
            out = "$out${text.slice(start, i)}\\u003c"
            start = i + 1
        }
        i = i + 1
    }
    "$out${text.slice(start, text.size)}"
}

fun oneLiveSessionId(): string = hexEncode(secureRandomBytes(16).bytes)

// Native shared-store jobs use fresh IDs; keep OS entropy out of the Wasm session codec.
fun oneRecoveryRawReadId(): int {
    // Fresh per attempt (including a new owner epoch). A consumed job cannot
    // recreate its deleted inbox row, so replay must not reuse its ID.
    val random=secureRandomBytes(7).bytes
    if(random.size!=7)return 0
    var value=0
    var at=0
    for(b in random){value=if(at==0)b%16 else value*256+b;at=at+1}
    -(oneRecoveryRawIdBase+value)
}

fun OneLiveServer.findSession(id: string): int {
    var i = 0
    while (i < sessions.size) {
        if (sessions[i].id == id) return i
        i = i + 1
    }
    -1
}

fun OneLiveServer.findSlot(descriptor: int): int {
    var i = 0
    while (i < slots.size) {
        if (slots[i].descriptor == descriptor) return i
        i = i + 1
    }
    -1
}

fun OneLiveServer.queue(slot: int, bytes: string): void {
    if (slot < 0 || slots[slot].descriptor < 0) return
    if (slots[slot].output.size + bytes.size > 8388608) {
        closeSlot(slot)
        return
    }
    slots[slot].output = "${slots[slot].output}$bytes"
    poller.modifyDescriptor(slots[slot].descriptor, true, true)
    return
}

// Slots are reused, so a ticket also names the connection, and one from a closed
// connection finds nothing.
fun OneLiveServer.ticket(slot: int): int = slots[slot].generation * 65536 + slot

fun OneLiveServer.ticketSlot(ticket: int): int {
    val slot = ticket % 65536
    if (ticket >= 0 && slot < slots.size && slots[slot].descriptor >= 0 && this.ticket(slot) == ticket) slot else -1
}

// Answers a deferred request. False when its connection has gone.
fun OneLiveServer.answer(ticket: int, response: HttpResponse): bool {
    val slot = ticketSlot(ticket)
    if (slot < 0 || slots[slot].upgraded) return false
    queue(slot, response.render())
    if (slots[slot].descriptor < 0) return false
    slots[slot].closing = true
    true
}

fun OneLiveServer.sendSocket(ticket: int, text: string): bool {
    val slot = ticketSlot(ticket)
    if (slot < 0 || !slots[slot].appSocket) return false
    queue(slot, webSocketEncodeFrame(text, 1))
    slots[slot].descriptor >= 0
}

fun OneLiveServer.closeSocket(ticket: int, code: int, reason: string): void {
    val slot = ticketSlot(ticket)
    if (slot < 0 || !slots[slot].appSocket) return
    queue(slot, webSocketEncodeFrame(webSocketClosePayload(code, reason), 8))
    if (slots[slot].descriptor >= 0) slots[slot].closing = true
    return
}

fun OneLiveServer.closeSlot(slot: int): void {
    if (slot < 0 || slots[slot].descriptor < 0) return
    poller.unwatchDescriptor(slots[slot].descriptor)
    linuxTcpCloseDescriptor(slots[slot].descriptor)
    if (slots[slot].appSocket) {
        val closed = sockets.closed
        closed(this.ticket(slot))
    }
    slots[slot].generation = slots[slot].generation + 1
    slots[slot].appSocket = false
    val session = findSession(slots[slot].session)
    if(session>=0 && sessions[session].slot==slot && sessions[session].queue.ephemeralDeadline>0){
        sessions[session].queue.clearEphemeral()
        sessions[session].app.receive("ephemeral-expired","")
        sessions[session].changed=true
    }
    if (session >= 0 && sessions[session].slot == slot) sessions[session].slot = -1
    slots[slot].descriptor = -1
    slots[slot].input = ""
    slots[slot].output = ""
    slots[slot].outputOffset = 0
    slots[slot].upgraded = false
    slots[slot].session = ""
    slots[slot].closing = false
    slots[slot].recoveryRequest = null
    slots[slot].awaitingRecovery = false
    slots[slot].recoveryMessage = ""
    slots[slot].recoveryStarted = 0
    return
}

// Ends a session now: its page is told to reload, and nothing of it stays to resume.
fun OneLiveServer.endSession(index: int): void {
    val id = sessions[index].id
    val ending = oneRecoverySessions.get(id)
    if (ending != null) {
        ending.ending = true
        oneRecoveryRawDrop(ending)
    }
    val slot = sessions[index].slot
    if (slot >= 0 && slots[slot].descriptor >= 0) {
        queue(slot, webSocketEncodeFrame(webSocketClosePayload(1008, "session ended"), 8))
        if (slots[slot].descriptor >= 0) {
            slots[slot].session = ""
            slots[slot].closing = true
        }
    }
    browserContexts.remove(id)
    oneLiveForget(id)
    oneMemoForget(id)
    val kept: array<OneLiveSession> = []
    var i = 0
    while (i < sessions.size) {
        if (i != index) kept.append(sessions[i])
        i = i + 1
    }
    sessions.clear()
    for (session in kept) sessions.append(session)
    return
}

// The session a request names, if its credentials may continue it; one they may not is over.
fun OneLiveServer.resumable(request: HttpRequest, id: string): int {
    val index = findSession(id)
    if (index < 0 || storage.resumes(request, sessions[index].queue.storage)) return index
    endSession(index)
    -1
}

fun OneLiveServer.accept(): void {
    var accepting = true
    while (accepting) {
        val connection = listener.accept()
        if (connection.descriptor < 0) accepting = false
        else {
            connection.setNonblocking()
            val descriptor = connection.descriptor
            connection.descriptor = -1
            var slot = -1
            var i = 0
            while (slot < 0 && i < slots.size) {
                if (slots[i].descriptor < 0) slot = i
                i = i + 1
            }
            if (slot < 0) slots.append(OneLiveSlot(descriptor, "", "", 0, false, "", false, 1, false))
            else {
                slots[slot].descriptor = descriptor
                slots[slot].input = ""
            }
            poller.watchDescriptor(descriptor)
        }
    }
    return
}

fun oneLiveContentLength(request: HttpRequest): int = oneParseInt(request.header("content-length"), 0)

fun OneLiveServer.read(slot: int): void {
    val connection = TcpConnection(slots[slot].descriptor)
    val incoming = connection.readResult(65536)
    connection.descriptor = -1
    if (incoming.hasData()) {
        slots[slot].input = "${slots[slot].input}${incoming.bytes}"
        if (slots[slot].upgraded) frames(slot) else http(slot)
    } else if (incoming.reachedEof() || (incoming.failed() && incoming.errorCode != 11)) closeSlot(slot)
    return
}

fun OneLiveServer.write(slot: int): void {
    if (slots[slot].outputOffset >= slots[slot].output.size) return
    val connection = TcpConnection(slots[slot].descriptor)
    val written = connection.writeResult(slots[slot].output.slice(slots[slot].outputOffset, slots[slot].output.size))
    connection.descriptor = -1
    slots[slot].outputOffset = slots[slot].outputOffset + written.written
    if (written.failed() && written.errorCode != 11) closeSlot(slot)
    else if (slots[slot].outputOffset >= slots[slot].output.size) {
        slots[slot].output = ""
        slots[slot].outputOffset = 0
        if (slots[slot].closing) closeSlot(slot)
        else poller.modifyDescriptor(slots[slot].descriptor, true, false)
    }
    return
}

// One complete HTTP request: a WebSocket upgrade, the host script, a live
// page, or the application's handler. Plain HTTP connections close after the
// response. The request carries the accepted socket peer (`request.peerAddress`),
// never one taken from forwarding headers; same-origin requests run in process
// (oneLiveExecute) carry none.
fun OneLiveServer.http(slot: int): void {
    httpWithPeer(slot, socketPeerAddress(slots[slot].descriptor))
    return
}

fun OneLiveServer.httpWithPeer(slot: int, peer: SocketPeerAddress?): void {
    val input = slots[slot].input
    val end = httpHeaderEnd(input)
    if (end < 0) {
        if (input.size > 65536) closeSlot(slot)
        return
    }
    val head = httpParseRequest(input.slice(0, end))
    val length = oneLiveContentLength(head)
    if (input.size < end + length) {
        if (length > 16777216) closeSlot(slot)
        return
    }
    val request = httpRequestWithAddress(httpParseRequest(input.slice(0, end + length)), peer)
    slots[slot].input = input.slice(end + length, input.size)
    val admission = this.admission
    if (admission != null) {
        val refusal = admission.check(request)
        if (refusal != null) {
            queue(slot, if(request.method=="HEAD")refusal.renderHead()else refusal.render())
            slots[slot].closing = true
            return
        }
    }
    if (request.path == "/one/live" && webSocketIsUpgradeRequest(request)) {
        val id = request.queryParameter("s")
        if(!recovery.enabled && request.queryParameter("recovery")=="1") {
            queue(slot,webSocketUpgradeResponse(request).render())
            queue(slot,webSocketEncodeFrame(webSocketClosePayload(1013,"recovery unavailable"),8))
            slots[slot].closing=true
            return
        }
        if (recoveryRequired(id)) {
            if (!oneRecoveryIdentifier(id)) { queue(slot, httpText("Invalid session", 400).render()); slots[slot].closing = true; return }
            slots[slot].recoveryRequest = oneRecoveryAttachRequest(request)
            slots[slot].awaitingRecovery = true
            slots[slot].recoveryStarted = oneLiveNow()
            slots[slot].upgraded = true
            slots[slot].session = id
            queue(slot, webSocketUpgradeResponse(request).render())
            frames(slot)
            return
        }
        // A session's first socket comes from the page load that just opened it or passed the check.
        val session = if (findSession(id) >= 0 && !sessions[findSession(id)].connected) findSession(id) else resumable(request, id)
        if (session < 0) {
            // The server restarted, the session expired or its credentials are gone: the page reloads.
            queue(slot, webSocketUpgradeResponse(request).render())
            queue(slot, webSocketEncodeFrame(webSocketClosePayload(1008, "unknown session"), 8))
            slots[slot].closing = true
            return
        }
        rememberBrowser(id,request)
        if (sessions[session].slot >= 0 && sessions[session].slot != slot) closeSlot(sessions[session].slot)
        sessions[session].slot = slot
        sessions[session].connected = true
        sessions[session].changed = true
        sessions[session].htmlSent = ""
        // The first legacy patch may leave before hello arrives. It must carry
        // the same saved counters as hello so a fresh host does not start at0.
        sessions[session].changeAnswer = sessions[session].changeFrontier
        sessions[session].routeAnswer = sessions[session].routeFrontier
        slots[slot].upgraded = true
        slots[slot].session = id
        queue(slot, webSocketUpgradeResponse(request).render())
        frames(slot)
        return
    }
    val claims = sockets.claims
    if (webSocketIsUpgradeRequest(request) && !oneLiveReserved(request.path) && claims(request)) {
        slots[slot].upgraded = true
        slots[slot].appSocket = true
        queue(slot, webSocketUpgradeResponse(request).render())
        val opened = sockets.opened
        if (slots[slot].descriptor >= 0) opened(this.ticket(slot), request)
        if (slots[slot].descriptor >= 0) frames(slot)
        return
    }
    if(!recovery.enabled && request.header("x-one-proof")!="" && (request.path=="/one/upload" || request.path=="/one/cookies")) {
        queue(slot,httpText("Session recovery unavailable",503).render())
        slots[slot].closing=true
        return
    }
    val defers = this.defers
    if (!oneLiveReserved(request.path) && defers(request, this.ticket(slot))) return
    if(request.path=="/one/upload" && request.method=="POST" && (request.queryParameter("kind")=="files-ephemeral" || request.queryParameter("kind")=="ephemeral-cancel")){
        for(job in ephemeralUploads)if(job.request.queryParameter("s")==request.queryParameter("s") && job.request.queryParameter("id")==request.queryParameter("id")){
            queue(slot,httpText("Ephemeral picker already pending",409).render());slots[slot].closing=true;return
        }
        var bytes=request.body.size
        for(job in ephemeralUploads)bytes=bytes+job.request.body.size
        if(ephemeralUploads.size>=16 || bytes>67108864){queue(slot,httpText("Ephemeral file capacity unavailable",429).render());slots[slot].closing=true;return}
        val response=ephemeralUpload(request)
        if(response.status==202)ephemeralUploads.append(OneEphemeralUpload(request,this.ticket(slot)))
        else{queue(slot,response.render());slots[slot].closing=true}
        return
    }
    if (request.path == "/one/upload" && request.method == "POST" && recoveryRequired(request.queryParameter("s"))) {
        val start = recovery.upload
        if (start(request, this.ticket(slot))) return
        queue(slot, httpText("Storage unavailable", 503).render())
        slots[slot].closing = true
        return
    }
    val response = if (request.path == "/one/upload" && request.method == "POST") upload(request)
        else if (request.path == "/one/cookies") cookies(request)
        else if (request.path == "/one/host.js")
        HttpResponse(200, [HttpHeader("Content-Type", "text/javascript; charset=utf-8"), HttpHeader("Cache-Control", "no-cache")], hostSource)
        else if (request.path == "/one/canvas.js")
        HttpResponse(200, [HttpHeader("Content-Type", "text/javascript; charset=utf-8"), HttpHeader("Cache-Control", "no-cache")], linuxReadFile(oneLiveSibling(options.hostScript, "canvas.js"), 1048576))
        else if (request.path.size > 11 && request.path.slice(0, 11) == "/one/fonts/" && oneLiveFontName(request.path.slice(11, request.path.size)))
        HttpResponse(200, [HttpHeader("Content-Type", "font/ttf"), HttpHeader("Cache-Control", "max-age=86400")], linuxReadFile("${oneLiveSibling(options.hostScript, "")}../../../assets/fonts/${request.path.slice(11, request.path.size)}", 1048576))
        else if (request.method == "GET" && !oneLiveReserved(request.path) && isPage(request)) page(request)
        else handler(request)
    val rendered = if (request.method == "HEAD") response.renderHead() else response.render()
    if (response.status == 202 && response.header("X-One-Recovery-Pending") != "") {
        recoveryWaitHttp(slot, request, response)
        return
    }
    queue(slot, rendered)
    slots[slot].closing = true
    return
}

// Uploads from the page's file pickers. ?s=session&id=request&kind=...:
// "profile"/"emoji" carry the normalized image as base64 text, "files" one
// raw file per request (X-One-Name, Content-Type; X-One-Last on the final
// one), "cancel" an empty body.
fun OneLiveServer.upload(request: HttpRequest): HttpResponse {
    val index = findSession(request.queryParameter("s"))
    if (index < 0) return httpText("unknown session", 404)
    val id = oneParseInt(request.queryParameter("id"), 0)
    val kind = request.queryParameter("kind")
    if (kind == "cancel") {
        sessions[index].queue.complete(oneResponsePayload(id, 204, if (request.queryParameter("files") == "1") "[]" else "", ""))
    } else if (kind == "profile" || kind == "emoji") {
        sessions[index].queue.complete(oneResponsePayload(id, 200, request.body, ""))
    } else {
        val handle = "file-${oneLiveSessionId()}"
        val info = jsonObject(["handle", "name", "size", "mime"], [jsonString(handle), jsonString(oneUrlDecode(request.header("x-one-name"))), jsonInteger(request.body.size), jsonString(if (request.header("content-type") != "") request.header("content-type") else "application/octet-stream")])
        sessions[index].queue.addFile(handle, request.body, jsonStringify(info))
        val picked = request.queryParameter("picked")
        val all = if (picked == "") handle else "$picked,$handle"
        if (request.header("x-one-last") == "1") {
            val files: array<Json> = []
            var start = 0
            var i = 0
            while (i <= all.size) {
                if (i == all.size || all[i] == 44) {
                    val stored = sessions[index].queue.fileInfo.get(all.slice(start, i))
                    if (stored != null) files.append(jsonParse(stored).value)
                    start = i + 1
                }
                i = i + 1
            }
            sessions[index].queue.complete(oneResponsePayload(id, 200, jsonStringify(jsonArray(files)), ""))
        }
        return HttpResponse(200, [HttpHeader("Content-Type", "text/plain"), HttpHeader("Cache-Control", "no-store")], handle)
    }
    HttpResponse(204, [HttpHeader("Cache-Control", "no-store")], "")
}

fun oneEphemeralProofEqual(a: string,b: string): bool {
    if(a.size!=b.size)return false
    var difference=0
    for(i in 0 until a.size)difference=difference | (a[i] ^ b[i])
    difference==0
}

// Only authorization metadata is offered to inspect; never the file body or
// its original name. Asynchronous inspection leaves bytes only in this node's
// bounded pending array, not in the recovery upload/blob/inbox path.
fun oneEphemeralInspectRequest(request: HttpRequest): HttpRequest {
    val headers: array<HttpHeader> = []
    for(header in request.headers)if(header.name.lowercase()!="x-one-name" && header.name.lowercase()!="content-length")headers.append(header)
    HttpRequest(request.method,request.path,request.query,headers,"",request.parameterNames,request.parameterValues,request.peerAddress)
}

fun OneLiveServer.ephemeralUpload(request: HttpRequest): HttpResponse {
    if(request.method!="POST")return httpText("Method not allowed",405)
    if(request.queryParameter("kind")!="files-ephemeral" && request.queryParameter("kind")!="ephemeral-cancel")return httpText("Invalid ephemeral operation",400)
    val index=findSession(request.queryParameter("s"))
    if(index<0)return httpText("Ephemeral session unavailable",404)
    sessions[index].queue.expireEphemeral(oneLiveNow())
    val id=oneParseInt(request.queryParameter("id"),0)
    val picker=sessions[index].queue.ephemeralPickers.get(id)
    if(id<1 || picker==null)return httpText("Ephemeral picker unavailable",410)
    if(!oneEphemeralProofEqual(request.queryParameter("nonce"),picker.nonce))return httpText("Ephemeral picker changed",403)
    val state=oneRecoverySessions.get(sessions[index].id)
    if(state!=null){
        val proof=request.header("x-one-proof")
        if(!state.ready || state.ending || picker.epoch!=state.epoch || !oneRecoveryIdentifier(proof) || !oneEphemeralProofEqual(proof,state.proof))return httpText("Ephemeral session unavailable",403)
        // An asynchronous fence is not a refusal. Keep this bounded upload in
        // the existing volatile pending array until authority settles, then
        // repeat every identity/proof/epoch and current-source check.
        if(state.status==202)return httpText("Ephemeral authorization pending",202)
        if(state.status!=200)return httpText("Ephemeral session unavailable",403)
        val checked=recovery.inspect(oneEphemeralInspectRequest(request),sessions[index].id,proof)
        if(checked.status!=200)return httpText("Ephemeral authorization pending",checked.status)
        if(checked.epoch!=state.epoch)return httpText("Ephemeral session changed",409)
    }else if(recovery.enabled && sessions[index].recoveryEligible)return httpText("Ephemeral session unavailable",503)
    if(request.queryParameter("kind")=="ephemeral-cancel"){
        if(request.body.size!=0)return httpText("Invalid ephemeral cancellation",400)
        sessions[index].queue.ephemeralPickers.remove(id)
        sessions[index].queue.complete(oneResponsePayload(id,204,"[]",""))
        return HttpResponse(204,[HttpHeader("Cache-Control","no-store")],"")
    }
    if(request.queryParameter("picked")!="" || request.header("x-one-last")!="1" || request.body.size==0 || request.body.size>picker.maximumBytes)return httpText("Invalid ephemeral file",413)
    val name=oneUrlDecode(request.header("x-one-name"))
    if(name.size>1024)return httpText("Invalid ephemeral file name",400)
    val handle="ephemeral-file-${oneLiveSessionId()}"
    val info=jsonObject(["handle","name","size","mime"],[jsonString(handle),jsonString(name),jsonInteger(request.body.size),jsonString(request.header("content-type"))])
    sessions[index].queue.addFile(handle,request.body,jsonStringify(info));sessions[index].queue.ephemeralFiles.set(handle,picker.expires)
    sessions[index].queue.ephemeralPickers.remove(id)
    sessions[index].queue.complete(oneResponsePayload(id,200,jsonStringify(jsonArray([info])),""))
    HttpResponse(200,[HttpHeader("Cache-Control","no-store"),HttpHeader("Content-Type","text/plain")],handle)
}

// The cookies for a session's stored values, fetched by the page after the
// session reports a change (`{"t":"cookies"}`).
fun OneLiveServer.cookies(request: HttpRequest): HttpResponse {
    if (recoveryRequired(request.queryParameter("s"))) return recoveryCookies(request)
    val index = findSession(request.queryParameter("s"))
    val headers: array<HttpHeader> = [HttpHeader("Cache-Control", "no-store")]
    if (index >= 0) for (line in sessionCookies(request, index)) headers.append(HttpHeader("Set-Cookie", line))
    HttpResponse(204, headers, "")
}

fun OneLiveServer.sessionCookies(request: HttpRequest, index: int): array<string> {
    val out: array<string> = []
    val stored = sessions[index].queue.storage
    for (key in stored.keys()) {
        val value = stored.get(key)
        if (value != null) for (line in storage.cookies(request, key, value)) out.append(line)
    }
    sessions[index].queue.cookiesChanged = false
    out
}

fun oneLiveSibling(path: string, name: string): string {
    var end = path.size
    while (end > 0 && path[end - 1] != 47) end = end - 1
    "${path.slice(0, end)}$name"
}

fun oneLiveFontName(name: string): bool = name == "Inter-400.ttf" || name == "Inter-500.ttf" || name == "Inter-600.ttf" || name == "Inter-700.ttf"

// A live page. Each tab has its own session: a reload resumes the session
// its tab just left (the host sets a short-lived `one_resume` cookie when the
// page hides, unless a link was followed from it), and any other request starts a
// new session seeded from the request. The page is rendered with the session's
// current state, at the route the request names: a new session starts there, and
// one resumed at another route (a URL typed in the same tab) moves there. Resuming
// asks `storage.resumes` first. A resumed session's app hears `receive("pageLoad", "")`, before the page renders.
fun OneLiveServer.page(request: HttpRequest): HttpResponse {
    val route = oneLiveRoute(request)
    var index = if (recovery.enabled) -1 else resumable(request, oneLiveCookie(request, "one_resume"))
    // Recovery claims belong to a browser tab, never origin-wide cookies.
    // SSR stays readable and starts fresh; a reloaded tab presents its opaque
    // claim over the authenticated WebSocket before any controls are accepted.
    if (index < 0) {
        val id = oneLiveSessionId()
        val queueIndex = oneLiveQueueIndex(id)
        val seeded = storage.seed(request)
        for (key in seeded.keys()) {
            val value = seeded.get(key)
            if (value != null) oneLiveQueueList[queueIndex].storage.set(key, value)
        }
        oneLiveQueueList[queueIndex].browser = true
        oneLiveQueueList[queueIndex].routes.start(route)
        rememberBrowser(id,request)
        val app = factory(request, id)
        sessions.append(oneSession(id, app, oneLiveQueueList[queueIndex]))
        index = sessions.size - 1
        if(recovery.enabled)sessions[index].recoveryEligible=recovery.participates(request)
    } else {
        if (oneRouteWithoutHash(sessions[index].queue.routes.current()) != route) sessions[index].queue.routes.arrive(route, sessions[index].queue.routes.fresh())
        // The person asked for the page again: what the app read earlier may have changed since, so it hears of it.
        if (!recovery.enabled) sessions[index].receive("pageLoad", "")
    }
    rememberBrowser(sessions[index].id,request)
    pageRender(request, index)
}

fun OneLiveServer.pageRender(request: HttpRequest, index: int): HttpResponse {
    val route = oneLiveRoute(request)
    sessions[index].lastSeen = oneLiveNow()
    // The remembered width improves the SSR/no-JS guess. It does not acknowledge
    // the layout of this browser: scripted pages still wait for their viewport.
    val remembered = oneParseInt(oneLiveCookie(request, "one_width"), 0)
    if (remembered > 0) sessions[index].width = remembered
    val canvas = request.queryParameter("render") == "canvas"
    // Settle work that completes without waiting (storage, in-process requests),
    // so the first paint shows content rather than a loading state.
    var rounds = 0
    while (rounds < 16 && pump(index)) rounds = rounds + 1
    val restoring = oneRecoverySessions.get(sessions[index].id)
    if (restoring != null && restoring.restored && !restoring.ready) return oneRecoveryPendingResponse("render", sessions[index].id)
    // The first paint is always a document (canvas pages show it until the
    // canvas takes over); a canvas session switches after.
    sessions[index].canvas = false
    val markup = sessions[index].render(theme, options.iconBase)
    sessions[index].shown = sessions[index].maps[sessions[index].maps.size - 1].screen
    sessions[index].canvas = canvas
    // A redirect while settling: the page starts at where the app went.
    sessions[index].queue.takeMoves()
    sessions[index].routeAnswer = 0
    val settled = oneRouteWithoutHash(sessions[index].queue.routes.current())
    sessions[index].cssSent = sessions[index].css.rules.size
    sessions[index].htmlSent = markup
    val recoveryStatus = recoveryStart(request, index)
    if (recoveryStatus == 202) return oneRecoveryPendingResponse("render", sessions[index].id)
    if (recoveryStatus != 200) return httpText("Session storage unavailable", recoveryStatus)
    val recoverable = oneRecoverySessions.get(sessions[index].id)
    val proof = if (recoverable != null) ",\"proof\":${oneLiveScriptString(recoverable.proof)}" else ""
    val boot = "{\"s\":\"${sessions[index].id}\",\"r\":${sessions[index].revision},\"icons\":\"${options.iconBase}\"$proof${if (settled != route) ",\"route\":${oneLiveScriptString(settled)}" else ""}}"
    val session = sessions[index]
    val fill = if (session.document) "min-height:100%" else "height:100%"
    val body = "<!doctype html><html lang=\"${oneHtmlEscape(if (session.lang != "") session.lang else options.lang)}\"><head><meta charset=\"utf-8\"><base href=\"${oneRouteBase(route)}\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\"><title>${oneHtmlEscape(if (session.title != "") session.title else options.title)}</title>${session.meta}${options.head}" +
        "<style>html,body{margin:0;height:100%;background:${options.background}}#one-root{$fill}#one-root>.one{$fill}\n${oneWebBaseCss()}</style><style id=\"one-css\">${sessions[index].css.text()}</style>" +
        "${if (canvas) "" else oneLiveHoldFirstPaint}${if (canvas) "" else oneWebEarlyEvents}<script>window.__one=$boot</script><script src=\"one/${if (canvas) "canvas" else "host"}.js\" defer></script></head><body>${if (canvas) "" else oneLiveConnection(options, route)}<div id=\"one-root\">$markup</div></body></html>"
    val headers = [
        HttpHeader("Content-Type", "text/html; charset=utf-8"),
        HttpHeader("Cache-Control", "no-store"),
        HttpHeader("Set-Cookie", "one_resume=; SameSite=Lax; Max-Age=0"),
        HttpHeader("Set-Cookie", "one_resume_proof=; SameSite=Lax; Max-Age=0")
    ]
    if (recoverable != null) {
        for (line in recoverable.pageCookies) headers.append(HttpHeader("Set-Cookie", line))
        recoverable.pageCookies.clear()
    }
    if (sessions[index].queue.cookiesChanged) for (line in sessionCookies(request, index)) headers.append(HttpHeader("Set-Cookie", line))
    HttpResponse(200, headers, body)
}

// A remembered width is only an SSR hint. With JS, a page becomes interactive
// after host.js applies the matching viewport acknowledgement. Without JS the
// attribute is never set, so the server-rendered page remains readable.
val oneLiveHoldFirstPaint = "<style>#one-connecting{display:none}[data-one-held] #one-root{visibility:hidden}[data-one-held] #one-connecting{display:flex;position:fixed;inset:0;align-items:center;justify-content:center;flex-direction:column;gap:16px;padding:24px;background:Canvas;color:CanvasText;font:16px system-ui}#one-connecting a{color:inherit}</style><script>document.documentElement.setAttribute('data-one-held','');document.addEventListener('click',e=>{if(e.target.closest&&e.target.closest('#one-connecting a')){e.preventDefault();location.reload()}})</script>"
fun oneLiveConnection(options: OneLiveOptions, route: string): string =
    "<div id=\"one-connecting\"><span role=\"status\" aria-live=\"polite\">${oneHtmlEscape(options.connectionText)}</span><a href=\"${oneHtmlEscape(route)}\">${oneHtmlEscape(options.reloadText)}</a></div>"

fun oneLiveCookie(request: HttpRequest, name: string): string {
    val header = request.header("cookie")
    var start = 0
    while (start < header.size) {
        var end = start
        while (end < header.size && header[end] != 59) end = end + 1
        var part = header.slice(start, end)
        while (part.size > 0 && part[0] == 32) part = part.slice(1, part.size)
        if (part.size > name.size && part.slice(0, name.size + 1) == "$name=") return part.slice(name.size + 1, part.size)
        start = end + 1
    }
    ""
}

fun OneLiveServer.frames(slot: int): void {
    var processing = true
    while (processing && slots[slot].descriptor >= 0) {
        val decoded = webSocketDecodeFrame(slots[slot].input, 4194304, true)
        if (decoded.error != "") {
            queue(slot, webSocketEncodeFrame(webSocketClosePayload(1002, "protocol error"), 8))
            slots[slot].closing = true
            processing = false
        } else if (!decoded.complete) processing = false
        else {
            slots[slot].input = slots[slot].input.slice(decoded.consumed, slots[slot].input.size)
            val frame = decoded.frame
            if (frame.opcode == 9) queue(slot, webSocketEncodeFrame(frame.payload, 10))
            else if (frame.opcode == 8) {
                queue(slot, webSocketEncodeFrame(frame.payload, 8))
                slots[slot].closing = true
                processing = false
            } else if (frame.opcode == 1) {
                if (slots[slot].appSocket) {
                    val received = sockets.message
                    received(this.ticket(slot), frame.payload)
                } else message(slot, frame.payload)
            }
        }
    }
    return
}

// Messages from the page host: {"t":"event","r":revision,"id":n,"v":value}
// and {"t":"hello"} after (re)connecting.
fun OneLiveServer.message(slot: int, payload: string): void {
    if (slots[slot].awaitingRecovery) { recoveryHello(slot, payload); return }
    val index = findSession(slots[slot].session)
    if (index < 0) return
    val parsed = jsonParse(payload)
    if (!parsed.succeeded) return
    val m = parsed.value
    if(m.getString("t")=="ephemeral-discard"){
        if(sessions[index].queue.ephemeralDeadline>0){
            sessions[index].queue.clearEphemeral()
            sessions[index].app.receive("ephemeral-expired","")
            sessions[index].changed=true
        }
        return
    }
    // Direct uploads stay out of recovery: their files live in the page.
    if(oneDirectAnswer(sessions[index].queue,m)){sessions[index].changed=true;return}
    if(m.getString("t")=="pick-error" && oneCheckpointCounter(m.get("id")) && sessions[index].queue.directPickers.has(m.getInt("id"))){
        sessions[index].queue.directPickers.remove(m.getInt("id"))
        sessions[index].queue.complete(oneResponsePayload(m.getInt("id"),0,"",m.getString("error")))
        sessions[index].changed=true
        return
    }
    if(m.getString("t")=="pick-error" && oneCheckpointCounter(m.get("id"))){
        if(sessions[index].queue.ephemeralPickers.has(m.getInt("id"))){sessions[index].queue.ephemeralPickers.remove(m.getInt("id"));sessions[index].queue.ephemeralOutbox.clear()}
    }
    val persisted = oneRecoverySessions.get(sessions[index].id)
    val before = sessions[index].eventFrontier
    if (persisted != null) {
        val kind = m.getString("t")
        if (!persisted.ready && kind != "hello" && kind != "viewport") return
        if (kind == "effect-ack") {
            val id = m.getString("id")
            val existing = persisted.effects.get(id)
            if (existing != null && jsonParse(existing).value.getString("t") != "pick") {
                oneRecoveryEffectForget(persisted,id)
                persisted.batch.changed()
            }
            return
        }
        if (kind != "hello" && kind != "event" && kind != "route" && kind != "viewport" && kind != "scroll" && kind != "pick-error") return
        if (kind == "event" && (!m.has("n") || !m.has("u"))) return
        if (kind == "pick-error" && oneCheckpointCounter(m.get("id"))) oneRecoveryPickerEnd(persisted,m.getInt("id"))
    }
    sessions[index].lastSeen = oneLiveNow()
    oneSessionMessage(sessions[index], theme, m)
    if (persisted != null && (m.getString("t") != "event" || sessions[index].eventFrontier > before)) {
        persisted.batch.changed(m.getString("t") == "hello" || m.getString("t") == "route" || m.getString("t") == "pick-error" || (m.getString("t") == "event" && m.get("id").asInt() <= oneChangeBase))
        persisted.active = true
        persisted.activitySerial = persisted.activitySerial + 1
    }
    return
}

// Runs one round of a session's platform work. Returns whether anything ran.
fun OneLiveServer.pump(index: int): bool {
    if (!recoveryFence(index, false)) return false
    val moved = sessions[index].deliverRoutes()
    val recovering = oneRecoverySessions.get(sessions[index].id)
    if (recovering != null && recovering.rawRequests.size > 0) {
        if (!recoveryRawFinish(index)) return moved
    }
    // A prior result CAS can publish picker effects; finish it before a new raw span.
    if (recovering != null && recovering.prepared != null && oneRecoveryRawQueued(sessions[index].queue)) return moved
    var requests = sessions[index].queue.takeRequests()
    while (requests.size > 0) {
        for (item in requests) {
            if (!recoveryFence(index, true)) { sessions[index].queue.request(item); continue }
            if (recovering != null && recovering.rawRequests.size > 0) { sessions[index].queue.request(item); continue }
            if (recovering != null && item.epoch > 0 && oneRecoveryRaw(item.request)) {
                if (!oneRecoveryRawIdentity(recovering,item)) { sessions[index].queue.complete(oneResponsePayload(item.id,409,"","File request unavailable")); continue }
                if (oneRecoveryRawBusy(recovering)) { sessions[index].queue.complete(oneResponsePayload(item.id,409,"",oneRecoveryRawBusyMessage(if(sessions[index].lang!="")sessions[index].lang else options.lang))); continue }
                recovering.rawResultPending = true
                recovering.rawRequests.append(oneRecoveryRawBegin(item, oneLiveNow()))
                recovering.batch.changed(true)
                continue
            }
            sessions[index].queue.complete(oneLiveExecute(handler, item, privateRequests, browserContexts.get(sessions[index].id)))
        }
        if (recovering != null && recovering.rawRequests.size > 0) return moved
        if (!recoveryFence(index, false)) return false
        requests = sessions[index].queue.takeRequests()
    }
    val completions = sessions[index].queue.takeCompletions()
    for (payload in completions) sessions[index].receive("result", payload)
    val pushes = sessions[index].queue.takePushes()
    for (payload in pushes) sessions[index].receive("push", payload)
    moved || completions.size > 0 || pushes.size > 0 || sessions[index].queue.routes.pending.size > 0
}

// Same-origin requests run through the application's handler in process.
fun oneLiveExecute(handler: (HttpRequest) -> HttpResponse, item: OneLiveRequest, privateRequests: OneLivePrivateRequests? = null, browser: OneLiveBrowserContext? = null): string {
    val r = item.request
    for (part in r.parts) if (!oneRecoveryPartMetadata(part.name,part.name.size) || !oneRecoveryPartMetadata(part.filename,part.filename.size) || !oneRecoveryPartMetadata(part.contentType,part.contentType.size)) return oneResponsePayload(item.id,400,"","Invalid multipart metadata")
    if (item.epoch > 0) {
        if (r.bodyFile != "") return oneResponsePayload(item.id,501,"","Recovery sessions must read file bytes before sending a request")
        for (part in r.parts) if (part.file != "") return oneResponsePayload(item.id,501,"","Recovery sessions must read file bytes before sending a request")
    }
    // "./api/x" is the browser-relative form of "/api/x" (pages may be served
    // under a path prefix); both run in process.
    val url = if (r.url.size > 1 && r.url[0] == 46 && r.url[1] == 47) r.url.slice(1, r.url.size) else r.url
    if (url.size == 0 || url[0] != 47) {
        return oneResponsePayload(item.id, 501, "", "live sessions only reach their own server (relative URLs)")
    }
    var path = url
    var query = ""
    var i = 0
    while (i < url.size) {
        if (url[i] == 63) {
            path = url.slice(0, i)
            query = url.slice(i + 1, url.size)
            i = url.size
        }
        i = i + 1
    }
    val headers: array<HttpHeader> = []
    for (h in r.headers) {
        val name = oneLowerAscii(h.name)
        if (!name.startsWith("x-one-live-") && !(r.parts.size>0 && name=="content-type")) headers.append(HttpHeader(name, h.value))
    }
    if (item.operation != "") headers.append(HttpHeader("x-one-live-operation", item.operation))
    if (item.session != "" && item.epoch > 0) {
        headers.append(HttpHeader("x-one-live-session", item.session))
        headers.append(HttpHeader("x-one-live-epoch", "${item.epoch}"))
    }
    var body = r.body
    if (r.bodyBase64 != "") body = base64Decode(r.bodyBase64)
    if (r.bodyFile != "") {
        val bytes = oneLiveFileBytesFor(item.session, r.bodyFile)
        if (bytes == null) return oneResponsePayload(item.id, 0, "", "unknown file handle")
        body = bytes
    }
    if (r.parts.size > 0) {
        val boundary = "abla-one-${oneLiveSessionId()}"
        var out = ""
        for (part in r.parts) {
            var content = part.value
            if (part.base64 != "") content = base64Decode(part.base64)
            if (part.file != "") {
                val bytes = oneLiveFileBytesFor(item.session,part.file)
                if (bytes == null) return oneResponsePayload(item.id,0,"","unknown file handle")
                content = bytes
            }
            out = "$out--$boundary\r\nContent-Disposition: form-data; name=\"${oneLivePartQuoted(part.name)}\"${if (part.filename != "") "; filename=\"${oneLivePartQuoted(part.filename)}\"" else ""}\r\n${if (part.contentType != "") "Content-Type: ${part.contentType}\r\n" else ""}\r\n$content\r\n"
        }
        body = "$out--$boundary--\r\n"
        headers.append(HttpHeader("content-type", "multipart/form-data; boundary=$boundary"))
    }
    val dispatched=HttpRequest(r.method,path,query,headers,body,[],[])
    val response=if(privateRequests==null)handler(dispatched)else{
        val handle=privateRequests.handle
        handle(dispatched,OneLiveCallContext(item.id,item.operation,item.session,item.epoch,browser))
    }
    val names: array<string> = []
    val values: array<Json> = []
    for (h in response.headers) {
        names.append(oneLowerAscii(h.name))
        values.append(jsonString(h.value))
    }
    jsonStringify(jsonObject(["requestId", "status", "body", "error", "headers"], [jsonInteger(item.id), jsonInteger(response.status), jsonString(response.body), jsonString(""), jsonObject(names, values)]))
}

// Percent-decoding for names sent in headers (encodeURIComponent).
fun oneUrlDecode(value: string): string {
    var out = ""
    var start = 0
    var i = 0
    while (i < value.size) {
        if (value[i] == 37 && i + 2 < value.size) {
            val hi = oneHexDigit(value[i + 1])
            val lo = oneHexDigit(value[i + 2])
            if (hi >= 0 && lo >= 0) {
                out = "$out${value.slice(start, i)}${byteEncode(hi * 16 + lo)}"
                i = i + 3
                start = i
                continue
            }
        }
        i = i + 1
    }
    "$out${value.slice(start, value.size)}"
}

fun oneHexDigit(b: int): int = if (b >= 48 && b <= 57) b - 48 else if (b >= 97 && b <= 102) b - 87 else if (b >= 65 && b <= 70) b - 55 else -1

fun oneLiveFileBytes(handle: string): string? {
    for (q in oneLiveQueueList) {
        val found = q.fileBytes.get(handle)
        if (found != null) return found
    }
    null
}

fun oneLiveFileBytesFor(session: string, handle: string): string? {
    if (session == "") return oneLiveFileBytes(handle)
    var i = 0
    while (i < oneLiveQueueIds.size) {
        if (oneLiveQueueIds[i] == session) return oneLiveQueueList[i].fileBytes.get(handle)
        i = i + 1
    }
    null
}

// One loop iteration after IO: broadcasts, due timers, platform work, then a
// patch for each connected session whose page changed.
// A dependency may defer due timers without pausing HTTP, pushes, platform
// completions, rendering or socket output. Deferred timers keep their deadline.
fun oneLiveAllTimersReady(): (OneLiveSession) -> bool = { session: OneLiveSession -> true }

fun OneLiveServer.settle(timersReady: (OneLiveSession) -> bool = oneLiveAllTimersReady()): void {
    val pendingEphemeral: array<OneEphemeralUpload> = []
    for(job in ephemeralUploads){
        val response=ephemeralUpload(job.request)
        if(response.status==202)pendingEphemeral.append(job)
        else answer(job.ticket,response)
    }
    ephemeralUploads.clear()
    for(job in pendingEphemeral)ephemeralUploads.append(job)
    if (recovery.enabled) recoveryPending()
    if (oneLiveBroadcasts.size > 0) {
        var i = 0
        while (i + 1 < oneLiveBroadcasts.size) {
            var j = 0
            while (j < sessions.size) {
                if (sessions[j].queue.subscribed(oneLiveBroadcasts[i])) sessions[j].queue.push(oneLiveBroadcasts[i + 1])
                j = j + 1
            }
            i = i + 2
        }
        oneLiveBroadcasts.clear()
    }
    val now = oneLiveNow()
    var index = 0
    while (index < sessions.size) {
        sessions[index].queue.expireEphemeral(now)
        if(sessions[index].queue.ephemeralExpired){sessions[index].queue.ephemeralExpired=false;sessions[index].app.receive("ephemeral-expired","");sessions[index].changed=true}
        val recoveryState = oneRecoverySessions.get(sessions[index].id)
        if(recoveryState!=null && (recoveryState.ending || recoveryState.status==401 || recoveryState.status==403 || recoveryState.status==404 || recoveryState.status==409 || recoveryState.status==410) && sessions[index].queue.ephemeralDeadline>0){sessions[index].queue.clearEphemeral();sessions[index].app.receive("ephemeral-expired","");sessions[index].changed=true}
        if (recoveryState != null && recoveryState.pendingPage) { index = index + 1; continue }
        if (timersReady(sessions[index])) sessions[index].queue.fireTimers(now)
        var rounds = 0
        while (rounds < 8 && pump(index)) rounds = rounds + 1
        if (recovery.enabled && sessions[index].recoveryEligible) {
            recoverySettle(index)
            val current=oneRecoverySessions.get(sessions[index].id)
            if(current!=null && current.ready && current.status==200 && !current.ending && current.batch.acknowledged() && current.prepared==null && sessions[index].slot>=0){
                for(message in sessions[index].queue.ephemeralOutbox)queue(sessions[index].slot,webSocketEncodeFrame(message,1))
                sessions[index].queue.ephemeralOutbox.clear()
                for(message in sessions[index].queue.directOutbox)queue(sessions[index].slot,webSocketEncodeFrame(message,1))
                sessions[index].queue.directOutbox.clear()
            }
            index = index + 1
            continue
        }
        if (sessions[index].slot >= 0) for (message in sessions[index].queue.takeOutbox()) queue(sessions[index].slot, webSocketEncodeFrame(message, 1))
        if(sessions[index].slot>=0){
            for(message in sessions[index].queue.ephemeralOutbox)queue(sessions[index].slot,webSocketEncodeFrame(message,1))
            sessions[index].queue.ephemeralOutbox.clear()
            for(message in sessions[index].queue.directOutbox)queue(sessions[index].slot,webSocketEncodeFrame(message,1))
            sessions[index].queue.directOutbox.clear()
        }
        if (sessions[index].queue.cookiesChanged && sessions[index].slot >= 0) {
            sessions[index].queue.cookiesChanged = false
            queue(sessions[index].slot, webSocketEncodeFrame("{\"t\":\"cookies\"}", 1))
        }
        if (sessions[index].changed && sessions[index].slot >= 0) {
            val message = oneSessionUpdate(sessions[index], theme, options.iconBase)
            if (message != "") queue(sessions[index].slot, webSocketEncodeFrame(message, 1))
        }
        index = index + 1
    }
    // Sessions without a page for 30 minutes end.
    val kept: array<OneLiveSession> = []
    for (session in sessions) {
        if (session.slot >= 0 || now - session.lastSeen < 1800000) kept.append(session)
        else {
            browserContexts.remove(session.id)
            oneLiveForget(session.id)
            oneMemoForget(session.id)
            val persisted = oneRecoverySessions.get(session.id)
            if (persisted != null) oneRecoveryRawDrop(persisted)
            oneRecoverySessions.remove(session.id)
        }
    }
    if (kept.size != sessions.size) {
        sessions.clear()
        for (session in kept) sessions.append(session)
    }
    return
}

fun OneLiveServer.nextTimeout(timersReady: (OneLiveSession) -> bool = oneLiveAllTimersReady()): int {
    var timeout = 1000
    val now = oneLiveNow()
    for (pending in oneRecoveryHttp) if (pending.owner == recoveryOwner) timeout = 10
    for (slot in slots) if (slot.awaitingRecovery && slot.recoveryMessage != "") timeout = 10
    for (session in sessions) {
        val recoveryState = oneRecoverySessions.get(session.id)
        if (recoveryState != null && (recoveryState.rawRequests.size > 0 || oneRecoveryRawQueued(session.queue) || recoveryState.prepared != null || recoveryState.inboxPending || recoveryState.status == 202)) {
            val pending = if (recoveryState.batch.retryAt > now) recoveryState.batch.retryAt - now else 10
            if (pending < timeout) timeout = pending
        }
        if (recoveryState != null && recoveryState.ready && session.queue.requestContexts.keys().size > 0) {
            val interval = oneRecoveryInboxInterval(false, if (recoveryState.awaitingSince < 0) 0 else now - recoveryState.awaitingSince)
            val since = now - recoveryState.inboxAt
            val due = if (since >= interval) 0 else interval - since
            if (due < timeout) timeout = due
        }
        if (timersReady(session)) {
            val wait = session.queue.nextTimer(now)
            if (wait < timeout) timeout = wait
        }
    }
    timeout
}

class OneLivePush(val topic: string, val payload: string)

fun oneLiveNoBeforeSettle(): (array<OneLiveSession>) -> array<OneLivePush> {
    val idle: (array<OneLiveSession>) -> array<OneLivePush> = { sessions -> array<OneLivePush>() }
    idle
}

// External sources registered with poller can update sessions after IO and
// before due timers/platform work. For example, a replica must apply renewed
// credentials before a timer sends another request with its previous tokens.
// The callback inspects sessions and returns topic pushes; step applies them
// directly before platform completions, rather than enqueueing them behind timers.
fun OneLiveServer.step(beforeSettle: (array<OneLiveSession>) -> array<OneLivePush> = oneLiveNoBeforeSettle(), timersReady: (OneLiveSession) -> bool = oneLiveAllTimersReady()): void {
    val events = poller.wait(1024, nextTimeout(timersReady))
    for (event in events.events) {
        if (event.descriptor == listener.descriptor && event.readable) accept()
        else {
            val slot = findSlot(event.descriptor)
            if (slot >= 0) {
                if (event.error || event.closed) closeSlot(slot)
                else {
                    if (event.readable) read(slot)
                    if (event.writable && slots[slot].descriptor >= 0) write(slot)
                }
            }
        }
    }
    for (push in beforeSettle(sessions)) {
        var i = 0
        while (i < sessions.size) {
            if (sessions[i].queue.subscribed(push.topic)) sessions[i].receive("push", push.payload)
            i = i + 1
        }
    }
    settle(timersReady)
    return
}

fun OneLiveServer.listening(): bool = listener.descriptor >= 0

// Stops at once, saying so, when it has no socket: most often another program has the address.
fun OneLiveServer.run(): int {
    if (listener.descriptor < 0) {
        eprintln("The live server can't listen: is another one on its port? (error ${-listener.descriptor})")
        return 1
    }
    tcpEnableGracefulShutdown()
    while (!stopped && !tcpShutdownRequested()) step()
    0
}
