import "../mobile_source.ab"
import importSubpath(oneMobileSource(), "ui")
import "android_tree.ab"
import "../core/node.ab"
import "../core/theme.ab"

// The protocol-v1 node shape is portable; iOS/mobile style scopes resolve here
// instead of accidentally retaining Android-only styles in a SwiftUI host.
fun oneIosNode(node: Node, theme: Theme, key: string): MobileNode =
    oneMobileNode(node, theme, key, "ios")
