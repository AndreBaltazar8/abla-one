import "epaper.ab"
import "abla/io"
import "abla/runtime/memory"
import "../../../abla-embedded/src/esp32/abla_host_esp_idf.ab"
import "../../../abla-embedded/src/m5stack/papermono_board.ab"
import "../../../abla-embedded/src/m5stack/papermono_gestures.ab"

// An Abla One app on an M5Stack PaperMono, entirely on the device (SPEC §10):
// the app, its state, layout, scrolling, hit testing and drawing run on the
// ESP32-S3, with the Abla heap in PSRAM (abla-embedded's ESP-IDF platform).
// Each render's changed rectangles (the e-paper backend's) are copied into
// the panel's canvas and refreshed in the mode the backend chose; taps and
// swipes go straight to the app. abla-embedded brings up the board.
//
//   @export("app_main")
//   fun appMain(): void {
//       var app: OneApp = MyApp()
//       onePaperMonoRun(app, myTheme(), OneIconSource({ name -> "" }))
//   }

trusted fun onePaperMonoPause(milliseconds: int): void {
    vTaskDelay(u32(milliseconds))
    return
}

trusted fun onePaperMonoMilliseconds(): int = int(esp_timer_get_time()) / 1000

// Copies an update's rectangles (both planes) into the canvas and refreshes.
// The session keeps one dirty rectangle, and a refresh drives all of it, so
// areas far apart refresh separately: greys between them must not go through a
// fast waveform. An area that shows greys takes the fast mode rather than the
// fastest, which has no grey stage.
trusted fun onePaperMonoShow(session: Ssd1677Session, state: OneEpaperState, update: OneEpaperUpdate): void {
    if (update.rects.size == 0) return
    val canvas = session.canvas()
    for (r in update.rects) {
        var plane = 0
        while (plane < 2) {
            var row = r.y
            while (row < r.y + r.h) {
                val at = plane * 48000 + row * 100 + r.x / 8
                val count = (r.x + r.w) / 8 - r.x / 8
                if (canvas.hasAddressRange(at, count)) ablaUnsafeCopyMemory(canvas.addressValue() + at, state.planes.addressAt(at), count)
                row = row + 1
            }
            plane = plane + 1
        }
    }
    for (group in oneEpaperGroupRects(update.rects)) {
        session.markDirtyOwned(group.x, group.y, group.w, group.h, true)
        val mode = if (update.mode == oneEpaperFastest && oneEpaperShowsGrey(state.planes, group)) oneEpaperFast else update.mode
        if (!paperMonoRefresh(session, mode)) paperMonoRefresh(session, paperMonoQuality)
    }
    return
}

// White, before the first refresh (the first frame then comes as a full one).
trusted fun onePaperMonoClear(): void {
    val canvas = paperMonoCanvas()
    var offset = 0
    while (offset < 96000) {
        canvas.storeU32(offset, 4294967295)
        offset = offset + 4
    }
    return
}

// Set before running: a tapped control shows its own pressed style (`pressed:background`)
// first. Off by default: the extra refresh delays what the tap does by about 0.3 s.
var onePaperMonoPressLook = false

// Runs `app` until the device powers off.
fun onePaperMonoRun(var app: OneApp, theme: Theme, icons: OneIconSource): void {
    onePaperMonoLoop(app, theme, icons, { "" })
    return
}

// The same, with `poll` called while idle: a completion (a services payload) for the
// app, or "".
fun onePaperMonoLoop(var app: OneApp, theme: Theme, icons: OneIconSource, var poll: FnMut() -> string): void {
    // Memory is cleaned up while idle (below). The runtime's own collection is a safety net
    // for work that outruns that: its threshold only moves when it runs itself, so one set
    // near the idle level would go off in the middle of a tap.
    runtimeMemorySetCollectionGrowth(3145728)
    // Below the 6 MiB region, and it keeps reclaiming free memory in step.
    runtimeMemorySetLimit(5242880)
    val control = paperMonoOpen()
    if ((control|0) == 0) return
    onePaperMonoClear()
    val session = paperMonoDisplayStart(control)
    if ((session|0) == 0) return
    paperMonoFrontlight(control, 26)
    if (!paperMonoGesturesOpen(control)) println("papermono: no touch")
    var state = oneEpaperState(onePaperMonoOptions())
    state.onBand = { paperMonoGestureSample() }
    var started = onePaperMonoMilliseconds()
    onePaperMonoShow(session, state, oneEpaperRender(app, theme, state, icons))
    println("papermono: first frame in ${onePaperMonoMilliseconds() - started} ms")
    var collected = runtimeMemoryLiveBytes()
    while (true) {
        paperMonoGestureSample()
        val gesture = paperMonoGestureTake()
        if (gesture != paperMonoGestureNone) {
            started = onePaperMonoMilliseconds()
            val x = paperMonoGestureAtX()
            val y = paperMonoGestureAtY()
            if (onePaperMonoPressLook && gesture == paperMonoGestureTap && oneEpaperPress(state, x, y)) {
                onePaperMonoShow(session, state, oneEpaperRender(app, theme, state, icons))
                oneEpaperRelease(state)
            }
            val acted = if (gesture == paperMonoGestureTap) oneEpaperTouch(app, theme, state, x, y)
                else oneEpaperScroll(state, x, y, paperMonoGestureTravel())
            // Nothing under the finger, or nothing left to scroll: nothing to draw.
            if (acted || state.scrolled) {
                val update = oneEpaperRender(app, theme, state, icons)
                println("papermono: ${if (gesture == paperMonoGestureTap) "tap" else "swipe"} at $x,$y, ${update.rects.size} rectangles, mode ${update.mode}, ${onePaperMonoMilliseconds() - started} ms")
                onePaperMonoShow(session, state, update)
            }
        }
        // Finished work from the platform, one at a time.
        if (gesture == paperMonoGestureNone) {
            val completion = poll()
            if (completion != "") {
                app.receive("result", completion)
                onePaperMonoShow(session, state, oneEpaperRender(app, theme, state, icons))
            }
        }
        // Cleaning up memory takes 100-200 ms: do it while nothing is waiting and no finger
        // is down, so a tap does not pay for it.
        if (gesture == paperMonoGestureNone) {
            val live = runtimeMemoryLiveBytes()
            if (live < collected) collected = live
            if (live > collected + 262144 && paperMonoGestureCell(paperMonoGestureDown) == 0) {
                runtimeMemoryCollect()
                collected = runtimeMemoryLiveBytes()
            }
            onePaperMonoPause(2)
        }
    }
}
