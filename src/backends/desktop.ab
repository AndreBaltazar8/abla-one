import "abla/http"
import "abla/http/tls"
import "abla/json"
import "abla/process/time"
import "../../../abla-graphics/src/graphics.ab"
import "../layout/edit.ab"
import "../raster/raster.ab"
import "web_live.ab"

// The `desktop` target (SPEC §10, M3): Linux windows through abla-graphics.
// Each change is laid out (one-layout), painted and rasterized (one-raster),
// then presented. Input goes through the frame's hit regions; a focused text
// field is edited as text is anywhere (src/layout/edit.ab): a caret placed with the pointer or
// the arrows, Home and End, selections with Shift or a drag, words with Control or a double
// click, and Ctrl+A, C, X and V. Services use the same session
// queue as live web sessions (`oneLiveServices(session)`), with absolute
// http(s) URLs sent over the network. Routes are the queue's, a stack here; a window
// has no back button of its own, so going back is the app's (`services.back`).

class OneDesktopOptions(
    val title: string,
    val width: int,
    val height: int,
    val background: string,
    // Directory of `<name>.svg` icons (tools/vector2svg output).
    val iconDir: string
)

// Sends an absolute http:// or https:// request; returns a completion payload.
fun oneDesktopExecute(item: OneLiveRequest): string {
    val r = item.request
    val https = oneStarts(r.url, "https://")
    if (!https && !oneStarts(r.url, "http://")) return oneResponsePayload(item.id, 501, "", "desktop apps send absolute http(s) URLs")
    val rest = r.url.slice(if (https) 8 else 7, r.url.size)
    var slash = 0
    while (slash < rest.size && rest[slash] != 47) slash = slash + 1
    val authority = rest.slice(0, slash)
    val target = if (slash < rest.size) rest.slice(slash, rest.size) else "/"
    var host = authority
    var port = if (https) 443 else 80
    var colon = 0
    while (colon < authority.size) {
        if (authority[colon] == 58) {
            host = authority.slice(0, colon)
            port = oneParseInt(authority.slice(colon + 1, authority.size), port)
        }
        colon = colon + 1
    }
    var path = target
    var query = ""
    var q = 0
    while (q < target.size) {
        if (target[q] == 63) {
            path = target.slice(0, q)
            query = target.slice(q + 1, target.size)
        }
        q = q + 1
    }
    val headers: array<HttpHeader> = []
    for (h in r.effectiveHeaders()) headers.append(HttpHeader(h.name, h.value))
    var body = r.body
    if (r.bodyBase64 != "") body = base64Decode(r.bodyBase64)
    if (r.bodyFile != "") {
        val bytes = oneLiveFileBytes(r.bodyFile)
        if (bytes != null) body = bytes
    }
    val request = HttpRequest(r.method, path, query, headers, body, [], [])
    val client = if (https) httpsClient(host, port, 8388608, r.timeoutMs)
        else httpIpv4Client(authority, if (host == "localhost") "127.0.0.1" else host, port, 8388608, r.timeoutMs)
    val result = client.send(request)
    if (!result.succeeded) return oneResponsePayload(item.id, 0, "", "request failed")
    val names: array<string> = []
    val values: array<Json> = []
    for (h in result.response.headers) {
        names.append(oneLowerAscii(h.name))
        values.append(jsonString(h.value))
    }
    jsonStringify(jsonObject(["requestId", "status", "body", "error", "headers"], [jsonInteger(item.id), jsonInteger(result.response.status), jsonString(result.response.body), jsonString(""), jsonObject(names, values)]))
}

class OneDesktopState(
    var width: int,
    var height: int,
    var pointerX: int,
    var pointerY: int,
    var downX: int,
    var downY: int,
    var dragging: bool,
    var dragKey: string,
    var dragFrom: int,
    var focusKey: string,
    var dirty: bool,
    val scroll: Map<string, int>,
    val delivered: Map<int, int>,
    val routes: OneRoutes,
    val routeScrolls: OneRouteScrolls = oneRouteScrolls(),
    // The route epoch of the frame on screen: a press on it is for that route.
    var routeEpoch: int = 0,
    // An Alt key is down: abla-graphics reports keys, not modifiers.
    var alt: bool = false,
    // A Control key is down, and the field a paste asked the clipboard for.
    var control: bool = false,
    var pasteKey: string = "",
    var dragAcross: bool = false,
    var shift: bool = false,
    // The pointer went down on the focused field and is selecting while it moves.
    var selecting: bool = false,
    // When the last press on a field was, and how many came quickly one after another.
    var clickAt: int = 0,
    var clicks: int = 0,
    // The layout kept from frame to frame (one per width: styles resolve by the viewport).
    var layoutCache: OneLayoutCache = oneLayoutCache(),
    var layoutWidth: int = -1
)

// Lays the frame's tree out through the kept cache: only what changed is laid out again.
fun oneDesktopLayout(root: Node, theme: Theme, var state: OneDesktopState): OneBox {
    if (state.layoutWidth != state.width) {
        state.layoutCache = oneLayoutCache()
        state.layoutWidth = state.width
    }
    oneLayoutCached(root, theme, "desktop", state.width, state.height, state.scroll, state.layoutCache)
}

// One frame: render, lay out, paint. Visible feed rows are delivered first.
fun oneDesktopFrame(var app: OneApp, theme: Theme, var state: OneDesktopState): OneFrame {
    state.routeScrolls.moved("${state.routes.entry()}", state.scroll)
    state.routeEpoch = state.routes.epoch
    var ui = oneUiSized("desktop", theme, state.width)
    val frame = onePaintFrame(oneDesktopLayout(app.render(ui), theme, state), state.width, state.height)
    var again = false
    for (v in frame.visible) {
        val last = state.delivered.get(v.event)
        if (last == null || v.item > last) {
            state.delivered.set(v.event, v.item)
            oneDispatch(app, "desktop", theme, v.event, "${v.item}", state.width)
            again = true
        }
    }
    if (!again) return frame
    var ui2 = oneUiSized("desktop", theme, state.width)
    onePaintFrame(oneDesktopLayout(app.render(ui2), theme, state), state.width, state.height)
}

// An input event for the frame on screen; dropped when the route has moved since.
fun oneDesktopDeliver(var app: OneApp, theme: Theme, var state: OneDesktopState, event: int, value: string): bool {
    if (state.routes.epoch != state.routeEpoch) return false
    oneDispatch(app, "desktop", theme, event, value, state.width)
}

fun oneDesktopHit(frame: OneFrame, x: int, y: int, kind: string): int {
    var i = frame.hits.size - 1
    while (i >= 0) {
        val h = frame.hits[i]
        if (h.kind == kind && x >= h.x && x < h.x + h.w && y >= h.y && y < h.y + h.h) return i
        i = i - 1
    }
    -1
}

fun oneDesktopHitAtKey(frame: OneFrame, key: string): int {
    var i = frame.hits.size - 1
    while (i >= 0) {
        if (frame.hits[i].kind == "scroll" && frame.hits[i].key == key) return i
        i = i - 1
    }
    -1
}

// Gives the focused field its changed text, if it changed. The caller lays out again after
// one, as the next key builds on it.
fun oneDesktopEdit(var app: OneApp, theme: Theme, var state: OneDesktopState, event: int, old: string, edited: OneEdited): bool {
    state.dirty = true
    if (edited.value == old) return false
    oneDesktopDeliver(app, theme, state, event, edited.value)
    true
}

// What a key does to the field being edited, or "" for nothing. Enter makes a new line in a
// field of several, unless it sends: then Shift+Enter does.
fun oneDesktopEditAction(key: int, multiline: bool, submits: bool, shift: bool): string {
    if (key == keyLeft) return "left"
    if (key == keyRight) return "right"
    if (key == keyUp) return "up"
    if (key == keyDown) return "down"
    if (key == keyHome) return "home"
    if (key == keyEnd) return "end"
    if (key == keyBackspace) return "backspace"
    if (key == keyDelete) return "delete"
    if ((key == keyEnter || key == keyKpEnter) && multiline && (!submits || shift)) return "newline"
    ""
}

fun oneDesktopEditing(state: OneDesktopState): bool = state.focusKey != "" && oneEditKey() == state.focusKey

fun oneDesktopBlur(var state: OneDesktopState): void {
    state.focusKey = ""
    state.selecting = false
    oneEditStop()
    return
}

// The press that closes the open popover on top (onePaintPopovers), or -1.
fun oneDesktopDismiss(frame: OneFrame): int {
    var i = frame.hits.size - 1
    while (i >= 0) {
        if (frame.hits[i].key == "dismiss") return i
        i = i - 1
    }
    -1
}

fun oneDesktopInput(frame: OneFrame, key: string): int {
    var i = 0
    while (i < frame.hits.size) {
        if (frame.hits[i].kind == "input" && frame.hits[i].key == key) return i
        i = i + 1
    }
    -1
}

// The platform work of the session: requests, timers and completions.
fun oneDesktopPump(var app: OneApp, session: string): bool {
    val index = oneLiveQueueIndex(session)
    oneLiveQueueList[index].fireTimers(oneLiveNow())
    var worked = oneRoutesDrain(app, oneLiveQueueList[index].routes)
    for (item in oneLiveQueueList[index].takeRequests()) {
        oneLiveQueueList[index].complete(oneDesktopExecute(item))
    }
    for (payload in oneLiveQueueList[index].takeCompletions()) {
        app.receive("result", payload)
        worked = true
    }
    oneRoutesDrain(app, oneLiveQueueList[index].routes) || worked
}

// Copies the rasterized frame into the window's pixel buffer.
trusted fun oneDesktopBlit(var pixels: PixelBuffer, surface: OneSurface): bool {
    var y = 0
    var ok = true
    while (y < surface.height) {
        var x = 0
        while (x < surface.width) {
            val c = surface.pixels.word(y * surface.width + x)
            ok = pixels.setRgba8(x, y, (c / 65536) % 256, (c / 256) % 256, c % 256, 255) && ok
            x = x + 1
        }
        y = y + 1
    }
    ok
}

// The text caret after the focused field's text.
fun oneDesktopCaret(var surface: OneSurface, frame: OneFrame, key: string): void {
    val hitIndex = oneDesktopInput(frame, key)
    if (hitIndex < 0) return
    val h = frame.hits[hitIndex]
    oneFillRect(surface, h.caretX, h.caretY - 10, oneCaretWidth, 20, 1653808, 255)
    return
}

trusted fun oneDesktopRun(var app: OneApp, theme: Theme, session: string, options: OneDesktopOptions): int {
    val window = graphicsApplication(
        GraphicsConfig(backend = graphicsBackendAuto, validation = false),
        WindowConfig(title = options.title, width = options.width, height = options.height, resizable = true)
    )
    if (!window.valid()) return 1
    oneUseEditing()
    val icons = OneIconSource({ name -> linuxReadFile("${options.iconDir}/$name.svg", 65536) })
    oneLiveQueueList[oneLiveQueueIndex(session)].routes.start("/")
    var state = OneDesktopState(options.width, options.height, 0, 0, 0, 0, false, "", 0, "", true, Map(), Map(), oneLiveQueueList[oneLiveQueueIndex(session)].routes)
    var pixels = pixelBuffer(state.width, state.height)
    var frame = OneFrame([], [], [], 0, 0)
    var running = true
    // Frames still owed after a resize: the first one presented to a new size
    // may not reach the screen, and otherwise nothing replaces it until
    // something else changes.
    var settling = 0
    while (running) {
        if (oneDesktopPump(app, session)) state.dirty = true
        for (text in oneLiveQueueList[oneLiveQueueIndex(session)].takeCopies()) window.setClipboard(text)
        if (settling > 0) {
            settling = settling - 1
            state.dirty = true
        }
        if (state.dirty) {
            state.dirty = false
            frame = oneDesktopFrame(app, theme, state)
            var surface = oneRasterFrame(frame, options.background, icons)
            if (state.focusKey != "") oneDesktopCaret(surface, frame, state.focusKey)
            if (pixels.width != state.width || pixels.height != state.height) pixels = pixelBuffer(state.width, state.height)
            if (oneDesktopBlit(pixels, surface)) window.presentPixels(pixels)
        }
        val wait = oneLiveQueueList[oneLiveQueueIndex(session)].nextTimer(oneLiveNow())
        val most = if (settling > 0) 16 else 50
        var event = window.pollEvent(if (wait < most) wait else most)
        while (event.happened()) {
            if (event.kind == windowEventCloseRequested) running = false
            else if (event.kind == windowEventResized || event.kind == windowEventFramebufferResized) {
                if (event.first > 0 && event.second > 0) {
                    state.width = event.first
                    state.height = event.second
                    state.dirty = true
                    settling = 12
                }
            } else if (event.kind == windowEventPointerMoved) {
                state.pointerX = event.pointerX()
                state.pointerY = event.pointerY()
                if (state.selecting && oneDesktopEditing(state)) {
                    oneEditPointer(state.pointerX, state.pointerY, true, 1)
                    state.dirty = true
                } else if (state.dragKey != "") {
                    val dy = if (state.dragAcross) state.downX - state.pointerX else state.downY - state.pointerY
                    if (dy > 6 || dy < -6) state.dragging = true
                    if (state.dragging) {
                        val dragged = oneDesktopHitAtKey(frame, state.dragKey)
                        if (dragged >= 0) oneScrollTo(state.scroll, frame.hits[dragged], state.dragFrom + dy)
                        else state.scroll.set(state.dragKey, state.dragFrom + dy)
                        state.dirty = true
                    }
                }
            } else if (event.kind == windowEventPointerButton && (event.pointerButton() == pointerButtonBack || event.pointerButton() == pointerButtonForward)) {
                // The mouse's own buttons, as in a browser.
                if (event.pointerButtonPressed()) {
                    if (event.pointerButton() == pointerButtonBack) state.routes.back("") else state.routes.forward()
                    state.dirty = true
                }
            } else if (event.kind == windowEventKey && (event.key() == keyLeftAlt || event.key() == keyRightAlt)) {
                state.alt = event.keyPressed()
            } else if (event.kind == windowEventKey && (event.key() == keyLeftControl || event.key() == keyRightControl)) {
                state.control = event.keyPressed()
            } else if (event.kind == windowEventKey && (event.key() == keyLeftShift || event.key() == keyRightShift)) {
                state.shift = event.keyPressed()
            } else if (event.kind == windowEventKey && event.keyPressed() && state.control && oneDesktopEditing(state) && (event.key() == keyA || event.key() == keyC || event.key() == keyX)) {
                val i = oneDesktopInput(frame, state.focusKey)
                if (event.key() == keyA) oneEditAction("all", false, false)
                else if (i >= 0) {
                    // A hidden field gives nothing to copy, and so cuts nothing.
                    val copied = oneEditCopy()
                    if (copied != "" && window.setClipboard(copied) && event.key() == keyX) {
                        if (oneDesktopEdit(app, theme, state, frame.hits[i].event, frame.hits[i].value, oneEditType(""))) frame = oneDesktopFrame(app, theme, state)
                    }
                }
                state.dirty = true
            } else if (event.kind == windowEventKey && event.keyPressed() && state.control && event.key() == keyV && oneDesktopEditing(state)) {
                // Ctrl+V: the text comes later, as a clipboard event, for the field focused now.
                if (window.requestClipboard()) state.pasteKey = state.focusKey
            } else if (event.kind == windowEventClipboard && state.pasteKey != "") {
                val i = oneDesktopInput(frame, state.pasteKey)
                state.pasteKey = ""
                if (i >= 0 && oneDesktopEditing(state) && event.clipboardTextAvailable() && event.clipboardText() != "") {
                    // A field of one line takes what's pasted as one.
                    val text = if (frame.hits[i].multiline) event.clipboardText() else event.clipboardText().replace("\n", " ")
                    if (oneDesktopEdit(app, theme, state, frame.hits[i].event, frame.hits[i].value, oneEditType(text))) frame = oneDesktopFrame(app, theme, state)
                }
            } else if (event.kind == windowEventKey && event.keyPressed() && state.alt && (event.key() == keyLeft || event.key() == keyRight)) {
                // Alt+Left and Alt+Right, as in a browser.
                if (event.key() == keyLeft) state.routes.back("") else state.routes.forward()
                state.dirty = true
            } else if (event.kind == windowEventKey && event.keyPressed() && event.key() == keyEscape && oneDesktopDismiss(frame) >= 0) {
                oneDesktopDeliver(app, theme, state, frame.hits[oneDesktopDismiss(frame)].event, "")
                state.dirty = true
            } else if (event.kind == windowEventPointerButton && event.pointerButton() == pointerButtonLeft) {
                val field = oneDesktopHit(frame, state.pointerX, state.pointerY, "input")
                if (event.pointerButtonPressed() && field >= 0) {
                    // On a field: focus, then the caret under the pointer, or a word or all of it
                    // on a second or third click.
                    val key = frame.hits[field].key
                    val now = oneLiveNow()
                    state.clicks = if (key == state.focusKey && now - state.clickAt < 400 && state.clicks < 3) state.clicks + 1 else 1
                    state.clickAt = now
                    if (!oneDesktopEditing(state) || key != state.focusKey) {
                        state.focusKey = key
                        oneEditStart(key, frame.hits[field].value)
                        frame = oneDesktopFrame(app, theme, state)
                    }
                    oneEditPointer(state.pointerX, state.pointerY, state.shift, state.clicks)
                    state.selecting = true
                    state.dragKey = ""
                    state.dirty = true
                } else if (event.pointerButtonPressed()) {
                    state.downX = state.pointerX
                    state.downY = state.pointerY
                    state.dragging = false
                    val across = oneDesktopHit(frame, state.pointerX, state.pointerY, "scrollAcross")
                    state.dragAcross = across >= 0
                    val s = if (across >= 0) across else oneDesktopHit(frame, state.pointerX, state.pointerY, "scroll")
                    state.dragKey = if (s >= 0) frame.hits[s].key else ""
                    state.dragFrom = if (s >= 0) oneParseInt(frame.hits[s].value, 0) else 0
                } else if (state.selecting) {
                    state.selecting = false
                } else {
                    if (!state.dragging && field < 0) {
                        val p = oneDesktopHit(frame, state.pointerX, state.pointerY, "press")
                        oneDesktopBlur(state)
                        if (p >= 0) oneDesktopDeliver(app, theme, state, frame.hits[p].event, "")
                        state.dirty = true
                    }
                    state.dragKey = ""
                    state.dragging = false
                }
            } else if (event.kind == windowEventScrolled) {
                val across = oneDesktopHit(frame, state.pointerX, state.pointerY, "scrollAcross")
                val s = oneDesktopHit(frame, state.pointerX, state.pointerY, "scroll")
                if (across >= 0) {
                    // A plain wheel moves it too: most mice have no sideways wheel.
                    val notches = if (event.scrollX() != 0) event.scrollX() else event.scrollY()
                    state.scroll.set(frame.hits[across].key, oneParseInt(frame.hits[across].value, 0) - notches * 48)
                    state.dirty = true
                } else if (s >= 0) {
                    oneScrollTo(state.scroll, frame.hits[s], oneParseInt(frame.hits[s].value, 0) - event.scrollY() * 48)
                    state.dirty = true
                }
            } else if (event.kind == windowEventText && oneDesktopEditing(state) && !state.control) {
                val i = oneDesktopInput(frame, state.focusKey)
                // The next key may already be queued, and builds on this text.
                if (i >= 0 && oneDesktopEdit(app, theme, state, frame.hits[i].event, frame.hits[i].value, oneEditType(oneUtf8(event.codepoint())))) frame = oneDesktopFrame(app, theme, state)
            } else if (event.kind == windowEventKey && event.keyPressed() && oneDesktopEditing(state)) {
                val i = oneDesktopInput(frame, state.focusKey)
                val action = if (i >= 0) oneDesktopEditAction(event.key(), frame.hits[i].multiline, frame.hits[i].submit > 0, state.shift) else ""
                if (action != "") {
                    if (oneDesktopEdit(app, theme, state, frame.hits[i].event, frame.hits[i].value, oneEditAction(action, state.shift, state.control))) frame = oneDesktopFrame(app, theme, state)
                } else if (i >= 0 && (event.key() == keyEnter || event.key() == keyKpEnter) && frame.hits[i].submit > 0) {
                    oneDesktopDeliver(app, theme, state, frame.hits[i].submit, "")
                    state.dirty = true
                } else if (event.key() == keyEscape) {
                    oneDesktopBlur(state)
                    state.dirty = true
                }
            }
            event = window.pollEvent(0)
        }
    }
    0
}

fun oneUtf8(code: int): string {
    if (code < 128) return byteEncode(code)
    if (code < 2048) return "${byteEncode(192 + code / 64)}${byteEncode(128 + code % 64)}"
    if (code < 65536) return "${byteEncode(224 + code / 4096)}${byteEncode(128 + (code / 64) % 64)}${byteEncode(128 + code % 64)}"
    "${byteEncode(240 + code / 262144)}${byteEncode(128 + (code / 4096) % 64)}${byteEncode(128 + (code / 64) % 64)}${byteEncode(128 + code % 64)}"
}
