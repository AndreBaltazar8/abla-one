import "abla/json"
import "abla/crypto"
import "abla/process/time"
import "../one.ab"
import "web_document.ab"
import "web_recovery_store.ab"
import "../layout/paint.ab"

// A web session, wherever it runs: on the server (web_live.ab, over a
// WebSocket) or in the browser (web_client.ab, compiled to Wasm). The page
// speaks the same messages to both. The session holds the app, the CSS the
// page has, the event maps of recent revisions, and its platform queue.

// One time source for scheduling, delivery and session lifetimes. Native tests can inject a logical monotonic clock;
// normal applications keep the platform clock. Set it before creating sessions, and reset it after a test. An array avoids nullable function values on the supported compiler.
val oneLiveClockOverrides: array<() -> int> = []

fun oneLiveNow(): int {
    if (oneLiveClockOverrides.size == 0) return monotonicMilliseconds()
    val clock = oneLiveClockOverrides[0]
    clock()
}

fun oneLiveSetClock(clock: () -> int): void {
    oneLiveClockOverrides.clear()
    oneLiveClockOverrides.append(clock)
    return
}

fun oneLiveResetClock(): void {
    oneLiveClockOverrides.clear()
    return
}

class OneLiveRequest(val id: int, val request: OneRequest, val operation: string = "", val session: string = "", val epoch: int = 0)
class OneLiveTimer(val id: int, val due: int)

// A session's platform state, shared between the session and its services.
class OneEphemeralPicker(val request: int, val maximumBytes: int, val expires: int, val nonce: string, val epoch: int)

class OneLiveQueue(
    var nextId: int,
    val requests: array<OneLiveRequest>,
    val completions: array<string>,
    val timers: array<OneLiveTimer>,
    val storage: Map<string, string>,
    val topics: array<string>,
    val pushes: array<string>,
    var cookiesChanged: bool,
    // Messages for the page (file pickers), sent on the next settle.
    val outbox: array<string>,
    // Uploaded files by handle: bytes and their {handle, name, size, mime}.
    val fileBytes: Map<string, string>,
    val fileInfo: Map<string, string>,
    val routes: OneRoutes,
    // A page holds the history (web sessions): moves for it, sent with the next patch.
    var browser: bool,
    val moves: array<Json>,
    var eventContext: string = "",
    var eventOrdinal: int = 0,
    val requestContexts: Map<int, string> = Map(),
    // Text to copy, for a window with no page to do it (the desktop).
    val copies: array<string> = [],
    // These values never enter recovery checkpoints, files or inboxes.
    val ephemeralPickers: Map<int, OneEphemeralPicker> = Map(),
    val ephemeralFiles: Map<string, int> = Map(),
    val ephemeralOutbox: array<string> = [],
    val ephemeralRequests: Map<int, int> = Map(),
    val ephemeralCancelled: Map<int, bool> = Map(),
    var ephemeralDeadline: int = 0,
    var ephemeralExpired: bool = false
) {
    fun clearEphemeral(): void {
        for(id in ephemeralRequests.keys())ephemeralCancelled.set(id,true)
        val kept: array<string> = []
        for(payload in completions){
            val parsed=jsonParse(payload)
            if(!parsed.succeeded || !ephemeralRequests.has(parsed.value.getInt("requestId")))kept.append(payload)
        }
        completions.clear();for(payload in kept)completions.append(payload)
        val pending: array<OneLiveRequest> = []
        for(item in requests)if(!ephemeralRequests.has(item.id))pending.append(item)
        requests.clear();for(item in pending)requests.append(item)
        for(id in ephemeralRequests.keys())requestContexts.remove(id)
        ephemeralRequests.clear();ephemeralDeadline=0
        ephemeralPickers.clear();ephemeralOutbox.clear()
        for(handle in ephemeralFiles.keys())removeFile(handle)
        ephemeralFiles.clear()
        return
    }
    fun expireEphemeral(now: int): void {
        if(ephemeralDeadline>0 && now>=ephemeralDeadline){clearEphemeral();ephemeralExpired=true}
        for(id in ephemeralPickers.keys()){
            val pick=ephemeralPickers.get(id)
            if(pick!=null && now>=pick.expires)ephemeralPickers.remove(id)
        }
        for(handle in ephemeralFiles.keys()){
            val until=ephemeralFiles.get(handle)
            if(until!=null && now>=until){removeFile(handle);ephemeralFiles.remove(handle)}
        }
        if(ephemeralPickers.keys().size==0)ephemeralOutbox.clear()
        return
    }
    fun takeCopies(): array<string> {
        val out: array<string> = []
        for (item in copies) out.append(item)
        copies.clear()
        out
    }
    fun takeRequests(): array<OneLiveRequest> {
        val out: array<OneLiveRequest> = []
        for (item in requests) out.append(item)
        requests.clear()
        out
    }
    fun takeCompletions(): array<string> {
        val out: array<string> = []
        for (item in completions) {
            if(ephemeralRequests.keys().size>0){val parsed=jsonParse(item);if(parsed.succeeded)ephemeralRequests.remove(parsed.value.getInt("requestId"))}
            out.append(item)
        }
        completions.clear()
        out
    }
    fun takePushes(): array<string> {
        val out: array<string> = []
        for (item in pushes) out.append(item)
        pushes.clear()
        out
    }
    fun complete(payload: string): void {
        if(ephemeralCancelled.keys().size>0){val parsed=jsonParse(payload);if(parsed.succeeded && ephemeralCancelled.has(parsed.value.getInt("requestId")))return}
        completions.append(payload)
        return
    }
    fun allocate(): int {
        nextId = nextId + 1
        nextId
    }
    fun request(item: OneLiveRequest): void {
        requests.append(item)
        return
    }
    fun store(key: string, value: string): void {
        storage.set(key, value)
        cookiesChanged = true
        return
    }
    fun unstore(key: string): void {
        storage.set(key, "")
        cookiesChanged = true
        return
    }
    fun schedule(item: OneLiveTimer): void {
        timers.append(item)
        return
    }
    fun toPage(message: string): void {
        outbox.append(message)
        return
    }
    fun takeOutbox(): array<string> {
        val out: array<string> = []
        for (item in outbox) out.append(item)
        outbox.clear()
        out
    }
    fun addFile(handle: string, bytes: string, info: string): void {
        fileBytes.set(handle, bytes)
        fileInfo.set(handle, info)
        return
    }
    fun removeFile(handle: string): bool {
        val existed = fileBytes.has(handle)
        fileBytes.remove(handle)
        fileInfo.remove(handle)
        existed
    }
    fun takeMoves(): array<Json> {
        val out: array<Json> = []
        for (item in moves) out.append(item)
        moves.clear()
        out
    }
    fun navigate(path: string, replace: bool): void {
        routes.navigate(path, replace)
        if (browser) moves.append(jsonObject(["p", "x", "e"], [jsonString(routes.current()), jsonBoolean(replace), jsonInteger(routes.entry())]))
        return
    }
    fun back(fallback: string): void {
        if (browser) toPage(jsonStringify(jsonObject(["t", "to"], [jsonString("back"), jsonString(if (fallback != "") oneRoutePath(fallback) else "")])))
        else routes.back(fallback)
        return
    }
    fun forward(): void {
        if (browser) toPage("{\"t\":\"forward\"}")
        else routes.forward()
        return
    }
    fun subscribe(topic: string): void {
        if (!subscribed(topic)) topics.append(topic)
        return
    }
    fun unsubscribe(topic: string): void {
        val kept: array<string> = []
        for (item in topics) if (item != topic) kept.append(item)
        topics.clear()
        for (item in kept) topics.append(item)
        return
    }
    fun push(payload: string): void {
        pushes.append(payload)
        return
    }
    fun subscribed(topic: string): bool {
        for (item in topics) if (item == topic) return true
        false
    }
    // Completes timers that are due; returns the milliseconds until the next.
    fun fireTimers(now: int): int {
        var next = 1000
        val waiting: array<OneLiveTimer> = []
        for (t in timers) {
            if (t.due <= now) completions.append(oneResponsePayload(t.id, 200, "timer", ""))
            else {
                waiting.append(t)
                if (t.due - now < next) next = t.due - now
            }
        }
        timers.clear()
        for (t in waiting) timers.append(t)
        next
    }
    fun nextTimer(now: int): int {
        var next = 1000
        for (t in timers) if (t.due - now < next) next = if (t.due - now < 0) 0 else t.due - now
        next
    }
}

fun oneLiveQueue(): OneLiveQueue = OneLiveQueue(0, [], [], [], Map(), [], [], false, [], Map(), Map(), oneRoutes(), false, [])

// Only opaque operation IDs and local request numbers go in the checkpoint;
// request payloads and credentials remain outside it.
fun oneLiveOperationCheckpoint(queue: OneLiveQueue): Json {
    val entries: array<Json> = []
    for (id in queue.requestContexts.keys()) entries.append(jsonObject(["id", "operation"], [jsonInteger(id), jsonString(queue.requestContexts.get(id) ?? "")]))
    jsonObject(["context", "ordinal", "requests"], [jsonString(queue.eventContext), jsonInteger(queue.eventOrdinal), jsonArray(entries)])
}
fun oneLiveOperationRestore(var queue: OneLiveQueue, data: Json): bool {
    val ordinal = data.get("ordinal")
    val entries = data.get("requests")
    val context = data.get("context")
    if (!data.isObject() || !context.isString() || context.asString().size > 512 || !ordinal.isNumber() || !ordinal.asNumber().integer || !ordinal.intAvailable() || ordinal.asInt() < 0 || !entries.isArray() || entries.size() > 4096) return false
    val restored: Map<int, string> = Map()
    for (entry in entries.values) {
        val number = entry.get("id")
        val operation = entry.get("operation")
        if (!entry.isObject() || !number.isNumber() || !number.asNumber().integer || !number.intAvailable() || number.asInt() < 1 || number.asInt() > queue.nextId || !operation.isString() || operation.asString().size < 1 || operation.asString().size > 512 || restored.has(number.asInt())) return false
        restored.set(number.asInt(), operation.asString())
    }
    queue.eventContext = context.asString()
    queue.eventOrdinal = ordinal.asInt()
    for (id in queue.requestContexts.keys()) queue.requestContexts.remove(id)
    for (id in restored.keys()) queue.requestContexts.set(id, restored.get(id) ?? "")
    true
}

// Session queues, shared by each session's services and the server. They are
// reached through this global (by session id), which is how both sides may
// change the same queue.
val oneLiveQueueList: array<OneLiveQueue> = []
val oneLiveQueueIds: array<string> = []

fun oneLiveQueueIndex(session: string): int {
    var i = 0
    while (i < oneLiveQueueIds.size) {
        if (oneLiveQueueIds[i] == session) return i
        i = i + 1
    }
    oneLiveQueueIds.append(session)
    oneLiveQueueList.append(oneLiveQueue())
    oneLiveQueueIds.size - 1
}

fun oneLiveForget(session: string): void {
    val ids: array<string> = []
    val queues: array<OneLiveQueue> = []
    var i = 0
    while (i < oneLiveQueueIds.size) {
        if (oneLiveQueueIds[i] != session) {
            ids.append(oneLiveQueueIds[i])
            queues.append(oneLiveQueueList[i])
        }
        i = i + 1
    }
    oneLiveQueueIds.clear()
    oneLiveQueueList.clear()
    for (id in ids) oneLiveQueueIds.append(id)
    for (q in queues) oneLiveQueueList.append(q)
    return
}

// The services for a new session; call it in the server's app factory with
// the session id the factory receives.
fun oneLiveServices(session: string): OneServices {
    oneLiveQueueIndex(session)
    OneLiveServices(session)
}

class OneLiveServices(val session: string) : OneServices {
    fun nextId(): int {
        val q = oneLiveQueueList[oneLiveQueueIndex(session)]
        val id = q.allocate()
        if (q.eventContext != "") {
            q.eventOrdinal = q.eventOrdinal + 1
            // A long upload can chain thousands of completions. Hash the
            // ancestry so an operation ID stays bounded at every depth.
            q.requestContexts.set(id, oneLiveOperationChild(q.eventContext, q.eventOrdinal))
        }
        id
    }
    fun complete(id: int, status: int, body: string, error: string): int {
        oneLiveQueueList[oneLiveQueueIndex(session)].complete(oneResponsePayload(id, status, body, error))
        id
    }
    fun send(request: OneRequest): int {
        val id = nextId()
        val q = oneLiveQueueList[oneLiveQueueIndex(session)]
        val operation = q.requestContexts.get(id) ?? ""
        val recovery = oneRecoverySessions.get(session)
        if(recovery!=null && oneRecoveryRaw(request)){
            val status=oneRecoveryRawMetadata(request)
            if(status!=200)return complete(id,status,"","File request unavailable")
        }
        val captured=if(recovery!=null && oneRecoveryRaw(request))oneLiveRequestSnapshot(request)else request
        q.request(OneLiveRequest(id, captured, operation, session, if (recovery != null) recovery.epoch else 0))
        id
    }
    fun secureRead(key: string): int {
        val value = oneLiveQueueList[oneLiveQueueIndex(session)].storage.get(key)
        if (value != null && value != "") complete(nextId(), 200, value, "") else complete(nextId(), 404, "", "")
    }
    fun secureWrite(key: string, value: Json): int {
        oneLiveQueueList[oneLiveQueueIndex(session)].store(key, jsonStringify(value))
        complete(nextId(), 204, "", "")
    }
    fun secureRemove(key: string): int {
        oneLiveQueueList[oneLiveQueueIndex(session)].unstore(key)
        complete(nextId(), 204, "", "")
    }
    fun timer(milliseconds: int): int {
        // Polling timers may live for the whole session: they must not keep a
        // press's ancestry alive indefinitely or generate a claim each tick.
        val id = oneLiveQueueList[oneLiveQueueIndex(session)].allocate()
        oneLiveQueueList[oneLiveQueueIndex(session)].schedule(OneLiveTimer(id, oneLiveNow() + milliseconds))
        id
    }
    // The page opens the browser's file picker and uploads what was chosen
    // to /one/upload; the completion arrives when the upload does.
    fun pickFiles(mime: array<string>, multiple: bool): int {
        val id = nextId()
        if (!oneRecoveryPickerBegin(session, id, "files")) return complete(id, 429, "", "Too many pending file pickers")
        val types: array<Json> = []
        for (item in mime) types.append(jsonString(item))
        oneLiveQueueList[oneLiveQueueIndex(session)].toPage(jsonStringify(jsonObject(["t", "id", "kind", "accept", "multiple"], [jsonString("pick"), jsonInteger(id), jsonString("files"), jsonArray(types), jsonBoolean(multiple)])))
        id
    }
    fun pickEphemeralFile(mime: array<string>, maximumBytes: int = 16777216, lifetimeMilliseconds: int = 900000): int {
        // The Wasm adapter has no private upload transport yet: fail closed.
        val q=oneLiveQueueList[oneLiveQueueIndex(session)]
        if(session=="client" || !q.browser)return 0
        val id=nextId()
        if(maximumBytes<1 || maximumBytes>16777216 || lifetimeMilliseconds<1 || lifetimeMilliseconds>900000 || mime.size>64)return complete(id,400,"","Invalid ephemeral picker bounds")
        q.expireEphemeral(oneLiveNow())
        if(q.ephemeralCancelled.keys().size>=2048)return complete(id,429,"","Ephemeral request capacity unavailable")
        if(q.ephemeralPickers.keys().size>0 || q.ephemeralFiles.keys().size>0)return complete(id,409,"","Ephemeral picker already active")
        val types: array<Json> = []
        for(item in mime){if(item.size>128)return complete(id,400,"","Invalid ephemeral picker type");types.append(jsonString(item))}
        val nonce=oneLiveSessionId()
        val recovery=oneRecoverySessions.get(session)
        q.ephemeralDeadline=oneLiveNow()+lifetimeMilliseconds
        q.ephemeralRequests.set(id,q.ephemeralDeadline)
        q.ephemeralPickers.set(id,OneEphemeralPicker(id,maximumBytes,oneLiveNow()+lifetimeMilliseconds,nonce,if(recovery==null)0 else recovery.epoch))
        q.ephemeralOutbox.append(jsonStringify(jsonObject(["t","id","kind","accept","multiple","maximumBytes","nonce"],[jsonString("pick-ephemeral"),jsonInteger(id),jsonString("files-ephemeral"),jsonArray(types),jsonBoolean(false),jsonInteger(maximumBytes),jsonString(nonce)])))
        id
    }
    fun readFile(file: OneFile, offset: int, length: int): int {
        if(file.handle.startsWith("ephemeral-file-")){
            val q=oneLiveQueueList[oneLiveQueueIndex(session)]
            q.expireEphemeral(oneLiveNow())
            val bytes=q.fileBytes.get(file.handle)
            if(!q.ephemeralFiles.has(file.handle) || bytes==null)return complete(nextId(),404,"","Ephemeral file unavailable")
            val start=if(offset<0)0 else if(offset>bytes.size)bytes.size else offset
            val count=if(length>262144)262144 else if(length<0)0 else length
            val end=if(start+count>bytes.size)bytes.size else start+count
            val id=nextId()
            q.ephemeralRequests.set(id,q.ephemeralDeadline)
            q.complete(jsonStringify(jsonObject(["requestId","status","body","error","bodyBase64"],[jsonInteger(id),jsonInteger(200),jsonString(""),jsonString(""),jsonString(base64Encode(bytes.slice(start,end)))])))
            return id
        }
        if (oneRecoverySessions.has(session)) {
            val id = nextId()
            val count = if (length > 262144) 262144 else if (length < 0) 0 else length
            val status = oneRecoveryFileRead(session, id, file.handle, if (offset < 0) 0 else offset, count)
            if (status != 200 && status != 202) complete(id, status, "", "File unavailable")
            return id
        }
        val bytes = oneLiveQueueList[oneLiveQueueIndex(session)].fileBytes.get(file.handle)
        if (bytes == null) return complete(nextId(), 404, "", "unknown file handle")
        val start = if (offset < 0) 0 else if (offset > bytes.size) bytes.size else offset
        val count = if (length > 262144) 262144 else if (length < 0) 0 else length
        val end = if (start + count > bytes.size) bytes.size else start + count
        val id = nextId()
        oneLiveQueueList[oneLiveQueueIndex(session)].complete(jsonStringify(jsonObject(["requestId", "status", "body", "error", "bodyBase64"], [jsonInteger(id), jsonInteger(200), jsonString(""), jsonString(""), jsonString(base64Encode(bytes.slice(start, end)))])))
        id
    }
    fun cancelEphemeralFiles(): void {
        val q=oneLiveQueueList[oneLiveQueueIndex(session)]
        q.clearEphemeral()
        q.ephemeralExpired=false
        return
    }
    fun trackEphemeralRequest(requestId: int): bool {
        val q=oneLiveQueueList[oneLiveQueueIndex(session)]
        q.expireEphemeral(oneLiveNow())
        if(requestId<1 || requestId>q.nextId || q.ephemeralDeadline<=oneLiveNow() || q.ephemeralRequests.keys().size>=128)return false
        q.ephemeralRequests.set(requestId,q.ephemeralDeadline)
        true
    }
    fun deleteFile(file: OneFile): int {
        if(file.handle.startsWith("ephemeral-file-")){
            val q=oneLiveQueueList[oneLiveQueueIndex(session)]
            q.expireEphemeral(oneLiveNow())
            val found=q.ephemeralFiles.has(file.handle)
            q.removeFile(file.handle);q.ephemeralFiles.remove(file.handle)
            return complete(nextId(),if(found)204 else 404,"","")
        }
        val id = nextId()
        if (oneRecoverySessions.has(session)) {
            val status = oneRecoveryFileDelete(session, id, file.handle)
            if (status != 200 && status != 202) complete(id, status, "", "File unavailable")
            return id
        }
        complete(id, if (oneLiveQueueList[oneLiveQueueIndex(session)].removeFile(file.handle)) 204 else 404, "", "")
    }
    // Normalized in the browser like the Android host: "profile" is a 256px
    // square JPEG, "emoji" a small transparent PNG, both at most 10 KB.
    fun pickImage(kind: string): int {
        val id = nextId()
        if (!oneRecoveryPickerBegin(session, id, if (kind == "emoji") "emoji" else "profile")) return complete(id, 429, "", "Too many pending file pickers")
        oneLiveQueueList[oneLiveQueueIndex(session)].toPage(jsonStringify(jsonObject(["t", "id", "kind", "accept", "multiple"], [jsonString("pick"), jsonInteger(id), jsonString(if (kind == "emoji") "emoji" else "profile"), jsonArray([jsonString("image/*")]), jsonBoolean(false)])))
        id
    }
    fun clearImageCache(): void { return }
    fun effect(kind: string, payload: string): bool {
        if (kind == "live-checkpoint") return oneRecoveryCapture(session, payload)
        if (kind == "live-restored") return oneRecoveryReady(session)
        if (kind == "copy") {
            val queue = oneLiveQueueList[oneLiveQueueIndex(session)]
            if (queue.browser) queue.toPage(jsonStringify(jsonObject(["t", "text"], [jsonString("copy"), jsonString(payload)])))
            else queue.copies.append(payload)
            return true
        }
        if (kind == "subscribe") {
            oneLiveQueueList[oneLiveQueueIndex(session)].subscribe(payload)
            return true
        }
        if (kind == "unsubscribe") {
            oneLiveQueueList[oneLiveQueueIndex(session)].unsubscribe(payload)
            return true
        }
        false
    }
    fun navigate(path: string, replace: bool = false): void {
        oneLiveQueueList[oneLiveQueueIndex(session)].navigate(path, replace)
        return
    }
    fun back(fallback: string = ""): void {
        oneLiveQueueList[oneLiveQueueIndex(session)].back(fallback)
        return
    }
    fun forward(): void {
        oneLiveQueueList[oneLiveQueueIndex(session)].forward()
        return
    }
}

fun oneLiveOperationChild(parent: string, ordinal: int): string = hexEncode(sha256("$parent:$ordinal"))

class OneLiveSession(
    val id: string,
    var app: OneApp,
    val queue: OneLiveQueue,
    var css: OneCss,
    var cssSent: int,
    var revision: int,
    var html: string,
    var htmlSent: string,
    val maps: array<OneEventMap>,
    var slot: int,
    var lastSeen: int,
    var changed: bool,
    var width: int,
    // web-canvas sessions: laid out and painted on the server.
    var canvas: bool,
    var height: int,
    val scroll: Map<string, int>,
    val delivered: Map<int, int>,
    // From a `page(...)` root: document title, language, meta tags, flow.
    var title: string,
    var lang: string,
    var meta: string,
    var document: bool,
    // What keeps a raced press off a new route; a route message from the page,
    // answered with the next patch; canvas scroll positions per entry.
    val fence: OneRouteFence,
    val presses: OnePresses,
    var routeAnswer: int,
    val scrolls: OneRouteScrolls,
    // A page has had a socket to this session.
    var connected: bool,
    // The last change event the session handled, answered with the next patch.
    var changeAnswer: int,
    // A press has run since the last render.
    var pressed: bool,
    // What the screen on the page says (OneEventMap.screen).
    var shown: int,
    // Width acknowledged only by a patch rendered after hello/viewport.
    var viewportAnswer: int = 0,
    // P2 can defer acknowledgement until its checkpoint CAS is durable.
    var eventFrontier: int = 0,
    var durableFrontier: int = 0,
    var eventAckSent: int = 0,
    var deferEventAck: bool = false,
    // Set by trusted SSR policy; never restored from a client/checkpoint.
    var recoveryEligible: bool = true,
    // Retained separately: changeAnswer is consumed while preparing a patch,
    // but a new node must acknowledge typing whose durable patch was lost.
    var changeFrontier: int = 0,
    var routeFrontier: int = 0
) {
    // The tree of the current state, with its event map: a new revision.
    fun tree(theme: Theme): Node {
        var ui = oneUiSized(if (canvas) "web-canvas" else "web-document", theme, width)
        val root = app.render(ui)
        pressed = false
        title = root.attr("page.title")
        lang = root.attr("page.lang")
        meta = oneWebPageMeta(root)
        document = root.attr("page.flow") == "document"
        // The same controls keep their revision: a screen that re-renders with no change to them (a
        // poll, a clock) doesn't age what's on the page, which gets no patch for it.
        val map = oneEventMap(root)
        if (maps.size == 0 || queue.routes.epoch != fence.epoch || !map.same(maps[maps.size - 1])) {
            revision = revision + 1
            maps.append(map)
        }
        fence.rendered(queue.routes, revision)
        oneEventMapsBound(maps, 8)
        root
    }
    // Renders the current state; returns the markup and records the event map.
    fun render(theme: Theme, iconBase: string): string {
        oneMemoScope = id
        val root = tree(theme)
        if (canvas) {
            scrolls.moved("${queue.routes.entry()}", scroll)
            val frame = onePaintFrame(oneLayout(root, theme, "web-canvas", if (width > 0) width else 390, if (height > 0) height else 844, scroll), if (width > 0) width else 390, if (height > 0) height else 844)
            // Rows the page shows in full are reported like the DOM host does.
            for (v in frame.visible) {
                val last = delivered.get(v.event)
                if (last == null || v.item > last) {
                    delivered.set(v.event, v.item)
                    oneDispatch(app, "web-canvas", theme, v.event, "${v.item}", width)
                    changed = true
                }
            }
            html = oneFrameJson(frame)
        } else html = oneWebRenderInto(root, theme, css, iconBase)
        html
    }
    // An event from the page; `eventRevision` is the revision it was shown at.
    fun event(theme: Theme, eventRevision: int, eventId: int, value: string): void {
        oneMemoScope = id
        // Ids are positions in a render, and several events can arrive before the next one. After a
        // press the screen may be another, and a press needs the screen as it is now. Typing doesn't
        // move a field, and each key would cost a render, unless the route has moved.
        val change = eventId > oneChangeBase
        val moving = queue.routes.epoch != fence.epoch
        if (moving) deliverRoutes()
        if (moving || pressed || (changed && !change)) tree(theme)
        val target = oneEventLanding(maps, revision - eventRevision, eventId, eventRevision < fence.from)
        if (target > 0) {
            oneDispatch(app, if (canvas) "web-canvas" else "web-document", theme, target, value, width)
            changed = true
            if (!change) {
                pressed = true
                presses.landed(eventRevision, eventId)
            }
        } else if (presses.lost(app, eventRevision, eventId)) changed = true
        return
    }
    fun receive(kind: string, payload: string): void {
        oneMemoScope = id
        val previous = queue.eventContext
        val previousOrdinal = queue.eventOrdinal
        if (kind == "result") {
            val completed = oneResponse(payload).requestId
            queue.eventContext = queue.requestContexts.get(completed) ?? ""
            queue.requestContexts.remove(completed)
            queue.eventOrdinal = 0
        }
        app.receive(kind, payload)
        queue.eventContext = previous
        queue.eventOrdinal = previousOrdinal
        changed = true
        return
    }
    // Moves between routes reach the app. Whether there were any.
    fun deliverRoutes(): bool {
        oneMemoScope = id
        val moved = oneRoutesDrain(app, queue.routes)
        if (moved) changed = true
        moved
    }
}


// A message from the page: hello, event, route (the browser moved), viewport, scroll.
// Legacy hosts omit both fields. A sequenced host must send a bounded opaque
// ID and the next number; repeats are acknowledged without redispatch.
fun oneLiveEventBegin(var session: OneLiveSession, m: Json): bool {
    if (!m.has("n") && !m.has("u")) return true
    val id = m.getString("u")
    val number = m.get("n")
    if (!number.isNumber() || !number.asNumber().integer || !number.intAvailable() || !m.get("u").isString() || id.size < 1 || id.size > 128) return false
    val n = m.get("n").asInt()
    if (n < 1 || n > 9007199254740991) return false
    if (n <= session.eventFrontier) { session.changed = true; return false }
    if (n != session.eventFrontier + 1) return false
    session.eventFrontier = n
    if (!session.deferEventAck) session.durableFrontier = n
    session.changed = true
    true
}
fun oneSessionMessage(var session: OneLiveSession, theme: Theme, m: Json): void {
    val kind = m.getString("t")
    if (kind == "event") {
        if (!oneLiveEventBegin(session, m)) return
        val previous = session.queue.eventContext
        val previousOrdinal = session.queue.eventOrdinal
        session.queue.eventContext = if (m.get("u").isString()) m.getString("u") else ""
        session.queue.eventOrdinal = 0
        session.event(theme, m.get("r").asInt(), m.get("id").asInt(), m.getString("v"))
        session.queue.eventContext = previous
        session.queue.eventOrdinal = previousOrdinal
        if (m.get("c").intAvailable()) {
            session.changeAnswer = m.get("c").asInt()
            session.changeFrontier = session.changeAnswer
            session.changed = true
        }
    }
    else if (kind == "pick-error" && m.get("id").intAvailable()) {
        session.queue.complete(oneResponsePayload(m.get("id").asInt(), 0, "", m.getString("error")))
    }
    else if (kind == "hello") {
        session.htmlSent = ""
        session.cssSent = 0
        session.eventAckSent = -1
        session.changed = true
        session.changeAnswer = session.changeFrontier
        session.routeAnswer = session.routeFrontier
        if (m.get("w").intAvailable()) {
            session.width = m.get("w").asInt()
            session.viewportAnswer = session.width
        }
        if (m.get("h").intAvailable()) session.height = m.get("h").asInt()
        if (m.get("e").intAvailable()) session.queue.routes.adopt(m.get("e").asInt())
    } else if (kind == "route") {
        if (session.deferEventAck && m.get("n").intAvailable() && m.get("n").asInt() > 0 && m.get("n").asInt() <= session.routeFrontier) {
            session.routeAnswer = session.routeFrontier
            session.changed = true
            return
        }
        session.queue.routes.arrive(m.getString("p"), m.get("e").asInt())
        session.routeAnswer = m.get("n").asInt()
        session.routeFrontier = session.routeAnswer
        session.changed = true
    } else if (kind == "viewport" && m.get("w").intAvailable()) {
        session.width = m.get("w").asInt()
        session.viewportAnswer = session.width
        if (m.get("h").intAvailable()) session.height = m.get("h").asInt()
        session.changed = true
    } else if (kind == "scroll" && m.get("y").intAvailable()) {
        session.scroll.set(m.getString("key"), m.get("y").asInt())
        session.changed = true
    }
    return
}

// Renders a changed session; returns the page message (a patch, or a frame
// for canvas sessions), or "" when nothing the page shows changed.
fun oneSessionUpdate(var session: OneLiveSession, theme: Theme, iconBase: string): string {
    if (!session.changed) return ""
    session.changed = false
    val markup = session.render(theme, iconBase)
    val moves = session.queue.takeMoves()
    val answer = session.routeAnswer
    session.routeAnswer = 0
    val same = markup == session.htmlSent
    // A move goes out even when the screen looks the same: the URL still changes.
    val typed = session.changeAnswer
    session.changeAnswer = 0
    val viewport = session.viewportAnswer
    session.viewportAnswer = 0
    val frontier = session.durableFrontier
    if (same && moves.size == 0 && answer == 0 && typed == 0 && viewport == 0 && frontier == session.eventAckSent) return ""
    val screen = session.maps[session.maps.size - 1].screen
    val kept = moves.size > 0 && screen == session.shown
    session.shown = screen
    // Atomic class IDs belong to this session's style table. A fresh owner
    // may reuse the previous owner's IDs for different declarations.
    val cssReset = session.cssSent == 0
    val css = if (cssReset) session.css.text() else session.css.since(session.cssSent)
    session.cssSent = session.css.rules.size
    session.htmlSent = markup
    val keys = ["t", "r", "css", "title"]
    val values = [jsonString(if (session.canvas) "frame" else "patch"), jsonInteger(session.revision), jsonString(css), jsonString(session.title)]
    if (cssReset) {
        keys.append("cssReset")
        values.append(jsonBoolean(true))
    }
    if (frontier > 0 || session.eventAckSent < 0) {
        keys.append("a")
        values.append(jsonInteger(frontier))
        session.eventAckSent = frontier
    }
    if (viewport > 0) {
        keys.append("viewport")
        values.append(jsonInteger(viewport))
    }
    if (!same && !session.canvas) {
        keys.append("html")
        values.append(jsonString(markup))
    }
    if (moves.size > 0 || answer > 0) {
        keys.append("nav")
        values.append(jsonArray(moves))
        keys.append("ack")
        values.append(jsonInteger(answer))
        keys.append("at")
        values.append(jsonString(session.queue.routes.current()))
    }
    if (kept) {
        keys.append("kept")
        values.append(jsonBoolean(true))
    }
    if (typed > 0) {
        keys.append("c")
        values.append(jsonInteger(typed))
    }
    val text = jsonStringify(jsonObject(keys, values))
    if (session.canvas && !same) "${text.slice(0, text.size - 1)},\"frame\":$markup}" else text
}

fun oneSession(id: string, app: OneApp, queue: OneLiveQueue): OneLiveSession {
    OneLiveSession(id, app, queue, oneCss(), 0, 0, "", "", [], -1, oneLiveNow(), true, 0, false, 0, Map(), Map(), "", "", "", false, oneRouteFence(), onePresses(), 0, oneRouteScrolls(), false, 0, false, 0)
}
