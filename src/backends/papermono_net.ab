import "papermono.ab"
import "papermono_policy.ab"
import "abla/bytes"
import "abla/json"
import "../../../abla-embedded/src/esp32/esp_idf_net.ab"

// The network and storage of a PaperMono app (SPEC §9): HTTP through ESP-IDF's sockets
// and TLS, secure values in NVS, timers. Requests run one at a time between touches: a
// request blocks the loop, but touch is still read while it waits.

trusted noescape extern:"c" fun lwip_socket(domain: i32, kind: i32, protocol: i32): i32
trusted noescape extern:"c" fun lwip_connect(socket: i32, address: i64*, length: u32): i32
trusted noescape extern:"c" fun lwip_send(socket: i32, data: i64*, length: u32, flags: i32): i32
trusted noescape extern:"c" fun lwip_recv(socket: i32, data: i64*, length: u32, flags: i32): i32
trusted noescape extern:"c" fun lwip_close(socket: i32): i32
trusted noescape extern:"c" fun nvs_open(name: i64*, mode: i32, handle: i64*): i32
trusted noescape extern:"c" fun nvs_set_blob(handle: u32, key: i64*, value: i64*, length: u32): i32
trusted noescape extern:"c" fun nvs_get_blob(handle: u32, key: i64*, value: i64*, length: i64*): i32
trusted noescape extern:"c" fun nvs_erase_key(handle: u32, key: i64*): i32
trusted noescape extern:"c" fun nvs_commit(handle: u32): i32
trusted noescape extern:"c" fun nvs_close(handle: u32): void
trusted noescape extern:"c" fun nvs_get_u8(handle: u32, key: i64*, value: i64*): i32
trusted noescape extern:"c" fun nvs_set_u8(handle: u32, key: i64*, value: u8): i32
trusted noescape extern:"c" fun nvs_flash_secure_init(keys: i64*): i32
trusted noescape extern:"c" fun nvs_flash_deinit(): i32
trusted noescape extern:"c" fun esp_efuse_get_key_purpose(block: i32): i32
trusted noescape extern:"c" fun esp_hmac_calculate(key: i32, message: i64*, length: u32, out: i64*): i32

// Wi-Fi credentials, as C strings with their lengths.
// `storage`: how secure values are kept (oneNetStartStorage), and tools/papermono-thin-config sets it.
class OneWifiConfig(val ssid: int, val ssidLength: int, val password: int, val passwordLength: int,
    val storage: int = 0, val storageKey: int = 0, val storageFuse: int = 0)

val oneNetHostStorage = nativeStaticAllocate(256)
val oneNetReceiveStorage = nativeStaticAllocate(2048)
val oneNetAddressStorage = nativeStaticAllocate(16)
val oneNetCells = nativeStaticMutableU32s([0, 0])
val oneNetKeyStorage = nativeStaticAllocate(16)
val oneNetLargest = 262144

// A URL's parts: http://1.2.3.4[:port]/path or https://name[:port]/path.
class OneNetUrl(val tls: bool, val host: string, val port: int, val path: string, val valid: bool)

fun oneNetParseUrl(url: string): OneNetUrl {
    val tls = url.startsWith("https://")
    if (!tls && !url.startsWith("http://")) return OneNetUrl(false, "", 0, "", false)
    val start = if (tls) 8 else 7
    var end = start
    while (end < url.size && url[end] != 47 && url[end] != 58) end = end + 1
    val host = url.slice(start, end)
    var port = if (tls) 443 else 80
    var pathAt = end
    if (end < url.size && url[end] == 58) {
        pathAt = end + 1
        while (pathAt < url.size && url[pathAt] != 47) pathAt = pathAt + 1
        port = oneParseInt(url.slice(end + 1, pathAt), port)
    }
    OneNetUrl(tls, host, port, if (pathAt < url.size) url.slice(pathAt, url.size) else "/", host != "")
}

// The request as bytes: HTTP/1.0, so the answer has no chunks and ends with the connection.
fun oneNetRequestText(request: OneRequest, url: OneNetUrl): string {
    var head = "${request.method} ${url.path} HTTP/1.0\r\nHost: ${url.host}\r\nConnection: close\r\nContent-Length: ${request.body.size}\r\n"
    for (header in request.headers) head = "$head${header.name}: ${header.value}\r\n"
    "$head\r\n${request.body}"
}

// A response as a completion payload (oneResponse), given what came over the wire.
fun oneNetCompletion(id: int, answer: string): string {
    if (answer.size < 12 || !answer.startsWith("HTTP/")) return oneResponsePayload(id, 0, "", "no answer")
    val status = oneParseInt(answer.slice(9, 12), 0)
    var body = 0
    while (body + 3 < answer.size && !(answer[body] == 13 && answer[body + 1] == 10 && answer[body + 2] == 13 && answer[body + 3] == 10)) body = body + 1
    oneResponsePayload(id, status, if (body + 4 <= answer.size) answer.slice(body + 4, answer.size) else "", "")
}

// NVS keys are at most 15 characters: a stable hash of the app's key.
fun oneNetKey(key: string): string {
    var h = 5381
    for (b in key) h = (h * 33 + b) & 1099511627775
    "k$h"
}

trusted fun oneNetCString(text: string, storage: int, capacity: int): bool {
    if (text.size + 1 > capacity) return false
    val out = nativeBufferAt(storage, capacity)
    var i = 0
    while (i < text.size) {
        out.store(i, text[i])
        i = i + 1
    }
    out.store(text.size, 0)
    true
}

trusted fun oneNetSocket(url: OneNetUrl): int {
    var octets: array<int> = []
    var part = 0
    var digits = 0
    for (b in url.host) {
        if (b == 46) {
            octets.append(part)
            part = 0
        } else if (b >= 48 && b <= 57) {
            part = part * 10 + b - 48
            digits = digits + 1
        } else return -1
    }
    octets.append(part)
    if (octets.size != 4 || digits == 0) return -1
    val socket = int(lwip_socket(i32(2), i32(1), i32(0)))
    if (socket < 0) return -1
    val address = nativeBufferAt(oneNetAddressStorage, 16)
    var offset = 0
    while (offset < 16) {
        address.storeU32(offset, 0)
        offset = offset + 4
    }
    address.store(0, 16)
    address.store(1, 2)
    address.store(2, (url.port >> 8) & 255)
    address.store(3, url.port & 255)
    address.store(4, octets[0])
    address.store(5, octets[1])
    address.store(6, octets[2])
    address.store(7, octets[3])
    val timeout = nativeBufferAt(socketTimeoutStorage, 16)
    timeout.storeU32(0, 5)
    timeout.storeU32(4, 0)
    timeout.storeU32(8, 0)
    timeout.storeU32(12, 0)
    lwip_setsockopt(i32(socket), i32(solSocket), i32(soReceiveTimeout), pointer(socketTimeoutStorage), u32(16))
    lwip_setsockopt(i32(socket), i32(solSocket), i32(soSendTimeout), pointer(socketTimeoutStorage), u32(16))
    if (lwip_connect(i32(socket), pointer(oneNetAddressStorage), u32(16)) != i32(0)) {
        lwip_close(i32(socket))
        return -1
    }
    socket
}

// Sends `text` and returns everything that comes back ("" if nothing does).
trusted fun oneNetExchange(url: OneNetUrl, text: string, onWait: () -> void): string {
    if (!oneNetCString(url.host, oneNetHostStorage, 256)) return ""
    val connection = if (url.tls) (tlsConnectBundle(oneNetHostStorage, url.host.size, url.port, 5000)|0) else oneNetSocket(url)
    if (connection <= 0) return ""
    val chunk = nativeBufferAt(oneNetReceiveStorage, 2048)
    var sent = 0
    var fine = true
    while (sent < text.size && fine) {
        val size = if (text.size - sent > 2048) 2048 else text.size - sent
        var i = 0
        while (i < size) {
            chunk.store(i, text[sent + i])
            i = i + 1
        }
        fine = if (url.tls) TlsConnection(connection).writeAll(oneNetReceiveStorage, size)
            else int(lwip_send(i32(connection), pointer(oneNetReceiveStorage), u32(size), i32(0))) == size
        sent = sent + size
    }
    var answer = byteBuffer()
    var quiet = 0
    var total = 0
    while (fine && quiet < 1000 && total < oneNetLargest) {
        onWait()
        val read = if (url.tls) TlsConnection(connection).readSome(oneNetReceiveStorage, 2048)
            else int(lwip_recv(i32(connection), pointer(oneNetReceiveStorage), u32(2048), i32(0)))
        if (read > 0) {
            var at = 0
            while (at < read) {
                answer.appendByteValue(chunk.load(at))
                at = at + 1
            }
            total = total + read
            quiet = 0
        } else if (url.tls && tlsWouldBlock(read)) {
            delayMilliseconds(5)
            quiet = quiet + 1
        } else quiet = 1000
    }
    if (url.tls) TlsConnection(connection).close() else lwip_close(i32(connection))
    answer.toText()
}

val oneNetStoragePlain = 0
val oneNetStorageBuildKey = 1
val oneNetStorageFuse = 2
// nvs_sec_cfg_t: the XTS encryption key, then its tweak key.
val oneNetKeysStorage = nativeStaticAllocate(64)
val oneNetSeedStorage = nativeStaticAllocate(32)
val oneNetFlagStorage = nativeStaticAllocate(4)
// ESP-IDF's seeds (nvs_sec_provider.c), so its own scheme would derive the same keys.
val oneNetEncryptSeed = 2931710554
val oneNetTweakSeed = 3470697893
val oneNetFuseFirstKeyBlock = 4
val oneNetFuseHmacUp = 8

trusted fun oneNetFuseKey(fuse: int, seed: int, out: int): bool {
    val message = nativeBufferAt(oneNetSeedStorage, 32)
    var i = 0
    while (i < 32) {
        message.storeU32(i, seed)
        i = i + 4
    }
    esp_hmac_calculate(i32(fuse), pointer(oneNetSeedStorage), u32(32), pointer(out)) == i32(0)
}

// The keys into oneNetKeysStorage; false if they can't be had. Only reads eFuses.
trusted fun oneNetStorageKeys(wifi: OneWifiConfig): bool {
    if (wifi.storage == oneNetStorageBuildKey) {
        val from = nativeBufferAt(wifi.storageKey, 64)
        val keys = nativeBufferAt(oneNetKeysStorage, 64)
        var i = 0
        while (i < 64) {
            keys.store(i, from.load(i))
            i = i + 1
        }
        return true
    }
    if (int(esp_efuse_get_key_purpose(i32(oneNetFuseFirstKeyBlock + wifi.storageFuse))) != oneNetFuseHmacUp) {
        println("papermono: secure storage needs its eFuse key, which isn't there (docs/papermono-secure-storage.md)")
        return false
    }
    oneNetFuseKey(wifi.storageFuse, oneNetEncryptSeed, oneNetKeysStorage) && oneNetFuseKey(wifi.storageFuse, oneNetTweakSeed, oneNetKeysStorage + 32)
}

// A first start on encrypted NVS: anything from before is erased, or the plain values would
// stay on flash, unreadable by the app and readable by anyone else.
trusted fun oneNetStorageMarked(): bool {
    if (nvs_open(pointer(nativeStaticBytes("abla_one_sec\x00")), i32(1), pointer(oneNetCells)) != i32(0)) return false
    val handle = u32(nativeAddressLoadU32(oneNetCells, 0))
    val key = pointer(nativeStaticBytes("encrypted\x00"))
    val marked = nvs_get_u8(handle, key, pointer(oneNetFlagStorage)) == i32(0)
    nvs_close(handle)
    marked
}

trusted fun oneNetStorageMark(): bool {
    if (nvs_open(pointer(nativeStaticBytes("abla_one_sec\x00")), i32(1), pointer(oneNetCells)) != i32(0)) return false
    val handle = u32(nativeAddressLoadU32(oneNetCells, 0))
    val status = nvs_set_u8(handle, pointer(nativeStaticBytes("encrypted\x00")), u8(1))
    val committed = nvs_commit(handle)
    nvs_close(handle)
    status == i32(0) && committed == i32(0)
}

// Brings up NVS as the build says, and then Wi-Fi. Encrypted fails closed: without its keys
// there's no storage, and values aren't kept in the clear instead.
trusted fun oneNetStartStorage(wifi: OneWifiConfig): int {
    if (wifi.storage == oneNetStoragePlain) return wifiStart()
    if (!oneNetStorageKeys(wifi)) return 100
    val keys = pointer(oneNetKeysStorage)
    if (nvs_flash_secure_init(keys) != i32(0) || !oneNetStorageMarked()) {
        nvs_flash_deinit()
        nvs_flash_erase()
        if (nvs_flash_secure_init(keys) != i32(0)) return 101
        if (!oneNetStorageMark()) return 102
    }
    wifiStartDriver()
}

// A secure value: NVS holds it (encrypted by a build with ONE_SECURE_STORAGE, on plain flash
// otherwise), "" when absent.
trusted fun oneNetStoreOpen(): u32 {
    val status = nvs_open(pointer(nativeStaticBytes("abla_one\x00")), i32(1), pointer(oneNetCells))
    if (status != i32(0)) return u32(0)
    u32(nativeAddressLoadU32(oneNetCells, 0))
}

trusted fun oneNetStoreRead(key: string): string {
    val handle = oneNetStoreOpen()
    if (int(handle) == 0 || !oneNetCString(oneNetKey(key), oneNetKeyStorage, 16)) return ""
    nativeAddressStoreU32(oneNetCells, 4, 2048)
    val status = nvs_get_blob(handle, pointer(oneNetKeyStorage), pointer(oneNetReceiveStorage), pointer(oneNetCells + 4))
    nvs_close(handle)
    if (status != i32(0)) return ""
    val size = nativeAddressLoadU32(oneNetCells, 4)
    val chunk = nativeBufferAt(oneNetReceiveStorage, 2048)
    var out = byteBuffer()
    var i = 0
    while (i < size) {
        out.appendByteValue(chunk.load(i))
        i = i + 1
    }
    out.toText()
}

trusted fun oneNetStoreWrite(key: string, value: string): bool {
    val handle = oneNetStoreOpen()
    if (int(handle) == 0 || value.size > 2048 || !oneNetCString(oneNetKey(key), oneNetKeyStorage, 16)) return false
    val chunk = nativeBufferAt(oneNetReceiveStorage, 2048)
    var i = 0
    while (i < value.size) {
        chunk.store(i, value[i])
        i = i + 1
    }
    val status = nvs_set_blob(handle, pointer(oneNetKeyStorage), pointer(oneNetReceiveStorage), u32(value.size))
    nvs_commit(handle)
    nvs_close(handle)
    status == i32(0)
}

trusted fun oneNetStoreRemove(key: string): void {
    val handle = oneNetStoreOpen()
    if (int(handle) == 0 || !oneNetCString(oneNetKey(key), oneNetKeyStorage, 16)) return
    nvs_erase_key(handle, pointer(oneNetKeyStorage))
    nvs_commit(handle)
    nvs_close(handle)
    return
}

class OnePaperMonoJob(val id: int, val kind: string, val key: string, val value: string, val request: OneRequest, val due: int)

val onePaperMonoJobs: array<OnePaperMonoJob> = []
var onePaperMonoNextJob = 0

fun onePaperMonoAdd(kind: string, key: string, value: string, request: OneRequest, due: int): int {
    onePaperMonoNextJob = onePaperMonoNextJob + 1
    onePaperMonoJobs.append(OnePaperMonoJob(onePaperMonoNextJob, kind, key, value, request, due))
    onePaperMonoNextJob
}

// What an app on a PaperMono calls. Everything completes later, in order, from the
// run loop (onePaperMonoServe). What a PaperMono can't do completes with 501.
class OnePaperMonoServices() : OneServices {
    fun none(): OneRequest = oneRequest("", "")
    fun send(request: OneRequest): int = onePaperMonoAdd("http", "", "", request, 0)
    fun secureRead(key: string): int = onePaperMonoAdd("read", key, "", none(), 0)
    fun secureWrite(key: string, value: Json): int = onePaperMonoAdd("write", key, jsonStringify(value), none(), 0)
    fun secureRemove(key: string): int = onePaperMonoAdd("remove", key, "", none(), 0)
    fun timer(milliseconds: int): int = onePaperMonoAdd("timer", "", "", none(), onePaperMonoMilliseconds() + milliseconds)
    fun pickFiles(mime: array<string>, multiple: bool): int = onePaperMonoAdd("none", "", "", none(), 0)
    fun readFile(file: OneFile, offset: int, length: int): int = onePaperMonoAdd("none", "", "", none(), 0)
    fun deleteFile(file: OneFile): int = onePaperMonoAdd("none", "", "", none(), 0)
    fun pickImage(kind: string): int = onePaperMonoAdd("none", "", "", none(), 0)
    fun clearImageCache(): void { return }
    fun effect(kind: string, payload: string): bool = false
    fun navigate(path: string, replace: bool = false): void {
        oneAppRoutes.navigate(path, replace)
        return
    }
    fun back(fallback: string = ""): void {
        oneAppRoutes.back(fallback)
        return
    }
    fun forward(): void {
        oneAppRoutes.forward()
        return
    }
}

// Runs one job that is due, and returns its completion ("" if none was).
trusted fun onePaperMonoServe(): string {
    var i = 0
    while (i < onePaperMonoJobs.size) {
        val job = onePaperMonoJobs[i]
        val waits = job.kind == "http" && oneNetRequestWaits(wifiHasAddress(), onePaperMonoMilliseconds(), oneNetWaitUntil)
        if (!waits && (job.kind != "timer" || onePaperMonoMilliseconds() >= job.due)) {
            var k = i
            while (k + 1 < onePaperMonoJobs.size) {
                onePaperMonoJobs[k] = onePaperMonoJobs[k + 1]
                k = k + 1
            }
            onePaperMonoJobs.truncate(onePaperMonoJobs.size - 1)
            return onePaperMonoRun1(job)
        }
        i = i + 1
    }
    ""
}

trusted fun onePaperMonoRun1(job: OnePaperMonoJob): string {
    if (job.kind == "timer") return oneResponsePayload(job.id, 200, "", "")
    if (job.kind == "read") {
        val value = oneNetStoreRead(job.key)
        return oneResponsePayload(job.id, if (value == "") 404 else 200, value, "")
    }
    if (job.kind == "write") return oneResponsePayload(job.id, if (oneNetStoreWrite(job.key, job.value)) 204 else 500, "", "")
    if (job.kind == "remove") {
        oneNetStoreRemove(job.key)
        return oneResponsePayload(job.id, 204, "", "")
    }
    if (job.kind == "http") {
        val url = oneNetParseUrl(job.request.url)
        if (!url.valid) return oneResponsePayload(job.id, 501, "", "needs an absolute http(s) URL")
        if (!wifiHasAddress()) return oneResponsePayload(job.id, 0, "", "no network")
        return oneNetCompletion(job.id, oneNetExchange(url, oneNetRequestText(job.request, url), { paperMonoGestureSample() }))
    }
    oneResponsePayload(job.id, 501, "", "not on a PaperMono")
}

val oneNetStarted = nativeStaticMutableU32s([0])
var oneNetWaitUntil = 0

// A networked app on a PaperMono: the screen comes first, Wi-Fi joins in the background from
// the idle loop, and `services` jobs run between touches. Runs until the device powers off.
trusted fun onePaperMonoRunNet(var app: OneApp, theme: Theme, icons: OneIconSource, wifi: OneWifiConfig): void {
    onePaperMonoLoop(app, theme, icons, {
        if (nativeAddressLoadU32(oneNetStarted, 0) == 0) {
            nativeAddressStoreU32(oneNetStarted, 0, 1)
            oneNetWaitUntil = onePaperMonoMilliseconds() + oneNetBootWait
            val status = oneNetStartStorage(wifi)
            if (status != 0) println("papermono: Wi-Fi start failed: $status")
            else if (!wifiJoinBegin(wifi.ssid, wifi.ssidLength, wifi.password, wifi.passwordLength)) println("papermono: no Wi-Fi: its name or password doesn't fit")
        }
        wifiJoinTick()
        onePaperMonoServe()
    })
    return
}
